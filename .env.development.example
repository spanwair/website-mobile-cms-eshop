# Supabase — development project
PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY

# Website (Astro uses PUBLIC_ prefix)
PUBLIC_SUPABASE_URL=https://YOUR_DEV_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_DEV_ANON_KEY
# Base domain for storefront subdomains (store-slug.PUBLIC_APP_DOMAIN); custom domains
# in store_domains are matched first, this is only the subdomain fallback.
PUBLIC_APP_DOMAIN=localhost:4321
# Server-only — never expose to browser. Used for admin operations (invite users, etc.)
# Local dev: run `supabase status` and copy the "service_role key"
SUPABASE_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

# App version
EXPO_PUBLIC_VERSION=1.0.0
EXPO_PUBLIC_APP_NAME=Template Dev

# EAS
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Stripe — TEST MODE keys only (dashboard.stripe.com/test/apikeys)
# Full setup guide: docs/src/content/docs/guides/integrations.md
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4321/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend transactional email — https://resend.com/api-keys
# No domain verified yet? Leave RESEND_API_KEY unset — email.ts logs to
# the console instead of sending (see sendPartyInvitation dev fallback).
RESEND_API_KEY=re_...
EMAIL_FROM=onboarding@resend.dev
# Inbox that receives /landingpage lead-capture and contact-form emails
LEADS_INBOX=founders@yourdomain.cz

# Public shop URL (used in emails for links)
PUBLIC_SHOP_URL=http://localhost:4321

# Shared secret checked by POST /api/cron/monthly-platform-fees against the x-cron-secret
# header. See supabase/migrations/20260103000073_monthly_fee_cron.sql for the matching
# one-time `ALTER DATABASE ... SET app.settings.*` setup this needs in the dev DB.
CRON_SECRET=

# Shipping — PPL / Packeta. Leave unset for local dev — PUBLIC_SHIPPING_MOCK_MODE=true
# below makes checkout use a built-in mock carrier so you never need real credentials
# to develop or run Playwright locally. See .env.production.example for what each var
# is and where to get real values once you have carrier accounts.
PPL_CLIENT_ID=
PPL_CLIENT_SECRET=
PPL_API_BASE_URL=https://api-sandbox.dhl.com/ecs/ppl/sandbox
PUBLIC_PPL_WIDGET_API_KEY=
# PPL_LIVE_BOOKING gates REAL billable shipment creation. Leave empty/false in dev:
# CPL creds above are still used read-only for the pickup-point map + validation
# (GET /accessPoint, free), but booking stays on the mock carrier. Only set "true" in prod.
PPL_LIVE_BOOKING=
PACKETA_API_PASSWORD=
PACKETA_SENDER_LABEL=
PUBLIC_PACKETA_WIDGET_API_KEY=
PUBLIC_SHIPPING_MOCK_MODE=true
