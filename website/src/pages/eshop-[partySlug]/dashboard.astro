---
import Layout from "../../components/layout/Layout.astro";
import DashboardBody from "../../components/dashboard/DashboardBody.astro";
import { loadDashboardView } from "../../lib/customerDashboard";
import { useT } from "../../lib/i18n";

const storeParty = Astro.locals.storeParty;
if (!storeParty) return Astro.redirect("/shop");

// Scope the account view to the eshop in context so it renders inside this store's own chrome.
const view = await loadDashboardView(Astro, { partyId: storeParty.id });
if (view.redirect) return Astro.redirect(view.redirect);

const t = useT(Astro);
---

<Layout title={`${t.dashboard.welcomeBack} — ${view.brandName}`}>
  <div class="account-page">
    <DashboardBody
      displayName={view.displayName}
      brandName={view.brandName}
      shopHref={view.shopHref}
      logoUrl={view.logoUrl}
      storeConfig={view.storeConfig}
      account={view.account}
    />
  </div>
</Layout>

<style>
  .account-page { padding: 32px 24px; }
</style>
