---
import Layout from "../../components/layout/Layout.astro";
import CheckoutAddressForm from "../../components/shop/CheckoutAddressForm.astro";
import CheckoutOrderSummary from "../../components/shop/CheckoutOrderSummary.astro";
import ShippingProviderSelector from "../../components/shop/ShippingProviderSelector.astro";
import PaymentProviderSelector from "../../components/shop/PaymentProviderSelector.astro";
import { createSupabase, createAdminClient } from "../../lib/supabase";
import { getOrCreateGuestCartId } from "../../lib/guestCart";
import { clearCart, calcCartTotal, type CartIdentity } from "@shared/services/cartService";
import { createOrder, addOrderItemsOrRollback } from "@shared/services/orderService";
import { fetchEnabledShippingConfigs, computeShippingCost } from "@shared/services/shippingConfigService";
import { createShipmentRecord } from "@shared/services/shipmentService";
import { computeItemTax, computeOrderTax } from "@shared/utils/tax";
import { startOrderCheckout } from "../../lib/checkoutFlow";
import { sendOrderConfirmation } from "../../lib/integrations/email";
import { PAYMENT_METHOD, COD_FEE_CZK } from "@shared/constants/payment";
import { SELLER_MODE } from "@shared/constants/sellerMode";
import { sellerOfRecordInfo } from "@shared/constants/company";
import { useT, getLang } from "../../lib/i18n";

const { partySlug } = Astro.params;
const storeParty = Astro.locals.storeParty;
if (!storeParty) return Astro.redirect("/shop");
const partyId = storeParty.id;
const linkBase = `/eshop-${partySlug}`;

const supabase = createSupabase(Astro);
const t = useT(Astro);
const lang = getLang(Astro);

const { data: { session } } = await supabase.auth.getSession();
const identity: CartIdentity = session
  ? { userId: session.user.id }
  : { sessionId: getOrCreateGuestCartId(Astro.cookies) };
const adminClient = createAdminClient();
const cartClient = session ? supabase : adminClient;

let cartQuery = cartClient
  .from("carts")
  .select("*, cart_items(*, product:products(id, title, slug, price, discount_price, sku, tax_rate))")
  .eq("party_id", partyId);
cartQuery = identity.userId !== undefined ? cartQuery.eq("user_id", identity.userId) : cartQuery.eq("session_id", identity.sessionId);
const { data: cartRaw } = await cartQuery.order("updated_at", { ascending: false }).limit(1).maybeSingle();

const cart = cartRaw as any;
if (!cart || !(cart.cart_items?.length > 0)) return Astro.redirect(`${linkBase}/cart`);

const items = cart.cart_items ?? [];
const { subtotal } = calcCartTotal(items.map((i: any) => ({ ...i, unit_price: Number(i.unit_price) })));

const { data: sellingParty } = await supabase.from("parties").select("seller_mode").eq("id", partyId).single();
const sellerMode = (sellingParty?.seller_mode ?? "own_company") as "own_company" | "smalljobs_commission";
const shippingConfigs = await fetchEnabledShippingConfigs(supabase);

let checkoutError = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const firstName = (form.get("first_name") as string).trim();
  const lastName = (form.get("last_name") as string).trim();
  const phone = (form.get("phone") as string)?.trim() || null;
  const line1 = (form.get("line1") as string).trim();
  const city = (form.get("city") as string).trim();
  const postalCode = (form.get("postal_code") as string).trim();
  const countryCode = ((form.get("country_code") as string)?.trim() || "CZ").toUpperCase().slice(0, 2);
  const shippingProviderCode = (form.get("shipping_provider") as string) || "";
  const deliveryType = (form.get("delivery_type") as string) || "home";
  const pickupPointId = (form.get("pickup_point_id") as string) || null;
  const pickupPointName = (form.get("pickup_point_name") as string) || null;
  const pickupPointAddress = (form.get("pickup_point_address") as string) || null;
  const email = (session?.user.email ?? (form.get("email") as string))?.trim();
  const paymentMethod = ((form.get("payment_method") as string) || PAYMENT_METHOD.STRIPE) as "stripe" | "cod";

  try {
    if (!email) throw new Error(t.shop.emailLabel);
    const shippingConfig = shippingConfigs.find((c) => c.code === shippingProviderCode);
    if (!shippingConfig) throw new Error("Invalid shipping method");
    if (deliveryType === "pickup" && !pickupPointId) throw new Error(t.shop.pickupPointRequired);
    const shippingCost = computeShippingCost(shippingConfig, subtotal);
    const paymentFee = paymentMethod === PAYMENT_METHOD.COD ? COD_FEE_CZK : 0;
    let { data: customer } = await adminClient
      .from("customers")
      .select("id")
      .eq("party_id", partyId)
      .eq("email", email)
      .maybeSingle();

    if (!customer) {
      const { data: newCust, error: custErr } = await adminClient
        .from("customers")
        .insert({
          party_id: partyId,
          email,
          first_name: firstName,
          last_name: lastName,
          phone,
          user_id: session?.user.id ?? null,
          is_active: true,
          gdpr_consent: true,
          preferred_language: lang,
        })
        .select("id")
        .single();
      if (custErr) throw new Error(custErr.message);
      customer = newCust!;
    } else {
      // Keep in sync so a returning customer's confirmation email always matches
      // their current session language, not whatever it was on their first order.
      await adminClient.from("customers").update({ preferred_language: lang }).eq("id", customer.id);
    }

    const { data: address, error: addrErr } = await adminClient
      .from("addresses")
      .insert({
        customer_id: customer.id,
        first_name: firstName,
        last_name: lastName,
        line1,
        city,
        postal_code: postalCode,
        country_code: countryCode,
        type: "shipping",
        is_default: true,
      })
      .select("id")
      .single();
    if (addrErr) throw new Error(addrErr.message);

    const orderNumber = "ORD-" + String(Math.floor(Math.random() * 1_000_000)).padStart(8, "0");

    const taxItems = items.map((i: any) => ({ unit_price: Number(i.unit_price), quantity: i.quantity, tax_rate: i.product?.tax_rate ? Number(i.product.tax_rate) : null }));
    const { data: order, error: orderErr } = await createOrder(adminClient, {
      party_id: partyId,
      customer_id: customer.id,
      shipping_address_id: address!.id,
      order_number: orderNumber,
      status: "pending",
      payment_status: "unpaid",
      subtotal,
      tax_amount: computeOrderTax(taxItems, sellerMode),
      shipping_amount: shippingCost,
      payment_method: paymentMethod,
      payment_fee: paymentFee,
      total_amount: subtotal + shippingCost + paymentFee,
      currency: "CZK",
    });
    if (orderErr || !order) throw new Error(orderErr?.message ?? "Order creation failed");

    // Add items — triggers deduct_stock_on_order_item, which atomically guards against
    // overselling. On failure the order is cancelled (not left half-populated) and any
    // stock already deducted for earlier items is restored via return_stock_on_order_cancel.
    const orderItemInputs = items.map((item: any) => ({
      order_id: order.id,
      product_id: item.product_id,
      variant_id: item.variant_id ?? null,
      title: item.product?.title ?? "Product",
      sku: item.product?.sku ?? null,
      quantity: item.quantity,
      unit_price: Number(item.unit_price),
      discount_amount: 0,
      tax_amount: computeItemTax({ unit_price: Number(item.unit_price), quantity: item.quantity, tax_rate: item.product?.tax_rate ? Number(item.product.tax_rate) : null }, sellerMode),
      total_price: Number(item.unit_price) * item.quantity,
    }));
    const { error: itemsErr, insufficientStock } = await addOrderItemsOrRollback(
      adminClient,
      order.id,
      orderItemInputs,
      session?.user.id ?? null
    );
    if (itemsErr) throw new Error(insufficientStock ? t.shop.itemNoLongerAvailable : itemsErr.message);

    // No product weight field exists in this schema yet — a flat per-item estimate is
    // used for the carrier payload until real product weights are tracked.
    const itemCount = items.reduce((s: number, i: any) => s + i.quantity, 0);
    const { error: shipmentErr } = await createShipmentRecord(adminClient, {
      order_id: order.id,
      party_id: partyId,
      provider: shippingProviderCode as "ppl" | "packeta",
      status: "pending",
      pickup_point_id: pickupPointId,
      pickup_point_name: pickupPointName,
      pickup_point_address: pickupPointAddress,
      shipping_cost: shippingCost,
      weight_kg: Math.max(1, itemCount * 0.5),
    });
    if (shipmentErr) throw new Error(shipmentErr.message);

    // adminClient — a guest cart has no anon RLS grant to clear via `supabase`
    await clearCart(adminClient, cart.id);

    if (paymentMethod === PAYMENT_METHOD.COD) {
      // No online payment step — the carrier collects payment_fee + total_amount from the
      // customer on handover, so the order is confirmed immediately. payment_status stays
      // 'unpaid' until the delivery-status cron (api/cron/refresh-shipment-statuses) sees
      // the carrier report the shipment delivered.
      // The order is already committed and the cart already cleared at this point — a
      // transient email-provider failure must not surface as a checkout error (matches
      // confirmStripeSession's own email try/catch in lib/checkoutFlow.ts).
      try {
        await sendOrderConfirmation({
          to: email,
          customerName: `${firstName} ${lastName}`,
          orderNumber: order.order_number,
          orderTotal: order.total_amount,
          items: items.map((i: any) => ({ title: i.product?.title ?? "Product", quantity: i.quantity, price: Number(i.unit_price) })),
          currency: order.currency,
          lang,
          sellerOfRecord: sellerMode === SELLER_MODE.SMALLJOBS_COMMISSION ? sellerOfRecordInfo(lang) : undefined,
        });
      } catch (emailErr) {
        console.error("COD order confirmation email failed:", (emailErr as Error).message);
      }
      return Astro.redirect(`${linkBase}/order-confirmation?order=${order.order_number}`);
    }

    const { url: sessionUrl, error: sessionError } = await startOrderCheckout({
      items,
      orderId: order.id,
      currency: "czk",
      shippingCost,
      shippingLabel: shippingConfig.display_name,
      successUrl: `${Astro.url.origin}${linkBase}/order-confirmation?order=${order.order_number}&session_id={CHECKOUT_SESSION_ID}`,
      cancelUrl: `${Astro.url.origin}${linkBase}/checkout`,
    });
    if (sessionError || !sessionUrl) throw new Error(sessionError ?? "Could not start checkout session");

    return Astro.redirect(sessionUrl);
  } catch (e: any) {
    checkoutError = e?.message ?? "Checkout failed. Please try again.";
  }
}

// Matches the defaults baked into ShippingProviderSelector (first config checked) and
// PaymentProviderSelector (Stripe checked) so the summary is correct before any JS runs.
const defaultShippingConfig = shippingConfigs[0];
const defaultShippingCost = defaultShippingConfig ? computeShippingCost(defaultShippingConfig, subtotal) : 0;
---

<Layout title={t.shop.checkoutTitle}>
  <div class="checkout-page">
    <h1 class="page-title">{t.shop.checkoutTitle}</h1>

    {checkoutError && <div class="form-error" style="margin-bottom:16px">{checkoutError}</div>}

    <div class="checkout-layout">
      <div class="checkout-form-col">
        <ShippingProviderSelector configs={shippingConfigs} subtotal={subtotal} currency={storeParty.config?.currency_code} />
        <PaymentProviderSelector currency={storeParty.config?.currency_code} />
        <CheckoutAddressForm cancelHref={`${linkBase}/cart`} sessionEmail={session?.user.email ?? null} />
      </div>
      <CheckoutOrderSummary
        items={items}
        subtotal={subtotal}
        currency={storeParty.config?.currency_code}
        shippingCost={defaultShippingCost}
        shippingLabel={defaultShippingConfig?.display_name}
        paymentFee={0}
        paymentLabel={t.shop.paymentMethodStripe}
      />
    </div>
  </div>
</Layout>

<style>
  .checkout-page { max-width:1000px; margin:0 auto; padding:32px 24px; }
  .page-title { font-size:28px; font-weight:800; margin-bottom:24px; }
  .checkout-layout { display:grid; grid-template-columns:1fr 320px; gap:32px; align-items:start; }
  .checkout-form-col { display:flex; flex-direction:column; gap:24px; }
  @media(max-width:768px) { .checkout-layout { grid-template-columns:1fr; } }
</style>
