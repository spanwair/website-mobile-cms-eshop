---
import Layout from "../../components/layout/Layout.astro";
import ProductCard from "../../components/variants/ProductCard/ProductCard.astro";
import Sections from "../../components/sections/Sections.astro";
import CategorySidebar from "../../components/shop/CategorySidebar.astro";
import { createSupabase } from "../../lib/supabase";
import { useT } from "../../lib/i18n";
import { sanitizeLayout } from "../../lib/pageComposer";
import { fetchShopData } from "../../lib/shopQueries";
import { fetchStoreMedia } from "@shared/services/storeMediaService";
import { fetchVisibleHeroSlides } from "@shared/services/heroSlideService";
import { fetchVisibleBenefitItems } from "@shared/services/benefitItemService";
import { fetchProductConditions } from "@shared/services/productConditionService";
import { fetchPublishedBlogPosts } from "@shared/services/blogService";

const { partySlug } = Astro.params;
const storeParty = Astro.locals.storeParty;
if (!storeParty) return Astro.redirect("/shop");

const supabase = createSupabase(Astro);
const t = useT(Astro);
const storeConfig = storeParty.config;
const cardVariant = storeConfig?.product_card_variant ?? "classic";
const linkBase = `/eshop-${partySlug}`;
const sectionsMedia = await fetchStoreMedia(supabase, storeParty.id);
const heroSlides = await fetchVisibleHeroSlides(supabase, storeParty.id);
const benefitItems = await fetchVisibleBenefitItems(supabase, storeParty.id);
const conditions = await fetchProductConditions(supabase, storeParty.id);
const blogPosts = (await fetchPublishedBlogPosts(supabase, storeParty.id, { page: 1, pageSize: 3 })).posts;

const url = new URL(Astro.request.url);
const categorySlug = url.searchParams.get("category") ?? "";
const search = url.searchParams.get("q") ?? "";
const sort = url.searchParams.get("sort") ?? "newest";
const conditionCode = url.searchParams.get("condition") ?? "";
const page = parseInt(url.searchParams.get("page") ?? "1", 10);
const pageSize = 24;
const isHomepageView = !search && !categorySlug && !conditionCode && page === 1;

const { categories, featuredProducts, products, count, totalPages } = await fetchShopData(supabase, {
  partyId: storeParty.id,
  categorySlug, search, sort, page, pageSize, isHomepageView, conditionCode,
});

function buildUrl(params: Record<string, string>) {
  const u = new URL(Astro.request.url);
  Object.entries(params).forEach(([k, v]) => {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  });
  u.searchParams.delete("page");
  return u.pathname + u.search;
}
---

<Layout title={`${storeConfig?.brand_name ?? "Shop"}${search ? ` — ${search}` : ""}${categorySlug ? ` — ${categorySlug}` : ""}`}>
  {isHomepageView && (
    <Sections
      layout={sanitizeLayout(storeConfig?.homepage_layout)}
      storeConfig={storeConfig}
      categories={categories.filter((c) => !c.parent_id)}
      featuredProducts={featuredProducts}
      cardVariant={cardVariant}
      media={sectionsMedia}
      slides={heroSlides}
      benefitItems={benefitItems}
      conditions={conditions}
      blogPosts={blogPosts}
      linkBase={linkBase}
    />
  )}
  <div class="shop-layout">
    <CategorySidebar categories={categories} categorySlug={categorySlug} homeHref={linkBase} buildUrl={buildUrl} conditions={conditions} activeCondition={conditionCode} />

    <main class="shop-main">
      <div class="shop-toolbar">
        <form method="GET" action={linkBase} class="search-form">
          {categorySlug && <input type="hidden" name="category" value={categorySlug} />}
          <input type="search" name="q" value={search} placeholder={t.shop.searchPlaceholder} class="search-input" />
          <button type="submit" class="btn btn-primary">{t.shop.search}</button>
          {search && <a href={buildUrl({ category: categorySlug, sort })} class="btn btn-ghost">{t.shop.clear}</a>}
        </form>

        <div class="sort-wrap">
          <label for="sort-select" class="sort-label">{t.shop.sort}</label>
          <select
            id="sort-select"
            onchange={`window.location.href='${buildUrl({ category: categorySlug, q: search, sort: "__SORT__" })}'.replace('__SORT__', this.value)`}
            class="sort-select"
          >
            <option value="newest" selected={sort === "newest"}>{t.shop.sortNewest}</option>
            <option value="price_asc" selected={sort === "price_asc"}>{t.shop.sortPriceAsc}</option>
            <option value="price_desc" selected={sort === "price_desc"}>{t.shop.sortPriceDesc}</option>
            <option value="rating" selected={sort === "rating"}>{t.shop.sortTopRated}</option>
          </select>
        </div>

        <span class="result-count">{count} {t.shop.products}</span>
      </div>

      {products.length === 0 ? (
        <div class="empty-state">
          <p>{t.shop.noProducts}</p>
          <a href={linkBase} class="btn btn-ghost">{t.shop.viewAll}</a>
        </div>
      ) : (
        <div class="product-grid">
          {products.map((product) => (
            <ProductCard product={product as any} variant={cardVariant} linkBase={linkBase} />
          ))}
        </div>
      )}

      {totalPages > 1 && (
        <div class="pagination">
          {page > 1 && (
            <a href={buildUrl({ category: categorySlug, q: search, sort }) + `&page=${page - 1}`} class="btn btn-ghost">← {t.common.previous}</a>
          )}
          <span class="page-info">{t.common.page} {page} / {totalPages}</span>
          {page < totalPages && (
            <a href={buildUrl({ category: categorySlug, q: search, sort }) + `&page=${page + 1}`} class="btn btn-ghost">{t.common.next} →</a>
          )}
        </div>
      )}
    </main>
  </div>
</Layout>

<style>
  .shop-layout { display:grid; grid-template-columns:220px 1fr; gap:32px; max-width:1280px; margin:0 auto; padding:32px 24px; }

  .shop-main { min-width:0; }
  .shop-toolbar { display:flex; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:24px; }
  .search-form { display:flex; gap:8px; flex:1; min-width:200px; }
  .search-input { flex:1; padding:8px 12px; border:1px solid var(--border); border-radius:8px; font-size:14px; }
  .sort-wrap { display:flex; align-items:center; gap:6px; }
  .sort-label { font-size:13px; color:var(--text-muted); }
  .sort-select { padding:6px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px; }
  .result-count { font-size:13px; color:var(--text-muted); white-space:nowrap; margin-left:auto; }

  .product-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:20px; }

  .empty-state { text-align:center; padding:60px 24px; display:flex; flex-direction:column; align-items:center; gap:16px; color:var(--text-muted); }
  .pagination { display:flex; align-items:center; gap:16px; justify-content:center; margin-top:32px; }
  .page-info { color:var(--text-muted); font-size:14px; }

  @media(max-width:768px) {
    .shop-layout { grid-template-columns:1fr; }
    .sidebar { position:static; }
    .shop-toolbar { flex-direction:column; align-items:stretch; }
  }
</style>
