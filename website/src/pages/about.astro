---
import LandingLayout from "../components/landing/LandingLayout.astro";
import PageHero from "../components/landing/PageHero.astro";
import FinalCta from "../components/landing/sections/FinalCta.astro";
import { useT } from "../lib/i18n";

const t = useT(Astro);
---

<LandingLayout title={`${t.landing.about.title} — Mamtodoma`} description={t.landing.about.sub}>
  <PageHero eyebrow={t.landing.about.eyebrow} title={t.landing.about.title} lead={t.landing.about.sub} image="/img/desk-work.jpg" imageAlt="" />
  <section class="landing" style="padding-top:0">
    <div class="container-lg about-content">
      {t.landing.about.paragraphs.map((p) => <p class="about-paragraph">{p}</p>)}
    </div>
  </section>
  <FinalCta />
</LandingLayout>

<style>
  .about-content { max-width: 680px; margin-inline: auto; }
  .about-paragraph { color: var(--text-muted); line-height: 1.7; margin-bottom: 20px; font-size: 16px; }
</style>
