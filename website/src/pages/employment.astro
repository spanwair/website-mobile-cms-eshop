---
// Surfaces the existing smalljobs_commission / no-IČO selling arrangement (see
// shared/services/commissionaireService.ts, shared/constants/sellerMode.ts) as its own
// page — previously this was only explained inside a single homepage section.
import LandingLayout from "../components/landing/LandingLayout.astro";
import PageHero from "../components/landing/PageHero.astro";
import FinalCta from "../components/landing/sections/FinalCta.astro";
import { useT } from "../lib/i18n";
import {
  NO_ICO_DEDUCTION_RATE,
  NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK,
  NO_ICO_WITHHOLDING_EXPIRY_YEARS,
  PAYOUT_HOLD_DAYS,
} from "@shared/constants/sellerMode";

const t = useT(Astro);
const employmentPct = Math.round(NO_ICO_DEDUCTION_RATE * 100);
const limitFmt = NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK.toLocaleString("cs-CZ");
const warningText = t.landing.employmentPage.warningText.replace("{limit}", limitFmt).replace("{years}", String(NO_ICO_WITHHOLDING_EXPIRY_YEARS));
---

<LandingLayout title={`${t.landing.employmentPage.title} — Mamtodoma`} description={t.landing.employmentPage.sub}>
  <PageHero eyebrow={t.landing.employmentPage.eyebrow} title={t.landing.employmentPage.title} lead={t.landing.employmentPage.sub} image="/img/payment.jpg" imageAlt="" />

  <section class="landing" style="padding-top:0">
    <div class="container-lg employment-grid">
      <div>
        <h2 class="section-title">{t.landing.employmentPage.stepsTitle}</h2>
        <ol class="employment-steps" data-reveal-group>
          {t.landing.employmentPage.steps.map((step) => (
            <li data-reveal>
              <span class="employment-step-num font-display">{step.number}</span>
              <div>
                <strong>{step.title}</strong>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="employment-card">
        <h3 class="font-display">{t.landing.employmentPage.statsTitle}</h3>
        <dl>
          <div><dt>{t.landing.employmentPage.deductionLabel}</dt><dd>{employmentPct} %</dd></div>
          <div><dt>{t.landing.employmentPage.limitLabel}</dt><dd>{limitFmt} Kč</dd></div>
          <div><dt>{t.landing.employmentPage.holdLabel}</dt><dd>{PAYOUT_HOLD_DAYS} {t.landing.employmentPage.daysUnit}</dd></div>
        </dl>
        <h4>{t.landing.employmentPage.suitableTitle}</h4>
        <ul class="employment-suitable">
          {t.landing.employmentPage.suitableFor.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="container-lg">
      <div class="employment-warning">
        <strong>{t.landing.employmentPage.warningTitle}</strong>
        <p>{warningText}</p>
        <p class="employment-tax-note">{t.landing.employmentPage.taxNote}</p>
      </div>
    </div>
  </section>

  <FinalCta />
</LandingLayout>

<style>
  .employment-grid { display: grid; gap: 48px; grid-template-columns: 1.2fr 1fr; margin-bottom: 40px; }
  .employment-steps { list-style: none; display: flex; flex-direction: column; gap: 24px; margin-top: 24px; }
  .employment-steps li { display: flex; gap: 16px; align-items: flex-start; }
  .employment-step-num {
    display: grid; place-items: center; flex-shrink: 0;
    width: 40px; height: 40px; border-radius: 50%; background: var(--landing-ink); color: var(--bg-page);
    font-size: 16px;
  }
  .employment-steps strong { display: block; margin-bottom: 4px; }
  .employment-steps p { color: var(--text-muted); font-size: 14px; line-height: 1.6; }

  .employment-card {
    background: var(--landing-ink); color: #fff; border-radius: var(--radius-xl);
    padding: 32px; height: fit-content;
  }
  .employment-card h3 { margin-bottom: 16px; font-size: 20px; }
  .employment-card dl { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
  .employment-card dl > div { display: flex; justify-content: space-between; padding-bottom: 12px; border-bottom: 1px solid rgba(255,255,255,0.12); font-size: 14px; }
  .employment-card dd { font-weight: 700; color: var(--landing-mint); }
  .employment-card h4 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; color: rgba(255,255,255,0.6); margin-bottom: 10px; }
  .employment-suitable { list-style: none; display: flex; flex-direction: column; gap: 8px; font-size: 14px; }
  .employment-suitable li::before { content: "— "; color: var(--landing-mint); }

  .employment-warning {
    background: rgba(249,123,122,0.08); border: 1px solid rgba(249,123,122,0.35);
    border-radius: var(--radius-lg); padding: 24px 28px; margin-top: 8px;
  }
  .employment-warning strong { color: var(--landing-coral); display: block; margin-bottom: 8px; }
  .employment-warning p { color: var(--text-muted); line-height: 1.6; font-size: 14px; }
  .employment-tax-note { margin-top: 12px; font-style: italic; }

  @media (max-width: 900px) {
    .employment-grid { grid-template-columns: 1fr; }
  }
</style>
