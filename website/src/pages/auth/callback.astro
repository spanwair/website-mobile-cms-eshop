---
import { createSupabase, createAdminClient } from "../../lib/supabase";
import { ROLE } from "@shared/constants/permissions";

const supabase = createSupabase(Astro);
const code = Astro.url.searchParams.get("code");
const token_hash = Astro.url.searchParams.get("token_hash");
const type = Astro.url.searchParams.get("type") as Parameters<typeof supabase.auth.verifyOtp>[0]["type"] | null;

let userId: string | null = null;
let userMeta: Record<string, string | null> = {};
let userEmail: string | null = null;

if (code) {
  const { data } = await supabase.auth.exchangeCodeForSession(code);
  if (data.session) {
    userId = data.session.user.id;
    userMeta = (data.session.user.user_metadata ?? {}) as Record<string, string | null>;
    userEmail = data.session.user.email ?? null;
  }
} else if (token_hash && type) {
  const { data } = await supabase.auth.verifyOtp({ token_hash, type });
  if (data.session) {
    userId = data.session.user.id;
    userMeta = (data.session.user.user_metadata ?? {}) as Record<string, string | null>;
    userEmail = data.session.user.email ?? null;
  }
}

const rawRedirect = Astro.url.searchParams.get("redirect");
const safeRedirect = rawRedirect && rawRedirect.startsWith("/") && !rawRedirect.startsWith("//") ? rawRedirect : null;
let redirectTo = safeRedirect ?? "/";

if (userId) {
  const googleName = userMeta["full_name"] ?? userMeta["name"] ?? null;
  const googleAvatar = userMeta["avatar_url"] ?? userMeta["picture"] ?? null;

  const { data: existing } = await supabase
    .from("profiles")
    .select("display_name, avatar_url")
    .eq("id", userId)
    .single();

  const isNewUser = !existing;

  await supabase.from("profiles").upsert({
    id: userId,
    display_name: existing?.display_name ?? googleName ?? userEmail?.split("@")[0] ?? null,
    avatar_url: existing?.avatar_url ?? googleAvatar ?? null,
  }, { onConflict: "id" });

  const adminClient = createAdminClient();

  const pendingPartyId = userMeta["pending_party_id"] ?? null;
  const pendingRoleId = userMeta["pending_role_id"] ?? null;
  const invitedBy = userMeta["invited_by"] ?? null;

  // Invite routing rule: a user arriving via an invite must end up as a member of the
  // inviting org — otherwise they see zero parties and land on /admin/onboarding instead
  // of the company that invited them.
  let invitePartyId: string | null = pendingPartyId;
  let inviteRoleId: string | null = pendingRoleId;
  if (!invitePartyId && invitedBy) {
    // Legacy recovery: Admin invites sent before the fix carry no party metadata at all.
    // When the inviter administers exactly one party, that is unambiguously the inviting
    // org — attach the invitee there. With zero or several parties we cannot guess.
    const { data: inviterMemberships } = await adminClient
      .from("user_party_roles")
      .select("party_id")
      .eq("user_id", invitedBy);
    const distinctParties = [...new Set((inviterMemberships ?? []).map((m) => m.party_id))];
    if (distinctParties.length === 1) invitePartyId = distinctParties[0];
  }
  if (invitePartyId && !inviteRoleId) {
    // Admin invites pick no custom role (permissions come from the system role), but the
    // membership row still needs a valid role FK — use the highest-permission role.
    const { data: fallbackRole } = await adminClient
      .from("roles")
      .select("id")
      .order("permissions", { ascending: false })
      .limit(1)
      .single();
    inviteRoleId = fallbackRole?.id ?? null;
  }
  if (invitePartyId && inviteRoleId) {
    await adminClient.from("user_party_roles").upsert(
      { user_id: userId, party_id: invitePartyId, role_id: inviteRoleId, ...(invitedBy ? { invited_by: invitedBy } : {}) },
      { ignoreDuplicates: true }
    );
    // Pin the session to the inviting org so /admin (and the finish-registration step → /admin
    // lands there — not on onboarding, and not on an unrelated first-alphabetical org.
    Astro.cookies.set("activePartyId", invitePartyId, {
      path: "/",
      httpOnly: true,
      sameSite: "lax",
      maxAge: 60 * 60 * 24 * 30,
    });
  }

  // Storefront customer classification for the Google OAuth path. Email/OTP signups already
  // carry `signup_party_id` in user_metadata and are classified USER by handle_new_user(); OAuth
  // can't set metadata, so a brand-new Google account defaults to the organic ADMIN(4) role. When
  // `sp` is present in the callback URL we reclassify it as a customer of that eshop — but only a
  // truly fresh account: role is still the organic default, no party role was ever assigned, and
  // no home eshop is recorded yet. This never touches a real admin/owner or eshop_admin.
  const spParam = Astro.url.searchParams.get("sp");
  if (spParam) {
    const { data: prof } = await adminClient
      .from("profiles")
      .select("role, signup_party_id")
      .eq("id", userId)
      .single();
    const { count: partyRoleCount } = await adminClient
      .from("user_party_roles")
      .select("user_id", { count: "exact", head: true })
      .eq("user_id", userId);
    if (prof && prof.role === ROLE.ADMIN && !prof.signup_party_id && !partyRoleCount) {
      await adminClient
        .from("profiles")
        .update({ role: ROLE.USER, signup_party_id: spParam })
        .eq("id", userId);
    }
  }

  const { data: roleRow } = await supabase.from("profiles").select("role").eq("id", userId).single();
  const currentRole = roleRow?.role ?? ROLE.USER;

  // Invite, or a brand-new user arriving via magic link (invite→signup flow), still has no
  // password set — send them to the shared registration page in invite-completion mode
  // (email prefilled + locked), which sets the password and then forwards to /admin.
  if (type === "invite" || (type === "magiclink" && isNewUser)) {
    redirectTo = "/login?invite=1";
  } else {
    // Every other successfully authenticated user (email confirmation, magic-link sign-in,
    // Google OAuth, returning login). An explicit redirect (e.g. an eshop storefront) always
    // wins. Otherwise route by role: a seller/staff account (>= eshop_admin) goes to the admin
    // area (a party-less ADMIN is routed on through setup → onboarding), while a plain customer
    // goes to their account dashboard. Never drop an authenticated user on the marketing homepage.
    redirectTo = safeRedirect ?? (currentRole >= ROLE.ESHOP_ADMIN ? "/admin" : "/dashboard");
  }
}

return Astro.redirect(redirectTo);
---
