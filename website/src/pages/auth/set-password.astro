---
import Layout from "../../components/layout/Layout.astro";
import { createSupabase } from "../../lib/supabase";
import { useT } from "../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const t = useT(Astro);
const userEmail = session.user.email ?? "";
---

<Layout title={t.auth.setPasswordTitle}>
  <div class="page">
    <div class="container">
      <div
        class="auth-card card"
        data-title={t.auth.setPasswordTitle}
        data-setting={t.auth.settingPassword}
        data-btn={t.auth.setPasswordBtn}
        data-success={t.auth.setPasswordSuccess}
        data-err-name={t.auth.errorNameTooShort}
        data-err-pw-short={t.auth.errorPasswordTooShort}
        data-err-pw-mismatch={t.auth.errorPasswordMismatch}
        data-google={t.auth.continueWithGoogle}
        data-or={t.common.or}
      >
        <a href="/" class="auth-brand">Template</a>
        <h1 class="auth-title">{t.auth.setPasswordTitle}</h1>
        <p class="auth-sub">{t.auth.setPasswordSubtitle}</p>

        <button id="google-btn" class="btn btn-secondary full-width google-btn" type="button">
          <span class="google-icon">G</span> {t.auth.continueWithGoogle}
        </button>

        <div class="divider"><span>{t.common.or}</span></div>

        <p id="error-sp" class="error-msg hidden"></p>
        <p id="success-sp" class="success-msg hidden"></p>

        <form id="setpw-form" class="form">
          <div class="field">
            <label for="sp-name">{t.auth.fullName}</label>
            <input id="sp-name" type="text" placeholder={t.auth.fullNamePlaceholder} required autocomplete="name" minlength="2" maxlength="100" />
          </div>
          <div class="field">
            <label>{t.auth.emailLabel}</label>
            <input type="email" value={userEmail} disabled class="disabled-input" />
          </div>
          <div class="field">
            <label for="sp-password">{t.auth.password} <span class="field-hint">{t.auth.passwordHint}</span></label>
            <input id="sp-password" type="password" placeholder={t.auth.passwordPlaceholder} required autocomplete="new-password" minlength="8" />
          </div>
          <div class="field">
            <label for="sp-confirm">{t.auth.confirmPassword}</label>
            <input id="sp-confirm" type="password" placeholder={t.auth.confirmPasswordPlaceholder} required autocomplete="new-password" />
          </div>
          <button type="submit" class="btn btn-primary full-width" id="setpw-btn">{t.auth.setPasswordBtn}</button>
        </form>

        <p class="switch-hint">
          <a href="/dashboard" class="link-btn">{t.auth.skipForNow}</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { createBrowserClient } from "@supabase/ssr";

  const url = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
  const supabase = createBrowserClient(url, key);

  const card = document.querySelector(".auth-card") as HTMLElement;
  const d = card.dataset;

  document.getElementById("google-btn")!.addEventListener("click", async () => {
    const btn = document.getElementById("google-btn") as HTMLButtonElement;
    btn.disabled = true;
    const { error } = await supabase.auth.linkIdentity({
      provider: "google",
      options: { redirectTo: `${window.location.origin}/auth/callback` },
    });
    if (error) {
      document.getElementById("error-sp")!.textContent = error.message;
      document.getElementById("error-sp")!.classList.remove("hidden");
      btn.disabled = false;
    }
  });

  function showError(msg: string) {
    const el = document.getElementById("error-sp")!;
    el.textContent = msg;
    el.classList.remove("hidden");
    document.getElementById("success-sp")!.classList.add("hidden");
  }

  document.getElementById("setpw-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    document.getElementById("error-sp")!.classList.add("hidden");
    document.getElementById("success-sp")!.classList.add("hidden");

    const btn = document.getElementById("setpw-btn") as HTMLButtonElement;
    const name = (document.getElementById("sp-name") as HTMLInputElement).value.trim();
    const password = (document.getElementById("sp-password") as HTMLInputElement).value;
    const confirm = (document.getElementById("sp-confirm") as HTMLInputElement).value;

    if (name.length < 2) { showError(d.errName!); return; }
    if (password.length < 8) { showError(d.errPwShort!); return; }
    if (password !== confirm) { showError(d.errPwMismatch!); return; }

    btn.disabled = true;
    btn.textContent = d.setting!;

    const { error } = await supabase.auth.updateUser({
      password,
      data: { full_name: name, display_name: name },
    });

    if (error) {
      showError(error.message);
      btn.disabled = false;
      btn.textContent = d.btn!;
      return;
    }

    await supabase.from("profiles").update({ display_name: name }).eq("id", (await supabase.auth.getUser()).data.user!.id);

    const el = document.getElementById("success-sp")!;
    el.textContent = d.success!;
    el.classList.remove("hidden");

    setTimeout(() => { window.location.href = "/dashboard"; }, 1500);
  });
</script>

<style>
  .page { display: flex; align-items: center; min-height: calc(100vh - 64px); }
  .auth-card { max-width: 420px; margin: 0 auto; padding: 40px; }
  .auth-brand { font-size: 22px; font-weight: 900; color: #4F46E5; display: block; text-align: center; margin-bottom: 28px; text-decoration: none; }
  .auth-title { font-size: 24px; font-weight: 800; color: #212529; margin-bottom: 4px; text-align: center; }
  .auth-sub { font-size: 14px; color: #6C757D; text-align: center; margin-bottom: 24px; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .field label { display: block; font-size: 12px; font-weight: 700; color: #6C757D; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
  .field-hint { font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 11px; }
  .field input { display: block; }
  .disabled-input { background: #F8F9FA; color: #6C757D; cursor: not-allowed; }
  .full-width { width: 100%; }
  .google-btn { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .google-icon { font-size: 16px; font-weight: 900; }
  .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: #ADB5BD; font-size: 12px; }
  .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #E9ECEF; }
  .switch-hint { font-size: 13px; color: #6C757D; text-align: center; margin-top: 20px; }
  .link-btn { background: none; border: none; color: #4F46E5; font-size: 13px; font-weight: 600; cursor: pointer; padding: 0; font-family: inherit; text-decoration: none; }
  .error-msg { color: #EF4444; font-size: 13px; margin-bottom: 8px; }
  .success-msg { color: #10B981; font-size: 13px; margin-bottom: 8px; }
</style>
