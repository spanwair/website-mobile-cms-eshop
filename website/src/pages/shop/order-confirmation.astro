---
import Layout from "../../components/layout/Layout.astro";
import { useT, getLang } from "../../lib/i18n";
import { createSupabase, createAdminClient } from "../../lib/supabase";
import { confirmStripeSession } from "../../lib/checkoutFlow";

const t = useT(Astro);
const searchParams = new URL(Astro.request.url).searchParams;
const orderNumber = searchParams.get("order") ?? "";
const sessionId = searchParams.get("session_id");

if (sessionId && orderNumber) {
  await confirmStripeSession(createAdminClient(), sessionId, orderNumber, getLang(Astro));
}

// RLS ("Customers read own order_shipments") already scopes this to the signed-in
// customer's own order — no separate ownership check needed here.
const supabase = createSupabase(Astro);
const { data: order } = orderNumber
  ? await supabase.from("orders").select("id, payment_method, payment_status").eq("order_number", orderNumber).maybeSingle()
  : { data: null };
const { data: shipment } = order
  ? await supabase.from("order_shipments").select("*").eq("order_id", order.id).maybeSingle()
  : { data: null };
---

<Layout title={t.shop.confirmationTitle}>
  <div class="confirmation-page">
    <div class="confirmation-card">
      <div class="check-icon">✓</div>
      <h1 class="title">{t.shop.confirmationTitle}</h1>
      {orderNumber && <p class="order-number">Order: <strong>{orderNumber}</strong></p>}
      <p class="body">{t.shop.confirmationBody}</p>
      {order?.payment_method === "cod" && order.payment_status === "unpaid" && (
        <p class="cod-notice">{t.shop.codPendingNotice}</p>
      )}
      {shipment?.tracking_number && (
        <div class="shipment-info">
          {shipment.is_mock && <p class="mock-badge">{t.shop.shipmentTestModeBadge}</p>}
          <p class="tracking-line">{t.shop.trackingNumber}: <strong>{shipment.tracking_number}</strong></p>
          {shipment.label_storage_path && order && (
            <a href={`/api/shipping-label/${order.id}`} target="_blank" class="btn btn-secondary">{t.shop.downloadLabel}</a>
          )}
        </div>
      )}
      <a href="/shop" class="btn btn-primary">{t.shop.continueShopping}</a>
    </div>
  </div>
</Layout>

<style>
  .confirmation-page { display:flex; justify-content:center; align-items:center; min-height:60vh; padding:32px 24px; }
  .confirmation-card { text-align:center; max-width:480px; display:flex; flex-direction:column; align-items:center; gap:16px; }
  .check-icon { width:80px; height:80px; background:#dcfce7; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:36px; color:#16a34a; }
  .title { font-size:28px; font-weight:800; margin:0; }
  .order-number { font-size:16px; color:var(--text-muted); margin:0; }
  .body { font-size:15px; color:var(--text-secondary); line-height:1.6; margin:0; }
  .cod-notice { font-size:13px; color:var(--text-muted); background:var(--bg-subtle); border-radius:8px; padding:10px 14px; margin:0; }
  .shipment-info { display:flex; flex-direction:column; align-items:center; gap:8px; padding:12px 16px; border:1px solid var(--border); border-radius:8px; }
  .tracking-line { font-size:14px; margin:0; }
  .mock-badge { font-size:11px; font-weight:700; color:#b45309; background:#fef3c7; border-radius:4px; padding:2px 8px; margin:0; }
</style>
