---
import Layout from "../../components/layout/Layout.astro";
import { createSupabase } from "../../lib/supabase";
import { fetchProductReviews, submitReview } from "@shared/services/reviewService";
import { fetchInventoryByProduct } from "@shared/services/inventoryService";
import { getOrCreateCart, addToCart } from "@shared/services/cartService";
import { useT } from "../../lib/i18n";

const supabase = createSupabase(Astro);
const t = useT(Astro);
const { slug } = Astro.params;
let cartSuccess = false;
let cartError = "";

// Handle review submission
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action") as string;

  if (action === "review") {
    const { data: { session } } = await supabase.auth.getSession();
    const productId = form.get("product_id") as string;
    const partyId = form.get("party_id") as string;

    await submitReview(supabase, {
      party_id: partyId,
      product_id: productId,
      author_name: form.get("author_name") as string,
      author_email: form.get("author_email") as string,
      rating: parseInt(form.get("rating") as string, 10),
      title: form.get("title") as string || undefined,
      body: form.get("body") as string || undefined,
      customer_id: session?.user?.id ? undefined : null,
    });
    return Astro.redirect(`/shop/${slug}?reviewed=1`);
  }

  if (action === "add_to_cart") {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return Astro.redirect(`/login?redirect=/shop/${slug}`);
    const productId = form.get("product_id") as string;
    const partyId = form.get("party_id") as string;
    const unitPrice = parseFloat(form.get("unit_price") as string);
    const qty = Math.max(1, parseInt(form.get("quantity") as string, 10) || 1);
    try {
      const cart = await getOrCreateCart(supabase, partyId, session.user.id);
      const result = await addToCart(supabase, cart.id, productId, qty, unitPrice);
      if (result.error) { cartError = result.error.message; }
      else { return Astro.redirect(`/shop/${slug}?added=1`); }
    } catch (e: any) {
      cartError = e?.message ?? "Failed to add to cart";
    }
  }
}

// Fetch product
const { data: product } = await supabase
  .from("products")
  .select(`
    *,
    product_images(id, url, alt, is_primary, sort_order),
    product_categories(category:categories(id, name, slug)),
    product_variants(id, name, price, attributes, is_active),
    brands(name, slug)
  `)
  .eq("slug", slug!)
  .eq("status", "active")
  .eq("is_visible", true)
  .single();

if (!product) return Astro.redirect("/shop");

const images = ((product as any).product_images ?? []).sort(
  (a: any, b: any) => (b.is_primary ? 1 : 0) - (a.is_primary ? 1 : 0)
);
const primaryImage = images[0];

const categories = ((product as any).product_categories ?? [])
  .map((pc: any) => pc.category)
  .filter(Boolean);

const variants = ((product as any).product_variants ?? []).filter((v: any) => v.is_active);
const brand = (product as any).brands;

// Fetch reviews
const { data: reviews, total: reviewTotal, averageRating } = await fetchProductReviews(
  supabase,
  product.id,
  { pageSize: 10 }
);

const reviewed = new URL(Astro.request.url).searchParams.has("reviewed");
const addedToCart = new URL(Astro.request.url).searchParams.has("added");

// Fetch related products (same categories, different product)
const categoryIds = categories.map((c: any) => c.id);
// Fetch inventory for stock display
const inventoryItem = await fetchInventoryByProduct(supabase, product.id);
const qtyAvailable = inventoryItem ? (inventoryItem.qty_on_hand - inventoryItem.qty_reserved) : null;
const isOutOfStock = qtyAvailable !== null && qtyAvailable <= 0;

// Fetch session for cart button
const { data: { session: pageSession } } = await supabase.auth.getSession();

let relatedProducts: any[] = [];
if (categoryIds.length > 0) {
  const { data: related } = await supabase
    .from("products")
    .select("id, title, slug, price, discount_price, product_images(url, is_primary)")
    .eq("status", "active")
    .eq("is_visible", true)
    .neq("id", product.id)
    .limit(4);
  relatedProducts = (related ?? []).map(p => {
    const imgs = (p as any).product_images ?? [];
    return { ...p, primaryImage: (imgs.find((i: any) => i.is_primary) ?? imgs[0])?.url };
  });
}
---

<Layout title={product.seo_title ?? product.title}>
  <!-- Breadcrumb -->
  <nav class="breadcrumb">
    <a href="/shop">{t.shop.breadcrumbShop}</a>
    {categories[0] && <><span>/</span><a href={`/shop?category=${categories[0].slug}`}>{categories[0].name}</a></>}
    <span>/</span>
    <span>{product.title}</span>
  </nav>

  <div class="product-layout">
    <!-- Images -->
    <div class="images-col">
      <div class="main-image-wrap">
        {primaryImage ? (
          <img id="main-img" src={primaryImage.url} alt={(primaryImage as any).alt ?? product.title} class="main-image" />
        ) : (
          <div class="no-image">No image</div>
        )}
      </div>
      {images.length > 1 && (
        <div class="thumb-row">
          {images.map((img: any) => (
            <button class="thumb-btn" onclick={`document.getElementById('main-img').src='${img.url}'`}>
              <img src={img.url} alt={(img as any).alt ?? ""} class="thumb-img" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <!-- Product info -->
    <div class="info-col">
      {brand && <p class="brand-name"><a href={`/shop?brand=${brand.slug}`}>{brand.name}</a></p>}
      <h1 class="product-title">{product.title}</h1>

      {reviewTotal > 0 && (
        <div class="rating-row">
          <span class="stars">{"★".repeat(Math.round(averageRating))}{"☆".repeat(5 - Math.round(averageRating))}</span>
          <span class="rating-text">{averageRating.toFixed(1)} ({reviewTotal} {t.shop.reviews})</span>
        </div>
      )}

      <div class="price-row">
        {product.discount_price ? (
          <>
            <span class="price-old">{Number(product.price).toFixed(2)} Kč</span>
            <span class="price-main sale">{Number(product.discount_price).toFixed(2)} Kč</span>
            <span class="saving-badge">
              {t.shop.save} {Math.round((1 - Number(product.discount_price) / Number(product.price)) * 100)}%
            </span>
          </>
        ) : (
          <span class="price-main">{Number(product.price).toFixed(2)} Kč</span>
        )}
      </div>

      {categories.length > 0 && (
        <div class="categories-row">
          {categories.map((cat: any) => (
            <a href={`/shop?category=${cat.slug}`} class="cat-chip">{cat.name}</a>
          ))}
        </div>
      )}

      {variants.length > 0 && (
        <div class="variants-section">
          <p class="variants-label">{t.shop.variants}</p>
          <div class="variants-grid">
            {variants.map((v: any) => (
              <label class="variant-option">
                <input type="radio" name="variant" value={v.id} />
                <span class="variant-label">
                  {v.name}
                  {v.price && <strong> — {Number(v.price).toFixed(2)} Kč</strong>}
                </span>
              </label>
            ))}
          </div>
        </div>
      )}

      {addedToCart && <div class="cart-success">✓ Added to cart! <a href="/shop/cart">View cart</a></div>}
      {cartError && <div class="cart-error">{cartError}</div>}

      <div class="add-to-cart-section">
        {isOutOfStock ? (
          <div class="out-of-stock-badge">{t.shop.outOfStock}</div>
        ) : (
          <form method="POST" class="cart-form">
            <input type="hidden" name="_action" value="add_to_cart" />
            <input type="hidden" name="product_id" value={product.id} />
            <input type="hidden" name="party_id" value={product.party_id} />
            <input type="hidden" name="unit_price" value={String(product.discount_price ?? product.price)} />
            <div class="qty-row">
              <label>{t.shop.qty}</label>
              <input type="number" name="quantity" value="1" min="1" max={qtyAvailable ?? 99} class="qty-input" />
            </div>
            {qtyAvailable !== null && qtyAvailable <= 10 && qtyAvailable > 0 && (
              <p class="low-stock-hint">{t.shop.stockRemaining.replace("{{n}}", String(qtyAvailable))}</p>
            )}
            {!pageSession ? (
              <a href={`/login?redirect=/shop/${slug}`} class="btn btn-primary btn-large">{t.shop.loginToCheckout}</a>
            ) : (
              <button type="submit" class="btn btn-primary btn-large">{t.shop.addToCart}</button>
            )}
          </form>
        )}
      </div>

      {product.description && (
        <div class="description">
          <h2 class="section-title">{t.shop.description}</h2>
          <p>{product.description}</p>
        </div>
      )}
    </div>
  </div>

  <!-- Reviews -->
  <section class="reviews-section">
    <div class="reviews-header">
      <h2 class="section-title">{t.shop.customerReviews}</h2>
      {reviewTotal > 0 && (
        <div class="avg-rating">
          <span class="avg-stars">{"★".repeat(Math.round(averageRating))}{"☆".repeat(5 - Math.round(averageRating))}</span>
          <span class="avg-num">{averageRating.toFixed(1)} / 5</span>
          <span class="avg-count">({reviewTotal} {t.shop.reviews})</span>
        </div>
      )}
    </div>

    {reviewed && (
      <div class="success-banner">
        ✓ Thank you! Your review has been submitted and is pending approval.
      </div>
    )}

    {reviews.map(review => (
      <div class="review-card">
        <div class="review-header">
          <span class="review-stars">{"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)}</span>
          <strong>{review.author_name}</strong>
          {review.is_verified && <span class="verified-badge">Verified Purchase</span>}
          <time>{new Date(review.created_at).toLocaleDateString("cs-CZ")}</time>
        </div>
        {review.title && <h3 class="review-title">{review.title}</h3>}
        {review.body && <p class="review-body">{review.body}</p>}
      </div>
    ))}

    {reviews.length === 0 && (
      <p class="no-reviews">No reviews yet. Be the first to review this product!</p>
    )}

    <!-- Write a review -->
    <div class="write-review">
      <h3 class="section-title">Write a Review</h3>
      <form method="POST" class="review-form">
        <input type="hidden" name="_action" value="review" />
        <input type="hidden" name="product_id" value={product.id} />
        <input type="hidden" name="party_id" value={product.party_id} />

        <div class="form-row">
          <div class="field">
            <label>Your Name *</label>
            <input type="text" name="author_name" required class="input" />
          </div>
          <div class="field">
            <label>Email *</label>
            <input type="email" name="author_email" required class="input" />
          </div>
        </div>

        <div class="field">
          <label>Rating *</label>
          <div class="star-rating">
            {[5,4,3,2,1].map(n => (
              <>
                <input type="radio" name="rating" id={`star${n}`} value={n} required />
                <label for={`star${n}`} class="star-label" title={`${n} stars`}>★</label>
              </>
            ))}
          </div>
        </div>

        <div class="field">
          <label>Review Title</label>
          <input type="text" name="title" class="input" placeholder="Summarise your experience" />
        </div>

        <div class="field">
          <label>Your Review</label>
          <textarea name="body" class="input textarea" rows="4" placeholder="Tell others what you think…"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Submit Review</button>
      </form>
    </div>
  </section>

  <!-- Related products -->
  {relatedProducts.length > 0 && (
    <section class="related-section">
      <h2 class="section-title">You might also like</h2>
      <div class="related-grid">
        {relatedProducts.map(p => (
          <a href={`/shop/${p.slug}`} class="related-card">
            {p.primaryImage && <img src={p.primaryImage} alt={p.title} class="related-img" loading="lazy" />}
            <p class="related-title">{p.title}</p>
            <p class="related-price">{Number(p.discount_price ?? p.price).toFixed(2)} Kč</p>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .breadcrumb { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text-muted); padding:16px 24px; max-width:1280px; margin:0 auto; }
  .breadcrumb a { color:var(--text-muted); text-decoration:none; } .breadcrumb a:hover { color:var(--primary); }
  .product-layout { display:grid; grid-template-columns:1fr 1fr; gap:48px; max-width:1280px; margin:0 auto; padding:0 24px 48px; }
  .images-col { display:flex; flex-direction:column; gap:12px; }
  .main-image-wrap { aspect-ratio:1; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--bg-subtle); }
  .main-image { width:100%; height:100%; object-fit:cover; cursor:zoom-in; }
  .no-image { display:flex; align-items:center; justify-content:center; height:100%; color:var(--text-muted); }
  .thumb-row { display:flex; gap:8px; flex-wrap:wrap; }
  .thumb-btn { border:2px solid transparent; border-radius:8px; overflow:hidden; cursor:pointer; padding:0; background:none; width:64px; height:64px; }
  .thumb-btn:hover { border-color:var(--primary); }
  .thumb-img { width:100%; height:100%; object-fit:cover; }
  .brand-name { font-size:13px; color:var(--text-muted); margin:0 0 4px; } .brand-name a { color:var(--primary); text-decoration:none; }
  .product-title { font-size:28px; font-weight:800; margin:0 0 12px; line-height:1.2; }
  .rating-row { display:flex; align-items:center; gap:8px; margin-bottom:12px; }
  .stars { color:#f59e0b; font-size:20px; }
  .rating-text { font-size:14px; color:var(--text-muted); }
  .price-row { display:flex; align-items:center; gap:12px; margin-bottom:16px; }
  .price-main { font-size:28px; font-weight:800; color:var(--primary); }
  .price-main.sale { color:#dc2626; }
  .price-old { font-size:16px; color:var(--text-muted); text-decoration:line-through; }
  .saving-badge { background:#dcfce7; color:#16a34a; font-size:12px; font-weight:700; padding:3px 10px; border-radius:20px; }
  .categories-row { display:flex; gap:6px; flex-wrap:wrap; margin-bottom:16px; }
  .cat-chip { background:var(--bg-subtle); border:1px solid var(--border); border-radius:16px; padding:4px 12px; font-size:12px; text-decoration:none; color:var(--text-secondary); }
  .variants-section { margin-bottom:20px; } .variants-label { font-size:13px; font-weight:600; color:var(--text-muted); margin-bottom:8px; }
  .variants-grid { display:flex; flex-direction:column; gap:6px; }
  .variant-option { display:flex; align-items:center; gap:8px; cursor:pointer; font-size:14px; }
  .add-to-cart-section { display:flex; align-items:flex-start; gap:12px; margin-bottom:24px; flex-direction:column; }
  .cart-form { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .qty-row { display:flex; align-items:center; gap:8px; font-size:14px; }
  .qty-input { width:60px; padding:8px; border:1px solid var(--border); border-radius:8px; text-align:center; font-size:16px; }
  .btn-large { padding:12px 32px; font-size:16px; }
  .out-of-stock-badge { background:#fee2e2; color:#dc2626; font-size:14px; font-weight:700; padding:10px 20px; border-radius:8px; }
  .low-stock-hint { font-size:13px; color:#f59e0b; font-weight:600; margin:0; }
  .cart-success { background:#dcfce7; border:1px solid #86efac; color:#15803d; border-radius:8px; padding:10px 16px; font-size:14px; margin-bottom:12px; }
  .cart-success a { color:#15803d; font-weight:700; }
  .cart-error { background:#fee2e2; border:1px solid #fca5a5; color:#dc2626; border-radius:8px; padding:10px 16px; font-size:14px; margin-bottom:12px; }
  .section-title { font-size:20px; font-weight:700; margin-bottom:16px; }
  .description { border-top:1px solid var(--border); padding-top:20px; }
  .description p { font-size:15px; line-height:1.7; color:var(--text-secondary); }

  .reviews-section { max-width:1280px; margin:0 auto; padding:0 24px 48px; border-top:1px solid var(--border); padding-top:48px; }
  .reviews-header { display:flex; align-items:center; gap:16px; margin-bottom:24px; flex-wrap:wrap; }
  .avg-rating { display:flex; align-items:center; gap:8px; }
  .avg-stars { color:#f59e0b; font-size:22px; }
  .avg-num { font-size:20px; font-weight:700; }
  .avg-count { color:var(--text-muted); font-size:14px; }
  .success-banner { background:#dcfce7; border:1px solid #86efac; color:#15803d; border-radius:8px; padding:12px 16px; margin-bottom:20px; font-size:14px; }
  .review-card { border-bottom:1px solid var(--border); padding:20px 0; }
  .review-header { display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; font-size:14px; color:var(--text-muted); }
  .review-stars { color:#f59e0b; font-size:16px; }
  .review-header strong { color:var(--text-primary); }
  .verified-badge { background:#dbeafe; color:#1d4ed8; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; }
  .review-title { font-size:15px; font-weight:600; margin:0 0 6px; }
  .review-body { font-size:14px; color:var(--text-secondary); line-height:1.6; margin:0; }
  .no-reviews { color:var(--text-muted); font-size:14px; padding:16px 0; }

  .write-review { border-top:1px solid var(--border); padding-top:32px; margin-top:32px; }
  .review-form { display:flex; flex-direction:column; gap:16px; max-width:560px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .field { display:flex; flex-direction:column; gap:4px; }
  .field label { font-size:13px; font-weight:600; color:var(--text-muted); }
  .textarea { min-height:100px; resize:vertical; }

  .star-rating { display:flex; flex-direction:row-reverse; gap:4px; }
  .star-rating input { display:none; }
  .star-label { font-size:28px; color:#d1d5db; cursor:pointer; transition:color .15s; }
  .star-rating input:checked ~ .star-label,
  .star-rating label:hover,
  .star-rating label:hover ~ .star-label { color:#f59e0b; }

  .related-section { max-width:1280px; margin:0 auto; padding:0 24px 64px; }
  .related-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px; }
  .related-card { border:1px solid var(--border); border-radius:10px; overflow:hidden; text-decoration:none; color:inherit; transition:box-shadow .2s; }
  .related-card:hover { box-shadow:0 4px 16px rgba(0,0,0,.08); }
  .related-img { width:100%; aspect-ratio:1; object-fit:cover; }
  .related-title { font-size:13px; font-weight:600; padding:8px 10px 2px; line-height:1.3; }
  .related-price { font-size:14px; font-weight:700; color:var(--primary); padding:0 10px 10px; }

  @media(max-width:768px) {
    .product-layout { grid-template-columns:1fr; gap:24px; }
    .form-row { grid-template-columns:1fr; }
  }
</style>
