---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { fetchReturn, updateReturnStatus } from "@shared/services/returnService";
import { useT, getLang } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_ORDERS)) return Astro.redirect("/admin");
const t = useT(Astro);
const lang = getLang(Astro);

const { id } = Astro.params;

// Handle status/resolution updates
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const updates: Record<string, unknown> = {};

  const status = form.get("status") as string;
  const resolution = form.get("resolution") as string;
  const refund_amount = form.get("refund_amount");
  const refund_method = form.get("refund_method") as string;
  const notes = form.get("notes") as string;

  if (status) updates.status = status;
  if (resolution) updates.resolution = resolution;
  if (refund_amount) updates.refund_amount = parseFloat(refund_amount as string);
  if (refund_method) updates.refund_method = refund_method;
  if (notes !== null) updates.notes = notes;

  if (status === "received") updates.received_at = new Date().toISOString();
  if (status === "completed") updates.completed_at = new Date().toISOString();
  if (status) updates.processed_by = session.user.id;

  await updateReturnStatus(supabase, id!, updates as Parameters<typeof updateReturnStatus>[2]);
  return Astro.redirect(`/admin/returns/${id}`);
}

const rma = await fetchReturn(supabase, id!);
if (!rma) return Astro.redirect("/admin/returns");

const STATUSES = ["pending","approved","rejected","received","processing","completed","cancelled"];
const RESOLUTIONS = ["refund","exchange","store_credit"];
const REFUND_METHODS = ["original_payment","store_credit","bank_transfer"];

function statusClass(s: string) {
  const map: Record<string, string> = {
    pending:"badge-pending", approved:"badge-draft", received:"badge-draft",
    processing:"badge-draft", completed:"badge-active", rejected:"badge-error", cancelled:"badge-inactive",
  };
  return map[s] ?? "badge-draft";
}

const STATUS_LABELS: Record<string, string> = {
  pending: t.admin.returns.statusPending, approved: t.admin.returns.statusApproved,
  received: t.admin.returns.statusReceived, processing: t.admin.returns.statusProcessing,
  completed: t.admin.returns.statusCompleted, rejected: t.admin.returns.statusRejected,
  cancelled: t.admin.returns.statusCancelled,
};
const REASON_LABELS: Record<string, string> = {
  wrong_item: t.admin.returns.reasonWrongItem, damaged: t.admin.returns.reasonDamaged, defective: t.admin.returns.reasonDefective,
  not_as_described: t.admin.returns.reasonNotAsDescribed, changed_mind: t.admin.returns.reasonChangedMind,
  quality_issue: t.admin.returns.reasonQualityIssue, size_issue: t.admin.returns.reasonSizeIssue, other: t.admin.returns.reasonOther,
};
const RESOLUTION_LABELS: Record<string, string> = {
  refund: t.admin.returns.resolutionRefund, exchange: t.admin.returns.resolutionExchange, store_credit: t.admin.returns.storeCredit,
};
const REFUND_METHOD_LABELS: Record<string, string> = {
  original_payment: t.admin.returns.refundMethodOriginalPayment, store_credit: t.admin.returns.storeCredit,
  bank_transfer: t.admin.returns.refundMethodBankTransfer,
};
---

<CmsLayout title={t.admin.returns.detailTitle.replace("{{number}}", rma.return_number)} userPermissions={permissions} currentPath="/admin/returns" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="toolbar">
    <a href="/admin/returns" class="btn btn-ghost">{t.admin.returns.back}</a>
    <h1 class="page-title">{rma.return_number}</h1>
    <span class={`badge ${statusClass(rma.status)}`}>{STATUS_LABELS[rma.status] ?? rma.status}</span>
  </div>

  <div class="detail-grid">
    <div class="card">
      <h2 class="section-title">{t.admin.returns.sectionDetails}</h2>
      <dl class="detail-list">
        <dt>{t.admin.returns.fieldOrder}</dt>
        <dd><a href={`/admin/orders/${rma.order_id}`}>{rma.order_id.slice(0, 8)}</a></dd>
        <dt>{t.admin.returns.fieldReason}</dt>
        <dd>{REASON_LABELS[rma.reason] ?? rma.reason}</dd>
        <dt>{t.admin.returns.fieldCustomerNotes}</dt>
        <dd>{rma.customer_notes ?? "—"}</dd>
        <dt>{t.admin.returns.fieldCreated}</dt>
        <dd>{new Date(rma.created_at).toLocaleString(lang)}</dd>
        {rma.received_at && <><dt>{t.admin.returns.fieldReceived}</dt><dd>{new Date(rma.received_at).toLocaleString(lang)}</dd></>}
        {rma.completed_at && <><dt>{t.admin.returns.fieldCompleted}</dt><dd>{new Date(rma.completed_at).toLocaleString(lang)}</dd></>}
      </dl>
    </div>

    <div class="card">
      <h2 class="section-title">{t.admin.returns.sectionResolution}</h2>
      <form method="POST" class="resolution-form">
        <div class="field">
          <label>{t.admin.returns.fieldStatus}</label>
          <select name="status" class="input">
            {STATUSES.map(s => <option value={s} selected={s === rma.status}>{STATUS_LABELS[s] ?? s}</option>)}
          </select>
        </div>
        <div class="field">
          <label>{t.admin.returns.fieldResolution}</label>
          <select name="resolution" class="input">
            <option value="">{t.admin.returns.notSet}</option>
            {RESOLUTIONS.map(r => <option value={r} selected={r === rma.resolution}>{RESOLUTION_LABELS[r] ?? r}</option>)}
          </select>
        </div>
        <div class="field">
          <label>{t.admin.returns.fieldRefundAmount}</label>
          <input type="number" name="refund_amount" step="0.01" value={rma.refund_amount ?? ""} class="input" />
        </div>
        <div class="field">
          <label>{t.admin.returns.fieldRefundMethod}</label>
          <select name="refund_method" class="input">
            <option value="">{t.admin.returns.notSet}</option>
            {REFUND_METHODS.map(m => <option value={m} selected={m === rma.refund_method}>{REFUND_METHOD_LABELS[m] ?? m}</option>)}
          </select>
        </div>
        <div class="field">
          <label>{t.admin.returns.fieldNotes}</label>
          <textarea name="notes" class="input textarea">{rma.notes ?? ""}</textarea>
        </div>
        <button type="submit" class="btn btn-primary">{t.common.saveChanges}</button>
      </form>
    </div>
  </div>

  {(rma as any).items?.length > 0 && (
    <div class="card" style="margin-top:20px">
      <h2 class="section-title">{t.admin.returns.sectionItems}</h2>
      <table class="data-table">
        <thead>
          <tr><th>{t.admin.returns.colItem}</th><th>{t.admin.inventory.colSku}</th><th>{t.admin.returns.colQtyOrdered}</th><th>{t.admin.returns.colQtyReturned}</th><th>{t.admin.returns.colCondition}</th><th>{t.admin.returns.colRestock}</th></tr>
        </thead>
        <tbody>
          {(rma as any).items.map((item: any) => (
            <tr>
              <td>{item.order_item?.title ?? "—"}</td>
              <td>{item.order_item?.sku ?? "—"}</td>
              <td>{item.order_item?.quantity}</td>
              <td>{item.quantity}</td>
              <td>{item.condition ?? "—"}</td>
              <td>{item.restock ? "✓" : "—"}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</CmsLayout>

<style>
  .toolbar { display:flex; align-items:center; gap:12px; margin-bottom:24px; }
  .detail-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; }
  .section-title { font-size:16px; font-weight:700; margin-bottom:16px; }
  .detail-list { display:grid; grid-template-columns:auto 1fr; gap:8px 16px; font-size:14px; }
  .detail-list dt { color:var(--text-muted); font-weight:600; }
  .resolution-form { display:flex; flex-direction:column; gap:14px; }
  .field { display:flex; flex-direction:column; gap:4px; }
  .field label { font-size:13px; font-weight:600; color:var(--text-muted); }
  .textarea { min-height:80px; resize:vertical; }
  @media(max-width:768px) { .detail-grid { grid-template-columns:1fr; } }
</style>
