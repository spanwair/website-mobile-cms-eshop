---
import { createSupabase } from "../../../lib/supabase";
import { fetchInventory, updateStock, updateThresholds } from "@shared/services/inventoryService";
import type { StockMovementType } from "@shared/types";
import { requireAdminCtx } from "../../../lib/admin";
import { useT } from "../../../lib/i18n";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import CmsLayout from "../../../components/cms/CmsLayout.astro";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_INVENTORY)) return Astro.redirect("/admin");
const t = useT(Astro);

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;
  const inventoryItemId = form.get("inventory_item_id") as string;

  if (action === "update_thresholds") {
    const lowStockValue = form.get("low_stock_threshold") as string;
    const maxThresholdValue = form.get("max_threshold") as string;
    const lowStockThreshold = lowStockValue && parseInt(lowStockValue, 10) > 0 ? parseInt(lowStockValue, 10) : null;
    const maxThreshold = maxThresholdValue && parseInt(maxThresholdValue, 10) > 0 ? parseInt(maxThresholdValue, 10) : null;
    const result = await updateThresholds(supabase, [{
      id: inventoryItemId,
      low_stock_threshold: lowStockThreshold,
      max_threshold: maxThreshold,
    }]);
    if (result.error) { error = result.error.message; }
    else { return Astro.redirect("/admin/inventory"); }
  } else {
    const quantity = parseInt(form.get("quantity") as string, 10);
    const type = form.get("type") as StockMovementType;
    const note = (form.get("note") as string) || undefined;
    const result = await updateStock(supabase, {
      inventory_item_id: inventoryItemId,
      party_id: partyId,
      quantity,
      type,
      note: note ?? null,
      created_by: session.user.id,
    });
    if (result.error) { error = result.error.message; }
    else { return Astro.redirect("/admin/inventory"); }
  }
}

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get("page") ?? "1", 10);
const filter = url.searchParams.get("filter") ?? "all";
const lowStockOnly = filter === "low";
const outOfStockOnly = filter === "out";
const pageSize = 30;

const inventoryResult = await fetchInventory(supabase, partyId, { page, pageSize, lowStockOnly });
let items = inventoryResult.data;
if (outOfStockOnly) items = items.filter(i => i.qty_on_hand <= 0);
const total = outOfStockOnly ? items.length : inventoryResult.total;

// Fetch product names for display
const productIds = [...new Set(items.map(i => i.product_id))];
const productNames: Record<string, string> = {};
if (productIds.length > 0) {
  const { data: prods } = await supabase
    .from("products")
    .select("id, title")
    .in("id", productIds);
  (prods ?? []).forEach((p: any) => { productNames[p.id] = p.title; });
}

const totalPages = Math.ceil(total / pageSize);
const lowCount = inventoryResult.data.filter((i) => i.qty_on_hand <= i.low_stock_threshold && i.qty_on_hand > 0).length;
const outCount = inventoryResult.data.filter((i) => i.qty_on_hand <= 0).length;
const isLowMap = new Map(items.map((i) => [i.id, i.qty_on_hand <= i.low_stock_threshold]));
---

<CmsLayout title={t.admin.inventory.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId}>
  {error && <div class="alert-error">{error}</div>}

  <div class="toolbar">
    <div class="filter-links">
      <a href="?filter=all" class={`filter-btn ${filter === "all" ? "active" : ""}`}>{t.admin.inventory.filterAll} ({inventoryResult.total})</a>
      <a href="?filter=low" class={`filter-btn ${filter === "low" ? "active" : ""}`}>{t.admin.inventory.filterLow} ({lowCount})</a>
      <a href="?filter=out" class={`filter-btn ${filter === "out" ? "active" : ""}`}>{t.admin.inventory.filterOutOfStock} ({outCount})</a>
    </div>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{t.admin.inventory.colProduct}</th><th>{t.admin.inventory.colVariant}</th><th>{t.admin.inventory.colOnHand}</th><th>{t.admin.inventory.colReserved}</th><th>{t.admin.inventory.colAvailable}</th><th>{t.admin.inventory.colThreshold}</th><th>{t.admin.inventory.updateThresholds}</th><th>{t.admin.inventory.adjust}</th></tr>
      </thead>
      <tbody>
        {items.map((item) => (
          <tr>
            <td>
              <a href={`/admin/products/${item.product_id}`} style="font-weight:600;font-size:14px">{productNames[item.product_id] ?? item.product_id.slice(0, 8) + "…"}</a>
            </td>
            <td style="font-size:12px;color:var(--text-muted)">{item.variant_name ?? "—"}</td>
            <td style={`font-weight:700;${isLowMap.get(item.id) ? "color:var(--error)" : ""}`}>{item.qty_on_hand}</td>
            <td>{item.qty_reserved}</td>
            <td>{item.qty_available}</td>
            <td>
              <div style="display:flex;flex-direction:column;gap:4px">
                <span style="font-size:13px">
                  <span style="color:var(--text-muted);font-size:11px;text-transform:uppercase">{t.admin.inventory.shortMin}</span> {item.low_stock_threshold || "—"}
                </span>
                <span style="font-size:13px">
                  <span style="color:var(--text-muted);font-size:11px;text-transform:uppercase">{t.admin.inventory.shortMax}</span> {item.max_threshold || "—"}
                </span>
              </div>
              {isLowMap.get(item.id) && <span class="badge badge-error" style="margin-top:4px">{t.admin.inventory.filterLow}</span>}
            </td>
            <td>
              <form method="POST" class="threshold-form">
                <input type="hidden" name="action" value="update_thresholds" />
                <input type="hidden" name="inventory_item_id" value={item.id} />
                <input class="form-input threshold-input min-threshold" name="low_stock_threshold" type="number" min="0" placeholder="0" value={item.low_stock_threshold || 0} />
                <input class="form-input threshold-input max-threshold" name="max_threshold" type="number" min="0" placeholder="0" value={item.max_threshold || 0} />
                <button type="submit" class="btn btn-secondary" style="padding:6px 10px;font-size:12px;white-space:nowrap">{t.common.apply}</button>
              </form>
            </td>
            <td>
              <form method="POST" class="adjust-form">
                <input type="hidden" name="inventory_item_id" value={item.id} />
                <input class="form-input qty-input" name="quantity" type="number" required placeholder="±" />
                <select class="form-input type-select" name="type">
                  <option value="adjustment">{t.admin.inventory.typeAdjustment}</option>
                  <option value="purchase">{t.admin.inventory.typePurchase}</option>
                  <option value="return">{t.admin.inventory.typeReturn}</option>
                  <option value="damage">{t.admin.inventory.typeDamage}</option>
                </select>
                <input class="form-input note-input" name="note" placeholder={t.admin.orders.noteOptional} />
                <button type="submit" class="btn btn-secondary" style="padding:8px 12px;font-size:13px;white-space:nowrap">{t.common.apply}</button>
              </form>
            </td>
          </tr>
        ))}
        {items.length === 0 && (
          <tr><td colspan="8" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.inventory.noInventory}</td></tr>
        )}
      </tbody>
    </table>
  </div>

  {totalPages > 1 && (
    <div class="pagination">
      {page > 1 && <a href={`?page=${page - 1}&filter=${filter}`} class="btn btn-ghost">{t.common.previous}</a>}
      <span class="page-info">{t.common.page} {page} {t.common.of} {totalPages}</span>
      {page < totalPages && <a href={`?page=${page + 1}&filter=${filter}`} class="btn btn-ghost">{t.common.next}</a>}
    </div>
  )}
</CmsLayout>

<style>
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
  .filter-links { display:flex; gap:4px; }
  .filter-btn { padding:8px 16px; font-size:13px; font-weight:600; border-radius:8px; color:var(--text-muted); text-decoration:none; transition:background 0.15s, color 0.15s; }
  .filter-btn:hover { background:var(--bg-subtle); color:var(--text-primary); text-decoration:none; }
  .filter-btn.active { background:var(--accent-primary); color:#fff; }
  .adjust-form { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .qty-input { width:70px; padding:6px 10px; font-size:13px; }
  .type-select { width:120px; padding:6px 10px; font-size:13px; }
  .note-input { width:120px; padding:6px 10px; font-size:13px; }
  .pagination { display:flex; align-items:center; gap:12px; margin-top:16px; }
  .page-info { font-size:13px; color:var(--text-muted); }
  .threshold-form { display:flex; gap:6px; align-items:center; flex-direction:column; }
  .threshold-input { width:70px; padding:6px 8px; font-size:12px; }
  @media(min-width:1200px) { .threshold-form { flex-direction:row; } }
</style>

