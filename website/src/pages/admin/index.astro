---
import CmsLayout from "../../components/cms/CmsLayout.astro";
import ProductsOverviewSection from "../../components/admin/ProductsOverviewSection.astro";
import { createSupabase } from "../../lib/supabase";
import { fetchUsersForAdmin } from "@shared/services/profileService";
import { fetchProducts } from "@shared/services/productService";
import { fetchOrders } from "@shared/services/orderService";
import { fetchProductOverview, fetchProductActivityLog } from "@shared/services/productOverviewService";
import { fetchPartiesPaged } from "@shared/services/partyService";
import type { ProductOverviewStats, ProductActivityEvent, Party } from "@shared/types";
import { requireAdminCtx } from "../../lib/admin";
import { useT, getLang } from "../../lib/i18n";
import { ROLE, PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { formatPrice } from "@shared/utils/format";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
// Eshop admin with no party has nothing to manage yet.
if (!ctx.isGlobal && !ctx.partyId) return Astro.redirect("/admin/setup");

const { permissions, partyId, role } = ctx;

// Self-serve admin (organic signup, not invited staff/owner) stays routed into the
// onboarding tutorial on every /admin visit until their org has at least one category and
// one product — landing here mid-onboarding must resume the flow, not show an empty
// dashboard, regardless of how many times they log back in.
if (role === ROLE.ADMIN && partyId) {
  const { count: catCount } = await supabase.from("categories").select("id", { count: "exact", head: true }).eq("party_id", partyId);
  const { count: prodCount } = await supabase.from("products").select("id", { count: "exact", head: true }).eq("party_id", partyId);
  if ((catCount ?? 0) === 0 || (prodCount ?? 0) === 0) {
    return Astro.redirect("/admin/onboarding/tutorial");
  }
}

if (!hasPermission(permissions, PERMISSIONS.VIEW_DASHBOARD)) return Astro.redirect("/admin/notifications");
const t = useT(Astro);
const lang = getLang(Astro);

const canUsers    = hasPermission(permissions, PERMISSIONS.MANAGE_USERS);
const canProducts = hasPermission(permissions, PERMISSIONS.MANAGE_PRODUCTS);
const canOrders   = hasPermission(permissions, PERMISSIONS.MANAGE_ORDERS);
const canReports  = hasPermission(permissions, PERMISSIONS.MANAGE_REPORTS);

// Non-ADMIN roles (eshop_admin staff dropped into an empty org, etc.) still just get a
// dismissable-by-completion banner rather than a hard redirect — they weren't part of the
// self-serve onboarding flow.
let showOnboardingChecklist = false;
if (partyId && canProducts && role !== ROLE.ADMIN) {
  const { count: catCount } = await supabase.from("categories").select("id", { count: "exact", head: true }).eq("party_id", partyId);
  const { count: prodCount } = await supabase.from("products").select("id", { count: "exact", head: true }).eq("party_id", partyId);
  showOnboardingChecklist = (catCount ?? 0) === 0 || (prodCount ?? 0) === 0;
}
const canAudit    = hasPermission(permissions, PERMISSIONS.MANAGE_AUDIT);

const { role: myRole } = ctx;

let totalUsers = 0;
let activeUsers = 0;
if (canUsers) {
  const users = await fetchUsersForAdmin(supabase, myRole, partyId);
  totalUsers = users.length;
  activeUsers = users.filter((u) => u.role > ROLE.USER).length;
}

let totalProducts = 0;
let activeProducts = 0;
let totalOrders = 0;
let recentOrders: Awaited<ReturnType<typeof fetchOrders>>["data"] = [];
let revenue = 0;
let productOverview: ProductOverviewStats | null = null;
let productActivity: ProductActivityEvent[] = [];

const { error: tablesProbeError } = await supabase.from("parties").select("id").limit(0);
const tablesReady = !tablesProbeError;

if (tablesReady && partyId) {
  if (canProducts) {
    const [allProds, activProds] = await Promise.all([
      fetchProducts(supabase, partyId, { pageSize: 1 }),
      fetchProducts(supabase, partyId, { status: "active", pageSize: 1 }),
    ]);
    totalProducts = allProds.total;
    activeProducts = activProds.total;
    [productOverview, productActivity] = await Promise.all([
      fetchProductOverview(supabase, partyId, 30),
      fetchProductActivityLog(supabase, partyId, 40),
    ]);
  }
  if (canOrders) {
    const ordersResult = await fetchOrders(supabase, partyId, { pageSize: 5 });
    totalOrders = ordersResult.total;
    recentOrders = ordersResult.data;
  }
  if (canOrders || canReports) {
    const now = new Date();
    const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).toISOString();
    const monthOrders = await fetchOrders(supabase, partyId, { from: monthStart, pageSize: 100 });
    revenue = monthOrders.data.reduce((sum, o) => sum + o.total_amount, 0);
  }
}

const kpis = [
  ...(canUsers    ? [{ key: "total-users",    label: t.admin.kpiTotalUsers,    value: totalUsers },
                     { key: "active-users",   label: t.admin.kpiActiveUsers,   value: activeUsers }] : []),
  ...(canProducts ? [{ key: "total-products", label: t.admin.kpiTotalProducts, value: totalProducts },
                     { key: "active-products", label: t.admin.kpiActiveProducts, value: activeProducts }] : []),
  ...(canOrders   ? [{ key: "total-orders",   label: t.admin.kpiTotalOrders,   value: totalOrders }] : []),
  ...((canOrders || canReports) ? [{ key: "revenue", label: t.admin.kpiRevenue, value: formatPrice(revenue, lang) }] : []),
];

// Owner-only: eshops awaiting approval (status = pending_approval), paginated max 10 per page.
// Only pending parties appear here — already approved ones are excluded by the status filter.
const pendingPageSize = 10;
let pendingParties: Party[] = [];
let pendingTotal = 0;
let pendingTotalPages = 0;
let pendingPage = 1;
if (ctx.isOwner && tablesReady) {
  const url = new URL(Astro.request.url);
  pendingPage = Math.max(1, parseInt(url.searchParams.get("pendingPage") ?? "1", 10));
  const pendingResult = await fetchPartiesPaged(supabase, { page: pendingPage, pageSize: pendingPageSize, status: "pending_approval" });
  pendingParties = pendingResult.data;
  pendingTotal = pendingResult.total;
  pendingTotalPages = Math.ceil(pendingTotal / pendingPageSize);
  if (pendingPage > pendingTotalPages && pendingTotalPages > 0) {
    pendingPage = pendingTotalPages;
    const corrected = await fetchPartiesPaged(supabase, { page: pendingPage, pageSize: pendingPageSize, status: "pending_approval" });
    pendingParties = corrected.data;
  }
}

function statusClass(s: string) {
  const map: Record<string, string> = {
    pending: "badge-pending", confirmed: "badge-active", processing: "badge-draft",
    shipped: "badge-active", delivered: "badge-active", cancelled: "badge-error",
  };
  return map[s] ?? "badge-inactive";
}
const STATUS_LABELS: Record<string, string> = {
  pending: t.admin.orders.tabPending, confirmed: t.admin.orders.tabConfirmed, processing: t.admin.orders.tabProcessing,
  shipped: t.admin.orders.tabShipped, delivered: t.admin.orders.tabDelivered, cancelled: t.admin.orders.tabCancelled,
  refunded: t.admin.orders.statusRefunded,
};
const dateLocale = lang === "en" ? "en-US" : "cs-CZ";
---

<CmsLayout title={t.admin.dashboard} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId}>
  {!tablesReady && (
    <div class="info-banner">⚠️ {t.admin.infoBanner}</div>
  )}
  {tablesReady && !partyId && ctx.isOwner && (
    <div class="info-banner">
      {t.admin.noOrgsYet}
      <a href="/admin/parties/new" class="banner-link">{t.admin.createFirstOrgLink}</a> {t.admin.createFirstOrgSuffix}
    </div>
  )}
  {tablesReady && !partyId && !ctx.isOwner && (
    <div class="info-banner">
      ⚠️ {t.admin.infoBannerNoParty} <a href="/admin/parties" class="banner-link">{t.admin.infoBannerPartiesLink}</a>.
    </div>
  )}
  {showOnboardingChecklist && (
    <div class="info-banner onboarding-banner">
      🚀 {t.admin.onboardingWizard.tutorialIntro}
      <a href="/admin/onboarding/tutorial" class="banner-link">{t.admin.onboardingWizard.tutorialTitle}</a>
    </div>
  )}

  {ctx.isOwner && tablesReady && (
    <div class="card" style="padding:0;overflow:hidden;margin-bottom:24px" data-section="pending-approvals">
      <div style="padding:20px 20px 0">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px;flex-wrap:wrap;gap:12px">
          <h2 class="section-title" style="margin-bottom:0">{t.admin.pendingApprovals.title}</h2>
          <span class="total-label">{pendingTotal} {t.admin.pendingApprovals.totalLabel}</span>
        </div>
        {pendingTotal > 0 && <p class="pending-hint">{t.admin.pendingApprovals.hint}</p>}
      </div>
      <div style="overflow-x:auto">
        <table class="data-table">
          <thead>
            <tr><th>{t.admin.pendingApprovals.colName}</th><th>{t.admin.pendingApprovals.colSlug}</th><th>{t.admin.pendingApprovals.colCompany}</th><th>{t.admin.pendingApprovals.colCreated}</th><th>{t.admin.pendingApprovals.colActions}</th></tr>
          </thead>
          <tbody>
            {pendingParties.map((p) => (
              <tr>
                <td style="font-weight:600">{p.name}</td>
                <td style="font-family:monospace;font-size:13px;color:var(--text-muted)">{p.slug}</td>
                <td style="color:var(--text-muted)">{p.company_name ?? "—"}</td>
                <td style="font-size:13px;color:var(--text-muted)">{new Date(p.created_at).toLocaleDateString(lang)}</td>
                <td><a href={`/admin/parties/${p.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.admin.pendingApprovals.view}</a></td>
              </tr>
            ))}
            {pendingParties.length === 0 && (
              <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.pendingApprovals.empty}</td></tr>
            )}
          </tbody>
        </table>
      </div>
      {pendingTotalPages > 1 && (
        <div class="pagination" style="padding:12px 20px">
          {pendingPage > 1 && <a href={`?pendingPage=${pendingPage - 1}`} class="btn btn-ghost">{t.common.previous}</a>}
          <span class="page-info">{t.common.page} {pendingPage} {t.common.of} {pendingTotalPages} ({t.common.total} {pendingTotal})</span>
          {pendingPage < pendingTotalPages && <a href={`?pendingPage=${pendingPage + 1}`} class="btn btn-ghost">{t.common.next}</a>}
        </div>
      )}
    </div>
  )}

  <div class="stats-row">
    {kpis.map(({ key, label, value }) => (
      <div class="card stat-card" data-kpi={key}>
        <span class="stat-num">{value}</span>
        <span class="stat-label">{label}</span>
      </div>
    ))}
  </div>

  {canProducts && productOverview && (
    <ProductsOverviewSection stats={productOverview} activity={productActivity} locale={dateLocale} />
  )}

  {(canOrders || canReports) && (
    <div class="dashboard-grid">
      {canOrders && (
        <div class="card" data-section="recent-orders">
          <h2 class="section-title">{t.admin.recentOrders}</h2>
          {recentOrders.length === 0 ? (
            <p class="empty">{t.admin.noOrders}</p>
          ) : (
            <table class="data-table">
              <thead>
                <tr><th>{t.admin.orders.colNumber}</th><th>{t.admin.orders.colStatus}</th><th>{t.admin.orders.colTotal}</th><th>{t.admin.orders.colDate}</th></tr>
              </thead>
              <tbody>
                {recentOrders.map((o) => (
                  <tr>
                    <td><a href={`/admin/orders/${o.id}`}>{o.order_number}</a></td>
                    <td><span class={`badge ${statusClass(o.status)}`}>{STATUS_LABELS[o.status] ?? o.status}</span></td>
                    <td>{formatPrice(o.total_amount, lang)}</td>
                    <td>{new Date(o.created_at).toLocaleDateString(dateLocale)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          )}
        </div>
      )}

      {(canOrders || canReports) && (
        <div class="card" data-section="revenue-chart">
          <h2 class="section-title">{t.admin.revenueChart}</h2>
          <div class="chart-placeholder">{t.admin.chartSoon}</div>
        </div>
      )}
    </div>
  )}

  {canAudit && (
    <div class="card" data-section="recent-activity" style="margin-top:24px">
      <h2 class="section-title">{t.admin.recentActivity}</h2>
      <p class="empty">{t.admin.noAudit}</p>
    </div>
  )}
</CmsLayout>

<style>
  .info-banner { background:#EEF2FF; border:1px solid #C7D2FE; border-radius:8px; padding:12px 16px; color:#3730A3; margin-bottom:24px; font-size:14px; }
  .banner-link { color:#3730A3; font-weight:600; text-decoration:underline; }
  .dashboard-grid { display:grid; grid-template-columns:2fr 1fr; gap:24px; }
  .chart-placeholder { height:160px; background:var(--bg-subtle); border-radius:8px; display:flex; align-items:center; justify-content:center; color:var(--text-muted); font-size:14px; }
  .empty { color:var(--text-muted); font-size:14px; padding:16px 0; }
  .section-title { font-size:16px; font-weight:700; margin-bottom:16px; }
  .total-label { font-size:13px; color:var(--text-muted); }
  .pending-hint { font-size:13px; color:var(--text-muted); margin-bottom:16px; line-height:1.5; }
  .pagination { display:flex; align-items:center; gap:12px; margin-top:0; border-top:1px solid var(--border-default); }
  .page-info { font-size:13px; color:var(--text-muted); }
  .badge-pending_approval { background: rgba(234,179,8,0.14); color: #a16207; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; }
  @media(max-width:768px) { .dashboard-grid { grid-template-columns:1fr; } }
</style>
