---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchUsersForAdmin } from "@shared/services/profileService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT } from "../../../lib/i18n";
import { ROLE, ROLE_LABEL, assignableRoles, canAssignRole, PERMISSIONS, hasPermission } from "@shared/constants/permissions";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
const { permissions, role: myRole } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_USERS)) return Astro.redirect("/admin");
const t = useT(Astro);

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const userId = form.get("user_id") as string;
  const newRole = Number(form.get("role"));

  if (!Object.values(ROLE).includes(newRole as typeof ROLE[keyof typeof ROLE])) {
    error = t.admin.users.errorInvalidRole;
  } else if (!canAssignRole(myRole, newRole)) {
    error = t.admin.users.errorRoleTooHigh;
  } else {
    const { error: updateErr } = await supabase
      .from("profiles")
      .update({ role: newRole })
      .eq("id", userId);
    if (updateErr) { error = updateErr.message; }
    else { return Astro.redirect("/admin/users"); }
  }
}

const users = await fetchUsersForAdmin(supabase, myRole, ctx.partyId);
const canAssign = assignableRoles(myRole);

// For a given user row, can the current viewer change their role?
function canChangeUser(u: { id: string; role: number; admin_assigned_by: string | null }): boolean {
  if (u.id === session.user.id) return false;
  if (u.role >= ROLE.OWNER) return false;
  if (u.role === ROLE.ADMIN) {
    return myRole >= ROLE.OWNER || (myRole === ROLE.ADMIN && u.admin_assigned_by === session.user.id);
  }
  return canAssign.length > 0;
}

// Roles available in the dropdown for a given target user.
function rolesForUser(u: { role: number }): typeof canAssign {
  if (u.role === ROLE.ADMIN) return canAssign.filter(r => r < ROLE.ADMIN);
  return canAssign;
}

function roleClass(r: number) {
  if (r >= ROLE.OWNER) return "badge-error";
  if (r >= ROLE.ADMIN) return "badge-pending";
  if (r >= ROLE.ESHOP_ADMIN) return "badge-draft";
  return "badge-inactive";
}
---

<CmsLayout title={t.admin.users.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId}>
  {error && <div class="alert-error">{error}</div>}

  <div class="toolbar">
    <span class="total-label">{users.length} {t.admin.users.title.toLowerCase()}</span>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr>
          <th>{t.admin.users.colName}</th>
          <th>{t.admin.users.colEmail}</th>
          <th>{t.admin.users.colRole}</th>
          <th>{t.admin.users.colJoined}</th>
          <th>{t.admin.users.colChangeRole}</th>
        </tr>
      </thead>
      <tbody>
        {users.map((u) => (
          <tr>
            <td style="font-weight:600">{u.display_name ?? t.common.unnamed}</td>
            <td style="color:var(--text-muted);font-size:13px">{u.email}</td>
            <td><span class={`badge ${roleClass(u.role)}`}>{ROLE_LABEL[u.role as keyof typeof ROLE_LABEL] ?? u.role}</span></td>
            <td style="color:var(--text-muted);font-size:13px">{new Date(u.created_at).toLocaleDateString()}</td>
            <td>
              {u.id === session.user.id && (
                <span style="font-size:12px;color:var(--text-muted)">{t.admin.users.you}</span>
              )}
              {canChangeUser(u) && (
                <form method="POST" class="role-form">
                  <input type="hidden" name="user_id" value={u.id} />
                  <select class="form-input role-select" name="role">
                    {rolesForUser(u).map(r => (
                      <option value={r} selected={u.role === r}>
                        {ROLE_LABEL[r as keyof typeof ROLE_LABEL]}
                      </option>
                    ))}
                  </select>
                  <button type="submit" class="btn btn-secondary" style="padding:7px 12px;font-size:13px">
                    {t.admin.users.applyBtn}
                  </button>
                </form>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
  .total-label { font-size:14px; color:var(--text-muted); }
  .role-form { display:flex; gap:6px; align-items:center; }
  .role-select { width:140px; padding:6px 10px; font-size:13px; }
</style>
