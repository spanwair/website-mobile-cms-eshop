---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchParties } from "@shared/services/partyService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT, getLang } from "../../../lib/i18n";
import { PERMISSIONS, ROLE, hasPermission } from "@shared/constants/permissions";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
const { permissions } = ctx;
const t = useT(Astro);
const lang = getLang(Astro);

if (!hasPermission(permissions, PERMISSIONS.MANAGE_USERS)) return Astro.redirect("/admin");

const parties = await fetchParties(supabase);
---

<CmsLayout title={t.admin.parties.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId}>
  <div class="toolbar">
    <span class="total-label">{parties.length} {t.admin.parties.title.toLowerCase()}</span>
    {ctx.role >= ROLE.ADMIN && <a href="/admin/parties/new" class="btn btn-primary">{t.admin.parties.new}</a>}
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{t.admin.parties.colName}</th><th>{t.admin.parties.colSlug}</th><th>{t.admin.parties.colCompany}</th><th>{t.admin.parties.sellerMode.section}</th><th>{t.admin.parties.colStatus}</th><th>{t.admin.parties.colCreated}</th><th>{t.admin.parties.colActions}</th></tr>
      </thead>
      <tbody>
        {parties.map((p) => (
          <tr>
            <td style="font-weight:600">{p.name}</td>
            <td style="font-family:monospace;font-size:13px;color:var(--text-muted)">{p.slug}</td>
            <td style="color:var(--text-muted)">{p.company_name ?? "—"}</td>
            <td>
              <span class={`badge ${p.seller_mode === 'smalljobs_commission' ? 'mode-badge--commission' : 'mode-badge--own'}`}>
                {p.seller_mode === 'smalljobs_commission' ? t.admin.parties.sellerMode.commissionLabel : t.admin.parties.sellerMode.ownCompanyLabel}
              </span>
            </td>
            <td><span class={`badge badge-${p.status}`}>{t.admin.parties[
              p.status === 'active' ? 'statusActive'
              : p.status === 'closed' ? 'statusClosed'
              : p.status === 'pending_approval' ? 'statusPendingApproval'
              : 'statusInactive'
            ]}</span></td>
            <td style="font-size:13px;color:var(--text-muted)">{new Date(p.created_at).toLocaleDateString(lang)}</td>
            <td><a href={`/admin/parties/${p.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.admin.parties.view}</a></td>
          </tr>
        ))}
        {parties.length === 0 && (
          <tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.parties.noParties}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
  .total-label { font-size:14px; color:var(--text-muted); }
  .mode-badge--own { background: var(--bg-subtle); color: var(--text-primary); padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; }
  .mode-badge--commission { background: rgba(124,179,66,0.12); color: #558b2f; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; }
  .badge-pending_approval { background: rgba(234,179,8,0.14); color: #a16207; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:700; }
</style>
