---
import CmsLayout from "@/components/cms/CmsLayout.astro";
import PartySellerModeCard from "@/components/admin/PartySellerModeCard.astro";
import SlugInput from "@/components/cms/SlugInput.astro";
import { createSupabase, createAdminClient } from "@/lib/supabase";
import { resolveSlug } from "@shared/utils/slug";
import { fetchParty, updateParty, fetchPartyMembers, inviteUserToParty, removeUserFromParty } from "@shared/services/partyService";
import { fetchCommissionaireAgreement, acceptCommissionaireAgreement, revokeCommissionaireAgreement } from "@shared/services/commissionaireService";
import { fetchRoles } from "@shared/services/permissionsService";
import { findUserByEmail } from "@shared/services/profileService";
import { fetchProducts } from "@shared/services/productService";
import { requireAdminCtx } from "@/lib/admin";
import { useT, getLang } from "@/lib/i18n";
import { PERMISSIONS, hasPermission, ROLE, ROLE_LABEL, assignableRoles, canAssignRole } from "@shared/constants/permissions";
import { sendPartyInvitation, buildDevInviteMetadata } from "@/lib/integrations/email";
import { SELLER_MODE, COMMISSION_RATE, REDUCED_COMMISSION_RATE, COMMISSION_REDUCED_THRESHOLD_CZK } from "@shared/constants/sellerMode";
import { formatPrice } from "@shared/utils/format";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
const { permissions, isOwner } = ctx;
const t = useT(Astro);
const lang = getLang(Astro);

const { id } = Astro.params;

// Non-owner users can only access parties they belong to.
if (!ctx.isOwner && !ctx.parties.some((p) => p.id === id)) {
  return Astro.redirect("/admin/parties");
}

const canManageUsers    = hasPermission(permissions, PERMISSIONS.MANAGE_USERS);
const canManageSettings = hasPermission(permissions, PERMISSIONS.MANAGE_AUDIT);
const myRole = ctx.role;
const systemRoleOptions = assignableRoles(myRole).filter(r => r >= ROLE.ESHOP_ADMIN && r < ROLE.OWNER);

if (!canManageUsers && !canManageSettings) return Astro.redirect("/admin");

let error = "";
let success = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;

  if (action === "update_party") {
    if (!canManageSettings) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      const { data: current } = await supabase.from("parties").select("status").eq("id", id!).single();
      const submittedStatus = form.get("status") as string;
      if (!isOwner && current?.status === "closed") {
        error = t.admin.parties.errorClosedOrg;
      } else if (!isOwner && current?.status === "pending_approval" && submittedStatus === "active") {
        error = t.admin.parties.errorPendingApprovalOrg;
      } else {
        const submittedLang = form.get("lang") as string;
        const result = await updateParty(supabase, id!, {
          name: form.get("name") as string,
          slug: resolveSlug(form.get("slug") as string, form.get("name") as string),
          company_name: (form.get("company_name") as string) || undefined,
          company_ico: (form.get("company_ico") as string) || undefined,
          vat_number: (form.get("vat_number") as string) || undefined,
          billing_email: (form.get("billing_email") as string) || undefined,
          status: submittedStatus,
          lang: submittedLang === "en" ? "en" : "cs",
        });
        if (result.error) { error = result.error.message; }
        else { success = t.admin.parties.updatedSuccess; }
      }
    }
  } else if (action === "update_fee_schedule") {
    if (!canManageSettings) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      // Blank input = clear the override and fall back to the platform default. Rates are entered
      // as percentages in the UI and stored as fractions (10 -> 0.10). resolveFeeSchedule reads
      // NULL as "use global", so an empty field must become NULL, not 0.
      const parsePct = (raw: string): number | null | undefined => {
        const v = raw.trim();
        if (v === "") return null;
        const n = Number(v.replace(",", "."));
        if (!Number.isFinite(n) || n < 0 || n > 100) return undefined; // invalid
        return Math.round((n / 100) * 10000) / 10000;
      };
      const parseKc = (raw: string): number | null | undefined => {
        const v = raw.trim();
        if (v === "") return null;
        const n = Number(v.replace(/\s/g, "").replace(",", "."));
        if (!Number.isFinite(n) || n < 0) return undefined;
        return Math.round(n * 100) / 100;
      };
      const rate = parsePct(form.get("commission_rate_pct") as string);
      const reduced = parsePct(form.get("reduced_commission_rate_pct") as string);
      const threshold = parseKc(form.get("commission_threshold_kc") as string);
      if (rate === undefined || reduced === undefined || threshold === undefined) {
        error = t.admin.parties.feeSchedule.errorInvalid;
      } else {
        const result = await updateParty(supabase, id!, {
          commission_rate_override: rate,
          reduced_commission_rate_override: reduced,
          commission_threshold_override: threshold,
        });
        if (result.error) { error = result.error.message; }
        else { success = t.admin.parties.feeSchedule.savedSuccess; }
      }
    }
  } else if (action === "invite") {
    if (!canManageUsers) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      const email = (form.get("email") as string).trim().toLowerCase();
      const roleId = form.get("role_id") as string;
      const rawSystemRole = form.get("system_role") as string;
      const systemRole = rawSystemRole ? Number(rawSystemRole) : null;
      const validSystemRole = systemRole && canAssignRole(myRole, systemRole) ? systemRole : null;
      const adminOnly = validSystemRole === ROLE.ADMIN;

      const origin = new URL(Astro.request.url).origin;
      const adminClient = createAdminClient();

      const { data: senderProf } = await supabase.from("profiles").select("lang").eq("id", session.user.id).single();
      // New users have no profile/lang yet, so the inviter's own language is the best
      // available signal for that path. Existing users already have their own saved
      // preference — that always wins over whatever language the inviter happens to use.
      const inviterLang: 'cs' | 'en' = senderProf?.lang === 'en' ? 'en' : 'cs';
      const partyName = ctx.parties.find(p => p.id === id)?.name ?? id!;

      let inviteRoleName = '';
      let inviteRolePerms = 0;
      if (!adminOnly && roleId) {
        const { data: roleRow } = await supabase.from("roles").select("name, permissions").eq("id", roleId).single();
        if (roleRow) { inviteRoleName = roleRow.name; inviteRolePerms = Number(roleRow.permissions); }
      }

      const existingUser = await findUserByEmail(supabase, email);
      if (existingUser) {
        const { data: memberships } = await adminClient.from("user_party_roles").select("party_id").eq("user_id", existingUser.id);
        const memberPartyIds = (memberships ?? []).map((m) => m.party_id);

        if (existingUser.role < ROLE.ADMIN && memberPartyIds.some(pid => pid !== id)) {
          error = t.admin.parties.errorUserInOtherOrg;
        }

        if (!error && !adminOnly && roleId) {
          const result = await inviteUserToParty(supabase, existingUser.id, id!, roleId, session.user.id);
          if (result.error) { error = result.error.message; }
        }

        if (!error) {
          if (validSystemRole) {
            await supabase.from("profiles").update({ role: validSystemRole }).eq("id", existingUser.id);
          }
          const allPartyIds = [...new Set([...memberPartyIds, id!])];
          const { data: partyRows } = await adminClient.from("parties").select("name").in("id", allPartyIds);
          const orgNames = (partyRows ?? []).map((p) => p.name);
          const emailLang: 'cs' | 'en' = existingUser.lang === 'en' ? 'en' : 'cs';
          try {
            await sendPartyInvitation({ to: email, lang: emailLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms, inviteLink: null, userOrganizations: orgNames, siteUrl: origin });
          } catch (e) { console.error('[invite] email send failed:', e); }
          return Astro.redirect(`/admin/parties/${id}`);
        }
      } else {
        const authData = {
          ...(!adminOnly && roleId ? { pending_party_id: id, pending_role_id: roleId } : {}),
          invited_by: session.user.id,
          ...(validSystemRole ? { pending_system_role: validSystemRole } : {}),
        };
        if (!import.meta.env.RESEND_API_KEY) {
          // Dev: inviteUserByEmail → GoTrue renders supabase/templates/invite.html → Mailpit
          const emailMeta = buildDevInviteMetadata({ lang: inviterLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms });
          const { error: inviteErr } = await adminClient.auth.admin.inviteUserByEmail(email, {
            redirectTo: `${origin}/auth/callback`,
            data: { ...authData, ...emailMeta },
          });
          if (inviteErr) { error = inviteErr.message; }
          else { success = t.admin.parties.inviteSentPrefix + email + t.admin.parties.inviteSentSuffix; }
        } else {
          // Prod: generateLink + styled Resend email
          const { data: linkData, error: linkErr } = await adminClient.auth.admin.generateLink({
            type: 'invite', email,
            options: { redirectTo: `${origin}/auth/callback`, data: authData },
          });
          if (linkErr) {
            error = linkErr.message;
          } else {
            const inviteLink = (linkData as { properties?: { action_link?: string } })?.properties?.action_link ?? null;
            try {
              await sendPartyInvitation({ to: email, lang: inviterLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms, inviteLink, userOrganizations: [partyName], siteUrl: origin });
            } catch (e) { console.error('[invite] email send failed:', e); }
            success = t.admin.parties.inviteSentPrefix + email + t.admin.parties.inviteSentSuffix;
          }
        }
      }
    }
  } else if (action === "accept_commission_agreement") {
    if (!canManageSettings) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else if (!form.get("terms_accepted")) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      const result = await acceptCommissionaireAgreement(supabase, id!, {
        legal_full_name: form.get("legal_full_name") as string,
        address_line1: form.get("address_line1") as string,
        address_city: form.get("address_city") as string,
        address_postal_code: form.get("address_postal_code") as string,
        bank_account: form.get("bank_account") as string,
        personal_id_note: (form.get("personal_id_note") as string) || undefined,
        accepted_by: session.user.id,
      });
      if (result.error) { error = result.error.message; }
      else { success = t.admin.parties.updatedSuccess; }
    }
  } else if (action === "revoke_commission_agreement") {
    if (!canManageSettings) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      const result = await revokeCommissionaireAgreement(supabase, id!);
      if (result.error) { error = result.error.message; }
      else { success = t.admin.parties.updatedSuccess; }
    }
  } else if (action === "approve_party") {
    if (!isOwner) {
      error = t.admin.parties.errorPendingApprovalOrg;
    } else {
      const result = await updateParty(supabase, id!, { status: "active" });
      if (result.error) { error = result.error.message; }
      else { success = t.admin.parties.approvedSuccess; }
    }
  } else if (action === "remove") {
    if (!canManageUsers) {
      error = t.admin.parties.errorInsufficientPermissions;
    } else {
      const userId = form.get("user_id") as string;
      await removeUserFromParty(supabase, userId, id!);
      return Astro.redirect(`/admin/parties/${id}`);
    }
  }
}

const party = await fetchParty(supabase, id!);
if (!party) return Astro.redirect("/admin/parties");

const partyProductsPage = Math.max(1, parseInt(new URL(Astro.request.url).searchParams.get("products_page") ?? "1", 10));
const partyProductsPageSize = 20;

const [members, allRoles, commissionAgreement, partyProductsResult] = await Promise.all([
  fetchPartyMembers(supabase, id!),
  fetchRoles(supabase),
  canManageSettings ? fetchCommissionaireAgreement(supabase, id!) : Promise.resolve(null),
  fetchProducts(supabase, id!, { page: partyProductsPage, pageSize: partyProductsPageSize }),
]);
const roles = allRoles.filter(r => !r.is_system);
const partyProducts = partyProductsResult.data;
const partyProductsTotal = partyProductsResult.total;
const partyProductsTotalPages = Math.ceil(partyProductsTotal / partyProductsPageSize);

function partyProductStatusClass(s: string) {
  return s === "active" ? "badge-active" : s === "draft" ? "badge-draft" : "badge-inactive";
}
function partyProductStatusLabel(s: string) {
  return s === "active" ? t.common.active : s === "draft" ? t.common.draft : t.common.inactive;
}
const partyStockColors = {
  muted: "var(--text-muted)",
  error: "var(--error)",
  warning: "var(--warning)",
  success: "var(--success)",
} as const;
type PartyStockVariant = keyof typeof partyStockColors;
function partyStockDisplay(stock: number | null): { variant: PartyStockVariant; label: string } {
  if (stock === null) return { variant: "muted", label: t.admin.products.noStockTracking };
  if (stock <= 0) return { variant: "error", label: t.admin.products.outOfStock };
  if (stock <= 10) return { variant: "warning", label: `${stock} ${t.admin.products.inStock}` };
  return { variant: "success", label: `${stock} ${t.admin.products.inStock}` };
}

// Fee-schedule editor: inputs show the party's override when set, otherwise blank with the
// global default as placeholder. Rates are percentages in the UI, fractions in the DB.
const isOwnCompany = party.seller_mode === SELLER_MODE.OWN_COMPANY;
const pctValue = (v: number | null) => (v === null || v === undefined ? "" : String(Math.round(Number(v) * 1000000) / 10000));
const feeSchedule = {
  ratePct: pctValue(party.commission_rate_override),
  reducedPct: pctValue(party.reduced_commission_rate_override),
  thresholdKc: party.commission_threshold_override === null || party.commission_threshold_override === undefined
    ? "" : String(Number(party.commission_threshold_override)),
  defRatePct: String(COMMISSION_RATE * 100),
  defReducedPct: String(REDUCED_COMMISSION_RATE * 100),
  defThresholdKc: COMMISSION_REDUCED_THRESHOLD_CZK.toLocaleString("cs-CZ"),
};

function roleName(roleId: string) {
  return allRoles.find((r) => r.id === roleId)?.name ?? roleId.slice(0, 8);
}
---

<CmsLayout title={party.name} userPermissions={permissions} currentPath="/admin/parties" parties={ctx.parties} partyId={ctx.partyId}>
  <a href="/admin/parties" class="back-link">{t.admin.parties.back}</a>
  {error && <div class="alert-error">{error}</div>}
  {success && <div class="alert-success">{success}</div>}

  {Astro.url.searchParams.get("onboarding") === "1" && party.status !== "pending_approval" && (
    <div class="alert-success onboarding-cta">
      🎉 <a href="/admin/onboarding/tutorial">{t.admin.onboardingWizard.tutorialTitle}</a>
    </div>
  )}

  {party.status === "pending_approval" && isOwner && (
    <div class="pending-banner">
      <p>{t.admin.parties.pendingApprovalOwnerBanner}</p>
      <form method="POST" onsubmit={`return confirm('${t.admin.parties.approveConfirm}')`}>
        <input type="hidden" name="action" value="approve_party" />
        <button type="submit" class="btn btn-primary">{t.admin.parties.approveBtn}</button>
      </form>
    </div>
  )}
  {party.status === "pending_approval" && !isOwner && (
    <div class="pending-banner">
      <p>{t.admin.parties.pendingApprovalCreatorBanner}</p>
      {Astro.url.searchParams.get("onboarding") === "1" && (
        <a href="/admin/onboarding/tutorial" class="btn btn-secondary">{t.admin.onboardingWizard.tutorialTitle}</a>
      )}
    </div>
  )}

  <div class="party-grid">
    <div>
      {canManageSettings && (
        <Fragment>
        <div class="card">
          <h2 class="section-title">{t.admin.parties.sectionInfo}</h2>
          <form method="POST" class="edit-form">
            <input type="hidden" name="action" value="update_party" />
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldName}</label>
              <input class="form-input" name="name" required value={party.name} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldCompany}</label>
              <input class="form-input" name="company_name" value={party.company_name ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.onboarding.fieldIco}</label>
              <input class="form-input" name="company_ico" value={party.company_ico ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldVat}</label>
              <input class="form-input" name="vat_number" value={party.vat_number ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldBillingEmail}</label>
              <input class="form-input" type="email" name="billing_email" value={party.billing_email ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldLang}</label>
              <select class="form-input" name="lang">
                <option value="cs" selected={party.lang === "cs"}>{t.settings.labelCs}</option>
                <option value="en" selected={party.lang === "en"}>{t.settings.labelEn}</option>
              </select>
              <p class="section-note" style="margin:2px 0 0">{t.admin.parties.fieldLangNote}</p>
            </div>
            <SlugInput sourceName="name" label={t.admin.parties.fieldSlug} value={party.slug} hint={t.common.slugAutoHint} />
            <div class="form-group">
              <label class="form-label" for="status">{t.admin.parties.fieldStatus}</label>
              {!isOwner && party.status === 'closed' && (
                <>
                  <p class="status-locked">{t.admin.parties.statusClosedReadonly}</p>
                  <input type="hidden" name="status" value={party.status} />
                </>
              )}
              {!isOwner && party.status === 'pending_approval' && (
                <>
                  <p class="status-locked">{t.admin.parties.pendingApprovalReadonly}</p>
                  <input type="hidden" name="status" value={party.status} />
                </>
              )}
              {(isOwner || (party.status !== 'closed' && party.status !== 'pending_approval')) && (
                <select class="form-input" name="status" id="status">
                  <option value="active" selected={party.status === 'active'}>{t.admin.parties.statusActive}</option>
                  <option value="inactive" selected={party.status === 'inactive'}>{t.admin.parties.statusInactive}</option>
                  {isOwner && <option value="closed" selected={party.status === 'closed'}>{t.admin.parties.statusClosed}</option>}
                  {party.status === 'pending_approval' && <option value="pending_approval" selected>{t.admin.parties.statusPendingApproval}</option>}
                </select>
              )}
            </div>
            <div class="form-meta">
              <span class="meta-label">{t.admin.parties.fieldCreated}</span>
              <span>{new Date(party.created_at).toLocaleDateString(lang)}</span>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:4px">{t.common.saveChanges}</button>
          </form>
        </div>
        <PartySellerModeCard party={party} agreement={commissionAgreement} lang={lang} t={t} />
        {isOwnCompany && (
          <div class="card" style="margin-top:16px">
            <h2 class="section-title">{t.admin.parties.feeSchedule.title}</h2>
            <p class="invite-note">{t.admin.parties.feeSchedule.hint}</p>
            <form method="POST" class="party-form">
              <input type="hidden" name="action" value="update_fee_schedule" />
              <div class="form-row">
                <label class="form-label" for="commission_rate_pct">{t.admin.parties.feeSchedule.standardRateLabel}</label>
                <div class="fee-input-wrap">
                  <input class="form-input" type="number" step="0.01" min="0" max="100" name="commission_rate_pct"
                    id="commission_rate_pct" value={feeSchedule.ratePct}
                    placeholder={`${feeSchedule.defRatePct} (${t.admin.parties.feeSchedule.defaultTag})`} />
                  <span class="fee-suffix">%</span>
                </div>
              </div>
              <div class="form-row">
                <label class="form-label" for="reduced_commission_rate_pct">{t.admin.parties.feeSchedule.reducedRateLabel}</label>
                <div class="fee-input-wrap">
                  <input class="form-input" type="number" step="0.01" min="0" max="100" name="reduced_commission_rate_pct"
                    id="reduced_commission_rate_pct" value={feeSchedule.reducedPct}
                    placeholder={`${feeSchedule.defReducedPct} (${t.admin.parties.feeSchedule.defaultTag})`} />
                  <span class="fee-suffix">%</span>
                </div>
              </div>
              <div class="form-row">
                <label class="form-label" for="commission_threshold_kc">{t.admin.parties.feeSchedule.thresholdLabel}</label>
                <div class="fee-input-wrap">
                  <input class="form-input" type="number" step="0.01" min="0" name="commission_threshold_kc"
                    id="commission_threshold_kc" value={feeSchedule.thresholdKc}
                    placeholder={`${feeSchedule.defThresholdKc} (${t.admin.parties.feeSchedule.defaultTag})`} />
                  <span class="fee-suffix">Kč</span>
                </div>
              </div>
              <p class="invite-note">{t.admin.parties.feeSchedule.clearNote}</p>
              <button type="submit" class="btn btn-primary" style="margin-top:4px">{t.common.saveChanges}</button>
            </form>
          </div>
        )}
        </Fragment>
      )}

      {canManageUsers && (
        <div class="card" style={canManageSettings ? "margin-top:16px" : ""}>
          <h2 class="section-title">{t.admin.parties.sectionInvite}</h2>
          <p class="invite-note">
            {t.admin.parties.inviteNote}
            {systemRoleOptions.length === 0 && (
              <>
                <br /><br />
                <strong>{t.admin.parties.inviteNoteExtra}</strong>{" "}
                <a href="/admin/users">{t.admin.sidebar.users}</a>{" "}
                {t.admin.parties.inviteNoteSuffix}
              </>
            )}
          </p>
          <form method="POST" class="invite-form">
            <input type="hidden" name="action" value="invite" />
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldEmail}</label>
              <input class="form-input" type="email" name="email" required placeholder={t.auth.emailPlaceholder} />
            </div>
            {systemRoleOptions.length > 0 && (
              <div class="form-group">
                <label class="form-label">{t.admin.parties.fieldSystemRole}</label>
                <select class="form-input system-role-select" name="system_role">
                  <option value="">{t.admin.parties.systemRoleNone}</option>
                  {systemRoleOptions.map(r => (
                    <option value={r}>{ROLE_LABEL[r as keyof typeof ROLE_LABEL]}</option>
                  ))}
                </select>
              </div>
            )}
            <div class="form-group party-role-group">
              <label class="form-label">
                {t.admin.parties.fieldRole}
                <span class="role-hint">{t.admin.parties.roleHint}</span>
              </label>
              <select class="form-input party-role-select" name="role_id">
                <option value="">{roles.length === 0 ? t.admin.parties.noRoles : t.admin.parties.selectRole}</option>
                {roles.map((r) => (
                  <option value={r.id}>
                    {r.name}{r.description ? ` — ${r.description}` : ""}
                  </option>
                ))}
              </select>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:4px">{t.admin.parties.sendInvite}</button>
          </form>
        </div>
      )}
    </div>

    <div style="display:flex;flex-direction:column;gap:24px;min-width:0">
      <div class="card" style="padding:0;overflow:hidden">
        <div style="padding:16px 16px 0;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap">
          <h2 class="section-title" style="margin-bottom:0">{t.admin.products.title} ({partyProductsTotal})</h2>
          <span class="total-label" style="font-size:13px;color:var(--text-muted)">{partyProductsTotal} {t.admin.products.title.toLowerCase()}</span>
        </div>
        <table class="data-table" style="margin-top:12px">
          <thead>
            <tr>
              <th></th>
              <th>{t.admin.products.colName}</th>
              <th>{t.admin.products.colSku}</th>
              <th>{t.admin.products.colStatus}</th>
              <th>{t.admin.products.colPrice}</th>
              <th>{t.admin.products.colStock}</th>
              <th>{t.admin.products.colActions}</th>
            </tr>
          </thead>
          <tbody>
            {partyProducts.map((p) => (
              <tr>
                <td class="thumb-cell">
                  {p.primaryImage ? (
                    p.primaryImageIsVideo ? (
                      <video src={`${p.primaryImage}#t=0.1`} class="thumb-img" muted playsinline preload="metadata" aria-label={p.title} />
                    ) : (
                      <img src={p.primaryImage} alt={p.title} class="thumb-img" />
                    )
                  ) : (
                    <div class="thumb-placeholder">{t.shop.noImage}</div>
                  )}
                </td>
                <td style="font-weight:600">{p.title}</td>
                <td style="color:var(--text-muted)">{p.sku ?? "—"}</td>
                <td><span class={`badge ${partyProductStatusClass(p.status)}`}>{partyProductStatusLabel(p.status)}</span></td>
                <td>{formatPrice(p.displayPrice, lang)}</td>
                <td>
                  {(() => {
                    const s = partyStockDisplay((p as any).stock ?? null);
                    return (
                      <span style={`color:${partyStockColors[s.variant]};${s.variant !== "muted" ? "font-weight:600" : ""}`}>
                        {s.label}
                      </span>
                    );
                  })()}
                </td>
                <td>
                  <a href={`/admin/products/${p.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.admin.products.edit}</a>
                </td>
              </tr>
            ))}
            {partyProducts.length === 0 && (
              <tr><td colspan="7" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.products.noProducts}</td></tr>
            )}
          </tbody>
        </table>
        {partyProductsTotalPages > 1 && (
          <div class="pagination" style="padding:12px 16px">
            {partyProductsPage > 1 && <a href={`?products_page=${partyProductsPage - 1}`} class="btn btn-ghost">{t.common.previous}</a>}
            <span class="page-info">{t.common.page} {partyProductsPage} {t.common.of} {partyProductsTotalPages} ({t.common.total} {partyProductsTotal})</span>
            {partyProductsPage < partyProductsTotalPages && <a href={`?products_page=${partyProductsPage + 1}`} class="btn btn-ghost">{t.common.next}</a>}
          </div>
        )}
      </div>

      <div class="card">
        <h2 class="section-title">{t.admin.parties.sectionMembers} ({members.length})</h2>
        <table class="data-table">
          <thead><tr><th>{t.admin.parties.colMemberName}</th><th>{t.admin.parties.colMemberEmail}</th><th>{t.admin.parties.colMemberRole}</th><th>{t.admin.parties.colJoined}</th><th></th></tr></thead>
          <tbody>
            {members.map((m) => (
              <tr>
                <td style="font-weight:600">{m.profile?.display_name ?? t.common.unnamed}</td>
                <td style="font-size:13px;color:var(--text-muted)">{m.profile?.email ?? "—"}</td>
                <td><span class="badge badge-pending">{roleName(m.role_id)}</span></td>
                <td style="font-size:12px;color:var(--text-muted)">{new Date(m.joined_at).toLocaleDateString(lang)}</td>
                <td>
                  {canManageUsers && m.user_id !== session.user.id && (
                    <form method="POST" onsubmit={`return confirm('${t.admin.parties.removeConfirm}')`} style="display:inline">
                      <input type="hidden" name="action" value="remove" />
                      <input type="hidden" name="user_id" value={m.user_id} />
                      <button type="submit" class="btn btn-danger" style="padding:4px 10px;font-size:12px">{t.admin.parties.removeBtn}</button>
                    </form>
                  )}
                </td>
              </tr>
            ))}
            {members.length === 0 && <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">{t.admin.parties.noMembers}</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</CmsLayout>

<script define:vars={{ ROLE_ADMIN: ROLE.ADMIN }}>
document.querySelectorAll('.system-role-select').forEach(sel => {
  const form = sel.closest('form');
  const roleGroup = form.querySelector('.party-role-group');
  const roleSelect = form.querySelector('.party-role-select');

  function sync() {
    const isAdmin = Number(sel.value) === ROLE_ADMIN;
    roleGroup.style.display = (isAdmin || !sel.value) ? 'none' : '';
    roleSelect.required = !isAdmin && roleSelect.options.length > 1;
  }
  sync();
  sel.addEventListener('change', sync);
});
</script>

