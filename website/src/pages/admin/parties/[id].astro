---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase, createAdminClient } from "../../../lib/supabase";
import { fetchParty, updateParty, fetchPartyMembers, inviteUserToParty, removeUserFromParty } from "@shared/services/partyService";
import { fetchRoles } from "@shared/services/permissionsService";
import { findUserByEmail } from "@shared/services/profileService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT } from "../../../lib/i18n";
import { PERMISSIONS, hasPermission, ROLE, ROLE_LABEL, assignableRoles, canAssignRole } from "@shared/constants/permissions";
import { sendPartyInvitation, buildDevInviteMetadata } from "../../../lib/integrations/email";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
const { permissions, isOwner } = ctx;
const t = useT(Astro);

const { id } = Astro.params;

// Non-owner users can only access parties they belong to.
if (!ctx.isOwner && !ctx.parties.some((p) => p.id === id)) {
  return Astro.redirect("/admin/parties");
}

const canManageUsers    = hasPermission(permissions, PERMISSIONS.MANAGE_USERS);
const canManageSettings = hasPermission(permissions, PERMISSIONS.MANAGE_AUDIT);
const myRole = ctx.role;
const systemRoleOptions = assignableRoles(myRole).filter(r => r >= ROLE.ESHOP_ADMIN && r < ROLE.OWNER);

if (!canManageUsers && !canManageSettings) return Astro.redirect("/admin");

let error = "";
let success = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;

  if (action === "update_party") {
    if (!canManageSettings) {
      error = "Insufficient permissions";
    } else {
      const { data: current } = await supabase.from("parties").select("status").eq("id", id!).single();
      if (!isOwner && current?.status === "closed") {
        error = t.admin.parties.errorClosedOrg;
      } else {
        const result = await updateParty(supabase, id!, {
          name: form.get("name") as string,
          company_name: (form.get("company_name") as string) || undefined,
          vat_number: (form.get("vat_number") as string) || undefined,
          billing_email: (form.get("billing_email") as string) || undefined,
          status: form.get("status") as string,
        });
        if (result.error) { error = result.error.message; }
        else { success = t.admin.parties.updatedSuccess; }
      }
    }
  } else if (action === "invite") {
    if (!canManageUsers) {
      error = "Insufficient permissions";
    } else {
      const email = (form.get("email") as string).trim().toLowerCase();
      const roleId = form.get("role_id") as string;
      const rawSystemRole = form.get("system_role") as string;
      const systemRole = rawSystemRole ? Number(rawSystemRole) : null;
      const validSystemRole = systemRole && canAssignRole(myRole, systemRole) ? systemRole : null;
      const adminOnly = validSystemRole === ROLE.ADMIN;

      const origin = new URL(Astro.request.url).origin;
      const adminClient = createAdminClient();

      const { data: senderProf } = await supabase.from("profiles").select("lang").eq("id", session.user.id).single();
      const emailLang: 'cs' | 'en' = senderProf?.lang === 'en' ? 'en' : 'cs';
      const partyName = ctx.parties.find(p => p.id === id)?.name ?? id!;

      let inviteRoleName = '';
      let inviteRolePerms = 0;
      if (!adminOnly && roleId) {
        const { data: roleRow } = await supabase.from("roles").select("name, permissions").eq("id", roleId).single();
        if (roleRow) { inviteRoleName = roleRow.name; inviteRolePerms = Number(roleRow.permissions); }
      }

      const existingUser = await findUserByEmail(supabase, email);
      if (existingUser) {
        const { data: memberships } = await adminClient.from("user_party_roles").select("party_id").eq("user_id", existingUser.id);
        const memberPartyIds = (memberships ?? []).map((m) => m.party_id);

        if (existingUser.role < ROLE.ADMIN && memberPartyIds.some(pid => pid !== id)) {
          error = t.admin.parties.errorUserInOtherOrg;
        }

        if (!error && !adminOnly && roleId) {
          const result = await inviteUserToParty(supabase, existingUser.id, id!, roleId, session.user.id);
          if (result.error) { error = result.error.message; }
        }

        if (!error) {
          if (validSystemRole) {
            await supabase.from("profiles").update({ role: validSystemRole }).eq("id", existingUser.id);
          }
          const allPartyIds = [...new Set([...memberPartyIds, id!])];
          const { data: partyRows } = await adminClient.from("parties").select("name").in("id", allPartyIds);
          const orgNames = (partyRows ?? []).map((p) => p.name);
          try {
            await sendPartyInvitation({ to: email, lang: emailLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms, inviteLink: null, userOrganizations: orgNames, siteUrl: origin });
          } catch (e) { console.error('[invite] email send failed:', e); }
          return Astro.redirect(`/admin/parties/${id}`);
        }
      } else {
        const authData = {
          ...(!adminOnly && roleId ? { pending_party_id: id, pending_role_id: roleId } : {}),
          invited_by: session.user.id,
          ...(validSystemRole ? { pending_system_role: validSystemRole } : {}),
        };
        if (!import.meta.env.RESEND_API_KEY) {
          // Dev: inviteUserByEmail → GoTrue renders supabase/templates/invite.html → Mailpit
          const emailMeta = buildDevInviteMetadata({ lang: emailLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms });
          const { error: inviteErr } = await adminClient.auth.admin.inviteUserByEmail(email, {
            redirectTo: `${origin}/auth/callback`,
            data: { ...authData, ...emailMeta },
          });
          if (inviteErr) { error = inviteErr.message; }
          else { success = t.admin.parties.inviteSentPrefix + email + t.admin.parties.inviteSentSuffix; }
        } else {
          // Prod: generateLink + styled Resend email
          const { data: linkData, error: linkErr } = await adminClient.auth.admin.generateLink({
            type: 'invite', email,
            options: { redirectTo: `${origin}/auth/callback`, data: authData },
          });
          if (linkErr) {
            error = linkErr.message;
          } else {
            const inviteLink = (linkData as { properties?: { action_link?: string } })?.properties?.action_link ?? null;
            try {
              await sendPartyInvitation({ to: email, lang: emailLang, partyName, roleName: inviteRoleName, systemRole: validSystemRole, rolePermissions: inviteRolePerms, inviteLink, userOrganizations: [partyName], siteUrl: origin });
            } catch (e) { console.error('[invite] email send failed:', e); }
            success = t.admin.parties.inviteSentPrefix + email + t.admin.parties.inviteSentSuffix;
          }
        }
      }
    }
  } else if (action === "remove") {
    if (!canManageUsers) {
      error = "Insufficient permissions";
    } else {
      const userId = form.get("user_id") as string;
      await removeUserFromParty(supabase, userId, id!);
      return Astro.redirect(`/admin/parties/${id}`);
    }
  }
}

const party = await fetchParty(supabase, id!);
if (!party) return Astro.redirect("/admin/parties");

const [members, allRoles] = await Promise.all([
  fetchPartyMembers(supabase, id!),
  fetchRoles(supabase),
]);
const roles = allRoles.filter(r => !r.is_system);

function roleName(roleId: string) {
  return allRoles.find((r) => r.id === roleId)?.name ?? roleId.slice(0, 8);
}
---

<CmsLayout title={party.name} userPermissions={permissions} currentPath="/admin/parties" parties={ctx.parties} partyId={ctx.partyId}>
  <a href="/admin/parties" class="back-link">{t.admin.parties.back}</a>
  {error && <div class="alert-error">{error}</div>}
  {success && <div class="alert-success">{success}</div>}

  <div class="party-grid">
    <div>
      {canManageSettings && (
        <div class="card">
          <h2 class="section-title">{t.admin.parties.sectionInfo}</h2>
          <form method="POST" class="edit-form">
            <input type="hidden" name="action" value="update_party" />
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldName}</label>
              <input class="form-input" name="name" required value={party.name} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldCompany}</label>
              <input class="form-input" name="company_name" value={party.company_name ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldVat}</label>
              <input class="form-input" name="vat_number" value={party.vat_number ?? ""} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldBillingEmail}</label>
              <input class="form-input" type="email" name="billing_email" value={party.billing_email ?? ""} />
            </div>
            <div class="form-row-inline">
              <label class="form-label">{t.admin.parties.fieldSlug}</label>
              <code>{party.slug}</code>
            </div>
            <div class="form-group">
              <label class="form-label" for="status">{t.admin.parties.fieldStatus}</label>
              {!isOwner && party.status === 'closed'
                ? <p class="status-locked">{t.admin.parties.statusClosedReadonly}</p>
                : (
                  <select class="form-input" name="status" id="status">
                    <option value="active" selected={party.status === 'active'}>{t.admin.parties.statusActive}</option>
                    <option value="inactive" selected={party.status === 'inactive'}>{t.admin.parties.statusInactive}</option>
                    {isOwner && <option value="closed" selected={party.status === 'closed'}>{t.admin.parties.statusClosed}</option>}
                  </select>
                )
              }
            </div>
            <div class="form-meta">
              <span class="meta-label">{t.admin.parties.fieldCreated}</span>
              <span>{new Date(party.created_at).toLocaleDateString()}</span>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:4px">{t.common.saveChanges}</button>
          </form>
        </div>
      )}

      {canManageUsers && (
        <div class="card" style={canManageSettings ? "margin-top:16px" : ""}>
          <h2 class="section-title">{t.admin.parties.sectionInvite}</h2>
          <p class="invite-note">
            {t.admin.parties.inviteNote}
            {systemRoleOptions.length === 0 && (
              <>
                <br /><br />
                <strong>{t.admin.parties.inviteNoteExtra}</strong>{" "}
                <a href="/admin/users">{t.admin.sidebar.users}</a>{" "}
                {t.admin.parties.inviteNoteSuffix}
              </>
            )}
          </p>
          <form method="POST" class="invite-form">
            <input type="hidden" name="action" value="invite" />
            <div class="form-group">
              <label class="form-label">{t.admin.parties.fieldEmail}</label>
              <input class="form-input" type="email" name="email" required placeholder={t.auth.emailPlaceholder} />
            </div>
            {systemRoleOptions.length > 0 && (
              <div class="form-group">
                <label class="form-label">{t.admin.parties.fieldSystemRole}</label>
                <select class="form-input system-role-select" name="system_role">
                  <option value="">{t.admin.parties.systemRoleNone}</option>
                  {systemRoleOptions.map(r => (
                    <option value={r}>{ROLE_LABEL[r as keyof typeof ROLE_LABEL]}</option>
                  ))}
                </select>
              </div>
            )}
            <div class="form-group party-role-group">
              <label class="form-label">
                {t.admin.parties.fieldRole}
                <span class="role-hint">{t.admin.parties.roleHint}</span>
              </label>
              <select class="form-input party-role-select" name="role_id">
                <option value="">{roles.length === 0 ? t.admin.parties.noRoles : t.admin.parties.selectRole}</option>
                {roles.map((r) => (
                  <option value={r.id}>
                    {r.name}{r.description ? ` — ${r.description}` : ""}
                  </option>
                ))}
              </select>
            </div>
            <button type="submit" class="btn btn-primary" style="margin-top:4px">{t.admin.parties.sendInvite}</button>
          </form>
        </div>
      )}
    </div>

    <div class="card">
      <h2 class="section-title">{t.admin.parties.sectionMembers} ({members.length})</h2>
      <table class="data-table">
        <thead><tr><th>{t.admin.parties.colMemberName}</th><th>{t.admin.parties.colMemberEmail}</th><th>{t.admin.parties.colMemberRole}</th><th>{t.admin.parties.colJoined}</th><th></th></tr></thead>
        <tbody>
          {members.map((m) => (
            <tr>
              <td style="font-weight:600">{m.profile?.display_name ?? t.common.unnamed}</td>
              <td style="font-size:13px;color:var(--text-muted)">{m.profile?.email ?? "—"}</td>
              <td><span class="badge badge-pending">{roleName(m.role_id)}</span></td>
              <td style="font-size:12px;color:var(--text-muted)">{new Date(m.joined_at).toLocaleDateString()}</td>
              <td>
                {canManageUsers && m.user_id !== session.user.id && (
                  <form method="POST" onsubmit={`return confirm('${t.admin.parties.removeConfirm}')`} style="display:inline">
                    <input type="hidden" name="action" value="remove" />
                    <input type="hidden" name="user_id" value={m.user_id} />
                    <button type="submit" class="btn btn-danger" style="padding:4px 10px;font-size:12px">{t.admin.parties.removeBtn}</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
          {members.length === 0 && <tr><td colspan="5" style="text-align:center;padding:24px;color:var(--text-muted)">{t.admin.parties.noMembers}</td></tr>}
        </tbody>
      </table>
    </div>
  </div>
</CmsLayout>

<script define:vars={{ ROLE_ADMIN: ROLE.ADMIN }}>
document.querySelectorAll('.system-role-select').forEach(sel => {
  const form = sel.closest('form');
  const roleGroup = form.querySelector('.party-role-group');
  const roleSelect = form.querySelector('.party-role-select');

  function sync() {
    const isAdmin = Number(sel.value) === ROLE_ADMIN;
    roleGroup.style.display = (isAdmin || !sel.value) ? 'none' : '';
    roleSelect.required = !isAdmin && roleSelect.options.length > 1;
  }
  sync();
  sel.addEventListener('change', sync);
});
</script>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .alert-success { background:rgba(34,197,94,0.08); border:1px solid #22c55e; border-radius:8px; padding:12px 16px; color:#16a34a; margin-bottom:16px; font-size:14px; }
  .party-grid { display:grid; grid-template-columns:1fr 2fr; gap:24px; }
  .section-title { font-size:15px; font-weight:700; margin-bottom:16px; }
  .edit-form { display:flex; flex-direction:column; gap:12px; }
  .form-group { display:flex; flex-direction:column; gap:4px; }
  .form-label { font-size:12px; font-weight:600; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; }
  .form-row-inline { display:flex; justify-content:space-between; align-items:center; font-size:14px; padding:4px 0; border-bottom:1px solid var(--border-default); }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-meta { display:flex; justify-content:space-between; font-size:13px; color:var(--text-muted); }
  .meta-label { font-weight:600; }
  .invite-form { display:flex; flex-direction:column; gap:12px; }
  .invite-note { font-size:13px; color:var(--text-muted); line-height:1.6; margin-bottom:12px; padding:10px 12px; background:var(--bg-subtle); border-radius:8px; border-left:3px solid var(--primary); }
  .invite-note a { color:var(--primary); font-weight:600; }
  .role-hint { font-weight:400; font-style:italic; color:var(--text-muted); }
  code { font-family:monospace; font-size:13px; background:var(--bg-subtle); padding:2px 6px; border-radius:4px; }
  .status-locked { font-size:13px; color:var(--text-muted); padding:8px 10px; background:var(--bg-subtle); border-radius:var(--radius-sm); border:1px solid var(--border-default); }
  @media(max-width:768px) { .party-grid { grid-template-columns:1fr; } }
</style>
