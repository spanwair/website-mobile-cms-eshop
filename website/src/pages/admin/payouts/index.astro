---
import CmsLayout from "@/components/cms/CmsLayout.astro";
import PayoutsTabs from "@/components/cms/PayoutsTabs.astro";
import OrderLedgerModal from "@/components/admin/OrderLedgerModal.astro";
import type { LedgerOrderRow } from "@/lib/payoutsTypes";
import { createSupabase } from "@/lib/supabase";
import { requireAdminCtx } from "@/lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT, getLang } from "@/lib/i18n";
import { SELLER_MODE, NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK } from "@shared/constants/sellerMode";
import { listBillingPeriodsForParties } from "@shared/services/billingPeriodService";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_AUDIT)) return Astro.redirect("/admin");
const t = useT(Astro);
const lang = getLang(Astro);
const pt = t.admin.payouts;

// Lists EVERY store this admin can see (owner: all parties, admin: assigned parties) — not
// just whichever one the party switcher currently has active. Paying out one store never
// requires switching into it first.
const partyIds = ctx.parties.map((p) => p.id);

let error = "";
let success = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action");

  if (action === "mark_paid_batch") {
    const formPartyId = (form.get("party_id") as string) ?? "";
    const ledgerIds = form.getAll("ledger_id").map(String).filter(Boolean);
    const payoutReference = (form.get("payout_reference") as string)?.trim() || null;
    // Guard against a crafted request paying out a party this admin can't see — mirrors the
    // RLS policy on order_commission_ledger (is_owner() OR MANAGE_AUDIT on that party), kept
    // here too so a disallowed party fails loudly instead of silently no-op'ing via RLS.
    const partyAllowed = ctx.parties.some((p) => p.id === formPartyId);
    if (partyAllowed && ledgerIds.length > 0) {
      const { error: updateErr } = await supabase
        .from("order_commission_ledger")
        .update({ status: "paid", paid_at: new Date().toISOString(), paid_by: session.user.id, payout_reference: payoutReference })
        .eq("party_id", formPartyId)
        .eq("status", "held")
        .lte("hold_until", new Date().toISOString())
        .in("id", ledgerIds);
      if (updateErr) error = updateErr.message;
      else success = `${pt.batchMarkPaidBtn} (${ledgerIds.length})`;
    }
  }
}

const status = Astro.url.searchParams.get("status") === "paid" ? "paid" : "unpaid";

function fmt(n: number) {
  return n.toLocaleString(lang === "en" ? "en-US" : "cs-CZ", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " Kč";
}

const now = Date.now();
const monthStart = new Date(Date.UTC(new Date().getUTCFullYear(), new Date().getUTCMonth(), 1)).toISOString();

const { data: partyRows } = partyIds.length > 0
  ? await supabase.from("parties").select("id, seller_mode").in("id", partyIds)
  : { data: [] };
const sellerModeByParty = new Map((partyRows ?? []).map((p) => [p.id, p.seller_mode]));

const { data: ledgerRows } = partyIds.length > 0
  ? await supabase
      .from("order_commission_ledger")
      .select("*, order:orders(order_number)")
      .in("party_id", partyIds)
      .eq("status", status === "paid" ? "paid" : "held")
      .order(status === "paid" ? "paid_at" : "created_at", { ascending: false })
      .limit(2000)
  : { data: [] };

const { data: reversedRows } = partyIds.length > 0
  ? await supabase.from("order_commission_ledger").select("party_id").in("party_id", partyIds).eq("status", "reversed")
  : { data: [] };

const { data: monthRows } = partyIds.length > 0
  ? await supabase
      .from("order_commission_ledger")
      .select("party_id, net_payable")
      .in("party_id", partyIds)
      .neq("status", "reversed")
      .gte("created_at", monthStart)
  : { data: [] };

const statementsByParty = await listBillingPeriodsForParties(supabase, partyIds, 12);

interface StoreGroup {
  partyId: string;
  partyName: string;
  isCommission: boolean;
  orders: LedgerOrderRow[];
  eligibleIds: string[];
  unpaidTotal: number;
  eligibleTotal: number;
  withheldTotal: number;
  paidTotal: number;
  payoutThisMonth: number;
  reversedCount: number;
}

const stores: StoreGroup[] = ctx.parties.map((party) => {
  const rowsForParty = (ledgerRows ?? []).filter((e: any) => e.party_id === party.id);
  const orders: LedgerOrderRow[] = rowsForParty.map((e: any) => ({
    id: e.id,
    orderNumber: e.order?.order_number ?? e.order_id.slice(0, 8),
    date: status === "paid" ? (e.paid_at ?? e.created_at) : e.created_at,
    gross: Number(e.gross_amount),
    tax: Number(e.tax_amount),
    commission: Number(e.commission_amount),
    net: Number(e.net_payable),
    withheld: Number(e.withheld_amount ?? 0),
    holdUntil: e.hold_until,
    computedStatus: status === "paid" ? "paid" : new Date(e.hold_until).getTime() <= now ? "eligible" : "held",
    paidAt: e.paid_at,
    payoutReference: e.payout_reference,
  }));
  const eligibleIds = orders.filter((o) => o.computedStatus === "eligible").map((o) => o.id);

  return {
    partyId: party.id,
    partyName: party.name,
    isCommission: sellerModeByParty.get(party.id) === SELLER_MODE.SMALLJOBS_COMMISSION,
    orders,
    eligibleIds,
    unpaidTotal: orders.reduce((sum, o) => sum + o.net, 0),
    eligibleTotal: orders.filter((o) => o.computedStatus === "eligible").reduce((sum, o) => sum + o.net, 0),
    withheldTotal: orders.reduce((sum, o) => sum + o.withheld, 0),
    paidTotal: orders.reduce((sum, o) => sum + o.net, 0),
    payoutThisMonth: (monthRows ?? []).filter((r: any) => r.party_id === party.id).reduce((sum, r: any) => sum + Number(r.net_payable), 0),
    reversedCount: (reversedRows ?? []).filter((r: any) => r.party_id === party.id).length,
  };
});
---

<CmsLayout title={pt.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId} isOwner={ctx.isOwner}>
  <p class="content-hint">{pt.hint}</p>
  {error && <div class="alert-error">{error}</div>}
  {success && <div class="alert-success">{success}</div>}

  <PayoutsTabs active={status} />

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr>
          <th>{t.admin.billing.colParty}</th>
          {status === "unpaid" ? (
            <>
              <th>{pt.summaryUnpaidTotal}</th>
              <th>{pt.summaryReadyTotal}</th>
            </>
          ) : (
            <th>{pt.summaryPaidTotal}</th>
          )}
          <th>{t.admin.billing.colActions}</th>
        </tr>
      </thead>
      <tbody>
        {stores.map((store) => (
          <tr>
            <td style="font-weight:600">
              {store.partyName}
              {store.reversedCount > 0 && <div class="muted">{store.reversedCount} {pt.reversedFootnote}</div>}
            </td>
            {status === "unpaid" ? (
              <>
                <td>
                  <div class="progress-line">{fmt(store.unpaidTotal)}</div>
                  {store.isCommission && (
                    <>
                      <div class="cap-bar"><div class="cap-bar-fill" style={`width:${Math.min((store.payoutThisMonth / NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK) * 100, 100)}%`}></div></div>
                      <div class="muted">{pt.payoutProgressLabel}: {fmt(store.payoutThisMonth)} {pt.capProgressOf} {fmt(NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK)}</div>
                      {store.withheldTotal > 0 && <div class="withheld-note">{pt.summaryWithheld}: {fmt(store.withheldTotal)}</div>}
                    </>
                  )}
                </td>
                <td>
                  {store.eligibleIds.length > 0 ? (
                    <span class="outstanding">{fmt(store.eligibleTotal)} <span class="muted">({store.eligibleIds.length} {pt.countOrdersSuffix})</span></span>
                  ) : (
                    <span class="muted">{pt.noneEligibleYet}</span>
                  )}
                </td>
              </>
            ) : (
              <td><span class="outstanding">{fmt(store.paidTotal)}</span></td>
            )}
            <td>
              <div class="actions-cell">
                <button type="button" class="btn btn-secondary" style="padding:4px 10px;font-size:12px" data-ol-open={store.partyId}>{pt.viewOrdersBtn} ({store.orders.length} {pt.countOrdersSuffix})</button>
                {status === "unpaid" && store.eligibleIds.length > 0 && (
                  <form method="POST" class="pay-form" onsubmit={`return confirm('${pt.batchMarkPaidConfirm}')`}>
                    <input type="hidden" name="action" value="mark_paid_batch" />
                    <input type="hidden" name="party_id" value={store.partyId} />
                    {store.eligibleIds.map((id) => <input type="hidden" name="ledger_id" value={id} />)}
                    <input class="form-input" name="payout_reference" placeholder={pt.fieldPayoutReference} style="padding:4px 8px;font-size:12px;width:140px" />
                    <button type="submit" class="btn btn-primary" style="padding:4px 10px;font-size:12px">{pt.batchMarkPaidBtn} ({fmt(store.eligibleTotal)})</button>
                  </form>
                )}
              </div>
            </td>
          </tr>
        ))}
        {stores.length === 0 && (
          <tr><td colspan={4} style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.billing.noParties}</td></tr>
        )}
      </tbody>
    </table>
  </div>

  {stores.map((store) => (
    <OrderLedgerModal
      partyId={store.partyId}
      partyName={store.partyName}
      status={status}
      orders={store.orders}
      eligibleIds={store.eligibleIds}
      statements={statementsByParty.get(store.partyId) ?? []}
    />
  ))}
</CmsLayout>

<style>
  .content-hint { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .alert-success { background:rgba(34,197,94,0.08); border:1px solid #22c55e; border-radius:8px; padding:12px 16px; color:#16a34a; margin-bottom:16px; font-size:14px; }
  .progress-line { font-size:13px; font-weight:600; margin-bottom:4px; }
  .cap-bar { height:6px; border-radius:999px; background:var(--border-default); overflow:hidden; max-width:180px; margin-top:4px; }
  .cap-bar-fill { height:100%; background:var(--accent-primary); border-radius:999px; }
  .withheld-note { font-size:12px; color:var(--error); margin-top:4px; }
  .muted { color:var(--text-muted); font-size:12px; }
  .outstanding { font-weight:600; }
  .actions-cell { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .pay-form { display:flex; gap:6px; align-items:center; }
</style>
