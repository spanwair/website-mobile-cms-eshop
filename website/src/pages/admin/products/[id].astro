---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import ProductImages from "../../../components/cms/ProductImages.astro";
import ProductVariants from "../../../components/admin/ProductVariants.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchProduct, updateProduct, deleteProduct, setProductCategories } from "@shared/services/productService";
import { addProductImage, deleteProductImage, setPrimaryImage, addProductVariant, updateProductVariant, deleteProductVariant, reorderProductVariants } from "@shared/services/productImageService";
import { fetchCategories } from "@shared/services/categoryService";
import { fetchProductConditions } from "@shared/services/productConditionService";
import { fetchInventoryRowsByProduct, updateStock, fetchStockMovements, updateThresholds, setTrackInventory } from "@shared/services/inventoryService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT, getLang } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_PRODUCTS)) return Astro.redirect("/admin");
const t = useT(Astro);
const dateLocale = getLang(Astro) === "en" ? "en-US" : "cs-CZ";
const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = (form.get("action") as string) ?? "";

  if (action === "delete") {
    await deleteProduct(supabase, id!);
    return Astro.redirect("/admin/products");
  }

  // Images/videos attach to whichever variant is currently selected (variant_id NULL when the
  // product has no variants) — mirrors inventory's existing "one row always in focus" model.
  const formVariantId = (form.get("variant_id_scope") as string) || null;

  if (action === "upload_image") {
    const files = form.getAll("image") as File[];
    const alt = (form.get("image_alt") as string) || null;
    const isPrimary = form.get("is_primary") === "on";
    const ts = Date.now();
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file || file.size === 0) continue;
      const ext = file.name.split(".").pop() ?? "jpg";
      const path = `${partyId}/${id}/${formVariantId ?? "shared"}/${ts}-${i}.${ext}`;
      const buf = await file.arrayBuffer();
      const { error: upErr } = await supabase.storage.from("product-images").upload(path, buf, { contentType: file.type });
      if (upErr) { error = t.admin.products.imageUploadFailed.replace("{{message}}", upErr.message); break; }
      const { data: { publicUrl } } = supabase.storage.from("product-images").getPublicUrl(path);
      const imgResult = await addProductImage(supabase, { product_id: id!, variant_id: formVariantId, url: publicUrl, alt, is_primary: i === 0 && isPrimary, sort_order: 0 });
      if (imgResult.error) { error = imgResult.error.message; break; }
    }
    if (!error) return Astro.redirect(`/admin/products/${id}${formVariantId ? `?variant=${formVariantId}` : ""}`);
  }

  if (action === "upload_video") {
    const files = form.getAll("video") as File[];
    const ts = Date.now();
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      if (!file || file.size === 0) continue;
      const ext = file.name.split(".").pop() ?? "mp4";
      const path = `${partyId}/${id}/${formVariantId ?? "shared"}/${ts}-${i}.${ext}`;
      const buf = await file.arrayBuffer();
      const { error: upErr } = await supabase.storage.from("product-videos").upload(path, buf, { contentType: file.type });
      if (upErr) { error = t.admin.products.videoUploadFailed.replace("{{message}}", upErr.message); break; }
      const { data: { publicUrl } } = supabase.storage.from("product-videos").getPublicUrl(path);
      const vidResult = await addProductImage(supabase, { product_id: id!, variant_id: formVariantId, url: publicUrl, alt: null, is_primary: false, sort_order: 0, media_type: "video" });
      if (vidResult.error) { error = vidResult.error.message; break; }
    }
    if (!error) return Astro.redirect(`/admin/products/${id}${formVariantId ? `?variant=${formVariantId}` : ""}`);
  }

  if (action === "delete_image") {
    await deleteProductImage(supabase, form.get("image_id") as string);
    return Astro.redirect(`/admin/products/${id}${formVariantId ? `?variant=${formVariantId}` : ""}`);
  }

  if (action === "set_primary") {
    await setPrimaryImage(supabase, id!, form.get("image_id") as string);
    return Astro.redirect(`/admin/products/${id}${formVariantId ? `?variant=${formVariantId}` : ""}`);
  }

  if (action === "move_variant") {
    const variantId = form.get("variant_id") as string;
    const direction = form.get("direction") as string;
    const { data: rows } = await supabase
      .from("product_variants")
      .select("id, sort_order")
      .eq("product_id", id!)
      .order("sort_order");
    const list = rows ?? [];
    const idx = list.findIndex((v) => v.id === variantId);
    const swapIdx = direction === "up" ? idx - 1 : idx + 1;
    if (idx >= 0 && swapIdx >= 0 && swapIdx < list.length) {
      await reorderProductVariants(supabase, [
        { id: list[idx].id, sort_order: list[swapIdx].sort_order },
        { id: list[swapIdx].id, sort_order: list[idx].sort_order },
      ]);
    }
    return Astro.redirect(`/admin/products/${id}`);
  }

  if (action === "adjust_inventory" && hasPermission(permissions, PERMISSIONS.MANAGE_INVENTORY)) {
    const inventoryItemId = form.get("inventory_item_id") as string;
    const quantity = parseInt(form.get("quantity") as string, 10);
    const type = form.get("type") as "adjustment" | "purchase" | "return" | "damage";
    const note = (form.get("note") as string) || null;
    await updateStock(supabase, {
      inventory_item_id: inventoryItemId,
      party_id: partyId,
      quantity,
      type,
      note,
      created_by: session.user.id,
    });
    return Astro.redirect(`/admin/products/${id}`);
  }

  if (action === "add_variant" || action === "update_variant") {
    const price = form.get("price") as string;
    const input = {
      product_id: id!,
      name: form.get("name") as string,
      sku: (form.get("sku") as string) || null,
      price: price ? parseFloat(price) : null,
      is_active: form.get("is_active") === "on",
    };
    const result = action === "update_variant"
      ? await updateProductVariant(supabase, form.get("variant_id") as string, input)
      : await addProductVariant(supabase, input);
    if (result.error) { error = result.error.message; } else { return Astro.redirect(`/admin/products/${id}`); }
  }

  if (action === "delete_variant") {
    await deleteProductVariant(supabase, form.get("variant_id") as string);
    return Astro.redirect(`/admin/products/${id}`);
  }

  if (action === "set_on_demand" && hasPermission(permissions, PERMISSIONS.MANAGE_INVENTORY)) {
    const inventoryItemId = form.get("inventory_item_id") as string;
    const onDemand = form.get("on_demand") === "on";
    const result = await setTrackInventory(supabase, inventoryItemId, !onDemand);
    if (result.error) {
      error = result.error.message;
    } else {
      return Astro.redirect(`/admin/products/${id}`);
    }
  }

  if (action === "update_thresholds" && hasPermission(permissions, PERMISSIONS.MANAGE_INVENTORY)) {
    const inventoryItemId = form.get("inventory_item_id") as string;
    const lowStockValue = form.get("low_stock_threshold") as string;
    const maxThresholdValue = form.get("max_threshold") as string;
    const lowStockThreshold = lowStockValue && parseInt(lowStockValue, 10) > 0 ? parseInt(lowStockValue, 10) : null;
    const maxThreshold = maxThresholdValue && parseInt(maxThresholdValue, 10) > 0 ? parseInt(maxThresholdValue, 10) : null;
    const result = await updateThresholds(supabase, [{
      id: inventoryItemId,
      low_stock_threshold: lowStockThreshold,
      max_threshold: maxThreshold,
    }]);
    if (result.error) {
      error = result.error.message;
    } else {
      return Astro.redirect(`/admin/products/${id}`);
    }
  }

  const result = await updateProduct(supabase, id!, {
    title: form.get("title") as string,
    slug: form.get("slug") as string,
    sku: (form.get("sku") as string) || null,
    barcode: (form.get("barcode") as string) || null,
    price: parseFloat(form.get("price") as string) || 0,
    cost_price: parseFloat(form.get("cost_price") as string) || 0,
    discount_price: form.get("discount_price") ? parseFloat(form.get("discount_price") as string) : null,
    status: (form.get("status") as "draft" | "active" | "inactive") ?? "draft",
    description: (form.get("description") as string) || null,
    is_featured: form.get("is_featured") === "on",
    condition_id: (form.get("condition_id") as string) || null,
  });
  if (result.error) {
    error = result.error.message;
  } else {
    await setProductCategories(supabase, id!, form.getAll("category_ids[]") as string[]);
    return Astro.redirect("/admin/products");
  }
}

const product = await fetchProduct(supabase, id!);
if (!product) return Astro.redirect("/admin/products");

const categories = await fetchCategories(supabase, partyId);
const selectedCats = new Set(product.categories);
const conditions = await fetchProductConditions(supabase, partyId);
const editingVariantId = Astro.url.searchParams.get("edit_variant");

// With any variant present the storefront shows that variant's price (never product.price
// directly — see ProductPurchasePanel), so the main price field is a dead input that only
// misleads admins once there's at least one variant to carry the real price.
const hasVariants = product.variants.length > 0;
const canManageInventory = hasPermission(permissions, PERMISSIONS.MANAGE_INVENTORY);
// A product is always "a group of variants" for inventory purposes — with real variants,
// one is always selected (default: the first); with none, the single product-level row plays
// that same role. Either way exactly one inventory row is ever in focus at a time, and every
// section below (stock panel, on-demand toggle, thresholds, movements) targets that one row —
// unchanged from the single-panel design, just re-pointed at whichever row is selected.
const requestedVariantId = Astro.url.searchParams.get("variant");
const selectedVariantId = product.variants.length > 0
  ? (product.variants.find((v) => v.id === requestedVariantId)?.id ?? product.variants[0].id)
  : null;

const inventoryRows = await fetchInventoryRowsByProduct(supabase, id!);
const inventoryItem = selectedVariantId
  ? (inventoryRows.find((r) => r.variant_id === selectedVariantId) ?? null)
  : (inventoryRows[0] ?? null);

function movementTypeLabel(type: string) {
  const map: Record<string, string> = {
    adjustment: t.admin.inventory.typeAdjustment,
    purchase: t.admin.inventory.typePurchase,
    return: t.admin.inventory.typeReturn,
    damage: t.admin.inventory.typeDamage,
    sale: t.admin.inventory.typeSale,
  };
  return map[type] ?? type;
}
const recentMovements = inventoryItem
  ? (await fetchStockMovements(supabase, { inventory_item_id: inventoryItem.id, pageSize: 5 })).data
  : [];
---

<CmsLayout title={t.admin.products.editTitle} userPermissions={permissions} currentPath="/admin/products" parties={ctx.parties} partyId={ctx.partyId}>
  <a href="/admin/products" class="back-link">{t.admin.products.back}</a>
  {error && <div class="form-error" style="margin-bottom:16px;max-width:720px">{error}</div>}

  <ProductVariants
    variants={product.variants}
    productId={id!}
    editingId={editingVariantId}
    selectedVariantId={selectedVariantId}
  />

  <div class="card" style="max-width:720px;margin-top:16px">
    <form method="POST" class="product-form">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldTitle}</label>
          <input class="form-input" name="title" required value={product.title} />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldSlug}</label>
          <input class="form-input" name="slug" required value={product.slug} />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldSku}</label>
          <input class="form-input" name="sku" value={product.sku ?? ""} />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldBarcode}</label>
          <input class="form-input" name="barcode" value={product.barcode ?? ""} />
        </div>
      </div>
      {hasVariants ? (
        <>
          <p class="price-by-variants-note">{t.admin.products.priceSetByVariants}</p>
          <input type="hidden" name="price" value={product.price} />
          <input type="hidden" name="discount_price" value={product.discount_price ?? ""} />
        </>
      ) : (
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{t.admin.products.fieldPrice}</label>
            <input class="form-input" name="price" type="number" step="0.01" min="0" required value={product.price} />
          </div>
          <div class="form-group">
            <label class="form-label">{t.admin.products.fieldDiscountPrice}</label>
            <input class="form-input" name="discount_price" type="number" step="0.01" min="0" value={product.discount_price ?? ""} />
          </div>
        </div>
      )}
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldCostPrice}</label>
        <input class="form-input" name="cost_price" type="number" step="0.01" min="0" value={product.cost_price} />
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldStatus}</label>
        <select class="form-input" name="status">
          <option value="draft" selected={product.status === "draft"}>{t.common.draft}</option>
          <option value="active" selected={product.status === "active"}>{t.common.active}</option>
          <option value="inactive" selected={product.status === "inactive"}>{t.common.inactive}</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldCondition}</label>
        <select class="form-input" name="condition_id">
          <option value="">{t.admin.products.fieldNoCondition}</option>
          {conditions.map((c) => (
            <option value={c.id} selected={product.condition_id === c.id}>{c.label}</option>
          ))}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldDescription}</label>
        <textarea class="form-input" name="description" rows="4">{product.description ?? ""}</textarea>
      </div>
      <div class="form-check">
        <input type="checkbox" name="is_featured" id="is_featured" checked={product.is_featured} />
        <label for="is_featured">{t.admin.products.fieldFeatured}</label>
      </div>
      {categories.length > 0 && (
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldCategories}</label>
          <div class="checkbox-grid">
            {categories.map((cat) => (
              <label class="cat-check">
                <input type="checkbox" name="category_ids[]" value={cat.id} checked={selectedCats.has(cat.id)} />
                {cat.name}
              </label>
            ))}
          </div>
        </div>
      )}
      <div class="form-actions">
        <div style="display:flex;gap:12px">
          <a href="/admin/products" class="btn btn-ghost">{t.common.cancel}</a>
          <button type="submit" class="btn btn-primary">{t.admin.products.saveBtn}</button>
        </div>
      </div>
    </form>
    <form method="POST" class="delete-form" onsubmit={`return confirm('${t.admin.products.deleteConfirm}')`} style="margin-top:8px">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="btn btn-danger">{t.admin.products.deleteBtn}</button>
    </form>
  </div>

  <ProductImages
    images={product.images}
    productId={id!}
    variantId={selectedVariantId}
    variantName={selectedVariantId ? (product.variants.find((v) => v.id === selectedVariantId)?.name ?? null) : null}
  />

  <div class="inv-card" style="max-width:720px">
      <h2 class="inv-title">
        {t.admin.inventory.title}
        {selectedVariantId && (
          <span class="inv-title-variant">— {product.variants.find((v) => v.id === selectedVariantId)?.name}</span>
        )}
      </h2>
      {inventoryItem ? (
        <>
          <div class="inv-stats">
            <div class="inv-stat">
              <span class="inv-label">{t.admin.inventory.colOnHand}</span>
              <span class={`inv-value${inventoryItem.qty_on_hand <= 0 ? " danger" : inventoryItem.is_low_stock ? " warning" : ""}`}>{inventoryItem.qty_on_hand}</span>
            </div>
            <div class="inv-stat">
              <span class="inv-label">{t.admin.inventory.colReserved}</span>
              <span class="inv-value">{inventoryItem.qty_reserved}</span>
            </div>
            <div class="inv-stat">
              <span class="inv-label">{t.admin.inventory.colAvailable}</span>
              <span class="inv-value">{inventoryItem.qty_available}</span>
            </div>
            <div class="inv-stat">
              <span class="inv-label">{t.admin.inventory.minThreshold}</span>
              <span class="inv-value">{inventoryItem.low_stock_threshold || "—"}</span>
            </div>
            <div class="inv-stat">
              <span class="inv-label">{t.admin.inventory.maxThreshold}</span>
              <span class="inv-value">{inventoryItem.max_threshold || "—"}</span>
            </div>
          </div>
          <div class="inv-badges">
            {inventoryItem.qty_on_hand <= 0 && <span class="badge badge-error">{t.admin.inventory.outOfStock}</span>}
            {inventoryItem.is_low_stock && inventoryItem.qty_on_hand > 0 && <span class="badge badge-warning">{t.admin.inventory.lowStock}</span>}
          </div>

          {canManageInventory && (
            <>
              <div class="inv-form-section">
                <form method="POST" class="on-demand-form">
                  <input type="hidden" name="action" value="set_on_demand" />
                  <input type="hidden" name="inventory_item_id" value={inventoryItem.id} />
                  <label class="form-check">
                    <input type="checkbox" name="on_demand" checked={!inventoryItem.track_inventory} onchange="this.form.requestSubmit()" />
                    {t.admin.inventory.onDemandLabel}
                  </label>
                  <p class="on-demand-hint">{t.admin.inventory.onDemandHint}</p>
                </form>
              </div>

              <div class="inv-form-section">
                <h3 class="form-section-title">{t.admin.inventory.adjustStock}</h3>
                <form method="POST" class="inv-adjust-form">
                  <input type="hidden" name="action" value="adjust_inventory" />
                  <input type="hidden" name="inventory_item_id" value={inventoryItem.id} />
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">{t.admin.inventory.quantity}</label>
                      <input class="form-input" name="quantity" type="number" required placeholder="±qty" />
                    </div>
                    <div class="form-group">
                      <label class="form-label">{t.admin.inventory.movementType}</label>
                      <select class="form-input" name="type">
                        <option value="adjustment">{t.admin.inventory.typeAdjustment}</option>
                        <option value="purchase">{t.admin.inventory.typePurchase}</option>
                        <option value="return">{t.admin.inventory.typeReturn}</option>
                        <option value="damage">{t.admin.inventory.typeDamage}</option>
                      </select>
                    </div>
                  </div>
                  <div class="form-group">
                    <label class="form-label">{t.admin.orders.noteOptional}</label>
                    <input class="form-input" name="note" placeholder={t.admin.orders.noteOptional} />
                  </div>
                  <button type="submit" class="btn btn-primary">{t.common.apply}</button>
                </form>
              </div>

              <div class="inv-form-section">
                <h3 class="form-section-title">{t.admin.inventory.updateThresholds}</h3>
                <form method="POST" class="threshold-form">
                  <input type="hidden" name="inventory_item_id" value={inventoryItem.id} />
                  <input type="hidden" name="action" value="update_thresholds" />
                  <div class="form-row">
                    <div class="form-group">
                      <label class="form-label">{t.admin.inventory.minThreshold}</label>
                      <input class="form-input" name="low_stock_threshold" type="number" min="0" placeholder="0" value={inventoryItem.low_stock_threshold || 0} />
                    </div>
                    <div class="form-group">
                      <label class="form-label">{t.admin.inventory.maxThreshold}</label>
                      <input class="form-input" name="max_threshold" type="number" min="0" placeholder="0" value={inventoryItem.max_threshold || 0} />
                    </div>
                  </div>
                  <button type="submit" class="btn btn-secondary">{t.admin.inventory.updateThresholds}</button>
                </form>
              </div>
            </>
          )}

          {recentMovements.length > 0 && (
            <div class="movements-section">
              <h3 class="movements-title">{t.admin.inventory.recentMovements}</h3>
              <table class="data-table">
                <thead><tr><th>{t.admin.inventory.movementType}</th><th>{t.admin.inventory.movementQty}</th><th>{t.admin.inventory.movementNote}</th><th>{t.admin.inventory.movementDate}</th></tr></thead>
                <tbody>
                  {recentMovements.map(m => (
                    <tr>
                      <td><span class={`badge badge-${m.type === "sale" || m.type === "damage" ? "error" : "active"}`}>{movementTypeLabel(m.type)}</span></td>
                      <td style={m.type === "sale" || m.type === "damage" ? "color:var(--error)" : ""}>{m.type === "sale" || m.type === "damage" ? "-" : "+"}{m.quantity}</td>
                      <td style="color:var(--text-muted);font-size:13px">{m.note ?? "—"}</td>
                      <td style="color:var(--text-muted);font-size:12px">{new Date(m.created_at).toLocaleString(dateLocale)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </>
      ) : (
        <p style="color:var(--text-muted);font-size:14px">{t.admin.inventory.noInventoryRecord}</p>
      )}
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .product-form { display:flex; flex-direction:column; gap:16px; }
  .price-by-variants-note { font-size:13px; color:var(--text-muted); margin:0; padding:10px 12px; background:var(--bg-subtle); border-radius:8px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; justify-content:space-between; align-items:center; margin-top:8px; }
  .checkbox-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:8px; }
  .cat-check { display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; }
  .cat-check input { width:auto; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
  .inv-card { margin-top:24px; }
  .inv-title { font-size:16px; font-weight:700; margin:0 0 16px; }
  .inv-title-variant { color:var(--text-muted); font-weight:500; }
  .inv-stats { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; margin-bottom:12px; }
  .inv-stat { background:var(--bg-subtle); border-radius:8px; padding:12px; display:flex; flex-direction:column; gap:4px; }
