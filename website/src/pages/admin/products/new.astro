---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { createProduct, setProductCategories } from "@shared/services/productService";
import { fetchCategories } from "@shared/services/categoryService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions } = ctx;
const multiParty = ctx.parties.length > 1;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_PRODUCTS)) return Astro.redirect("/admin");
const t = useT(Astro);

let error = "";
let selectedPartyId = ctx.partyId;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  if (multiParty) selectedPartyId = (form.get("party_id") as string) || ctx.partyId;
  const result = await createProduct(supabase, {
    party_id: selectedPartyId,
    title: form.get("title") as string,
    slug: form.get("slug") as string,
    sku: (form.get("sku") as string) || null,
    barcode: (form.get("barcode") as string) || null,
    price: parseFloat(form.get("price") as string) || 0,
    discount_price: form.get("discount_price") ? parseFloat(form.get("discount_price") as string) : null,
    status: (form.get("status") as "draft" | "active" | "inactive") ?? "draft",
    description: (form.get("description") as string) || null,
    is_featured: form.get("is_featured") === "on",
  });
  if (result.error) {
    error = result.error.message;
  } else {
    await setProductCategories(supabase, result.data!.id, form.getAll("category_ids[]") as string[]);
    return Astro.redirect(`/admin/products/${result.data!.id}`);
  }
}

const categories = await fetchCategories(supabase, selectedPartyId!);
---

<CmsLayout title={t.admin.products.newTitle} userPermissions={permissions} currentPath="/admin/products" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="card" style="max-width:720px">
    <a href="/admin/products" class="back-link">{t.admin.products.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}
    <form method="POST" class="product-form">
      {multiParty && (
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldOrganization}</label>
          <select class="form-input" name="party_id">
            {ctx.parties.map((p) => (
              <option value={p.id} selected={p.id === selectedPartyId}>{p.name}</option>
            ))}
          </select>
        </div>
      )}
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldTitle}</label>
          <input class="form-input" name="title" required placeholder={t.admin.products.fieldTitlePlaceholder} />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldSlug}</label>
          <input class="form-input" name="slug" required placeholder={t.admin.products.fieldSlugPlaceholder} />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldSku}</label>
          <input class="form-input" name="sku" placeholder="SKU-001" />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldBarcode}</label>
          <input class="form-input" name="barcode" placeholder="1234567890123" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldPrice}</label>
          <input class="form-input" name="price" type="number" step="0.01" min="0" required placeholder="0.00" />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.products.fieldDiscountPrice}</label>
          <input class="form-input" name="discount_price" type="number" step="0.01" min="0" placeholder="0.00" />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldStatus}</label>
        <select class="form-input" name="status">
          <option value="draft">{t.common.draft}</option>
          <option value="active">{t.common.active}</option>
          <option value="inactive">{t.common.inactive}</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldDescription}</label>
        <textarea class="form-input" name="description" rows="4" placeholder={t.admin.products.fieldDescPlaceholder}></textarea>
      </div>
      <div class="form-check">
        <input type="checkbox" name="is_featured" id="is_featured" />
        <label for="is_featured">{t.admin.products.fieldFeatured}</label>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.products.fieldCategories}</label>
        {categories.length > 0 ? (
          <div class="checkbox-grid">
            {categories.map((cat) => (
              <label class="cat-check">
                <input type="checkbox" name="category_ids[]" value={cat.id} />
                {cat.name}
              </label>
            ))}
          </div>
        ) : (
          <p class="no-cats">{t.admin.products.noCategories} — <a href="/admin/categories/new">{t.admin.products.noCategoriesLink}</a>.</p>
        )}
      </div>
      <div class="form-actions">
        <a href="/admin/products" class="btn btn-ghost">{t.common.cancel}</a>
        <button type="submit" class="btn btn-primary">{t.admin.products.createBtn}</button>
      </div>
    </form>
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .product-form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
  .checkbox-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:8px; }
  .cat-check { display:flex; align-items:center; gap:6px; font-size:14px; cursor:pointer; }
  .cat-check input { width:auto; }
  .no-cats { font-size:13px; color:var(--text-muted); margin:4px 0 0; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>
