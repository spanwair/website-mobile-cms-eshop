---
import "@/styles/global.css";
import { createSupabase } from "@/lib/supabase";
import { requireAdminCtx } from "@/lib/admin";
import { useT } from "@/lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");

const t = useT(Astro);
const i18n = {
  popupTitle: t.admin.bugReport.popupTitle,
  popupIntro: t.admin.bugReport.popupIntro,
  popupStart: t.admin.bugReport.popupStart,
  popupStop: t.admin.bugReport.popupStop,
  popupAttached: t.admin.bugReport.popupAttached,
  popupEndedEarly: t.admin.bugReport.popupEndedEarly,
  popupOpenerGone: t.admin.bugReport.popupOpenerGone,
  popupDownload: t.admin.bugReport.popupDownload,
  popupPermissionError: t.admin.bugReport.popupPermissionError,
};
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{i18n.popupTitle}</title>
  </head>
  <body class="rec-body">
    <div class="rec-shell">
      <h1 class="rec-title">🐛 {i18n.popupTitle}</h1>
      <p class="rec-intro">{i18n.popupIntro}</p>

      <button type="button" class="rec-start" data-rec-start>⏺ {i18n.popupStart}</button>

      <div class="rec-live" data-rec-live hidden>
        <span class="rec-dot"></span>
        <span class="rec-timer" data-rec-timer>00:00</span>
        <button type="button" class="rec-stop" data-rec-stop>⏹ {i18n.popupStop}</button>
      </div>

      <p class="rec-status" data-rec-status hidden></p>
      <a class="rec-download" data-rec-download download="bug-recording.webm" hidden>⬇ {i18n.popupDownload}</a>
    </div>

    <script define:vars={{ i18n }}>
      window.__bugRecorderI18n = i18n;
    </script>
    <script>
      import { initBugRecorderPopup } from "@/lib/bugRecorderPopup";
      initBugRecorderPopup();
    </script>

    <style is:global>
      html, body { height: 100%; }
      .rec-body { margin: 0; background: var(--bg-page); display: flex; align-items: stretch; }
      .rec-shell { flex: 1; display: flex; flex-direction: column; gap: 12px; padding: 18px; }
      .rec-title { font-size: 15px; font-weight: 700; margin: 0; }
      .rec-intro { font-size: 12px; color: var(--text-muted); margin: 0; line-height: 1.5; }
      .rec-start {
        border: none; border-radius: 8px; background: var(--accent-primary); color: #fff;
        font-size: 13px; font-weight: 600; padding: 10px 0; cursor: pointer;
      }
      .rec-start:hover { background: var(--accent-primary-hover); }
      .rec-live { display: flex; align-items: center; gap: 8px; }
      .rec-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--error); animation: rec-pulse 1s infinite; }
      @keyframes rec-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
      .rec-timer { font-family: monospace; font-size: 13px; color: var(--text-muted); }
      .rec-stop {
        margin-left: auto; border: none; border-radius: 8px; background: var(--error); color: #fff;
        font-size: 13px; font-weight: 600; padding: 7px 12px; cursor: pointer;
      }
      .rec-status { font-size: 12px; color: var(--text-muted); margin: 0; }
      .rec-download {
        display: inline-block; text-align: center; border: 1px solid var(--border-default);
        border-radius: 8px; padding: 8px 0; font-size: 13px; font-weight: 600; color: var(--accent-primary);
        text-decoration: none;
      }
      [hidden] { display: none !important; }
    </style>
  </body>
</html>
