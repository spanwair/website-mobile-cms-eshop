---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import CmsTabs from "../../../components/cms/CmsTabs.astro";
import { createSupabase } from "../../../lib/supabase";
import {
  fetchFaqItems, createFaqItem, updateFaqItem, deleteFaqItem,
} from "@shared/services/faqService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CMS)) return Astro.redirect("/admin");
const t = useT(Astro);
const s = t.admin.cms;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = (form.get("_action") as string) ?? "save";
  const id = form.get("id") as string;

  if (action === "delete" && id) {
    await deleteFaqItem(supabase, id);
  } else {
    const input = {
      question: (form.get("question") as string).trim(),
      answer: (form.get("answer") as string).trim(),
      context: (form.get("context") as string) || "general",
      sort_order: parseInt((form.get("sort_order") as string) || "0", 10),
      is_visible: form.get("is_visible") === "on",
    };
    const result = id
      ? await updateFaqItem(supabase, id, input)
      : await createFaqItem(supabase, { ...input, party_id: partyId });
    if (result.error) error = result.error.message;
  }
  if (!error) return Astro.redirect("/admin/cms/faq");
}

const items = await fetchFaqItems(supabase, partyId);
const editId = Astro.url.searchParams.get("edit");
const editing = editId ? items.find((f) => f.id === editId) ?? null : null;
---

<CmsLayout title={s.faqTitle} userPermissions={permissions} currentPath="/admin/cms/faq" parties={ctx.parties} partyId={ctx.partyId}>
  <CmsTabs active="faq" />
  {error && <div class="alert-error">{error}</div>}
  <p class="content-hint">{s.faqHint}</p>

  <div class="card" style="max-width:640px;margin-bottom:24px">
    <h2 class="section-title">{editing ? t.common.edit : s.addFaqBtn}</h2>
    <form method="POST" class="faq-form">
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <div class="form-group">
        <label class="form-label">{s.fieldQuestion}</label>
        <input class="form-input" name="question" required value={editing?.question ?? ""} />
      </div>
      <div class="form-group">
        <label class="form-label">{s.fieldAnswer}</label>
        <textarea class="form-input" name="answer" rows="3" required>{editing?.answer ?? ""}</textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldContext}</label>
          <input class="form-input" name="context" value={editing?.context ?? "general"} placeholder="general | about | buyback" />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.settings.fieldSortOrder}</label>
          <input class="form-input" type="number" name="sort_order" value={editing?.sort_order ?? 0} />
        </div>
      </div>
      <div class="form-check">
        <input type="checkbox" name="is_visible" id="faq_visible" checked={editing ? editing.is_visible : true} />
        <label for="faq_visible">{t.admin.settings.fieldVisible}</label>
      </div>
      <div class="form-actions">
        {editing && <a href="/admin/cms/faq" class="btn btn-ghost">{t.common.cancel}</a>}
        <button type="submit" class="btn btn-primary">{editing ? t.common.saveChanges : s.addFaqBtn}</button>
      </div>
    </form>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{s.colQuestion}</th><th>{s.colContext}</th><th>{s.colOrder}</th><th>{s.colActions}</th></tr>
      </thead>
      <tbody>
        {items.map((f) => (
          <tr>
            <td style="font-weight:600">{f.question}</td>
            <td style="color:var(--text-muted)">{f.context}</td>
            <td>{f.sort_order}</td>
            <td class="action-cell">
              <a href={`/admin/cms/faq?edit=${f.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.common.edit}</a>
              <form method="POST" onsubmit={`return confirm('${t.common.delete}?')`} style="display:inline">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={f.id} />
                <button type="submit" class="btn btn-danger" style="padding:6px 12px;font-size:13px">{t.common.delete}</button>
              </form>
            </td>
          </tr>
        ))}
        {items.length === 0 && (
          <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--text-muted)">{s.noFaq}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .section-title { font-size:15px; font-weight:700; margin-bottom:16px; }
  .content-hint { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
  .faq-form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; }
  .action-cell { display:flex; gap:8px; align-items:center; }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>
