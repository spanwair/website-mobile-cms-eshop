---
import CmsLayout from "../../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../../lib/supabase";
import { fetchContentPage, updateContentPage, deleteContentPage } from "@shared/services/contentPageService";
import { requireAdminCtx } from "../../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CMS)) return Astro.redirect("/admin");
const t = useT(Astro);
const s = t.admin.cms;
const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;
  if (action === "delete") {
    await deleteContentPage(supabase, id!);
    return Astro.redirect("/admin/cms/pages");
  }
  const result = await updateContentPage(supabase, id!, {
    slug: (form.get("slug") as string).trim(),
    title: (form.get("title") as string).trim(),
    template: (form.get("template") as "default" | "about" | "contact" | "faq") ?? "default",
    body: (form.get("body") as string) || null,
    body_format: (form.get("body_format") as "markdown" | "html") ?? "markdown",
    seo_title: (form.get("seo_title") as string) || null,
    seo_description: (form.get("seo_description") as string) || null,
    show_in_footer_column: (form.get("show_in_footer_column") as string) || null,
    is_visible: form.get("is_visible") === "on",
    sort_order: parseInt((form.get("sort_order") as string) || "0", 10),
  });
  if (result.error) error = result.error.message;
  else return Astro.redirect(`/admin/cms/pages/${id}`);
}

const page = await fetchContentPage(supabase, id!);
if (!page) return Astro.redirect("/admin/cms/pages");
---

<CmsLayout title={page.title} userPermissions={permissions} currentPath="/admin/cms/pages" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="card" style="max-width:720px">
    <a href="/admin/cms/pages" class="back-link">{s.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}
    <form method="POST" class="page-form">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldTitle}</label>
          <input class="form-input" name="title" required value={page.title} />
        </div>
        <div class="form-group">
          <label class="form-label">{s.fieldSlug}</label>
          <input class="form-input" name="slug" required value={page.slug} />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">{s.fieldTemplate}</label>
        <select class="form-input" name="template">
          <option value="default" selected={page.template === "default"}>{s.templateDefault}</option>
          <option value="about" selected={page.template === "about"}>{s.templateAbout}</option>
          <option value="contact" selected={page.template === "contact"}>{s.templateContact}</option>
          <option value="faq" selected={page.template === "faq"}>{s.templateFaq}</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">{s.fieldBody}</label>
        <textarea class="form-input" name="body" rows="10">{page.body ?? ""}</textarea>
      </div>
      <div class="form-group">
        <label class="form-label">{s.fieldBodyFormat}</label>
        <select class="form-input" name="body_format">
          <option value="markdown" selected={page.body_format === "markdown"}>{t.admin.settings.formatMarkdown}</option>
          <option value="html" selected={page.body_format === "html"}>{t.admin.settings.formatHtml}</option>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldSeoTitle}</label>
          <input class="form-input" name="seo_title" value={page.seo_title ?? ""} />
        </div>
        <div class="form-group">
          <label class="form-label">{s.fieldSeoDescription}</label>
          <input class="form-input" name="seo_description" value={page.seo_description ?? ""} />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldFooterColumn}</label>
          <input class="form-input" name="show_in_footer_column" value={page.show_in_footer_column ?? ""} placeholder="information" />
        </div>
        <div class="form-group">
          <label class="form-label">{s.fieldSortOrder}</label>
          <input class="form-input" type="number" name="sort_order" value={page.sort_order} />
        </div>
      </div>
      <div class="form-check">
        <input type="checkbox" name="is_visible" id="is_visible" checked={page.is_visible} />
        <label for="is_visible">{t.admin.settings.fieldVisible}</label>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">{s.saveBtn}</button>
      </div>
    </form>
    <form method="POST" onsubmit={`return confirm('${s.deleteConfirm}')`} style="margin-top:16px">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="btn btn-danger">{s.deletePageBtn}</button>
    </form>
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .page-form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>
