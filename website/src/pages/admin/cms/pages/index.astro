---
import CmsLayout from "../../../../components/cms/CmsLayout.astro";
import CmsTabs from "../../../../components/cms/CmsTabs.astro";
import { createSupabase } from "../../../../lib/supabase";
import { fetchContentPages, deleteContentPage } from "@shared/services/contentPageService";
import { requireAdminCtx } from "../../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CMS)) return Astro.redirect("/admin");
const t = useT(Astro);
const s = t.admin.cms;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const id = form.get("page_id") as string;
  if (id) await deleteContentPage(supabase, id);
  return Astro.redirect("/admin/cms/pages");
}

const pages = await fetchContentPages(supabase, partyId);
---

<CmsLayout title={s.pagesTitle} userPermissions={permissions} currentPath="/admin/cms/pages" parties={ctx.parties} partyId={ctx.partyId}>
  <CmsTabs active="pages" />
  <div class="toolbar">
    <span class="total-label">{pages.length} {s.pagesTitle.toLowerCase()}</span>
    <a href="/admin/cms/pages/new" class="btn btn-primary">{s.pagesNew}</a>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{s.colTitle}</th><th>{s.colSlug}</th><th>{s.colTemplate}</th><th>{s.colVisible}</th><th>{s.colActions}</th></tr>
      </thead>
      <tbody>
        {pages.map((p) => (
          <tr>
            <td style="font-weight:600">{p.title}</td>
            <td style="color:var(--text-muted)">/stranka/{p.slug}</td>
            <td>{p.template}</td>
            <td>{p.is_visible ? t.admin.categories.visible : t.admin.categories.hidden}</td>
            <td class="action-cell">
              <a href={`/admin/cms/pages/${p.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.common.edit}</a>
              <form method="POST" onsubmit={`return confirm('${t.common.delete}?')`} style="display:inline">
                <input type="hidden" name="page_id" value={p.id} />
                <button type="submit" class="btn btn-danger" style="padding:6px 12px;font-size:13px">{t.common.delete}</button>
              </form>
            </td>
          </tr>
        ))}
        {pages.length === 0 && (
          <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">{s.noPages}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .total-label { font-size:14px; color:var(--text-muted); }
  .action-cell { display:flex; gap:8px; align-items:center; }
</style>
