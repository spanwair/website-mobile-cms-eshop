---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import CmsTabs from "../../../components/cms/CmsTabs.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchContentPages } from "@shared/services/contentPageService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CMS)) return Astro.redirect("/admin");
const t = useT(Astro);
const s = t.admin.cms;

// Standard e-commerce legal/info document set. Content itself is authored per-store (or seeded
// once for a demo org) via the normal content_pages editor — this page only tracks which of the
// standard slugs already exist and links to create/edit them.
const STANDARD_DOCS: { slug: string; title: string }[] = [
  { slug: "obchodni-podminky", title: "Obchodní podmínky" },
  { slug: "ochrana-osobnich-udaju", title: "Ochrana osobních údajů" },
  { slug: "cookies", title: "Zásady používání cookies" },
  { slug: "vraceni-zbozi", title: "Vrácení zboží a odstoupení od smlouvy" },
  { slug: "reklamace", title: "Reklamační řád" },
  { slug: "platba-a-doprava", title: "Platba a doprava" },
  { slug: "cenik-sluzeb-a-oprav", title: "Ceník služeb a oprav" },
  { slug: "zaruka-originality", title: "Záruka originality" },
  { slug: "peclive-testovano", title: "Pečlivě testováno" },
  { slug: "vyhodne-ceny", title: "Výhodné ceny" },
  { slug: "zakaznicky-servis", title: "Zákaznický servis" },
  { slug: "kariera", title: "Kariéra" },
  { slug: "esim", title: "eSIM" },
  { slug: "bonusovy-program", title: "Bonusový program" },
];

const existingPages = await fetchContentPages(supabase, partyId);
const bySlug = new Map(existingPages.map((p) => [p.slug, p]));
---

<CmsLayout title={s.legalTitle} userPermissions={permissions} currentPath="/admin/cms/legal" parties={ctx.parties} partyId={ctx.partyId}>
  <CmsTabs active="legal" />
  <p class="content-hint">{s.legalHint}</p>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{s.colPage}</th><th>{s.colPageStatus}</th><th>{s.colActions}</th></tr>
      </thead>
      <tbody>
        {STANDARD_DOCS.map((doc) => {
          const page = bySlug.get(doc.slug);
          return (
            <tr>
              <td style="font-weight:600">{doc.title}</td>
              <td>{page ? s.statusCreated : s.statusMissing}</td>
              <td class="action-cell">
                {page ? (
                  <a href={`/admin/cms/pages/${page.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{s.editPageBtn}</a>
                ) : (
                  <a
                    href={`/admin/cms/pages/new?slug=${encodeURIComponent(doc.slug)}&title=${encodeURIComponent(doc.title)}`}
                    class="btn btn-primary"
                    style="padding:6px 12px;font-size:13px"
                  >
                    {s.createPageBtn}
                  </a>
                )}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .content-hint { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
  .action-cell { display:flex; gap:8px; align-items:center; }
</style>
