---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchUserNotifications } from "@shared/services/notificationService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT, getLang } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
const { permissions } = ctx;
const t = useT(Astro);
const lang = getLang(Astro);
const dateLocale = lang === "en" ? "en-US" : "cs-CZ";

const notifications = await fetchUserNotifications(supabase, session.user.id);
---

<CmsLayout title={t.admin.notifications.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId}>
  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr>
          <th>{t.admin.audit.colTimestamp}</th>
          <th>{t.admin.notifications.colType}</th>
          <th>{t.admin.notifications.colTitle}</th>
          <th>{t.admin.notifications.colMessage}</th>
          <th>{t.common.status}</th>
        </tr>
      </thead>
      <tbody>
        {notifications.map((n) => (
          <tr class={n.read_at ? "" : "unread"}>
            <td style="font-size:12px;color:var(--text-muted);white-space:nowrap">
              {new Date(n.created_at).toLocaleString(dateLocale)}
            </td>
            <td style="font-family:monospace;font-size:13px">{n.type}</td>
            <td>{n.title ?? "—"}</td>
            <td style="color:var(--text-muted);font-size:13px">{n.body ?? "—"}</td>
            <td>
              {n.read_at
                ? <span class="badge badge-inactive">{t.admin.notifications.statusRead}</span>
                : <span class="badge badge-active">{t.admin.notifications.statusUnread}</span>
              }
            </td>
          </tr>
        ))}
        {notifications.length === 0 && (
          <tr>
            <td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">
              {t.admin.notifications.noNotifications}
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .unread td { font-weight: 600; }
</style>
