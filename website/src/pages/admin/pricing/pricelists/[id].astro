---
import CmsLayout from "../../../../components/cms/CmsLayout.astro";
import PriceListItems from "../../../../components/cms/PriceListItems.astro";
import { createSupabase } from "../../../../lib/supabase";
import {
  fetchPriceList,
  updatePriceList,
  deletePriceList,
  fetchPriceListItems,
  upsertPriceListItem,
  deletePriceListItem,
} from "@shared/services/pricingService";
import { fetchProducts, fetchProduct } from "@shared/services/productService";
import { requireAdminCtx } from "../../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_PRICING)) return Astro.redirect("/admin");
const t = useT(Astro);
const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = (form.get("action") as string) ?? "";

  if (action === "delete") {
    await deletePriceList(supabase, id!);
    return Astro.redirect("/admin/pricing?tab=pricelists");
  }

  if (action === "add_item") {
    const product_id = form.get("product_id") as string;
    const price = Number(form.get("price"));
    const product = await fetchProduct(supabase, product_id);
    if (!product || product.party_id !== partyId) {
      error = t.admin.pricing.errorProductNotFound;
    } else {
      const result = await upsertPriceListItem(supabase, {
        price_list_id: id!,
        product_id,
        variant_id: null,
        price,
      });
      if (result.error) {
        error = result.error.message;
      } else {
        return Astro.redirect(`/admin/pricing/pricelists/${id}`);
      }
    }
  }

  if (action === "delete_item") {
    await deletePriceListItem(supabase, form.get("item_id") as string);
    return Astro.redirect(`/admin/pricing/pricelists/${id}`);
  }

  if (action === "update") {
    const valid_from = form.get("valid_from") ? (form.get("valid_from") as string) : null;
    const valid_to = form.get("valid_to") ? (form.get("valid_to") as string) : null;

    if (valid_from && valid_to && valid_from > valid_to) {
      error = t.admin.pricing.errorInvalidDateRange;
    } else {
      const result = await updatePriceList(supabase, id!, {
        name: (form.get("name") as string).trim(),
        currency: form.get("currency") as string,
        valid_from,
        valid_to,
        is_default: form.get("is_default") === "on",
        is_active: form.get("is_active") === "on",
      });
      if (result.error) {
        error = result.error.message;
      } else {
        return Astro.redirect(`/admin/pricing/pricelists/${id}`);
      }
    }
  }
}

const priceList = await fetchPriceList(supabase, id!);
if (!priceList || priceList.party_id !== partyId) return Astro.redirect("/admin/pricing");

const items = await fetchPriceListItems(supabase, id!);
const { data: products } = await fetchProducts(supabase, partyId, { pageSize: 500 });

function formatDate(date: string | null): string {
  if (!date) return "";
  return new Date(date).toISOString().split("T")[0];
}
---

<CmsLayout title={t.admin.pricing.editPriceListTitle} userPermissions={permissions} currentPath="/admin/pricing" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="container">
    <a href="/admin/pricing?tab=pricelists" class="back-link">{t.admin.pricing.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}

    <div class="card">
      <form method="POST" class="form">
        <input type="hidden" name="action" value="update" />
        <div class="form-group">
          <label class="form-label">{t.admin.pricing.fieldPriceListName}</label>
          <input class="form-input" name="name" required value={priceList.name} />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{t.admin.pricing.fieldCurrency}</label>
            <select class="form-input" name="currency" required>
              <option value="USD" selected={priceList.currency === "USD"}>USD</option>
              <option value="EUR" selected={priceList.currency === "EUR"}>EUR</option>
              <option value="CZK" selected={priceList.currency === "CZK"}>CZK</option>
              <option value="GBP" selected={priceList.currency === "GBP"}>GBP</option>
            </select>
          </div>
          <div class="form-check-group">
            <div class="form-check">
              <input type="checkbox" name="is_default" id="is_default" checked={priceList.is_default} />
              <label for="is_default">{t.admin.pricing.fieldDefault}</label>
            </div>
            <div class="form-check">
              <input type="checkbox" name="is_active" id="is_active" checked={priceList.is_active} />
              <label for="is_active">{t.admin.pricing.fieldActive}</label>
            </div>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{t.admin.pricing.fieldValidFrom}</label>
            <input class="form-input" name="valid_from" type="date" value={formatDate(priceList.valid_from)} />
          </div>
          <div class="form-group">
            <label class="form-label">{t.admin.pricing.fieldValidTo}</label>
            <input class="form-input" name="valid_to" type="date" value={formatDate(priceList.valid_to)} />
          </div>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{t.admin.pricing.savePriceListBtn}</button>
        </div>
      </form>
    </div>

    <PriceListItems items={items} products={products} currency={priceList.currency} />

    <form method="POST" style="margin-top:24px">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="btn btn-danger" onclick={`return confirm('${t.admin.pricing.deletePriceListConfirm}')`}>{t.admin.pricing.deletePriceList}</button>
    </form>
  </div>
</CmsLayout>

<style>
  .container { max-width:900px; }
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check-group { display:flex; flex-direction:column; gap:12px; justify-content:center; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
</style>
