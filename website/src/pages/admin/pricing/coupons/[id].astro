---
import CmsLayout from "../../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../../lib/supabase";
import { fetchCoupon, updateCoupon, deleteCoupon, fetchDiscountRules } from "@shared/services/pricingService";
import { requireAdminCtx } from "../../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT, getLang } from "../../../../lib/i18n";
import { formatPrice } from "@shared/utils/format";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_PRICING)) return Astro.redirect("/admin");
const t = useT(Astro);
const lang = getLang(Astro);
const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = (form.get("action") as string) ?? "";

  if (action === "delete") {
    await deleteCoupon(supabase, id!);
    return Astro.redirect("/admin/pricing?tab=coupons");
  }

  if (action === "update") {
    const result = await updateCoupon(supabase, id!, {
      code: (form.get("code") as string).toUpperCase().trim(),
      discount_rule_id: form.get("discount_rule_id") as string,
      max_uses: form.get("max_uses") ? parseInt(form.get("max_uses") as string, 10) : null,
      is_active: form.get("is_active") === "on",
    });
    if (result.error) {
      error = result.error.message;
    } else {
      return Astro.redirect(`/admin/pricing/coupons/${id}`);
    }
  }
}

const coupon = await fetchCoupon(supabase, id!);
if (!coupon || coupon.party_id !== partyId) return Astro.redirect("/admin/pricing");

const discountRules = await fetchDiscountRules(supabase, partyId);
---

<CmsLayout title={t.admin.pricing.editCouponTitle} userPermissions={permissions} currentPath="/admin/pricing" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="container">
    <a href="/admin/pricing?tab=coupons" class="back-link">{t.admin.pricing.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}

    <div class="card">
      <form method="POST" class="form">
        <input type="hidden" name="action" value="update" />
        <div class="form-group">
          <label class="form-label">{t.admin.pricing.fieldCode}</label>
          <input class="form-input" name="code" required value={coupon.code} style="text-transform:uppercase" />
          <span class="form-hint">{t.admin.pricing.codeHint}</span>
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.pricing.fieldRule}</label>
          <select class="form-input" name="discount_rule_id" required>
            <option value="">{t.admin.pricing.selectRule}</option>
            {discountRules.map((r) => (
              <option value={r.id} selected={r.id === coupon.discount_rule_id}>
                {r.name} ({r.type === "percentage" ? `${r.value}%` : formatPrice(r.value, lang)})
              </option>
            ))}
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.pricing.fieldMaxUses}</label>
          <input class="form-input" name="max_uses" type="number" min="1" value={coupon.max_uses ?? ""} placeholder={t.admin.pricing.maxUsesPlaceholder} />
          <span class="form-hint">{t.admin.pricing.currentUsage.replace("{{count}}", String(coupon.uses_count)).replace("{{limit}}", String(coupon.max_uses ?? t.admin.pricing.unlimited))}</span>
        </div>
        <div class="form-check">
          <input type="checkbox" name="is_active" id="is_active" checked={coupon.is_active} />
          <label for="is_active">{t.admin.pricing.fieldActive}</label>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{t.admin.pricing.saveCouponBtn}</button>
        </div>
      </form>
    </div>

    <form method="POST" style="margin-top:24px">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="btn btn-danger" onclick={`return confirm('${t.admin.pricing.deleteCouponConfirm}')`}>{t.admin.pricing.deleteCoupon}</button>
    </form>
  </div>
</CmsLayout>

<style>
  .container { max-width:480px; }
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .form { display:flex; flex-direction:column; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
  .form-hint { font-size:12px; color:var(--text-muted); margin-top:4px; }
</style>
