---
import CmsLayout from "../../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../../lib/supabase";
import { createCoupon, fetchDiscountRules } from "@shared/services/pricingService";
import { requireAdminCtx } from "../../../../lib/admin";
import { useT } from "../../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const ctx = await requireAdminCtx(supabase, session.user.id);
if (!ctx) return Astro.redirect("/dashboard");
const { permissions, partyId } = ctx;
const t = useT(Astro);

const discountRules = partyId ? await fetchDiscountRules(supabase, partyId) : [];

let error = "";

if (Astro.request.method === "POST" && partyId) {
  const form = await Astro.request.formData();
  const result = await createCoupon(supabase, {
    party_id: partyId,
    code: (form.get("code") as string).toUpperCase().trim(),
    discount_rule_id: form.get("discount_rule_id") as string,
    max_uses: form.get("max_uses") ? parseInt(form.get("max_uses") as string, 10) : null,
    is_active: form.get("is_active") === "on",
  });
  if (result.error) {
    error = result.error.message;
  } else {
    return Astro.redirect("/admin/pricing?tab=coupons");
  }
}
---

<CmsLayout title={t.admin.pricing.newCouponTitle} userPermissions={permissions} currentPath="/admin/pricing">
  <div class="card" style="max-width:480px">
    <a href="/admin/pricing?tab=coupons" class="back-link">{t.admin.pricing.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}
    {discountRules.length === 0 && (
      <div class="alert">{t.admin.pricing.noDiscountRules}</div>
    )}
    <form method="POST" class="coupon-form">
      <div class="form-group">
        <label class="form-label">{t.admin.pricing.fieldCode}</label>
        <input class="form-input" name="code" required placeholder="SUMMER20" style="text-transform:uppercase" />
        <span class="form-hint">{t.admin.pricing.codeHint}</span>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.pricing.fieldRule}</label>
        <select class="form-input" name="discount_rule_id" required>
          <option value="">{t.admin.pricing.selectRule}</option>
          {discountRules.map((r) => (
            <option value={r.id}>{r.name} ({r.type === "percentage" ? `${r.value}%` : `${r.value} Kč`})</option>
          ))}
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.pricing.fieldMaxUses}</label>
        <input class="form-input" name="max_uses" type="number" min="1" placeholder={t.admin.pricing.maxUsesPlaceholder} />
      </div>
      <div class="form-check">
        <input type="checkbox" name="is_active" id="is_active" checked />
        <label for="is_active">{t.admin.pricing.fieldActive}</label>
      </div>
      <div class="form-actions">
        <a href="/admin/pricing?tab=coupons" class="btn btn-ghost">{t.common.cancel}</a>
        <button type="submit" class="btn btn-primary" disabled={discountRules.length === 0}>{t.admin.pricing.createCouponBtn}</button>
      </div>
    </form>
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .alert { background:#FFF3CD; border:1px solid #FFEAA7; border-radius:8px; padding:12px 16px; color:#856404; margin-bottom:16px; font-size:13px; }
  .coupon-form { display:flex; flex-direction:column; gap:16px; }
  .form-hint { font-size:12px; color:var(--text-muted); margin-top:4px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; margin-top:8px; }
</style>
