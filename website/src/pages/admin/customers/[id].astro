---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchCustomer, updateCustomer } from "@shared/services/customerService";
import { fetchOrders } from "@shared/services/orderService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CUSTOMERS)) return Astro.redirect("/admin");
const t = useT(Astro);

const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const result = await updateCustomer(supabase, id!, {
    first_name: form.get("first_name") as string,
    last_name: form.get("last_name") as string,
    email: form.get("email") as string,
    phone: (form.get("phone") as string) || null,
    is_active: form.get("is_active") === "on",
    notes: (form.get("notes") as string) || null,
  });
  if (result.error) { error = result.error.message; }
  else { return Astro.redirect(`/admin/customers/${id}`); }
}

const customer = await fetchCustomer(supabase, id!);
if (!customer) return Astro.redirect("/admin/customers");

const orders = partyId
  ? (await fetchOrders(supabase, partyId, { customer_id: id, pageSize: 10 })).data
  : [];

function statusClass(s: string) {
  const map: Record<string, string> = {
    pending: "badge-pending", confirmed: "badge-active", processing: "badge-draft",
    shipped: "badge-active", delivered: "badge-active", cancelled: "badge-error",
  };
  return map[s] ?? "badge-inactive";
}
---

<CmsLayout title={`${customer.first_name} ${customer.last_name}`} userPermissions={permissions} currentPath="/admin/customers" parties={ctx.parties} partyId={ctx.partyId}>
  <a href="/admin/customers" class="back-link">{t.admin.customers.back}</a>
  {error && <div class="alert-error">{error}</div>}

  <div class="customer-grid">
    <div>
      <div class="card">
        <h2 class="section-title">{t.admin.customers.sectionPersonal}</h2>
        <form method="POST" class="info-form">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">{t.admin.customers.fieldFirstName}</label>
              <input class="form-input" name="first_name" required value={customer.first_name} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.customers.fieldLastName}</label>
              <input class="form-input" name="last_name" required value={customer.last_name} />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">{t.admin.customers.fieldEmail}</label>
              <input class="form-input" name="email" type="email" required value={customer.email} />
            </div>
            <div class="form-group">
              <label class="form-label">{t.admin.customers.fieldPhone}</label>
              <input class="form-input" name="phone" value={customer.phone ?? ""} />
            </div>
          </div>
          <div class="form-group">
            <label class="form-label">{t.admin.customers.fieldNotes}</label>
            <textarea class="form-input" name="notes" rows="3">{customer.notes ?? ""}</textarea>
          </div>
          <div class="form-check">
            <input type="checkbox" name="is_active" id="is_active" checked={customer.is_active} />
            <label for="is_active">{t.admin.customers.fieldActive}</label>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top:16px">{t.admin.customers.saveBtn}</button>
        </form>
      </div>

      {customer.addresses.length > 0 && (
        <div class="card" style="margin-top:16px">
          <h2 class="section-title">{t.admin.customers.sectionAddresses} ({customer.addresses.length})</h2>
          {customer.addresses.map((addr) => (
            <div class="address-card">
              <span class={`badge ${addr.is_default ? "badge-active" : "badge-inactive"}`}>{addr.type}</span>
              {addr.is_default && <span class="badge badge-pending" style="margin-left:4px">{t.admin.customers.defaultBadge}</span>}
              <p style="margin-top:8px;font-size:14px">{addr.first_name} {addr.last_name}<br />{addr.line1}{addr.line2 ? `, ${addr.line2}` : ""}<br />{addr.city} {addr.postal_code}, {addr.country_code}</p>
            </div>
          ))}
        </div>
      )}
    </div>

    <div class="card">
      <h2 class="section-title">{t.admin.customers.sectionOrders} ({customer.order_count})</h2>
      {orders.length === 0 ? (
        <p style="font-size:14px;color:var(--text-muted)">{t.admin.customers.noOrders}</p>
      ) : (
        <table class="data-table">
          <thead><tr><th>{t.admin.customers.colOrderNumber}</th><th>{t.admin.orders.colStatus}</th><th>{t.admin.orders.colTotal}</th><th>{t.admin.orders.colDate}</th></tr></thead>
          <tbody>
            {orders.map((o) => (
              <tr>
                <td><a href={`/admin/orders/${o.id}`}>{o.order_number}</a></td>
                <td><span class={`badge ${statusClass(o.status)}`}>{o.status}</span></td>
                <td>{o.total_amount.toFixed(2)} Kč</td>
                <td style="font-size:13px;color:var(--text-muted)">{new Date(o.created_at).toLocaleDateString()}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .customer-grid { display:grid; grid-template-columns:3fr 2fr; gap:24px; }
  .section-title { font-size:15px; font-weight:700; margin-bottom:16px; }
  .info-form { display:flex; flex-direction:column; gap:14px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .address-card { padding:12px 0; border-bottom:1px solid var(--border-default); }
  .address-card:last-child { border-bottom:none; }
  @media(max-width:768px) { .customer-grid { grid-template-columns:1fr; } .form-row { grid-template-columns:1fr; } }
</style>
