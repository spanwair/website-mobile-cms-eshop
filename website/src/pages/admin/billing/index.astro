---
// Platform-level, cross-party billing overview — every party's current pricing state (5%
// commission for own_company, 30%/12,000-payout-limit for smalljobs_commission) and
// outstanding balance in one place, so whoever holds MANAGE_AUDIT doesn't have to switch
// active party and hunt through /admin/payouts for each org individually. Always scoped to
// ctx.parties (owner sees every party, admin sees only their assigned ones) — never queries
// beyond that set. Both seller modes read from the same order_commission_ledger now (see
// shared/services/commissionLedgerService.ts) — own_company no longer has its own separate
// monthly-fee table.
import CmsLayout from "@/components/cms/CmsLayout.astro";
import { createSupabase } from "@/lib/supabase";
import { requireAdminCtx } from "@/lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT, getLang } from "@/lib/i18n";
import { SELLER_MODE, NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK } from "@shared/constants/sellerMode";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_AUDIT)) return Astro.redirect("/admin");
const t = useT(Astro);
const lang = getLang(Astro);

const partyIds = ctx.parties.map((p) => p.id);

function fmt(n: number) {
  return n.toLocaleString(lang === "en" ? "en-US" : "cs-CZ", { minimumFractionDigits: 0, maximumFractionDigits: 0 }) + " Kč";
}

const { data: partyRows } = await supabase.from("parties").select("id, name, seller_mode").in("id", partyIds);
const monthStart = new Date(Date.UTC(new Date().getUTCFullYear(), new Date().getUTCMonth(), 1)).toISOString();

interface PartyLedgerSummary {
  thisMonthGross: number;
  thisMonthCommission: number;
  thisMonthWithheld: number;
  eligibleTotal: number;
  eligibleCount: number;
  heldFutureCount: number;
  hasActivity: boolean;
}

const byParty = new Map<string, PartyLedgerSummary>();
if (partyIds.length > 0) {
  const { data: ledgerRows } = await supabase
    .from("order_commission_ledger")
    .select("party_id, gross_amount, commission_amount, net_payable, withheld_amount, status, hold_until, created_at")
    .in("party_id", partyIds)
    .neq("status", "reversed");

  const now = Date.now();
  for (const partyId of partyIds) {
    const rows = (ledgerRows ?? []).filter((r) => r.party_id === partyId);
    const thisMonthRows = rows.filter((r) => r.created_at >= monthStart);
    const eligible = rows.filter((r) => r.status === "held" && new Date(r.hold_until).getTime() <= now);
    const heldFuture = rows.filter((r) => r.status === "held" && new Date(r.hold_until).getTime() > now);
    byParty.set(partyId, {
      thisMonthGross: thisMonthRows.reduce((sum, r) => sum + Number(r.gross_amount), 0),
      thisMonthCommission: thisMonthRows.reduce((sum, r) => sum + Number(r.commission_amount), 0),
      thisMonthWithheld: thisMonthRows.reduce((sum, r) => sum + Number(r.withheld_amount ?? 0), 0),
      eligibleTotal: eligible.reduce((sum, r) => sum + Number(r.net_payable), 0),
      eligibleCount: eligible.length,
      heldFutureCount: heldFuture.length,
      hasActivity: rows.length > 0,
    });
  }
}

const rows = (partyRows ?? []).map((party) => {
  const isCommission = party.seller_mode === SELLER_MODE.SMALLJOBS_COMMISSION;
  const summary = byParty.get(party.id) ?? null;
  return { party, isCommission, summary };
});
---

<CmsLayout title={t.admin.billing.title} userPermissions={permissions} currentPath={Astro.url.pathname} parties={ctx.parties} partyId={ctx.partyId} isOwner={ctx.isOwner}>
  <p class="content-hint">{t.admin.billing.hint}</p>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr>
          <th>{t.admin.billing.colParty}</th><th>{t.admin.billing.colMode}</th><th>{t.admin.billing.colThisMonth}</th><th>{t.admin.billing.colOutstanding}</th><th>{t.admin.billing.colActions}</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ party, isCommission, summary }) => (
          <tr>
            <td style="font-weight:600">{party.name}</td>
            <td>
              <span class={`badge ${isCommission ? "badge-pending" : "badge-active"}`}>
                {isCommission ? t.admin.billing.modeCommission : t.admin.billing.modeOwnCompany}
              </span>
            </td>
            <td>
              {!summary?.hasActivity ? (
                <span class="muted">{t.admin.billing.noActivityYet}</span>
              ) : isCommission ? (
                <div>
                  <div class="progress-line">{fmt((summary.eligibleTotal))} {t.admin.billing.of} {fmt(NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK)}</div>
                  <div class="cap-bar"><div class="cap-bar-fill" style={`width:${Math.min((summary.eligibleTotal / NO_ICO_MONTHLY_PAYOUT_LIMIT_CZK) * 100, 100)}%`}></div></div>
                  {summary.thisMonthWithheld > 0 && (
                    <div class="withheld-note">{t.admin.billing.withheldLabel}: {fmt(summary.thisMonthWithheld)}</div>
                  )}
                </div>
              ) : (
                <div class="progress-line">{fmt(summary.thisMonthGross)} <span class="muted">({fmt(summary.thisMonthCommission)} {t.admin.billing.ofTurnover})</span></div>
              )}
            </td>
            <td>
              {(summary?.eligibleCount ?? 0) > 0 ? (
                <span class="outstanding">{fmt(summary!.eligibleTotal)} <span class="muted">({summary!.eligibleCount} {t.admin.billing.readyToPay})</span></span>
              ) : (summary?.heldFutureCount ?? 0) > 0 ? (
                <span class="muted">{summary!.heldFutureCount} {t.admin.billing.inHoldPeriod}</span>
              ) : (
                <span class="muted">{t.admin.billing.nothingDue}</span>
              )}
            </td>
            <td>
              <form method="POST" action="/api/switch-party">
                <input type="hidden" name="partyId" value={party.id} />
                <input type="hidden" name="redirect" value="/admin/payouts" />
                <button type="submit" class="btn btn-secondary" style="padding:4px 10px;font-size:12px">{t.admin.billing.resolveBtn}</button>
              </form>
            </td>
          </tr>
        ))}
        {rows.length === 0 && (
          <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.billing.noParties}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .content-hint { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
  .progress-line { font-size:13px; font-weight:600; margin-bottom:4px; }
  .cap-bar { height:6px; border-radius:999px; background:var(--border-default); overflow:hidden; max-width:180px; }
  .cap-bar-fill { height:100%; background:var(--accent-primary); border-radius:999px; }
  .withheld-note { font-size:12px; color:var(--error); margin-top:4px; }
  .muted { color:var(--text-muted); font-size:12px; }
  .outstanding { font-weight:600; }
</style>
