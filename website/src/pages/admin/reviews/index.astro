---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { fetchReviews } from "@shared/services/reviewService";
import { useT, getLang } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_PRODUCTS)) return Astro.redirect("/admin");
const t = useT(Astro);
const lang = getLang(Astro);

const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get("page") ?? "1", 10);
const statusFilter = url.searchParams.get("status") ?? "";
const pageSize = 20;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;
  const reviewId = form.get("review_id") as string;

  if (action === "approve" || action === "reject" || action === "hide") {
    await supabase.from("product_reviews").update({ status: action === "approve" ? "approved" : action === "reject" ? "rejected" : "hidden" }).eq("id", reviewId);
  } else if (action === "delete") {
    await supabase.from("product_reviews").delete().eq("id", reviewId);
  }
  return Astro.redirect("/admin/reviews");
}

const reviewsResult = await fetchReviews(supabase, partyId, {
  status: statusFilter || undefined,
  page,
  pageSize,
});
const reviews = reviewsResult.data;
const total = reviewsResult.total;

const totalPages = Math.ceil(total / pageSize);

const STATUS_TABS = [
  { value: "", label: t.admin.reviews.statusAll },
  { value: "pending", label: t.admin.reviews.statusPending },
  { value: "approved", label: t.admin.reviews.statusApproved },
  { value: "rejected", label: t.admin.reviews.statusRejected },
  { value: "hidden", label: t.admin.reviews.statusHidden },
];

const STAR = "★";
const EMPTY_STAR = "☆";
function stars(n: number) {
  return STAR.repeat(n) + EMPTY_STAR.repeat(5 - n);
}

function statusClass(s: string) {
  const map: Record<string, string> = {
    pending: "badge-pending",
    approved: "badge-active",
    rejected: "badge-error",
    hidden: "badge-inactive",
  };
  return map[s] ?? "badge-draft";
}
function statusLabel(s: string) {
  const map: Record<string, string> = {
    pending: t.admin.reviews.statusPending,
    approved: t.admin.reviews.statusApproved,
    rejected: t.admin.reviews.statusRejected,
    hidden: t.admin.reviews.statusHidden,
  };
  return map[s] ?? s;
}
---

<CmsLayout title={t.admin.reviews.title} userPermissions={permissions} currentPath="/admin/reviews" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="toolbar">
    <h1 class="page-title">{t.admin.reviews.title}</h1>
    <span class="toolbar-count">{total}</span>
  </div>

  <div class="tabs">
    {STATUS_TABS.map(tab => (
      <a
        href={`/admin/reviews${tab.value ? `?status=${tab.value}` : ""}`}
        class={`tab${statusFilter === tab.value ? " tab-active" : ""}`}
      >
        {tab.label}
      </a>
    ))}
  </div>

  {reviews.length === 0 ? (
    <div class="card empty-state">
      <p>{t.admin.reviews.noReviews}</p>
    </div>
  ) : (
    <div class="review-list">
      {reviews.map(review => (
        <div class="card review-card">
          <div class="review-header">
            <div class="review-meta">
              <span class="review-stars" title={`${review.rating}/5`}>{stars(review.rating)}</span>
              <strong class="review-author">{review.author_name}</strong>
              <span class="review-email">{review.author_email}</span>
              {review.is_verified && <span class="badge badge-active">{t.admin.reviews.verifiedPurchase}</span>}
              <span class={`badge ${statusClass(review.status)}`}>{statusLabel(review.status)}</span>
            </div>
            <time class="review-date">{new Date(review.created_at).toLocaleDateString(lang === "en" ? "en-US" : "cs-CZ")}</time>
          </div>

          {(review.pros.length > 0 || review.cons.length > 0) && (
            <div class="review-points">
              <ul class="point-col">{review.pros.map((p) => <li class="pro">{p}</li>)}</ul>
              <ul class="point-col">{review.cons.map((c) => <li class="con">{c}</li>)}</ul>
            </div>
          )}
          {review.body && <p class="review-body">{review.body}</p>}

          <div class="review-actions">
            {review.status !== "approved" && (
              <form method="POST">
                <input type="hidden" name="review_id" value={review.id} />
                <input type="hidden" name="action" value="approve" />
                <button type="submit" class="btn btn-primary btn-sm">{t.admin.reviews.approve}</button>
              </form>
            )}
            {review.status !== "rejected" && (
              <form method="POST">
                <input type="hidden" name="review_id" value={review.id} />
                <input type="hidden" name="action" value="reject" />
                <button type="submit" class="btn btn-ghost btn-sm">{t.admin.reviews.reject}</button>
              </form>
            )}
            {review.status !== "hidden" && (
              <form method="POST">
                <input type="hidden" name="review_id" value={review.id} />
                <input type="hidden" name="action" value="hide" />
                <button type="submit" class="btn btn-ghost btn-sm">{t.admin.reviews.hide}</button>
              </form>
            )}
            <form method="POST" onsubmit={`return confirm('${t.admin.reviews.deleteConfirm}')`}>
              <input type="hidden" name="review_id" value={review.id} />
              <input type="hidden" name="action" value="delete" />
              <button type="submit" class="btn btn-danger btn-sm">{t.common.delete}</button>
            </form>
          </div>
        </div>
      ))}
    </div>
  )}

  {totalPages > 1 && (
    <div class="pagination">
      {page > 1 && (
        <a href={`/admin/reviews?page=${page - 1}${statusFilter ? `&status=${statusFilter}` : ""}`} class="btn btn-ghost">← {t.common.previous}</a>
      )}
      <span class="page-info">{t.common.page} {page} / {totalPages}</span>
      {page < totalPages && (
        <a href={`/admin/reviews?page=${page + 1}${statusFilter ? `&status=${statusFilter}` : ""}`} class="btn btn-ghost">{t.common.next} →</a>
      )}
    </div>
  )}
</CmsLayout>

<style>
  .toolbar { display:flex; align-items:center; gap:12px; margin-bottom:20px; }
  .toolbar-count { color:var(--text-muted); font-size:14px; }
  .tabs { display:flex; gap:8px; margin-bottom:20px; flex-wrap:wrap; }
  .tab { padding:6px 16px; border-radius:20px; font-size:14px; color:var(--text-muted); border:1px solid var(--border); text-decoration:none; }
  .tab-active { background:var(--primary); color:#fff; border-color:var(--primary); }
  .review-list { display:flex; flex-direction:column; gap:12px; }
  .review-card { padding:20px; }
  .review-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:10px; }
  .review-meta { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  .review-stars { color:#f59e0b; font-size:18px; letter-spacing:1px; }
  .review-author { font-weight:600; }
  .review-email { color:var(--text-muted); font-size:13px; }
  .review-date { color:var(--text-muted); font-size:13px; white-space:nowrap; }
  .review-points { display:grid; grid-template-columns:1fr 1fr; gap:4px 24px; margin:8px 0; }
  .point-col { list-style:none; padding:0; margin:0; font-size:13px; }
  .point-col li { margin-bottom:2px; }
  .point-col li::before { font-weight:700; margin-right:6px; }
  .point-col li.pro::before { content:"+"; color:#16a34a; }
  .point-col li.con::before { content:"−"; color:#dc2626; }
  .review-body { color:var(--text-secondary); font-size:14px; line-height:1.6; margin:0 0 12px; }
  .review-actions { display:flex; gap:8px; flex-wrap:wrap; }
  .btn-sm { padding:4px 12px; font-size:13px; }
  .btn-danger { background:#fee2e2; color:#dc2626; border:1px solid #fca5a5; }
  .btn-danger:hover { background:#fecaca; }
  .empty-state { text-align:center; padding:40px; color:var(--text-muted); }
  .pagination { display:flex; align-items:center; gap:16px; justify-content:center; margin-top:24px; }
  .page-info { color:var(--text-muted); font-size:14px; }
</style>
