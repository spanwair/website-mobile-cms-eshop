---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import SettingsTabs from "../../../components/cms/SettingsTabs.astro";
import { createSupabase } from "../../../lib/supabase";
import {
  fetchBenefitItems, createBenefitItem, updateBenefitItem, deleteBenefitItem,
} from "@shared/services/benefitItemService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/dashboard");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId, parties } = ctx;
const partySlug = parties.find((p) => p.id === partyId)?.slug;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_SETTINGS)) return Astro.redirect("/admin");
const t = useT(Astro);
const s = t.admin.settings;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = (form.get("_action") as string) ?? "save";
  const id = form.get("id") as string;

  if (action === "delete" && id) {
    await deleteBenefitItem(supabase, id);
  } else {
    const input = {
      icon: (form.get("icon") as string) || "✓",
      title: (form.get("title") as string).trim(),
      description: (form.get("description") as string) || null,
      sort_order: parseInt((form.get("sort_order") as string) || "0", 10),
      is_visible: form.get("is_visible") === "on",
    };
    const result = id
      ? await updateBenefitItem(supabase, id, input)
      : await createBenefitItem(supabase, { ...input, party_id: partyId });
    if (result.error) error = result.error.message;
  }
  if (!error) return Astro.redirect("/admin/settings/benefits");
}

const items = await fetchBenefitItems(supabase, partyId);
const editId = Astro.url.searchParams.get("edit");
const editing = editId ? items.find((b) => b.id === editId) ?? null : null;
---

<CmsLayout title={s.title} userPermissions={permissions} currentPath="/admin/settings/benefits" parties={ctx.parties} partyId={ctx.partyId}>
  <SettingsTabs active="benefits" partySlug={partySlug} />
  {error && <div class="alert-error">{error}</div>}

  <div class="card" style="max-width:640px;margin-bottom:24px">
    <h2 class="section-title">{editing ? t.common.edit : s.addBenefitBtn}</h2>
    <form method="POST" class="benefit-form">
      {editing && <input type="hidden" name="id" value={editing.id} />}
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldIcon}</label>
          <input class="form-input" name="icon" value={editing?.icon ?? "✓"} placeholder="🛡️" />
        </div>
        <div class="form-group">
          <label class="form-label">{s.fieldBenefitTitle}</label>
          <input class="form-input" name="title" required value={editing?.title ?? ""} />
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">{s.fieldDescription}</label>
        <textarea class="form-input" name="description" rows="2">{editing?.description ?? ""}</textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{s.fieldSortOrder}</label>
          <input class="form-input" type="number" name="sort_order" value={editing?.sort_order ?? 0} />
        </div>
        <div class="form-check" style="align-self:end">
          <input type="checkbox" name="is_visible" id="benefit_visible" checked={editing ? editing.is_visible : true} />
          <label for="benefit_visible">{s.fieldVisible}</label>
        </div>
      </div>
      <div class="form-actions">
        {editing && <a href="/admin/settings/benefits" class="btn btn-ghost">{t.common.cancel}</a>}
        <button type="submit" class="btn btn-primary">{editing ? s.saveSlideBtn : s.addBenefitBtn}</button>
      </div>
    </form>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{s.colIcon}</th><th>{s.colBenefitTitle}</th><th>{s.colOrder}</th><th>{s.colVisible}</th><th>{s.colActions}</th></tr>
      </thead>
      <tbody>
        {items.map((b) => (
          <tr>
            <td style="font-size:20px">{b.icon}</td>
            <td style="font-weight:600">{b.title}</td>
            <td>{b.sort_order}</td>
            <td>{b.is_visible ? t.admin.categories.visible : t.admin.categories.hidden}</td>
            <td class="action-cell">
              <a href={`/admin/settings/benefits?edit=${b.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.common.edit}</a>
              <form method="POST" onsubmit={`return confirm('${t.common.delete}?')`} style="display:inline">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={b.id} />
                <button type="submit" class="btn btn-danger" style="padding:6px 12px;font-size:13px">{t.common.delete}</button>
              </form>
            </td>
          </tr>
        ))}
        {items.length === 0 && (
          <tr><td colspan="5" style="text-align:center;padding:32px;color:var(--text-muted)">{s.noBenefits}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .section-title { font-size:15px; font-weight:700; margin-bottom:16px; }
  .benefit-form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; }
  .action-cell { display:flex; gap:8px; align-items:center; }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>
