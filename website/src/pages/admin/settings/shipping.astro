---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchAllShippingConfigs, updateShippingConfig } from "@shared/services/shippingConfigService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
// Platform-wide, not per-party — gated by role directly, same precedent as party
// creation/closing, not by a MANAGE_SETTINGS bit (which is per-party scoped).
if (!ctx.isOwner) return Astro.redirect("/admin");

const t = useT(Astro);
const s = t.admin.settings;

let success = "";
let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const code = form.get("code") as "ppl" | "packeta";
  const freeAbove = (form.get("free_above_amount") as string) || "";
  const result = await updateShippingConfig(supabase, code, {
    enabled: form.get("enabled") === "on",
    base_price: Number(form.get("base_price") ?? 0),
    free_above_amount: freeAbove === "" ? null : Number(freeAbove),
    sender_name: form.get("sender_name") as string,
    sender_street: form.get("sender_street") as string,
    sender_city: form.get("sender_city") as string,
    sender_postal_code: form.get("sender_postal_code") as string,
    sender_country_code: ((form.get("sender_country_code") as string) || "CZ").toUpperCase().slice(0, 2),
    sender_phone: (form.get("sender_phone") as string) || null,
    sender_email: (form.get("sender_email") as string) || null,
  });
  if (result.error) error = result.error.message;
  else success = s.shippingSaved;
}

const configs = await fetchAllShippingConfigs(supabase);
const mockActive = (code: "ppl" | "packeta") =>
  code === "ppl"
    ? !(import.meta.env.PPL_CLIENT_ID && import.meta.env.PPL_CLIENT_SECRET)
    : !import.meta.env.PACKETA_API_PASSWORD;
---

<CmsLayout title={s.shippingTitle} userPermissions={ctx.permissions} currentPath="/admin/settings/shipping" parties={ctx.parties} partyId={ctx.partyId} isOwner={ctx.isOwner}>
  <p class="owner-notice">{s.shippingOwnerOnlyNotice}</p>
  {success && <div class="alert-success">{success}</div>}
  {error && <div class="alert-error">{error}</div>}

  <div class="provider-cards">
    {configs.map((cfg) => (
      <form method="POST" class="card provider-card">
        <input type="hidden" name="code" value={cfg.code} />
        <h2 class="section-title">{cfg.display_name}</h2>
        {mockActive(cfg.code) && <p class="mock-notice">{s.shippingMockNotice}</p>}

        <label class="checkbox-row">
          <input type="checkbox" name="enabled" checked={cfg.enabled} />
          {s.shippingEnableProvider}
        </label>

        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{s.shippingBasePrice}</label>
            <input class="form-input" type="number" step="0.01" min="0" name="base_price" value={cfg.base_price} />
          </div>
          <div class="form-group">
            <label class="form-label">{s.shippingFreeAbove}</label>
            <input class="form-input" type="number" step="0.01" min="0" name="free_above_amount" value={cfg.free_above_amount ?? ""} />
          </div>
        </div>

        <h3 class="subsection-title">{s.shippingSenderSection}</h3>
        <div class="form-group">
          <label class="form-label">{s.shippingSenderName}</label>
          <input class="form-input" name="sender_name" value={cfg.sender_name} required />
        </div>
        <div class="form-group">
          <label class="form-label">{s.shippingSenderStreet}</label>
          <input class="form-input" name="sender_street" value={cfg.sender_street} required />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{s.shippingSenderCity}</label>
            <input class="form-input" name="sender_city" value={cfg.sender_city} required />
          </div>
          <div class="form-group">
            <label class="form-label">{s.shippingSenderZip}</label>
            <input class="form-input" name="sender_postal_code" value={cfg.sender_postal_code} required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">{s.shippingSenderCountry}</label>
            <input class="form-input" name="sender_country_code" value={cfg.sender_country_code} maxlength="2" style="max-width:80px" required />
          </div>
          <div class="form-group">
            <label class="form-label">{s.shippingSenderPhone}</label>
            <input class="form-input" name="sender_phone" value={cfg.sender_phone ?? ""} />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">{s.shippingSenderEmail}</label>
          <input class="form-input" type="email" name="sender_email" value={cfg.sender_email ?? ""} />
        </div>

        <button type="submit" class="btn btn-primary">{t.common.save}</button>
      </form>
    ))}
  </div>
</CmsLayout>

<style>
  .owner-notice { font-size:13px; color:var(--text-muted); margin-bottom:16px; }
  .alert-success { background:rgba(34,197,94,0.08); border:1px solid #22c55e; border-radius:8px; padding:12px 16px; color:#16a34a; margin-bottom:16px; font-size:14px; }
  .alert-error { background:rgba(239,68,68,0.08); border:1px solid var(--error); border-radius:8px; padding:12px 16px; color:var(--error); margin-bottom:16px; font-size:14px; }
  .provider-cards { display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .provider-card { display:flex; flex-direction:column; gap:12px; }
  .section-title { font-size:18px; font-weight:700; margin:0; }
  .subsection-title { font-size:14px; font-weight:700; margin:8px 0 0; }
  .mock-notice { font-size:12px; color:var(--text-muted); background:var(--bg-subtle); border-radius:6px; padding:8px 10px; margin:0; }
  .checkbox-row { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media(max-width:900px) { .provider-cards { grid-template-columns:1fr; } .form-row { grid-template-columns:1fr; } }
</style>
