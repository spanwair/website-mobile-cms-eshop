---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchCategoryTree, deleteCategory } from "@shared/services/categoryService";
import { requireAdminCtx } from "../../../lib/admin";
import { useT } from "../../../lib/i18n";
import type { CategoryTree } from "@shared/types/index";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const ctx = await requireAdminCtx(supabase, session.user.id);
if (!ctx) return Astro.redirect("/dashboard");
const { permissions, partyId } = ctx;
const t = useT(Astro);

if (Astro.request.method === "POST" && partyId) {
  const form = await Astro.request.formData();
  const categoryId = form.get("category_id") as string;
  if (categoryId) await deleteCategory(supabase, categoryId);
  return Astro.redirect("/admin/categories");
}

const tree = partyId ? await fetchCategoryTree(supabase, partyId) : [];

function renderRows(nodes: CategoryTree[], depth = 0): { node: CategoryTree; depth: number }[] {
  return nodes.flatMap((n) => [{ node: n, depth }, ...renderRows(n.children, depth + 1)]);
}
const rows = renderRows(tree);
---

<CmsLayout title={t.admin.categories.title} userPermissions={permissions} currentPath={Astro.url.pathname}>
  <div class="toolbar">
    <span class="total-label">{rows.length} {t.admin.categories.title.toLowerCase()}</span>
    <a href="/admin/categories/new" class="btn btn-primary">{t.admin.categories.new}</a>
  </div>

  <div class="card" style="padding:0;overflow:hidden">
    <table class="data-table">
      <thead>
        <tr><th>{t.admin.categories.colName}</th><th>{t.admin.categories.colVisibility}</th><th>{t.admin.categories.colChildren}</th><th>{t.admin.categories.colActions}</th></tr>
      </thead>
      <tbody>
        {rows.map(({ node, depth }) => (
          <tr>
            <td>
              <span style={`padding-left:${depth * 20}px;display:inline-block`}>
                {depth > 0 && <span class="tree-indent">└ </span>}
                {node.icon && <span>{node.icon} </span>}
                <span style="font-weight:600">{node.name}</span>
              </span>
            </td>
            <td>
              <span class={`badge ${node.is_visible ? "badge-active" : "badge-inactive"}`}>
                {node.is_visible ? t.admin.categories.visible : t.admin.categories.hidden}
              </span>
            </td>
            <td>{node.children.length}</td>
            <td class="action-cell">
              <a href={`/admin/categories/${node.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{t.common.edit}</a>
              <form method="POST" onsubmit={`return confirm('${t.admin.categories.deleteConfirm}')`} style="display:inline">
                <input type="hidden" name="category_id" value={node.id} />
                <button type="submit" class="btn btn-danger" style="padding:6px 12px;font-size:13px">{t.admin.categories.deleteBtn}</button>
              </form>
            </td>
          </tr>
        ))}
        {rows.length === 0 && (
          <tr><td colspan="4" style="text-align:center;padding:32px;color:var(--text-muted)">{t.admin.categories.noCategories}</td></tr>
        )}
      </tbody>
    </table>
  </div>
</CmsLayout>

<style>
  .toolbar { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; }
  .total-label { font-size:14px; color:var(--text-muted); }
  .tree-indent { color:var(--text-muted); }
  .action-cell { display:flex; gap:8px; align-items:center; }
</style>
