---
import CmsLayout from "../../../components/cms/CmsLayout.astro";
import ImagePicker from "../../../components/cms/ImagePicker.astro";
import { createSupabase } from "../../../lib/supabase";
import { fetchCategory, fetchCategories, updateCategory, deleteCategory } from "@shared/services/categoryService";
import { fetchStoreMedia } from "@shared/services/storeMediaService";
import { requireAdminCtx } from "../../../lib/admin";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";
import { useT } from "../../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
if (!ctx) return Astro.redirect("/");
if (!ctx.partyId) return Astro.redirect(ctx.isOwner ? "/admin/parties/new" : "/admin/setup");
const { permissions, partyId } = ctx;
if (!hasPermission(permissions, PERMISSIONS.MANAGE_CATEGORIES)) return Astro.redirect("/admin");
const t = useT(Astro);

const { id } = Astro.params;

let error = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("action") as string;
  if (action === "delete") {
    await deleteCategory(supabase, id!);
    return Astro.redirect("/admin/categories");
  }
  const result = await updateCategory(supabase, id!, {
    name: form.get("name") as string,
    slug: form.get("slug") as string,
    parent_id: (form.get("parent_id") as string) || null,
    icon: (form.get("icon") as string) || null,
    image_url: (form.get("image_url") as string) || null,
    sort_order: parseInt(form.get("sort_order") as string, 10) || 0,
    is_visible: form.get("is_visible") === "on",
    show_in_nav: form.get("show_in_nav") === "on",
  });
  if (result.error) {
    error = result.error.message;
  } else {
    return Astro.redirect("/admin/categories");
  }
}

const category = await fetchCategory(supabase, id!);
if (!category) return Astro.redirect("/admin/categories");
const categories = (await fetchCategories(supabase, partyId)).filter((c) => c.id !== id);
const media = await fetchStoreMedia(supabase, partyId);
---

<CmsLayout title={t.admin.categories.editTitle} userPermissions={permissions} currentPath="/admin/categories" parties={ctx.parties} partyId={ctx.partyId}>
  <div class="card" style="max-width:560px">
    <a href="/admin/categories" class="back-link">{t.admin.categories.back}</a>
    {error && <div class="form-error" style="margin-bottom:16px">{error}</div>}
    <form method="POST" class="cat-form">
      <div class="form-group">
        <label class="form-label">{t.admin.categories.fieldName}</label>
        <input class="form-input" name="name" required value={category.name} />
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.categories.fieldSlug}</label>
        <input class="form-input" name="slug" required value={category.slug} />
      </div>
      <div class="form-group">
        <label class="form-label">{t.admin.categories.fieldParent}</label>
        <select class="form-input" name="parent_id">
          <option value="">{t.admin.categories.noParentOption}</option>
          {categories.map((c) => (
            <option value={c.id} selected={category.parent_id === c.id}>{c.name}</option>
          ))}
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">{t.admin.categories.fieldIcon}</label>
          <input class="form-input" name="icon" value={category.icon ?? ""} maxlength="10" />
        </div>
        <div class="form-group">
          <label class="form-label">{t.admin.categories.fieldSortOrder}</label>
          <input class="form-input" name="sort_order" type="number" value={category.sort_order} min="0" />
        </div>
      </div>
      <ImagePicker name="image_url" label={t.admin.categories.fieldImage} value={category.image_url} media={media} />
      <div class="form-check">
        <input type="checkbox" name="is_visible" id="is_visible" checked={category.is_visible} />
        <label for="is_visible">{t.admin.categories.fieldVisible}</label>
      </div>
      <div class="form-check">
        <input type="checkbox" name="show_in_nav" id="show_in_nav" checked={category.show_in_nav} />
        <label for="show_in_nav">{t.admin.categories.fieldShowInNav}</label>
      </div>
      <div class="form-actions">
        <div style="display:flex;gap:12px">
          <a href="/admin/categories" class="btn btn-ghost">{t.common.cancel}</a>
          <button type="submit" class="btn btn-primary">{t.admin.categories.saveBtn}</button>
        </div>
      </div>
    </form>
    <form method="POST" class="delete-form" onsubmit={`return confirm('${t.admin.categories.deleteConfirm}')`}>
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="btn btn-danger">{t.admin.categories.deleteBtn}</button>
    </form>
  </div>
</CmsLayout>

<style>
  .back-link { font-size:13px; color:var(--text-muted); display:block; margin-bottom:20px; }
  .back-link:hover { color:var(--text-primary); }
  .cat-form { display:flex; flex-direction:column; gap:16px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; justify-content:flex-end; align-items:center; margin-top:8px; flex-wrap:wrap; gap:8px; }
  .delete-form { margin-top:16px; padding-top:16px; border-top:1px solid var(--border); }
</style>
