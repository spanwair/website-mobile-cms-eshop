---
import CmsLayout from "../../components/cms/CmsLayout.astro";
import { createSupabase } from "../../lib/supabase";
import { requireAdminCtx } from "../../lib/admin";
import { ROLE } from "@shared/constants/permissions";
import { useT } from "../../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

const ctx = await requireAdminCtx(supabase, session.user.id);
if (!ctx) return Astro.redirect("/dashboard");

if (ctx.role >= ROLE.OWNER) return Astro.redirect("/admin");
if (ctx.partyId) return Astro.redirect("/admin");

const t = useT(Astro);
---

<CmsLayout title={t.admin.setup.title} userPermissions={0} currentPath="/admin/setup">
  <div class="card" style="max-width:560px;margin:40px auto;text-align:center;padding:40px">
    <div style="font-size:48px;margin-bottom:16px">🏢</div>
    <h2 style="margin:0 0 12px">{t.admin.setup.heading}</h2>
    <p style="color:var(--text-muted);margin:0 0 24px;line-height:1.6">
      {t.admin.setup.body}
    </p>
    <div style="display:flex;gap:12px;justify-content:center">
      <a href="/dashboard" class="btn btn-ghost">{t.admin.setup.goDashboard}</a>
    </div>
  </div>
</CmsLayout>
