---
import LandingLayout from "../components/landing/LandingLayout.astro";
import PageHero from "../components/landing/PageHero.astro";
import CommissionCalculator from "../components/landing/sections/CommissionCalculator.astro";
import OrderValueBreakdown from "../components/landing/sections/OrderValueBreakdown.astro";
import FinalCta from "../components/landing/sections/FinalCta.astro";
import { useT } from "../lib/i18n";
import { COMMISSION_TIERS, COMMISSION_ENTRY_RATE, NO_ICO_DEDUCTION_RATE } from "@shared/constants/sellerMode";

const t = useT(Astro);
const entryPct = Math.round(COMMISSION_ENTRY_RATE * 100);
const floorPct = Math.round(COMMISSION_TIERS[COMMISSION_TIERS.length - 2].rate * 100);
const employmentPct = Math.round(NO_ICO_DEDUCTION_RATE * 100);
---

<LandingLayout title={`${t.landing.pricingPage.title} — Mamtodoma`} description={t.landing.pricingPage.sub}>
  <PageHero eyebrow={t.landing.pricingPage.eyebrow} title={t.landing.pricingPage.title} lead={t.landing.pricingPage.sub} image="/img/happy-laptop.jpg" imageAlt="">
    <div class="pricing-summary" data-reveal-group>
      <div class="pricing-summary-item" data-reveal>
        <span class="pricing-summary-num font-display tnum">{floorPct}–{entryPct} %</span>
        <span class="pricing-summary-label">{t.landing.pricingPage.summaryCommissionLabel}</span>
      </div>
      <span class="pricing-summary-divider" aria-hidden="true"></span>
      <div class="pricing-summary-item" data-reveal>
        <span class="pricing-summary-num font-display tnum">{employmentPct} %</span>
        <span class="pricing-summary-label">{t.landing.pricingPage.summaryEmploymentLabel}</span>
      </div>
    </div>
  </PageHero>
  <CommissionCalculator />
  <OrderValueBreakdown />
  <section class="landing" id="faq">
    <div class="container-lg">
      <div class="faq-head">
        <h2 class="section-title section-title--center">{t.landing.pricingPage.faqTitle}</h2>
        <p class="section-sub section-sub--center">{t.landing.pricingPage.faqSub}</p>
      </div>
      <div class="faq-list" data-reveal-group>
        {t.landing.pricingPage.faq.map((item) => (
          <details class="faq-item" data-reveal>
            <summary>
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-answer"><p>{item.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
  <FinalCta />
</LandingLayout>

<style>
  /* PageHero defaults to padding-bottom:0, assuming the next section shares its light
     background (see about.astro, which zeroes the next section's padding-top to match).
     Here the next section is the dark CommissionCalculator, so the flush edge reads as
     an abrupt, undesigned cut — restore breathing room before that color change. */
  :global(.page-hero) { padding-bottom: var(--landing-section-y); }

  .pricing-summary {
    display: inline-grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    margin: 32px 0 4px; padding: 16px 4px; max-width: 100%;
    background: var(--bg-surface); border: 1px solid var(--border-default);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
  }
  .pricing-summary-item { display: flex; flex-direction: column; gap: 2px; padding-inline: 22px; }
  .pricing-summary-divider { width: 1px; align-self: stretch; background: var(--border-default); }
  .pricing-summary-num {
    font-size: 26px; font-weight: 800; letter-spacing: -0.02em;
    line-height: 1.15; color: var(--accent-primary);
  }
  .pricing-summary-label { font-size: 12px; line-height: 1.4; color: var(--text-muted); }

  .faq-head { max-width: 560px; margin: 0 auto clamp(2rem, 4vw, 2.75rem); text-align: center; }
  .faq-head .section-sub { margin-inline: auto; margin-bottom: 0; }

  .faq-list { max-width: 760px; margin-inline: auto; border-top: 1px solid var(--border-default); }
  .faq-item { border-bottom: 1px solid var(--border-default); }
  .faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 20px 4px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-size: 16px; font-weight: 700;
    line-height: 1.4; letter-spacing: -0.01em; color: var(--text-primary);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--accent-primary-hover); }
  .faq-item summary:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 2px; border-radius: var(--radius-sm); }
  .faq-icon { position: relative; flex: none; width: 16px; height: 16px; }
  .faq-icon::before,
  .faq-icon::after {
    content: ""; position: absolute; top: 50%; left: 50%; background: currentColor;
    border-radius: 1px; transform: translate(-50%, -50%);
    transition: transform var(--dur-fast) ease, opacity var(--dur-fast) ease;
  }
  .faq-icon::before { width: 14px; height: 1.5px; }
  .faq-icon::after { width: 1.5px; height: 14px; }
  .faq-item[open] .faq-icon::after { transform: translate(-50%, -50%) rotate(90deg); opacity: 0; }
  .faq-answer { padding: 0 48px 22px 4px; }
  .faq-answer p { margin: 0; max-width: 70ch; color: var(--text-muted); font-size: 15px; line-height: 1.7; }

  @media (max-width: 640px) {
    .pricing-summary { width: 100%; padding: 14px 0; }
    .pricing-summary-item { padding-inline: 16px; }
    .pricing-summary-num { font-size: 22px; }
    .pricing-summary-label { font-size: 11.5px; }
    .faq-item summary { font-size: 15px; padding: 18px 2px; gap: 16px; }
    .faq-answer { padding: 0 24px 20px 2px; }
  }
</style>
