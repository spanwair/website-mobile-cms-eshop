---
import LandingLayout from "../components/landing/LandingLayout.astro";
import Hero from "../components/landing/sections/Hero.astro";
import IncludedForFree from "../components/landing/sections/IncludedForFree.astro";
import FoundingSellers from "../components/landing/sections/FoundingSellers.astro";
import LogoMarquee from "../components/landing/LogoMarquee.astro";
import Features from "../components/landing/sections/Features.astro";
import HowItWorks from "../components/landing/sections/HowItWorks.astro";
import CommissionCalculator from "../components/landing/sections/CommissionCalculator.astro";
import ExampleScenarios from "../components/landing/sections/ExampleScenarios.astro";
import NoCompanySelling from "../components/landing/sections/NoCompanySelling.astro";
import RealEshopsShowcase from "../components/landing/sections/RealEshopsShowcase.astro";
import FinalCta from "../components/landing/sections/FinalCta.astro";
// Index block order mirrors Shoptet's homepage structure, mapped to functionality we
// actually ship and rendered in our own brand. Blocks we can't back with truth (faked
// shop counts, press logos, growth chart, avatar testimonials) are intentionally dropped
// or replaced with honest equivalents (ExampleScenarios = labelled illustrative math
// instead of fake reviews). The commission rate-decline chart now lives in Hero itself
// instead of a separate band below it. These stay on disk, unlisted: CreateOwnEshopCta,
// Documentation, TemplatesShowcase.
import { useT } from "../lib/i18n";
import { createSupabase } from "../lib/supabase";
import { listLandingFeaturedStores } from "@shared/services/storeConfigService";
import { LANDING_PROVIDER_LOGOS } from "@shared/constants/providerLogos";

const t = useT(Astro);
const supabase = createSupabase(Astro);
const featuredStores = await listLandingFeaturedStores(supabase);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Mamtodoma",
  url: new URL("/", Astro.site ?? "https://mamtodoma.cz").toString(),
};
const toJsonLd = (data: unknown) => JSON.stringify(data).replace(/</g, "\\u003c");
---

<LandingLayout
  title={t.landing.meta.defaultTitle}
  description={t.landing.meta.defaultDescription}
  preloadImage={{ mobile: "/img/hero-seller-mobile.webp", desktop: "/img/hero-seller.webp" }}
  ambient
>
  <script type="application/ld+json" set:html={toJsonLd(websiteSchema)} />
  <Hero />
  <IncludedForFree />
  <FoundingSellers />
  <LogoMarquee logos={LANDING_PROVIDER_LOGOS} label={t.landing.logoMarquee.label} />
  <Features />
  <HowItWorks />
  <CommissionCalculator />
  <ExampleScenarios />
  <NoCompanySelling />
  <RealEshopsShowcase stores={featuredStores} showCreateCard />
  <FinalCta />
</LandingLayout>
