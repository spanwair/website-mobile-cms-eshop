---
import Layout from "../components/layout/Layout.astro";
import { createSupabase } from "../lib/supabase";
import { fetchProfile, updateProfile } from "@shared/services/profileService";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (!session) return Astro.redirect("/login");

let profile = await fetchProfile(supabase, session.user.id, session.user.email ?? "");
let saved = false;
let saveError: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const displayName = form.get("display_name") as string;
  const { error } = await updateProfile(supabase, session.user.id, { display_name: displayName });
  if (error) saveError = error.message;
  else { saved = true; profile = await fetchProfile(supabase, session.user.id, session.user.email ?? ""); }
}
---

<Layout title="Profile">
  <div class="page container">
    <h1 class="page-title">Profile</h1>

    <div class="card profile-card">
      <div class="avatar">
        {profile?.avatar_url
          ? <img src={profile.avatar_url} alt="Avatar" class="avatar-img" />
          : <span class="avatar-initial">{(profile?.display_name ?? session.user.email ?? "?")[0].toUpperCase()}</span>
        }
      </div>
      <div class="profile-info">
        <span class="profile-name">{profile?.display_name ?? "Unknown"}</span>
        <span class="profile-email">{session.user.email}</span>
        <span class="profile-role">{profile?.role === "admin" ? "Admin" : "User"}</span>
      </div>
    </div>

    <div class="card edit-card">
      <h2 class="section-title">Edit profile</h2>
      {saved && <p class="success-msg">Profile saved!</p>}
      {saveError && <p class="error-msg">{saveError}</p>}
      <form method="POST" class="edit-form">
        <div class="field">
          <label for="display_name">Display name</label>
          <input id="display_name" name="display_name" type="text" value={profile?.display_name ?? ""} placeholder="Your name" />
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
      </form>
    </div>

    <form method="POST" action="/auth/signout">
      <button type="submit" class="btn btn-ghost">Sign out →</button>
    </form>
  </div>
</Layout>

<style>
  .page-title { font-size: 36px; font-weight: 900; color: #fff; margin-bottom: 32px; }
  .profile-card { display: flex; align-items: center; gap: 20px; margin-bottom: 24px; }
  .avatar { width: 72px; height: 72px; border-radius: 50%; overflow: hidden; background: #FF5E1A; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .avatar-img { width: 100%; height: 100%; object-fit: cover; }
  .avatar-initial { font-size: 28px; font-weight: 900; color: #fff; }
  .profile-info { display: flex; flex-direction: column; gap: 4px; }
  .profile-name { font-size: 20px; font-weight: 800; color: #fff; }
  .profile-email { font-size: 13px; color: #B3B3CC; }
  .profile-role { font-size: 11px; font-weight: 700; color: #FF5E1A; text-transform: uppercase; letter-spacing: 0.6px; }
  .edit-card { margin-bottom: 24px; }
  .section-title { font-size: 18px; font-weight: 700; color: #fff; margin-bottom: 20px; }
  .edit-form { display: flex; flex-direction: column; gap: 16px; }
  .field label { display: block; font-size: 12px; font-weight: 700; color: #808099; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
  .success-msg { color: #00E6A0; font-size: 14px; margin-bottom: 12px; }
  .error-msg { color: #FF3B55; font-size: 14px; margin-bottom: 12px; }
</style>
