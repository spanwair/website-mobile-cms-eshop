---
import "../styles/global.css";
import "../styles/landing.css";
import LandingFooter from "../components/landing/LandingFooter.astro";
import { createSupabase, createAdminClient } from "../lib/supabase";
import { useT, getLang } from "../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();

// Invited users arrive here already authenticated (the invite link created their account and
// /auth/callback exchanged it for a session) but without a password. `?invite=1` puts this
// shared registration page into finish-your-registration mode: email is prefilled + locked,
// submit sets the password instead of creating a new account, then lands on /admin.
const inviteMode = session != null && Astro.url.searchParams.get("invite") === "1";
if (session && !inviteMode) return Astro.redirect("/");

const t = useT(Astro);
const lang = getLang(Astro);

let invitePartyName: string | null = null;
if (inviteMode && session) {
  const meta = (session.user.user_metadata ?? {}) as Record<string, string | null>;
  const pendingPartyId = meta["pending_party_id"] ?? null;
  if (pendingPartyId) {
    const { data: party } = await createAdminClient()
      .from("parties").select("name").eq("id", pendingPartyId).single();
    invitePartyName = party?.name ?? null;
  }
}

const prefillEmail = inviteMode ? (session?.user.email ?? "") : (Astro.url.searchParams.get("email") ?? "");
const initialMode = inviteMode || Astro.url.searchParams.get("mode") === "signup" || prefillEmail ? "signup" : "signin";
const rawRedirect = Astro.url.searchParams.get("redirect");
const redirectTo = rawRedirect && rawRedirect.startsWith("/") && !rawRedirect.startsWith("//") ? rawRedirect : "";
// `sp` (storefront party id) is set when the user reaches /login from inside a storefront. It
// marks the signup as a customer of that eshop so handle_new_user() keeps them a plain USER and
// records their home eshop, instead of the default organic-signup ADMIN (seller) path.
const signupPartyId = Astro.url.searchParams.get("sp") ?? "";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" />
    <title>{t.auth.signInOrCreate} - Mamtodoma</title>
  </head>
  <body class="auth-body">
    <header class="auth-topbar">
      <a href="/" class="auth-brand">mamtodoma.cz</a>
      <div class="lang-select">
        <select id="lang-select" aria-label="Language">
          <option value="cs" selected={lang === "cs"}>Čeština</option>
          <option value="en" selected={lang === "en"}>English</option>
        </select>
        <svg class="lang-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="m6 9 6 6 6-6"/></svg>
      </div>
    </header>

    <main class="auth-main">
      <div class="auth-shell">
        <section class="auth-hero" aria-hidden="true">
          <img class="auth-hero-img" src="/img/happy-laptop.jpg" alt="" width="1200" height="900" loading="eager" />
          <div class="auth-hero-badge auth-hero-badge--a">{t.auth.heroBadgeFree}</div>
          <div class="auth-hero-badge auth-hero-badge--b">{t.auth.heroBadgeNoFees}</div>
          <div class="auth-hero-badge auth-hero-badge--c">{t.auth.heroBadgeCards}</div>
          <p class="auth-hero-caption">{t.auth.heroCaption}</p>
        </section>

        <section
          class="auth-col"
          data-signing-in={t.auth.signingIn}
          data-sign-in={t.auth.signIn}
          data-creating={t.auth.creatingAccount}
          data-create={t.auth.createAccount}
          data-err-name={t.auth.errorNameTooShort}
          data-err-pw-short={t.auth.errorPasswordTooShort}
          data-err-pw-mismatch={t.auth.errorPasswordMismatch}
          data-err-already={t.auth.errorAlreadyRegistered}
          data-success-signup={t.auth.successSignUp}
          data-lang={lang}
          data-redirect={redirectTo}
          data-sp={signupPartyId}
          data-invite={inviteMode ? "1" : ""}
        >
          <h1 class="auth-title">{inviteMode ? t.auth.finishRegistrationTitle : t.auth.signInOrCreate}</h1>

          {inviteMode ? (
            <>
              <p class="auth-sub">{t.auth.inviteSubtitlePrefix}</p>
              {invitePartyName && <div class="org-chip">{invitePartyName}</div>}
            </>
          ) : (
            <>
              <p id="error-social" class="auth-error hidden"></p>
              <div class="social-stack">
                <button id="google-btn" class="social-btn" type="button">
                  <svg class="social-ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#EA4335" d="M12 10.2v3.9h5.5c-.24 1.44-1.7 4.2-5.5 4.2-3.3 0-6-2.74-6-6.1s2.7-6.1 6-6.1c1.88 0 3.14.8 3.86 1.49l2.63-2.53C16.9 3.52 14.68 2.5 12 2.5 6.98 2.5 2.9 6.58 2.9 11.6S6.98 20.7 12 20.7c5.76 0 9.56-4.05 9.56-9.75 0-.66-.07-1.16-.16-1.66H12z"/></svg>
                  <span>{t.auth.continueWithGoogle}</span>
                </button>
                <button id="facebook-btn" class="social-btn" type="button">
                  <svg class="social-ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#1877F2" d="M24 12c0-6.63-5.37-12-12-12S0 5.37 0 12c0 5.99 4.39 10.95 10.13 11.85v-8.38H7.08V12h3.05V9.36c0-3 1.79-4.67 4.53-4.67 1.31 0 2.68.24 2.68.24v2.95h-1.51c-1.49 0-1.95.93-1.95 1.87V12h3.32l-.53 3.47h-2.79v8.38C19.61 22.95 24 17.99 24 12z"/></svg>
                  <span>{t.auth.continueWithFacebook}</span>
                </button>
                <button id="linkedin-btn" class="social-btn" type="button">
                  <svg class="social-ic" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#0A66C2" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.8 0 0 .78 0 1.74v20.52C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.74V1.74C24 .78 23.2 0 22.22 0z"/></svg>
                  <span>{t.auth.continueWithLinkedin}</span>
                </button>
              </div>
              <div class="auth-divider"><span>{t.common.or}</span></div>
            </>
          )}

          <div id="mode-signin" class:list={[{ hidden: initialMode === "signup" }]}>
            <p id="error-si" class="auth-error hidden"></p>
            <form id="signin-form" class="auth-form">
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
                <input id="si-email" type="email" placeholder={t.auth.emailPlaceholder} required autocomplete="email" />
              </div>
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input id="si-password" type="password" placeholder={t.auth.passwordPlaceholder} required autocomplete="current-password" />
                <button type="button" class="input-toggle" id="toggle-si-password" aria-label="toggle password visibility">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" width="18" height="18"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                </button>
              </div>
              <button type="submit" class="btn btn-primary btn-block" id="signin-btn">{t.auth.signIn}</button>
            </form>
            <p class="auth-switch">{t.auth.noAccount}<button type="button" class="auth-link" id="to-signup">{t.auth.noAccountLink}</button></p>
          </div>

          <div id="mode-signup" class:list={[{ hidden: initialMode === "signin" }]}>
            <p id="error-su" class="auth-error hidden"></p>
            <p id="success-su" class="auth-success hidden"></p>
            <form id="signup-form" class="auth-form">
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c1-4 4-6 7.5-6s6.5 2 7.5 6"/></svg>
                <input id="su-name" type="text" placeholder={t.auth.fullNamePlaceholder} required autocomplete="name" minlength="2" maxlength="100" />
              </div>
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
                <input id="su-email" type="email" value={prefillEmail} placeholder={t.auth.emailPlaceholder} required autocomplete="email" disabled={inviteMode} class:list={[{ "disabled-input": inviteMode }]} />
              </div>
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input id="su-password" type="password" placeholder={t.auth.passwordPlaceholder} required autocomplete="new-password" minlength="8" />
              </div>
              <div class="input-icon-group">
                <svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <input id="su-confirm" type="password" placeholder={t.auth.confirmPasswordPlaceholder} required autocomplete="new-password" />
              </div>
              <button type="submit" class="btn btn-primary btn-block" id="signup-btn">{inviteMode ? t.auth.setPasswordBtn : t.auth.createAccount}</button>
            </form>
            {!inviteMode && (
              <p class="auth-switch">{t.auth.haveAccount}<button type="button" class="auth-link" id="to-signin">{t.auth.haveAccountLink}</button></p>
            )}
          </div>
        </section>
      </div>
    </main>

    <div class="landing"><LandingFooter /></div>

    <script>
      const sel = document.getElementById("lang-select") as HTMLSelectElement | null;
      sel?.addEventListener("change", () => {
        document.cookie = `lang=${sel.value};path=/;max-age=31536000`;
        window.location.reload();
      });
    </script>

    <script>
      import { createBrowserClient } from "@supabase/ssr";

      const url = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
      const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
      const supabase = createBrowserClient(url, key);

      const panel = document.querySelector(".auth-col") as HTMLElement;
      const d = panel.dataset;

      const redirectPath = (d.redirect && d.redirect.startsWith("/") && !d.redirect.startsWith("//")) ? d.redirect : "";
      const signupPartyId = d.sp || "";
      const inviteMode = d.invite === "1";
      const callbackParams = new URLSearchParams();
      if (redirectPath) callbackParams.set("redirect", redirectPath);
      // Carried for the OAuth path only: social signups can't set user_metadata, so the callback
      // reads `sp` from the URL to classify a brand-new OAuth account as a storefront customer.
      // Email/OTP signups classify via signUp metadata (handle_new_user) and ignore this.
      if (signupPartyId) callbackParams.set("sp", signupPartyId);
      const callbackQuery = callbackParams.toString();
      const callbackUrl = `${window.location.origin}/auth/callback${callbackQuery ? `?${callbackQuery}` : ""}`;

      const modeSignin = document.getElementById("mode-signin")!;
      const modeSignup = document.getElementById("mode-signup")!;

      document.getElementById("to-signup")?.addEventListener("click", () => {
        modeSignin.classList.add("hidden");
        modeSignup.classList.remove("hidden");
      });
      document.getElementById("to-signin")?.addEventListener("click", () => {
        modeSignup.classList.add("hidden");
        modeSignin.classList.remove("hidden");
      });

      function togglePasswordVisibility(inputId: string, btnId: string) {
        const input = document.getElementById(inputId) as HTMLInputElement;
        document.getElementById(btnId)!.addEventListener("click", () => {
          input.type = input.type === "password" ? "text" : "password";
        });
      }
      togglePasswordVisibility("si-password", "toggle-si-password");

      function showError(id: string, msg: string) {
        const el = document.getElementById(id)!;
        el.textContent = msg;
        el.classList.remove("hidden");
      }
      function clearEl(id: string) {
        document.getElementById(id)!.classList.add("hidden");
      }

      type OAuthProvider = "google" | "facebook" | "linkedin_oidc";
      async function oauthSignIn(provider: OAuthProvider) {
        clearEl("error-social");
        const { error } = await supabase.auth.signInWithOAuth({
          provider,
          options: { redirectTo: callbackUrl },
        });
        if (error) showError("error-social", error.message);
      }
      document.getElementById("google-btn")?.addEventListener("click", () => oauthSignIn("google"));
      document.getElementById("facebook-btn")?.addEventListener("click", () => oauthSignIn("facebook"));
      document.getElementById("linkedin-btn")?.addEventListener("click", () => oauthSignIn("linkedin_oidc"));

      document.getElementById("signin-form")!.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearEl("error-si");
        const btn = document.getElementById("signin-btn") as HTMLButtonElement;
        const email = (document.getElementById("si-email") as HTMLInputElement).value.trim();
        const password = (document.getElementById("si-password") as HTMLInputElement).value;
        btn.disabled = true; btn.textContent = d.signingIn!;
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) { showError("error-si", error.message); btn.disabled = false; btn.textContent = d.signIn!; }
        else { window.location.href = redirectPath || "/"; }
      });

      document.getElementById("signup-form")!.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearEl("error-su"); clearEl("success-su");
        const btn = document.getElementById("signup-btn") as HTMLButtonElement;
        const name = (document.getElementById("su-name") as HTMLInputElement).value.trim();
        const email = (document.getElementById("su-email") as HTMLInputElement).value.trim();
        const password = (document.getElementById("su-password") as HTMLInputElement).value;
        const confirm = (document.getElementById("su-confirm") as HTMLInputElement).value;

        if (name.length < 2) { showError("error-su", d.errName!); return; }
        if (password.length < 8) { showError("error-su", d.errPwShort!); return; }
        if (password !== confirm) { showError("error-su", d.errPwMismatch!); return; }

        btn.disabled = true;
        btn.textContent = d.creating!;

        // Invite completion: the user is already authenticated (no password yet). Set the
        // password + name on the existing account instead of creating a new one, then go to
        // the admin area of the org that invited them (activePartyId was pinned in the callback).
        if (inviteMode) {
          const { error: updErr } = await supabase.auth.updateUser({
            password,
            data: { full_name: name, display_name: name },
          });
          if (updErr) { showError("error-su", updErr.message); btn.disabled = false; btn.textContent = d.create!; return; }
          const { data: { user } } = await supabase.auth.getUser();
          if (user) await supabase.from("profiles").update({ display_name: name }).eq("id", user.id);
          window.location.href = redirectPath || "/admin";
          return;
        }

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            emailRedirectTo: callbackUrl,
            data: { full_name: name, display_name: name, lang: d.lang ?? 'cs', ...(signupPartyId ? { signup_party_id: signupPartyId } : {}) },
          },
        });

        if (error) {
          if (error.message.toLowerCase().includes("already registered")) {
            const { error: otpErr } = await supabase.auth.signInWithOtp({
              email,
              options: {
                shouldCreateUser: false,
                emailRedirectTo: callbackUrl,
                data: { lang: d.lang ?? 'cs', ...(signupPartyId ? { signup_party_id: signupPartyId } : {}) },
              },
            });
            if (!otpErr) {
              const el = document.getElementById("success-su")!;
              el.textContent = d.successSignup!;
              el.classList.remove("hidden");
            } else {
              showError("error-su", d.errAlready!);
            }
          } else {
            showError("error-su", error.message);
          }
          btn.disabled = false;
          btn.textContent = d.create!;
          return;
        }

        // With email confirmation enabled, signUp returns no session — the account is
        // inactive until the emailed link is clicked. Forward to a dedicated "check your
        // email" page rather than logging them in. Only if confirmation is disabled (session
        // present) do we go straight in.
        if (data.session) {
          // Auto-confirm environments return a session straight from signUp (no email step).
          // Send a brand-new account into the admin area → onboarding, never the homepage.
          window.location.href = redirectPath || "/admin";
        } else {
          try { sessionStorage.setItem("pendingConfirmEmail", email); } catch { /* ignore */ }
          window.location.href = "/auth/confirm-email";
        }
      });
    </script>

    <style>
      .auth-body {
        /* landing.css scopes the evergreen palette to .landing; this page isn't .landing,
           so pull the brand accent in explicitly instead of falling back to global indigo. */
        --accent-primary: #0E8F63;
        --accent-primary-hover: #0B7450;
        --accent-subtle: #E6F4EE;
        min-height: 100vh; display: flex; flex-direction: column;
        background: var(--bg-page);
      }
      .auth-body input:focus, .auth-body select:focus {
        box-shadow: 0 0 0 4px rgba(14, 143, 99, 0.12);
      }
      .auth-topbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: var(--space-5) var(--space-6); max-width: 1200px; width: 100%; margin: 0 auto;
      }
      .auth-brand { color: var(--accent-primary); font-weight: 800; font-size: 22px; letter-spacing: -0.02em; }
      .lang-select { position: relative; display: inline-flex; align-items: center; }
      .lang-select select {
        appearance: none; -webkit-appearance: none;
        padding: 8px 34px 8px 14px; font: inherit; font-size: 14px; font-weight: 600;
        color: var(--text-primary); background: var(--bg-page);
        border: 1.5px solid var(--border-default); border-radius: var(--radius-sm); cursor: pointer;
      }
      .lang-select select:hover { border-color: var(--border-strong); }
      .lang-caret { position: absolute; right: 10px; pointer-events: none; color: var(--text-muted); }

      .auth-main {
        flex: 1; display: flex; align-items: center; justify-content: center;
        padding: var(--space-5) var(--space-6) var(--space-8);
      }
      .auth-shell {
        display: grid; grid-template-columns: 1.15fr 0.85fr; gap: var(--space-8);
        align-items: center; max-width: 1120px; width: 100%;
      }

      .auth-hero { position: relative; border-radius: var(--radius-xl); overflow: hidden; aspect-ratio: 4 / 3.4; }
      .auth-hero-img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .auth-hero-badge {
        position: absolute; z-index: 2; background: rgba(255,255,255,0.96);
        backdrop-filter: blur(4px); padding: 12px 16px 12px 14px;
        border-left: 4px solid var(--accent-primary); border-radius: 10px;
        font-weight: 700; font-size: 15px; color: var(--text-primary);
        box-shadow: var(--shadow-md); white-space: nowrap;
      }
      .auth-hero-badge--a { left: 7%; top: 52%; }
      .auth-hero-badge--b { right: 6%; top: 38%; }
      .auth-hero-badge--c { left: 22%; bottom: 16%; }
      .auth-hero-caption {
        position: absolute; left: 20px; bottom: 16px; z-index: 2;
        color: rgba(255,255,255,0.9); font-size: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.5);
      }

      .auth-col { width: 100%; max-width: 400px; margin: 0 auto; }
      .auth-title { font-size: 26px; font-weight: 800; color: var(--text-primary); margin-bottom: var(--space-5); letter-spacing: -0.02em; }
      .auth-sub { font-size: 14px; color: var(--text-muted); margin-bottom: var(--space-4); }

      .social-stack { display: flex; flex-direction: column; gap: var(--space-3); }
      .social-btn {
        position: relative; width: 100%; display: flex; align-items: center; justify-content: center;
        gap: var(--space-2); padding: 13px 44px; font-size: 14px; font-weight: 700;
        color: var(--text-primary); background: var(--bg-page);
        border: 1.5px solid var(--border-default); border-radius: var(--radius-sm); cursor: pointer;
        transition: border-color .15s ease, background .15s ease, box-shadow .15s ease;
      }
      .social-btn:hover { border-color: var(--border-strong); box-shadow: var(--shadow-sm); }
      .social-ic { position: absolute; left: 16px; flex-shrink: 0; }

      .auth-divider {
        display: flex; align-items: center; gap: var(--space-3); margin: var(--space-5) 0;
        color: var(--text-placeholder); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em;
      }
      .auth-divider::before, .auth-divider::after { content: ""; flex: 1; height: 1px; background: var(--border-default); }

      .auth-form { display: flex; flex-direction: column; gap: var(--space-3); }
      .auth-form input[type="password"] { padding-right: 42px; }
      .btn-block { width: 100%; padding: 13px; font-size: 15px; }
      .input-toggle {
        position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
        background: none; border: none; padding: 6px; cursor: pointer;
        display: flex; align-items: center; color: var(--text-placeholder);
      }
      .input-toggle:hover { color: var(--text-muted); }
      .disabled-input { background: var(--bg-subtle); color: var(--text-muted); cursor: not-allowed; }
      .org-chip {
        display: block; width: fit-content; max-width: 100%; margin: 0 0 var(--space-5);
        padding: 8px 16px; background: var(--accent-subtle, #E6F4EE); color: var(--accent-primary);
        font-weight: 700; font-size: 15px; border-radius: 10px;
      }
      .auth-error { font-size: 13px; color: var(--error); margin-bottom: var(--space-2); }
      .auth-success { font-size: 13px; color: var(--success); margin-bottom: var(--space-2); }
      .auth-switch { margin-top: var(--space-4); font-size: 14px; color: var(--text-muted); text-align: center; }
      .auth-link {
        background: none; border: none; padding: 0; font: inherit; font-weight: 700;
        color: var(--accent-primary); cursor: pointer;
      }
      .auth-link:hover { text-decoration: underline; }

      @media (max-width: 860px) {
        .auth-shell { grid-template-columns: 1fr; gap: var(--space-6); max-width: 440px; }
        .auth-hero { display: none; }
      }
      @media (max-width: 520px) {
        .auth-topbar { padding: var(--space-4); }
        .auth-main { padding: var(--space-4) var(--space-4) var(--space-6); }
      }
    </style>
  </body>
</html>
