---
import Layout from "../components/layout/Layout.astro";
import { createSupabase } from "../lib/supabase";
import { useT, getLang } from "../lib/i18n";

const supabase = createSupabase(Astro);
const { data: { session } } = await supabase.auth.getSession();
if (session) return Astro.redirect("/dashboard");
const t = useT(Astro);
const lang = getLang(Astro);
---

<Layout title={t.auth.signIn}>
  <div class="page">
    <div class="container">
      <div
        class="auth-card card"
        data-lang={lang}
        data-signing-in={t.auth.signingIn}
        data-sign-in={t.auth.signIn}
        data-creating={t.auth.creatingAccount}
        data-create={t.auth.createAccount}
        data-err-name={t.auth.errorNameTooShort}
        data-err-pw-short={t.auth.errorPasswordTooShort}
        data-err-pw-mismatch={t.auth.errorPasswordMismatch}
        data-err-already={t.auth.errorAlreadyRegistered}
        data-success-signup={t.auth.successSignUp}
      >
        <a href="/" class="auth-brand">Template</a>

        <div id="mode-signin">
          <h1 class="auth-title">{t.auth.welcomeBack}</h1>
          <p class="auth-sub">{t.auth.signInSubtitle}</p>

          <button id="google-btn-si" class="btn btn-secondary full-width google-btn" type="button">
            <span class="google-icon">G</span> {t.auth.continueWithGoogle}
          </button>

          <div class="divider"><span>{t.common.or}</span></div>

          <p id="error-si" class="error-msg hidden"></p>

          <form id="signin-form" class="form">
            <div class="field">
              <label for="si-email">{t.auth.emailLabel}</label>
              <input id="si-email" type="email" placeholder={t.auth.emailPlaceholder} required autocomplete="email" />
            </div>
            <div class="field">
              <label for="si-password">{t.auth.password}</label>
              <input id="si-password" type="password" placeholder={t.auth.passwordPlaceholder} required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary full-width" id="signin-btn">{t.auth.signIn}</button>
          </form>

          <p class="switch-hint">{t.auth.noAccount} <button type="button" class="link-btn" id="to-signup">{t.auth.createAccount}</button></p>
        </div>

        <div id="mode-signup" class="hidden">
          <h1 class="auth-title">{t.auth.createAccount}</h1>
          <p class="auth-sub">{t.auth.createAccountSubtitle}</p>

          <button id="google-btn-su" class="btn btn-secondary full-width google-btn" type="button">
            <span class="google-icon">G</span> {t.auth.continueWithGoogle}
          </button>

          <div class="divider"><span>{t.common.or}</span></div>

          <p id="error-su" class="error-msg hidden"></p>
          <p id="success-su" class="success-msg hidden"></p>

          <form id="signup-form" class="form">
            <div class="field">
              <label for="su-name">{t.auth.fullName}</label>
              <input id="su-name" type="text" placeholder={t.auth.fullNamePlaceholder} required autocomplete="name" minlength="2" maxlength="100" />
            </div>
            <div class="field">
              <label for="su-email">{t.auth.emailLabel}</label>
              <input id="su-email" type="email" placeholder={t.auth.emailPlaceholder} required autocomplete="email" />
            </div>
            <div class="field">
              <label for="su-password">{t.auth.password} <span class="field-hint">{t.auth.passwordHint}</span></label>
              <input id="su-password" type="password" placeholder={t.auth.passwordPlaceholder} required autocomplete="new-password" minlength="8" />
            </div>
            <div class="field">
              <label for="su-confirm">{t.auth.confirmPassword}</label>
              <input id="su-confirm" type="password" placeholder={t.auth.confirmPasswordPlaceholder} required autocomplete="new-password" />
            </div>
            <button type="submit" class="btn btn-primary full-width" id="signup-btn">{t.auth.createAccount}</button>
          </form>

          <p class="switch-hint">{t.auth.haveAccount} <button type="button" class="link-btn" id="to-signin">{t.auth.signIn}</button></p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { createBrowserClient } from "@supabase/ssr";

  const url = import.meta.env.PUBLIC_SUPABASE_URL ?? "";
  const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? "";
  const supabase = createBrowserClient(url, key);

  const card = document.querySelector(".auth-card") as HTMLElement;
  const d = card.dataset;

  const modeSignin = document.getElementById("mode-signin")!;
  const modeSignup = document.getElementById("mode-signup")!;

  document.getElementById("to-signup")!.addEventListener("click", () => {
    modeSignin.classList.add("hidden");
    modeSignup.classList.remove("hidden");
  });
  document.getElementById("to-signin")!.addEventListener("click", () => {
    modeSignup.classList.add("hidden");
    modeSignin.classList.remove("hidden");
  });

  function showError(id: string, msg: string) {
    const el = document.getElementById(id)!;
    el.textContent = msg;
    el.classList.remove("hidden");
  }
  function clearEl(id: string) {
    document.getElementById(id)!.classList.add("hidden");
  }

  async function googleSignIn() {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: `${window.location.origin}/auth/callback` },
    });
    if (error) showError("error-si", error.message);
  }
  document.getElementById("google-btn-si")!.addEventListener("click", googleSignIn);
  document.getElementById("google-btn-su")!.addEventListener("click", googleSignIn);

  document.getElementById("signin-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearEl("error-si");
    const btn = document.getElementById("signin-btn") as HTMLButtonElement;
    const email = (document.getElementById("si-email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("si-password") as HTMLInputElement).value;
    btn.disabled = true; btn.textContent = d.signingIn!;
    const { error } = await supabase.auth.signInWithPassword({ email, password });
    if (error) { showError("error-si", error.message); btn.disabled = false; btn.textContent = d.signIn!; }
    else { window.location.href = "/dashboard"; }
  });

  document.getElementById("signup-form")!.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearEl("error-su"); clearEl("success-su");
    const btn = document.getElementById("signup-btn") as HTMLButtonElement;
    const name = (document.getElementById("su-name") as HTMLInputElement).value.trim();
    const email = (document.getElementById("su-email") as HTMLInputElement).value.trim();
    const password = (document.getElementById("su-password") as HTMLInputElement).value;
    const confirm = (document.getElementById("su-confirm") as HTMLInputElement).value;

    if (name.length < 2) { showError("error-su", d.errName!); return; }
    if (password.length < 8) { showError("error-su", d.errPwShort!); return; }
    if (password !== confirm) { showError("error-su", d.errPwMismatch!); return; }

    btn.disabled = true;
    btn.textContent = d.creating!;

    const { data, error } = await supabase.auth.signUp({
      email,
      password,
      options: { data: { full_name: name, display_name: name } },
    });

    if (error) {
      if (error.message.toLowerCase().includes("already registered")) {
        // User exists (invited or confirmed) — send a magic link so they can log in without a password
        const { error: otpErr } = await supabase.auth.signInWithOtp({
          email,
          options: {
            shouldCreateUser: false,
            emailRedirectTo: `${window.location.origin}/auth/callback`,
            data: { lang: d.lang ?? 'cs' },
          },
        });
        if (!otpErr) {
          const el = document.getElementById("success-su")!;
          el.textContent = d.successSignup!;
          el.classList.remove("hidden");
        } else {
          showError("error-su", d.errAlready!);
        }
      } else {
        showError("error-su", error.message);
      }
      btn.disabled = false;
      btn.textContent = d.create!;
      return;
    }

    if (data.session) {
      window.location.href = "/dashboard";
    } else {
      const el = document.getElementById("success-su")!;
      el.textContent = d.successSignup!;
      el.classList.remove("hidden");
      btn.disabled = false;
      btn.textContent = d.create!;
    }
  });
</script>

<style>
  .page { display: flex; align-items: center; min-height: calc(100vh - 64px); }
  .auth-card { max-width: 420px; margin: 0 auto; padding: 40px; }
  .auth-brand { font-size: 22px; font-weight: 900; color: #4F46E5; display: block; text-align: center; margin-bottom: 28px; text-decoration: none; }
  .auth-title { font-size: 24px; font-weight: 800; color: #212529; margin-bottom: 4px; text-align: center; }
  .auth-sub { font-size: 14px; color: #6C757D; text-align: center; margin-bottom: 24px; }
  .google-icon { font-size: 16px; font-weight: 900; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .field label { display: block; font-size: 12px; font-weight: 700; color: #6C757D; text-transform: uppercase; letter-spacing: 0.6px; margin-bottom: 6px; }
  .field-hint { font-weight: 400; text-transform: none; letter-spacing: 0; font-size: 11px; }
  .field input { display: block; }
  .full-width { width: 100%; }
  .switch-hint { font-size: 13px; color: #6C757D; text-align: center; margin-top: 20px; }
  .link-btn { background: none; border: none; color: #4F46E5; font-size: 13px; font-weight: 600; cursor: pointer; padding: 0; font-family: inherit; }
  .divider { display: flex; align-items: center; gap: 12px; margin: 20px 0; color: #ADB5BD; font-size: 12px; }
  .divider::before, .divider::after { content: ""; flex: 1; height: 1px; background: #E9ECEF; }
  .error-msg { color: #EF4444; font-size: 13px; margin-bottom: 8px; }
  .success-msg { color: #10B981; font-size: 13px; margin-bottom: 8px; }
</style>
