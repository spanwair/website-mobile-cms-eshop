---
import LandingLayout from "../components/landing/LandingLayout.astro";
import PageHero from "../components/landing/PageHero.astro";
import TemplatesShowcase from "../components/landing/sections/TemplatesShowcase.astro";
import FinalCta from "../components/landing/sections/FinalCta.astro";
import { useT } from "../lib/i18n";

const t = useT(Astro);
---

<LandingLayout title={`${t.landing.templatesPage.title} — Mamtodoma`} description={t.landing.templatesPage.sub}>
  <PageHero eyebrow={t.landing.templatesPage.eyebrow} title={t.landing.templatesPage.title} lead={t.landing.templatesPage.sub} image="/img/template-fashion.jpg" imageAlt="" />
  <section class="landing">
    <div class="container-lg">
      <h2 class="section-title section-title--center">{t.landing.templatesPage.demosTitle}</h2>
      <p class="section-sub section-sub--center">{t.landing.templatesPage.demosSub}</p>
      <div class="demo-grid">
        {t.landing.templatesPage.demos.map((demo) => (
          <a href={demo.href} class="demo-card karta" target="_blank" rel="noopener">
            <img class="demo-card-preview" src={demo.image} alt={demo.title} loading="lazy" />
            <div class="demo-card-body">
              <strong>{demo.title}</strong>
              <span>{demo.desc}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <TemplatesShowcase />
  <FinalCta />
</LandingLayout>

<style>
  .demo-grid { display: grid; gap: 20px; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 32px; }
  .demo-card {
    display: flex; flex-direction: column; overflow: hidden;
    border: 1px solid var(--border-default); border-radius: var(--radius-lg);
    background: var(--bg-page); text-decoration: none; color: inherit;
    transition: border-color 0.15s ease;
  }
  .demo-card:hover { border-color: var(--accent-primary); text-decoration: none; }
  .demo-card-preview { width: 100%; aspect-ratio: 16/10; object-fit: cover; object-position: top; display: block; background: var(--bg-subtle); }
  .demo-card-body { display: flex; flex-direction: column; gap: 6px; padding: 20px 24px; }
  .demo-card strong { font-size: 16px; }
  .demo-card span { color: var(--text-muted); font-size: 14px; }

  @media (max-width: 700px) {
    .demo-grid { grid-template-columns: 1fr; }
  }
</style>
