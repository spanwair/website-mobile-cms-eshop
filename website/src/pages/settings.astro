---
import LandingLayout from "../components/landing/LandingLayout.astro";
import SettingsPanel from "../components/account/SettingsPanel.astro";
import { runSettingsPage } from "../lib/accountForms";
import { useT } from "../lib/i18n";

const result = await runSettingsPage(Astro);
if (result.redirect) return Astro.redirect(result.redirect);

const t = useT(Astro);
---

<LandingLayout title={`${t.settings.title} — Mamtodoma`} description={t.landing.meta.defaultDescription}>
  <section class="landing">
    <SettingsPanel
      displayName={result.displayName}
      email={result.email}
      currentLang={result.currentLang}
      hasEmailAuth={result.hasEmailAuth}
      success={result.success}
      error={result.error}
    />
  </section>
</LandingLayout>
