---
import "../../styles/global.css";
import { createSupabase } from "../../lib/supabase";
import { useT } from "../../lib/i18n";
import { requireAdminCtx } from "../../lib/admin";
import { ROLE } from "@shared/constants/permissions";
import { buildThemeCss, googleFontsUrl } from "../../lib/themeEngine";
import { fetchStoreMedia } from "@shared/services/storeMediaService";
import { fetchCartItemCount } from "@shared/services/cartService";
import { fetchStorefrontNavTree } from "@shared/services/navItemService";
import { fetchVisibleFooterLinks } from "@shared/services/footerLinkService";
import { fetchVisibleFooterBadges } from "@shared/services/footerBadgeService";
import Footer from "./Footer.astro";
import StorefrontNav from "./StorefrontNav.astro";
import ProfileMenu from "./ProfileMenu.astro";

interface Props {
  title?: string;
}
const storeParty = Astro.locals.storeParty;
const storeConfig = storeParty?.config ?? null;
const brandName = storeConfig?.brand_name ?? "Template";
const { title = brandName } = Astro.props;
const faviconUrl = storeConfig?.favicon_url ?? "/favicon.png";
const customFontsUrl = googleFontsUrl(storeConfig);

// A storefront-shaped page (/shop*, /eshop-[slug]*) with a resolved storeParty (custom
// domain, subdomain, or the /eshop-[partySlug] path itself) should behave like visiting that
// org's own dedicated site: the generic app nav (Obchod link, profile dropdown) never appears,
// and every in-page link stays scoped to this org rather than bouncing to the shared app/generic /shop.
// Gated on pathname too, not just storeParty — a staff member managing their org from its own
// custom domain must still reach /admin on that same domain.
const pathname = Astro.url.pathname;
const partySlug = Astro.params.partySlug as string | undefined;
const isStorefrontPage = pathname === "/shop" || pathname.startsWith("/shop/") || !!partySlug;
const isStorefront = isStorefrontPage && !!storeParty;
const shopHref = partySlug ? `/eshop-${partySlug}` : "/shop";
const brandHref = isStorefront ? shopHref : "/";

// The admin panel has its own layout (CmsLayout) and no storefront chrome — the storefront
// footer (with its own newsletter panel, badges, links) has no place there.
const isAdminPage = pathname === "/admin" || pathname.startsWith("/admin/");

const supabase = createSupabase(Astro);
const footerMedia = !isAdminPage && storeParty ? await fetchStoreMedia(supabase, storeParty.id) : [];
const navTree = storeParty ? await fetchStorefrontNavTree(supabase, storeParty.id, shopHref) : [];
const footerLinks = !isAdminPage && storeParty ? await fetchVisibleFooterLinks(supabase, storeParty.id) : [];
const footerBadges = !isAdminPage && storeParty ? await fetchVisibleFooterBadges(supabase, storeParty.id) : [];
const { data: { session } } = await supabase.auth.getSession();
const t = useT(Astro);

let displayName: string | null = null;
let isAdmin = false;
let obchodHref: string | null = null;
if (session) {
  const { data } = await supabase
    .from("profiles")
    .select("display_name, role")
    .eq("id", session.user.id)
    .single();
  displayName = data?.display_name ?? session.user.email?.split("@")[0] ?? null;

  const activePartyId = Astro.cookies.get("activePartyId")?.value ?? null;
  const ctx = await requireAdminCtx(supabase, session.user.id, activePartyId);
  isAdmin = ctx !== null && (ctx.role >= ROLE.ADMIN || ctx.parties.length > 0);

  // Obchod jumps straight into whichever org is currently active (party switcher
  // cookie, or the user's first assigned org) — hidden entirely when they have none.
  if (ctx?.partyId) {
    const activeParty = ctx.parties.find((p) => p.id === ctx.partyId);
    if (activeParty) obchodHref = `/eshop-${activeParty.slug}`;
  }
}
const navInitial = displayName?.[0]?.toUpperCase() ?? "?";
const cartCount = isStorefront && session && storeParty
  ? await fetchCartItemCount(supabase, session.user.id, storeParty.id)
  : 0;
const currentPath = Astro.url.pathname + Astro.url.search;
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href={faviconUrl} />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet" />
    {customFontsUrl && <link href={customFontsUrl} rel="stylesheet" />}
    <style set:html={buildThemeCss(storeConfig)} />
  </head>
  <body>
    {isStorefront ? (
      <StorefrontNav
        storeConfig={storeConfig}
        brandName={brandName}
        brandHref={brandHref}
        shopHref={shopHref}
        hasSession={!!session}
        displayName={displayName}
        navInitial={navInitial}
        cartCount={cartCount}
        currentPath={currentPath}
        navTree={navTree}
        partyId={storeParty?.id ?? null}
        isAdmin={isAdmin}
      />
    ) : (
      <nav class="nav">
        <div class="container nav-inner">
          <a href={brandHref} class="nav-brand">{brandName}</a>
          {obchodHref && (
            <div class="nav-links">
              <a href={obchodHref}>{t.nav.shop}</a>
            </div>
          )}
          <div class="nav-right">
            {session ? (
              <ProfileMenu displayName={displayName} navInitial={navInitial} isAdmin={isAdmin} />
            ) : (
              <a href="/login" class="btn btn-primary nav-cta">{t.nav.signIn}</a>
            )}
          </div>
        </div>
      </nav>
    )}
    <main>
      <slot />
    </main>
    {!isAdminPage && (
      <Footer storeConfig={storeConfig} media={footerMedia} footerLinks={footerLinks} footerBadges={footerBadges} shopHref={shopHref} />
    )}
  </body>
</html>

<style>
  /* Scoped to this component only (Astro's per-file style attribute), so it overrides the
     shared global .nav rule here without touching StorefrontNav's own .nav — that one must
     keep tracking the per-store --bg-page theme color instead of a fixed translucent white. */
  .nav { background: rgba(255,255,255,0.85); backdrop-filter: blur(8px); box-shadow: none; }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-block: 16px; }
  .nav-brand { font-weight: 800; font-size: 18px; color: var(--text-primary); letter-spacing: -0.5px; flex-shrink: 0; text-decoration: none; }
  .nav-links { display: flex; gap: 24px; flex: 1; }
  .nav-links a { font-size: 14px; font-weight: 600; color: var(--text-muted); text-decoration: none; }
  .nav-links a:hover { color: var(--accent-primary); }
  .nav-right { margin-left: auto; }
  .nav-cta { padding: 8px 20px; font-size: 14px; }

  /* .nav-links has no min-width:0, so by default it refuses to shrink below its content
     width and forces the whole bar wider than the viewport on any narrow screen. Found via
     mobile E2E testing (iPhone 13, 390px) — collapse to icon-only profile + brand below the
     point where links+name no longer fit, rather than letting the page scroll horizontally. */
  @media (max-width: 640px) {
    .nav-links { display: none; }
  }
</style>
