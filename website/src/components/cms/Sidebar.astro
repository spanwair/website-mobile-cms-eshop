---
import { useT } from "../../lib/i18n";
import { PERMISSIONS, hasPermission } from "@shared/constants/permissions";

interface Props {
  currentPath: string;
  userPermissions: number;
  storeHref?: string | null;
}
const { currentPath, userPermissions, storeHref = null } = Astro.props;
const t = useT(Astro);
const s = t.admin.sidebar;

function can(perm: number) {
  return hasPermission(userPermissions, perm);
}

function isActive(path: string) {
  return currentPath === path || currentPath.startsWith(path + "/");
}

const groups = [
  {
    label: s.overview,
    items: [
      { href: "/admin", label: s.overview, icon: "📊", perm: PERMISSIONS.VIEW_DASHBOARD, exact: true },
    ],
  },
  {
    label: s.eshop,
    items: [
      { href: "/admin/products",   label: s.products,   icon: "🛍️", perm: PERMISSIONS.MANAGE_PRODUCTS },
      { href: "/admin/categories", label: s.categories, icon: "📦", perm: PERMISSIONS.MANAGE_CATEGORIES },
      { href: "/admin/orders",     label: s.orders,     icon: "📋", perm: PERMISSIONS.MANAGE_ORDERS },
      { href: "/admin/customers",  label: s.customers,  icon: "👥", perm: PERMISSIONS.MANAGE_CUSTOMERS },
      { href: "/admin/pricing",    label: s.pricing,    icon: "💰", perm: PERMISSIONS.MANAGE_PRICING },
      { href: "/admin/inventory",  label: s.inventory,  icon: "🏭", perm: PERMISSIONS.MANAGE_INVENTORY },
      { href: "/admin/reviews",    label: s.reviews,    icon: "⭐", perm: PERMISSIONS.MANAGE_PRODUCTS },
      { href: "/admin/returns",    label: s.returns,    icon: "↩️", perm: PERMISSIONS.MANAGE_ORDERS },
      { href: "/admin/products/conditions", label: s.conditions, icon: "🏷️", perm: PERMISSIONS.MANAGE_PRODUCTS },
    ],
  },
  {
    label: s.content,
    items: [
      { href: "/admin/cms/navigation", label: s.navigation, icon: "🧭", perm: PERMISSIONS.MANAGE_CMS },
      { href: "/admin/cms/pages",      label: s.pages,      icon: "📄", perm: PERMISSIONS.MANAGE_CMS },
      { href: "/admin/cms/blog",       label: s.blog,       icon: "📰", perm: PERMISSIONS.MANAGE_CMS },
      { href: "/admin/cms/team",       label: s.team,       icon: "🧑‍🤝‍🧑", perm: PERMISSIONS.MANAGE_CMS },
      { href: "/admin/cms/faq",        label: s.faq,        icon: "❓", perm: PERMISSIONS.MANAGE_CMS },
    ],
  },
  {
    label: s.reports,
    items: [
      { href: "/admin/reports", label: s.reportsSub, icon: "📈", perm: PERMISSIONS.MANAGE_REPORTS },
    ],
  },
  {
    label: s.people,
    items: [
      { href: "/admin/users",   label: s.users,   icon: "👤", perm: PERMISSIONS.MANAGE_USERS },
      { href: "/admin/roles",   label: s.roles,   icon: "🔑", perm: PERMISSIONS.MANAGE_ROLES },
      { href: "/admin/parties", label: s.parties, icon: "🏢", perm: PERMISSIONS.MANAGE_USERS },
    ],
  },
  {
    label: s.system,
    items: [
      { href: "/admin/settings/branding", label: s.settings,      icon: "🎨", perm: PERMISSIONS.MANAGE_SETTINGS },
      { href: "/admin/payouts",           label: s.payouts,       icon: "💸", perm: PERMISSIONS.MANAGE_AUDIT },
      { href: "/admin/audit",             label: s.audit,         icon: "📝", perm: PERMISSIONS.MANAGE_AUDIT },
      { href: "/admin/notifications",     label: s.notifications, icon: "🔔", perm: 0 },
    ],
  },
];
---

<aside class="sidebar">
  <div class="sidebar-logo">
    <a href="/">{t.auth.brandName}</a>
  </div>
  {storeHref && (
    <a href={storeHref} target="_blank" rel="noopener" class="nav-item nav-item--store">
      <span class="nav-icon">🏬</span>
      <span>{s.store}</span>
      <span class="nav-item-store-external">↗</span>
    </a>
  )}
  <nav class="sidebar-nav">
    {groups.map((group) => {
      const visibleItems = group.items.filter(item => item.perm === 0 || can(item.perm));
      if (visibleItems.length === 0) return null;
      return (
        <div class="nav-group">
          <p class="nav-group-label">{group.label}</p>
          {visibleItems.map((item) => {
            const active = item.exact
              ? currentPath === item.href
              : isActive(item.href);
            return (
              <a
                href={item.href}
                class={`nav-item${active ? " nav-item--active" : ""}`}
              >
                <span class="nav-icon">{item.icon}</span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </div>
      );
    })}
  </nav>
</aside>

<style>
  .sidebar {
    width: 240px; min-width: 240px; height: 100vh; position: sticky; top: 0;
    background: var(--bg-page); border-right: 1px solid var(--border-default);
    display: flex; flex-direction: column; overflow-y: auto;
  }
  .sidebar-logo { padding: 20px 16px; border-bottom: 1px solid var(--border-default); }
  .sidebar-logo a { font-size: 18px; font-weight: 900; color: var(--accent-primary); text-decoration: none; letter-spacing: -0.5px; }
  .sidebar-nav { padding: 12px 8px; flex: 1; }
  .nav-group { margin-bottom: 20px; }
  .nav-group-label { font-size: 10px; font-weight: 700; color: var(--text-placeholder); text-transform: uppercase; letter-spacing: 1px; padding: 0 8px; margin-bottom: 4px; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius-sm); font-size: 14px; font-weight: 500; color: var(--text-muted); text-decoration: none; transition: background 0.1s, color 0.1s; }
  .nav-item:hover { background: var(--bg-subtle); color: var(--text-primary); text-decoration: none; }
  .nav-item--active { background: var(--accent-primary); color: #fff; }
  .nav-item--active:hover { background: var(--accent-primary-hover); color: #fff; }
  .nav-icon { font-size: 16px; flex-shrink: 0; }

  /* Only outbound link in the sidebar (leaves the admin panel for the live storefront) — needs
     to read as visually distinct from the internal page tabs below it, not blend in as one more. */
  .nav-item--store {
    margin: 12px 12px 4px; padding: 10px 12px;
    background: rgba(79,70,229,0.08); border: 1.5px dashed var(--accent-primary);
    color: var(--accent-primary); font-weight: 700;
  }
  .nav-item--store:hover { background: rgba(79,70,229,0.14); color: var(--accent-primary); }
  .nav-item-store-external { margin-left: auto; font-size: 13px; }
</style>
