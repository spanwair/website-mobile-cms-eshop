---
import { useT } from "../../lib/i18n";

interface Props {
  currentPath: string;
  userPermissions: number;
}
const { currentPath, userPermissions } = Astro.props;
const t = useT(Astro);
const s = t.admin.sidebar;

const PERM = {
  VIEW_DASHBOARD: 1,
  MANAGE_USERS: 2,
  MANAGE_ROLES: 4,
  MANAGE_PRODUCTS: 8,
  MANAGE_CATEGORIES: 16,
  MANAGE_ORDERS: 32,
  MANAGE_INVENTORY: 64,
  MANAGE_PRICING: 128,
  MANAGE_CUSTOMERS: 256,
  MANAGE_REPORTS: 512,
  MANAGE_AUDIT: 4096,
};

function can(perm: number) {
  return (userPermissions & perm) !== 0;
}

function isActive(path: string) {
  return currentPath === path || currentPath.startsWith(path + "/");
}

const groups = [
  {
    label: s.overview,
    items: [
      { href: "/admin", label: s.overview, icon: "📊", perm: PERM.VIEW_DASHBOARD, exact: true },
    ],
  },
  {
    label: s.eshop,
    items: [
      { href: "/admin/products", label: s.products, icon: "🛍️", perm: PERM.MANAGE_PRODUCTS },
      { href: "/admin/categories", label: s.categories, icon: "📦", perm: PERM.MANAGE_CATEGORIES },
      { href: "/admin/orders", label: s.orders, icon: "📋", perm: PERM.MANAGE_ORDERS },
      { href: "/admin/customers", label: s.customers, icon: "👥", perm: PERM.MANAGE_CUSTOMERS },
      { href: "/admin/pricing", label: s.pricing, icon: "💰", perm: PERM.MANAGE_PRICING },
      { href: "/admin/inventory", label: s.inventory, icon: "🏭", perm: PERM.MANAGE_INVENTORY },
      { href: "/admin/reviews", label: s.reviews, icon: "⭐", perm: PERM.MANAGE_PRODUCTS },
      { href: "/admin/returns", label: s.returns, icon: "↩️", perm: PERM.MANAGE_ORDERS },
    ],
  },
  {
    label: s.reports,
    items: [
      { href: "/admin/reports", label: s.reportsSub, icon: "📈", perm: PERM.MANAGE_REPORTS },
    ],
  },
  {
    label: s.people,
    items: [
      { href: "/admin/users", label: s.users, icon: "👤", perm: PERM.MANAGE_USERS },
      { href: "/admin/roles", label: s.roles, icon: "🔑", perm: PERM.MANAGE_ROLES },
      { href: "/admin/parties", label: s.parties, icon: "🏢", perm: 0 },
    ],
  },
  {
    label: s.system,
    items: [
      { href: "/admin/audit", label: s.audit, icon: "📝", perm: PERM.MANAGE_AUDIT },
      { href: "/admin/notifications", label: s.notifications, icon: "🔔", perm: 0 },
    ],
  },
];
---

<aside class="sidebar">
  <div class="sidebar-logo">
    <a href="/">Template</a>
  </div>
  <nav class="sidebar-nav">
    {groups.map((group) => {
      const visibleItems = group.items.filter(item => item.perm === 0 || can(item.perm));
      if (visibleItems.length === 0) return null;
      return (
        <div class="nav-group">
          <p class="nav-group-label">{group.label}</p>
          {visibleItems.map((item) => {
            const active = item.exact
              ? currentPath === item.href
              : isActive(item.href);
            return (
              <a
                href={item.href}
                class={`nav-item${active ? " nav-item--active" : ""}`}
              >
                <span class="nav-icon">{item.icon}</span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </div>
      );
    })}
  </nav>
</aside>

<style>
  .sidebar {
    width: 240px; min-width: 240px; height: 100vh; position: sticky; top: 0;
    background: #FFFFFF; border-right: 1px solid #E9ECEF;
    display: flex; flex-direction: column; overflow-y: auto;
  }
  .sidebar-logo { padding: 20px 16px; border-bottom: 1px solid #E9ECEF; }
  .sidebar-logo a { font-size: 18px; font-weight: 900; color: #4F46E5; text-decoration: none; letter-spacing: -0.5px; }
  .sidebar-nav { padding: 12px 8px; flex: 1; }
  .nav-group { margin-bottom: 20px; }
  .nav-group-label { font-size: 10px; font-weight: 700; color: #ADB5BD; text-transform: uppercase; letter-spacing: 1px; padding: 0 8px; margin-bottom: 4px; }
  .nav-item { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; font-size: 14px; font-weight: 500; color: #6C757D; text-decoration: none; transition: background 0.1s, color 0.1s; }
  .nav-item:hover { background: #F1F3F5; color: #212529; text-decoration: none; }
  .nav-item--active { background: #4F46E5; color: #FFFFFF; }
  .nav-item--active:hover { background: #4338CA; color: #FFFFFF; }
  .nav-icon { font-size: 16px; flex-shrink: 0; }
</style>
