---
import type { ContentFormat, StoreMedia } from "@shared/types";
import { renderContent } from "../../lib/contentRenderer";
import { useT } from "../../lib/i18n";

interface Props {
  name: "hero" | "subhero" | "footer";
  label: string;
  content: string | null;
  format: ContentFormat;
  media: StoreMedia[];
}
const { name, label, content, format, media } = Astro.props;
const t = useT(Astro);
const s = t.admin.settings;
const preview = content ? renderContent(content, format, media) : null;
---

<div class="card">
  <h2 class="section-title">{label}</h2>
  <div class="format-row">
    <span class="form-label">{s.fieldFormat}</span>
    <label class="radio-label">
      <input type="radio" name={`${name}_format`} value="markdown" checked={format === "markdown"} />
      {s.formatMarkdown}
    </label>
    <label class="radio-label">
      <input type="radio" name={`${name}_format`} value="html" checked={format === "html"} />
      {s.formatHtml}
    </label>
  </div>
  <div class="form-group">
    <label class="form-label">{s.fieldContent}</label>
    <textarea name={`${name}_content`} class="form-input content-textarea" rows="6">{content ?? ""}</textarea>
  </div>
  <div class="preview-wrap">
    <span class="form-label">{s.previewLabel}</span>
    {preview ? (
      <div class="preview-box" set:html={preview} />
    ) : (
      <p class="preview-empty">{s.previewEmpty}</p>
    )}
  </div>
</div>

<style>
  .section-title { font-size:15px; font-weight:700; margin-bottom:16px; }
  .format-row { display:flex; align-items:center; gap:16px; margin-bottom:16px; }
  .radio-label { display:flex; align-items:center; gap:6px; font-size:14px; }
  .content-textarea { font-family:monospace; font-size:13px; resize:vertical; }
  .preview-wrap { margin-top:16px; }
  .preview-box { border:1px solid var(--border-default); border-radius:8px; padding:16px; margin-top:6px; }
  .preview-empty { color:var(--text-muted); font-size:13px; margin-top:6px; }
</style>
