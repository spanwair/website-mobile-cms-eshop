---
interface ComboboxOption { label: string; value: string }

interface Props {
  name: string;
  value?: string | null;
  options: ComboboxOption[];
  placeholder?: string;
  id?: string;
  required?: boolean;
  createLabel: string;
  urlOnly?: boolean;
}

const {
  name, value = "", options, placeholder = "", id, required = false, createLabel, urlOnly = false,
} = Astro.props;
const inputId = id ?? name;
---

<div class="combobox" data-create-label={createLabel} data-url-only={urlOnly ? "true" : "false"}>
  <input
    class="form-input combobox-input"
    type="text"
    name={name}
    id={inputId}
    value={value ?? ""}
    placeholder={placeholder}
    required={required}
    autocomplete="off"
    role="combobox"
    aria-expanded="false"
    aria-autocomplete="list"
  />
  <ul class="combobox-list" role="listbox" hidden></ul>
  <script type="application/json" class="combobox-data" set:html={JSON.stringify(options)} />
</div>

<style is:global>
  .combobox { position: relative; }
  .combobox-list {
    position: absolute; top: calc(100% + 4px); left: 0; right: 0; z-index: 20;
    background: var(--bg-page); border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm); box-shadow: var(--shadow-md);
    max-height: 260px; overflow-y: auto; list-style: none; margin: 0; padding: 4px;
  }
  .combobox-option {
    display: flex; flex-direction: column; gap: 2px;
    padding: 8px 10px; border-radius: 6px; cursor: pointer; line-height: 1.3;
  }
  .combobox-option + .combobox-option { margin-top: 1px; }
  .combobox-option:hover, .combobox-option.active { background: var(--bg-subtle); }
  .combobox-option-label { font-size: 13px; font-weight: 600; color: var(--text-primary); }
  .combobox-option-value {
    font-size: 12px; color: var(--text-muted);
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .combobox-create {
    font-size: 13px; font-weight: 700; color: var(--accent-primary);
    background: rgba(79,70,229,0.08); margin-bottom: 4px;
  }
  .combobox-create:hover, .combobox-create.active { background: rgba(79,70,229,0.16); }
  .combobox-create-disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>

<script>
  function initCombobox(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>(".combobox-input");
    const list = root.querySelector<HTMLUListElement>(".combobox-list");
    const dataEl = root.querySelector<HTMLScriptElement>(".combobox-data");
    if (!input || !list || !dataEl) return;

    const options: { label: string; value: string }[] = JSON.parse(dataEl.textContent || "[]");
    const createLabel = root.dataset.createLabel ?? "Use custom value";
    const urlOnly = root.dataset.urlOnly === "true";
    let activeIndex = -1;

    function normalizeUrl(v: string): string {
      const trimmed = v.trim();
      if (!trimmed) return "";
      const lower = trimmed.toLowerCase();
      if (lower.startsWith("http://") || lower.startsWith("https://") || lower.startsWith("www.")) {
        return trimmed;
      }
      if (trimmed.startsWith("/")) {
        return trimmed;
      }
      return "/" + trimmed;
    }

    const isCustomAllowed = (v: string) => {
      if (!urlOnly) return v.trim().length > 0;
      return true;
    };

    function items(): HTMLLIElement[] {
      return Array.from(list!.querySelectorAll<HTMLLIElement>(".combobox-option"));
    }

    function setActive(index: number) {
      const els = items();
      activeIndex = index;
      els.forEach((el, i) => el.classList.toggle("active", i === activeIndex));
      els[activeIndex]?.scrollIntoView({ block: "nearest" });
    }

    function render() {
      const raw = input!.value;
      const q = raw.trim().toLowerCase();
      const filtered = q
        ? options.filter((o) => o.label.toLowerCase().includes(q) || o.value.toLowerCase().includes(q))
        : options;
      const exact = options.some((o) => o.value.toLowerCase() === q);
      const showCreate = !exact && isCustomAllowed(raw);

      list!.innerHTML = "";
      activeIndex = -1;

      if (!showCreate && filtered.length === 0) {
        list!.hidden = true;
        input!.setAttribute("aria-expanded", "false");
        return;
      }

      if (showCreate) {
        const li = document.createElement("li");
        li.className = "combobox-option combobox-create";
        li.setAttribute("role", "option");
        const normalized = normalizeUrl(raw);
        li.dataset.value = normalized;
        if (!normalized) {
          li.classList.add("combobox-create-disabled");
          li.setAttribute("aria-disabled", "true");
        }
        const labelSpan = document.createElement("span");
        labelSpan.textContent = normalized ? `${createLabel} "${normalized}"` : createLabel;
        li.appendChild(labelSpan);
        list!.appendChild(li);
      }

      filtered.forEach((o) => {
        const li = document.createElement("li");
        li.className = "combobox-option";
        li.setAttribute("role", "option");
        li.dataset.value = o.value;
        const labelSpan = document.createElement("span");
        labelSpan.className = "combobox-option-label";
        labelSpan.textContent = o.label;
        li.appendChild(labelSpan);
        if (o.value !== o.label) {
          const valueSpan = document.createElement("span");
          valueSpan.className = "combobox-option-value";
          valueSpan.textContent = o.value;
          li.appendChild(valueSpan);
        }
        list!.appendChild(li);
      });

      list!.hidden = false;
      input!.setAttribute("aria-expanded", "true");
    }

    function select(value: string) {
      input!.value = value;
      list!.hidden = true;
      input!.setAttribute("aria-expanded", "false");
    }

    input.addEventListener("input", render);
    input.addEventListener("focus", render);

    list.addEventListener("mousedown", (e) => {
      const li = (e.target as HTMLElement).closest<HTMLLIElement>(".combobox-option");
      if (!li) return;
      if (li.dataset.value === "") {
        e.preventDefault();
        return;
      }
      e.preventDefault();
      select(li.dataset.value ?? "");
      input!.focus();
    });

    input.addEventListener("keydown", (e) => {
      if (list!.hidden) return;
      const els = items();
      if (els.length === 0) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive(Math.min(activeIndex + 1, els.length - 1));
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(Math.max(activeIndex - 1, 0));
      } else if (e.key === "Enter") {
        if (activeIndex >= 0) {
          e.preventDefault();
          select(els[activeIndex].dataset.value ?? "");
        }
      } else if (e.key === "Escape") {
        list!.hidden = true;
        input!.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("click", (e) => {
      if (!root.contains(e.target as Node)) {
        list!.hidden = true;
        input!.setAttribute("aria-expanded", "false");
      }
    });
  }

  document.querySelectorAll<HTMLElement>(".combobox").forEach(initCombobox);
</script>
