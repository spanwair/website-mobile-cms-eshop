---
import type { NotificationWithMeta } from "@shared/types/index";
import { useT, getLang } from "../../lib/i18n";

interface Props {
  userId: string;
  userNotifications: NotificationWithMeta[];
}

const { userId, userNotifications } = Astro.props;
const t = useT(Astro);
const dateLocale = getLang(Astro) === "en" ? "en-US" : "cs-CZ";
const unread = userNotifications.filter((n) => !n.read_at);
---

<div class="notif-wrapper">
  <button class="notif-trigger" id="notif-toggle" aria-expanded="false" aria-haspopup="true">
    <span class="notif-icon">&#128276;</span>
    {unread.length > 0 && <span class="notif-badge">{unread.length > 9 ? "9+" : unread.length}</span>}
  </button>

  <div class="notif-panel" id="notif-panel" hidden>
    <div class="notif-header">
      <span class="notif-title">{t.admin.notifications.title}</span>
      {unread.length > 0 && (
        <form method="POST" action="/admin/notifications/mark-all-read" style="margin:0">
          <input type="hidden" name="user_id" value={userId} />
          <button type="submit" class="mark-all-btn">{t.admin.notifications.markAllRead}</button>
        </form>
      )}
    </div>

    <div class="notif-list">
      {userNotifications.length === 0 && (
        <div class="notif-empty">{t.admin.notifications.noNotifications}</div>
      )}
      {userNotifications.map((n) => (
        <div class={`notif-item ${!n.read_at ? "notif-item--unread" : ""}`}>
          <div class="notif-body">
            <p class="notif-title-text">{n.title ?? n.type}</p>
            {n.body && <p class="notif-body-text">{n.body}</p>}
            <time class="notif-time">{new Date(n.created_at).toLocaleString(dateLocale)}</time>
          </div>
          {!n.read_at && (
            <form method="POST" action="/admin/notifications/mark-read" style="margin:0">
              <input type="hidden" name="user_id" value={userId} />
              <input type="hidden" name="notification_id" value={n.id} />
              <button type="submit" class="read-btn" title={t.admin.notifications.markAsRead}>&#10003;</button>
            </form>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById("notif-toggle");
  const panel = document.getElementById("notif-panel");

  toggle?.addEventListener("click", () => {
    const isHidden = panel?.hasAttribute("hidden");
    if (isHidden) {
      panel?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
    } else {
      panel?.setAttribute("hidden", "");
      toggle.setAttribute("aria-expanded", "false");
    }
  });

  document.addEventListener("click", (e) => {
    if (!toggle?.contains(e.target as Node) && !panel?.contains(e.target as Node)) {
      panel?.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>

<style>
  .notif-wrapper { position:relative; display:inline-block; }
  .notif-trigger { background:none; border:none; cursor:pointer; padding:8px; border-radius:8px; position:relative; font-size:20px; line-height:1; }
  .notif-trigger:hover { background:var(--bg-subtle); }
  .notif-badge { position:absolute; top:2px; right:2px; background:var(--error); color:#fff; font-size:10px; font-weight:700; min-width:16px; height:16px; border-radius:999px; display:flex; align-items:center; justify-content:center; padding:0 3px; }
  .notif-icon { display:block; }
  .notif-panel { position:absolute; top:calc(100% + 8px); right:0; width:340px; background:#fff; border:1px solid var(--border-default); border-radius:var(--radius-md); box-shadow:var(--shadow-md); z-index:200; overflow:hidden; }
  .notif-header { display:flex; justify-content:space-between; align-items:center; padding:14px 16px; border-bottom:1px solid var(--border-default); }
  .notif-title { font-size:14px; font-weight:700; }
  .mark-all-btn { background:none; border:none; font-size:12px; color:var(--accent-primary); cursor:pointer; font-weight:600; padding:0; }
  .mark-all-btn:hover { text-decoration:underline; }
  .notif-list { max-height:360px; overflow-y:auto; }
  .notif-empty { padding:24px; text-align:center; font-size:14px; color:var(--text-muted); }
  .notif-item { display:flex; align-items:flex-start; gap:12px; padding:12px 16px; border-bottom:1px solid var(--border-default); transition:background 0.1s; }
  .notif-item:last-child { border-bottom:none; }
  .notif-item:hover { background:var(--bg-subtle); }
  .notif-item--unread { background:rgba(79,70,229,0.04); }
  .notif-body { flex:1; min-width:0; }
  .notif-title-text { font-size:13px; font-weight:600; margin-bottom:2px; }
  .notif-body-text { font-size:12px; color:var(--text-muted); margin-bottom:4px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .notif-time { font-size:11px; color:var(--text-placeholder); }
  .read-btn { background:none; border:1px solid var(--border-default); border-radius:999px; width:24px; height:24px; cursor:pointer; font-size:13px; color:var(--success); display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px; }
  .read-btn:hover { background:var(--bg-subtle); }
</style>
