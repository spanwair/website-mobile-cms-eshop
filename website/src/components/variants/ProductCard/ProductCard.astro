---
import type { ProductCardVariant } from "@shared/types";
import type { ProductCardData } from "../../../lib/variantRegistry";
import Classic from "./Classic.astro";
import Minimal from "./Minimal.astro";
import Luxury from "./Luxury.astro";

interface Props {
  product: ProductCardData;
  variant?: ProductCardVariant;
  linkBase?: string;
}
const { product, variant = "classic", linkBase = "/shop" } = Astro.props;

const VARIANTS = { classic: Classic, minimal: Minimal, luxury: Luxury };
const Card = VARIANTS[variant] ?? Classic;
---

<Card product={product} linkBase={linkBase} />
