---
import type { ProductCardData } from "../../../lib/variantRegistry";
import { useT, getLang } from "../../../lib/i18n";
import { formatPrice } from "@shared/utils/format";

interface Props { product: ProductCardData; linkBase?: string; currency?: string }
const { product, linkBase = "/shop", currency } = Astro.props;
const t = useT(Astro);
const lang = getLang(Astro);
---

<a href={`${linkBase}/${product.slug}`} class="product-card">
  <div class="product-img-wrap">
    {product.primaryImage ? (
      product.primaryMediaType === "video" ? (
        <video src={`${product.primaryImage}#t=0.5`} class="product-img" muted playsinline preload="metadata" />
      ) : (
        <img src={product.primaryImage} alt={product.title} class="product-img" loading="lazy" />
      )
    ) : (
      <div class="product-img-placeholder">{t.shop.noImage}</div>
    )}
    {product.hasVideo && (
      <span class="video-badge" title={t.shop.hasVideo} aria-label={t.shop.hasVideo}>
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
      </span>
    )}
    {product.isOutOfStock && <span class="oos-badge">{t.shop.outOfStock}</span>}
  </div>
  {product.orgName && <span class="org-badge">{product.orgName}</span>}
  {product.condition && <span class="condition-badge" style={`background:${product.condition.color_hex}`}>{product.condition.label}</span>}
  <div class="product-info">
    <h3 class="product-title">{product.title}</h3>
    <span class="price">{formatPrice(product.hasVariants ? product.displayPrice : Number(product.discount_price ?? product.price), lang, currency)}</span>
  </div>
  {product.variants && product.variants.length > 1 && (
    <div class="variant-chips">
      {product.variants.map((v) => <span class="variant-chip">{v.name}</span>)}
    </div>
  )}
</a>

<style>
  .product-card { display:flex; flex-direction:column; text-decoration:none; color:inherit; }
  .product-img-wrap { position:relative; aspect-ratio:1; background:var(--bg-subtle); overflow:hidden; border-radius:var(--radius-sm); }
  .product-img { width:100%; height:100%; object-fit:cover; transition:opacity .2s; }
  video.product-img { background:#000; }
  .product-card:hover .product-img { opacity:0.85; }
  .product-img-placeholder { display:flex; align-items:center; justify-content:center; height:100%; font-size:13px; color:var(--text-muted); }
  .video-badge { position:absolute; bottom:8px; right:8px; width:22px; height:22px; border-radius:50%; background:rgba(0,0,0,.6); color:#fff; display:flex; align-items:center; justify-content:center; }
  .oos-badge { position:absolute; inset:0; background:rgba(0,0,0,.4); color:#fff; font-size:11px; font-weight:600; display:flex; align-items:center; justify-content:center; }
  .org-badge { margin-top:8px; font-size:10px; font-weight:600; color:var(--accent-primary); text-transform:uppercase; letter-spacing:.04em; }
  .condition-badge { display:inline-block; margin-top:6px; font-size:9px; font-weight:700; color:#fff; padding:2px 7px; border-radius:9999px; width:fit-content; }
  .product-info { padding:10px 2px; display:flex; justify-content:space-between; align-items:baseline; gap:8px; }
  .product-title { font-size:13px; font-weight:500; color:var(--text-primary); margin:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .price { font-size:13px; font-weight:600; color:var(--text-primary); white-space:nowrap; }
  .variant-chips { display:flex; flex-wrap:wrap; gap:4px; margin-top:6px; }
  .variant-chip { font-size:10px; font-weight:500; color:var(--text-muted); background:var(--bg-subtle); border:1px solid var(--border); border-radius:9999px; padding:2px 8px; }
</style>
