---
import { useT, getLang } from "../../lib/i18n";
import ReviewForm from "./ReviewForm.astro";

interface Review {
  rating: number;
  author_name: string;
  is_verified: boolean;
  created_at: string;
  pros: string[];
  cons: string[];
  body?: string | null;
}
interface Props {
  reviews: Review[];
  reviewTotal: number;
  averageRating: number;
  reviewed: boolean;
  productId: string;
  reviewerName: string;
  reviewerEmail: string;
  isLoggedIn: boolean;
}
const { reviews, reviewTotal, averageRating, reviewed, productId, reviewerName, reviewerEmail, isLoggedIn } = Astro.props;
const t = useT(Astro);
const lang = getLang(Astro);
const dateLocale = lang === "en" ? "en-US" : "cs-CZ";
---

<section class="reviews-section">
  <div class="reviews-header">
    <h2 class="section-title">{t.shop.customerReviews}</h2>
    {reviewTotal > 0 && (
      <div class="avg-rating">
        <span class="avg-stars">{"★".repeat(Math.round(averageRating))}{"☆".repeat(5 - Math.round(averageRating))}</span>
        <span class="avg-num">{averageRating.toFixed(1)} / 5</span>
        <span class="avg-count">({reviewTotal} {t.shop.reviews})</span>
      </div>
    )}
  </div>

  {reviewed && <div class="success-banner">{t.shop.reviewSubmitted}</div>}

  {reviews.map((review) => (
    <div class="review-card">
      <div class="review-header">
        <strong>{review.author_name}</strong>
        {review.is_verified && <span class="verified-badge">{t.shop.verifiedPurchase}</span>}
        <time>{new Date(review.created_at).toLocaleDateString(dateLocale)}</time>
      </div>
      <div class="review-recommend">
        <span class="review-stars">{"★".repeat(review.rating)}{"☆".repeat(5 - review.rating)}</span>
        <span class="review-pct">{Math.round((review.rating / 5) * 100)}%</span>
        <span class="review-pct-label">{t.shop.recommendsProduct}</span>
      </div>
      <div class="review-points">
        <ul class="point-col">
          {review.pros.length > 0
            ? review.pros.map((p) => <li class="pro">{p}</li>)
            : <li class="empty">{t.shop.noPros}</li>}
        </ul>
        <ul class="point-col">
          {review.cons.length > 0
            ? review.cons.map((c) => <li class="con">{c}</li>)
            : <li class="empty">{t.shop.noCons}</li>}
        </ul>
      </div>
      {review.body && <p class="review-body">{review.body}</p>}
    </div>
  ))}

  {reviews.length === 0 && <p class="no-reviews">{t.shop.noReviews}</p>}

  <ReviewForm productId={productId} reviewerName={reviewerName} reviewerEmail={reviewerEmail} isLoggedIn={isLoggedIn} />
</section>

<style>
  .reviews-section { max-width:1280px; margin:0 auto; padding:0 24px 48px; border-top:1px solid var(--border); padding-top:48px; }
  .reviews-header { display:flex; align-items:center; gap:16px; margin-bottom:24px; flex-wrap:wrap; }
  .avg-rating { display:flex; align-items:center; gap:8px; }
  .avg-stars { color:#f59e0b; font-size:22px; }
  .avg-num { font-size:20px; font-weight:700; }
  .avg-count { color:var(--text-muted); font-size:14px; }
  .section-title { font-size:20px; font-weight:700; margin-bottom:16px; }
  .success-banner { background:#dcfce7; border:1px solid #86efac; color:#15803d; border-radius:8px; padding:12px 16px; margin-bottom:20px; font-size:14px; }
  .review-card { border-bottom:1px solid var(--border); padding:20px 0; }
  .review-header { display:flex; align-items:center; gap:10px; margin-bottom:8px; flex-wrap:wrap; font-size:14px; color:var(--text-muted); }
  .review-header strong { color:var(--text-primary); }
  .verified-badge { background:#dbeafe; color:#1d4ed8; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; }
  .review-recommend { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
  .review-stars { color:#f59e0b; font-size:16px; }
  .review-pct { font-size:14px; font-weight:700; color:var(--primary); }
  .review-pct-label { font-size:13px; color:var(--text-muted); }
  .review-points { display:grid; grid-template-columns:1fr 1fr; gap:8px 24px; margin-bottom:10px; }
  @media(max-width:560px) { .review-points { grid-template-columns:1fr; } }
  .point-col { list-style:none; padding:0; margin:0; font-size:14px; }
  .point-col li { margin-bottom:4px; }
  .point-col li::before { font-weight:700; margin-right:6px; }
  .point-col li.pro::before { content:"+"; color:#16a34a; }
  .point-col li.con::before { content:"−"; color:#dc2626; }
  .point-col li.empty { color:var(--text-muted); font-style:italic; }
  .point-col li.empty::before { content:""; margin:0; }
  .review-body { font-size:14px; color:var(--text-secondary); line-height:1.6; margin:0; }
  .no-reviews { color:var(--text-muted); font-size:14px; padding:16px 0; }
</style>
