---
import { useT } from "../../lib/i18n";

interface Props {
  images: { url: string; alt: string | null; media_type?: "image" | "video" }[];
  title: string;
}
const { images, title } = Astro.props;
const primaryImage = images[0];
const t = useT(Astro);
---

<div class="images-col">
  <div class="main-image-wrap">
    {primaryImage ? (
      primaryImage.media_type === "video" ? (
        <video id="main-img" src={primaryImage.url} class="main-image" controls preload="metadata" />
      ) : (
        <img id="main-img" src={primaryImage.url} alt={primaryImage.alt ?? title} class="main-image" />
      )
    ) : (
      <div class="no-image">{t.shop.noImage}</div>
    )}
  </div>
  {images.length > 1 && (
    <div class="thumb-row">
      {images.map((img) => (
        <button
          class="thumb-btn"
          data-url={img.url}
          data-alt={img.alt ?? ""}
          data-type={img.media_type === "video" ? "video" : "image"}
        >
          {img.media_type === "video" ? (
            <video src={img.url} class="thumb-img" preload="metadata" muted />
          ) : (
            <img src={img.url} alt={img.alt ?? ""} class="thumb-img" loading="lazy" />
          )}
        </button>
      ))}
    </div>
  )}
</div>

<style>
  .images-col { display:flex; flex-direction:column; gap:12px; }
  .main-image-wrap { aspect-ratio:1; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--bg-subtle); }
  .main-image { width:100%; height:100%; object-fit:cover; cursor:zoom-in; }
  video.main-image { background:#000; cursor:default; }
  .no-image { display:flex; align-items:center; justify-content:center; height:100%; color:var(--text-muted); }
  .thumb-row { display:flex; gap:8px; flex-wrap:wrap; }
  .thumb-btn { border:2px solid transparent; border-radius:8px; overflow:hidden; cursor:pointer; padding:0; background:none; width:64px; height:64px; }
  .thumb-btn:hover { border-color:var(--primary); }
  .thumb-img { width:100%; height:100%; object-fit:cover; }
  video.thumb-img { background:#000; }
</style>

<script>
  document.querySelectorAll(".thumb-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      const wrap = document.querySelector(".main-image-wrap");
      if (!wrap) return;
      const url = btn.getAttribute("data-url") ?? "";
      const alt = btn.getAttribute("data-alt") ?? "";
      const isVideo = btn.getAttribute("data-type") === "video";
      let el;
      if (isVideo) {
        el = document.createElement("video");
        el.src = url;
        el.controls = true;
        el.preload = "metadata";
      } else {
        el = document.createElement("img");
        el.src = url;
        el.alt = alt;
      }
      el.id = "main-img";
      el.className = "main-image";
      wrap.replaceChildren(el);
    });
  });
</script>
