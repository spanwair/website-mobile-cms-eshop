---
import { useT, getLang } from "../../lib/i18n";

interface GalleryImage { url: string; alt: string | null; media_type?: "image" | "video" }
interface Props {
  images: GalleryImage[];
  title: string;
  variantImages?: Record<string, GalleryImage[]>;
}
const { images, title, variantImages = {} } = Astro.props;
const primaryImage = images[0];
const t = useT(Astro);
const lang = getLang(Astro);
const variantImagesJson = Object.keys(variantImages).length > 0 ? JSON.stringify(variantImages) : null;
const imagesJson = JSON.stringify(images);
const zoomHintLabel = lang === "cs" ? "Klikněte pro zvětšení" : "Click to enlarge";
---

<div class="images-col" id="product-gallery" data-images={imagesJson} data-variant-images={variantImagesJson} data-no-image-text={t.shop.noImage} data-zoom-hint={zoomHintLabel}>
  <div class="main-image-wrap" id="main-image-wrap">
    {primaryImage ? (
      primaryImage.media_type === "video" ? (
        <video id="main-img" src={primaryImage.url} class="main-image" controls preload="metadata" />
      ) : (
        <img id="main-img" src={primaryImage.url} alt={primaryImage.alt ?? title} class="main-image" />
      )
    ) : (
      <div class="no-image">{t.shop.noImage}</div>
    )}
    {primaryImage && primaryImage.media_type !== "video" && <span class="zoom-hint" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/><path d="M11 8v6"/></svg> {zoomHintLabel}</span>}
  </div>
  <div class="thumb-row" id="thumb-row">
    {images.length > 1 && images.map((img, idx) => (
      <button
        class={`thumb-btn ${idx === 0 ? "thumb-btn--active" : ""}`}
        data-url={img.url}
        data-alt={img.alt ?? ""}
        data-type={img.media_type === "video" ? "video" : "image"}
        data-index={String(idx)}
        aria-label={img.alt ?? `Image ${idx + 1}`}
      >
        {img.media_type === "video" ? (
          <video src={img.url} class="thumb-img" preload="metadata" muted />
        ) : (
          <img src={img.url} alt={img.alt ?? ""} class="thumb-img" loading="lazy" />
        )}
      </button>
    ))}
  </div>
</div>

<!-- Lightbox — hidden until opened -->
<div class="pg-lightbox" id="pg-lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image preview">
  <button class="pg-lb-close" id="pg-lb-close" aria-label="Close">×</button>
  <button class="pg-lb-nav pg-lb-prev" id="pg-lb-prev" aria-label="Previous">‹</button>
  <div class="pg-lb-content" id="pg-lb-content"></div>
  <button class="pg-lb-nav pg-lb-next" id="pg-lb-next" aria-label="Next">›</button>
  <span class="pg-lb-counter" id="pg-lb-counter"></span>
</div>

<style>
  .images-col { display:flex; flex-direction:column; gap:12px; }
  .main-image-wrap { aspect-ratio:1; border:1px solid var(--border); border-radius:12px; overflow:hidden; background:var(--bg-subtle); position:relative; }
  /* :global — the gallery script creates these elements client-side on variant change, so they
     never get Astro's scoped data-astro-cid attribute and would otherwise render unstyled. */
  :global(.main-image) { width:100%; height:100%; object-fit:cover; cursor:zoom-in; transition:transform 0.22s ease-out; transform-origin:50% 50%; display:block; }
  :global(video.main-image) { background:#000; cursor:default; }
  :global(.no-image) { display:flex; align-items:center; justify-content:center; height:100%; color:var(--text-muted); }
  .thumb-row { display:flex; gap:8px; flex-wrap:wrap; }
  :global(.thumb-btn) { border:2px solid transparent; border-radius:8px; overflow:hidden; cursor:pointer; padding:0; background:none; width:64px; height:64px; position:relative; }
  :global(.thumb-btn:hover) { border-color:var(--primary); }
  :global(.thumb-btn--active) { border-color:var(--primary); }
  :global(.thumb-img) { width:100%; height:100%; object-fit:cover; }
  :global(video.thumb-img) { background:#000; }
  .zoom-hint {
    position:absolute; bottom:10px; right:10px;
    background:rgba(15,23,42,0.82); color:#fff; font-size:11px; font-weight:600;
    padding:5px 10px; border-radius:9999px; pointer-events:none;
    display:flex; align-items:center; gap:6px; opacity:0; transition:opacity 0.2s;
    letter-spacing:0.02em; backdrop-filter:blur(4px);
  }
  .main-image-wrap:hover .zoom-hint { opacity:1; }
  .main-image-wrap.is-zooming :global(.main-image) { transform:scale(2.2); }
  @media (hover: none) {
    .zoom-hint { opacity:1; }
    .main-image-wrap.is-zooming :global(.main-image) { transform:none; }
  }
  /* Lightbox */
  :global(.pg-lightbox) {
    position:fixed; inset:0; z-index:2000;
    background:rgba(0,0,0,0.92);
    display:flex; align-items:center; justify-content:center;
    padding:32px 56px;
  }
  :global(.pg-lightbox[hidden]) { display:none !important; }
  :global(.pg-lb-content) { display:flex; align-items:center; justify-content:center; max-width:92vw; max-height:88vh; width:100%; height:100%; }
  :global(.pg-lb-content img) { max-width:100%; max-height:88vh; object-fit:contain; border-radius:8px; display:block; box-shadow:0 20px 60px rgba(0,0,0,0.5); }
  :global(.pg-lb-content video) { max-width:100%; max-height:88vh; border-radius:8px; background:#000; box-shadow:0 20px 60px rgba(0,0,0,0.5); }
  :global(.pg-lb-close) {
    position:absolute; top:16px; right:16px;
    width:44px; height:44px; border-radius:50%; border:none;
    background:rgba(255,255,255,0.12); color:#fff; font-size:28px; line-height:1;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:background 0.15s;
  }
  :global(.pg-lb-close:hover) { background:rgba(255,255,255,0.22); }
  :global(.pg-lb-nav) {
    position:absolute; top:50%; transform:translateY(-50%);
    width:44px; height:44px; border-radius:50%; border:none;
    background:rgba(255,255,255,0.12); color:#fff; font-size:30px; line-height:1;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    transition:background 0.15s;
  }
  :global(.pg-lb-nav:hover) { background:rgba(255,255,255,0.22); }
  :global(.pg-lb-prev) { left:16px; }
  :global(.pg-lb-next) { right:16px; }
  :global(.pg-lb-nav[hidden]) { display:none !important; }
  :global(.pg-lb-counter) {
    position:absolute; bottom:16px; left:50%; transform:translateX(-50%);
    background:rgba(0,0,0,0.6); color:#fff; font-size:12px; font-weight:600;
    padding:4px 12px; border-radius:9999px; letter-spacing:0.02em;
  }
  @media(max-width:640px) {
    :global(.pg-lightbox) { padding:16px; }
    :global(.pg-lb-prev) { left:8px; }
    :global(.pg-lb-next) { right:8px; }
  }
</style>

<script>
  interface GalleryImage { url: string; alt: string | null; media_type?: "image" | "video" }

  const root = document.getElementById("product-gallery");
  const mainWrap = document.getElementById("main-image-wrap") as HTMLElement | null;
  const thumbRow = document.getElementById("thumb-row");
  const noImageText = root?.dataset.noImageText ?? "";
  const zoomHintLabel = root?.dataset.zoomHint ?? "Click to enlarge";
  const variantImagesJson = root?.dataset.variantImages;
  const variantImages: Record<string, GalleryImage[]> = variantImagesJson ? JSON.parse(variantImagesJson) : {};
  const initialImages: GalleryImage[] = root?.dataset.images ? JSON.parse(root.dataset.images) : [];

  let currentImages: GalleryImage[] = initialImages.slice();
  let currentIndex = 0;

  // Lightbox elements
  const lightbox = document.getElementById("pg-lightbox") as HTMLElement | null;
  const lbContent = document.getElementById("pg-lb-content") as HTMLElement | null;
  const lbClose = document.getElementById("pg-lb-close") as HTMLButtonElement | null;
  const lbPrev = document.getElementById("pg-lb-prev") as HTMLButtonElement | null;
  const lbNext = document.getElementById("pg-lb-next") as HTMLButtonElement | null;
  const lbCounter = document.getElementById("pg-lb-counter") as HTMLElement | null;

  const canHoverZoom = window.matchMedia("(hover: hover)").matches;

  function isVideo(img: GalleryImage) { return img.media_type === "video"; }

  function createMainElement(img: GalleryImage): HTMLElement {
    const el = img.media_type === "video" ? document.createElement("video") : document.createElement("img");
    if (el instanceof HTMLVideoElement) {
      el.src = img.url;
      el.controls = true;
      el.preload = "metadata";
    } else {
      el.src = img.url;
      el.alt = img.alt ?? "";
    }
    el.id = "main-img";
    el.className = "main-image";
    return el;
  }

  function setMainImage(img: GalleryImage, index: number) {
    if (!mainWrap) return;
    currentIndex = index;
    const mainEl = createMainElement(img);
    const hintHtml = !isVideo(img)
      ? `<span class="zoom-hint" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/><path d="M11 8v6"/></svg> ${zoomHintLabel}</span>`
      : "";
    mainWrap.replaceChildren(mainEl);
    if (hintHtml) mainWrap.insertAdjacentHTML("beforeend", hintHtml);
    updateThumbActive();
    // Reset zoom state after switching image
    mainWrap.classList.remove("is-zooming");
    const freshImg = mainWrap.querySelector<HTMLElement>("#main-img");
    if (freshImg) freshImg.style.transformOrigin = "50% 50%";
  }

  function updateThumbActive() {
    thumbRow?.querySelectorAll<HTMLButtonElement>(".thumb-btn").forEach((btn) => {
      const idx = parseInt(btn.dataset.index ?? "-1", 10);
      btn.classList.toggle("thumb-btn--active", idx === currentIndex);
    });
  }

  function bindThumbClicks() {
    thumbRow?.querySelectorAll<HTMLButtonElement>(".thumb-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = parseInt(btn.dataset.index ?? "0", 10);
        const img: GalleryImage = {
          url: btn.dataset.url ?? "",
          alt: btn.dataset.alt ?? "",
          media_type: btn.dataset.type === "video" ? "video" : "image",
        };
        setMainImage(img, idx);
      });
    });
  }

  // One-time hover zoom + click-to-enlarge bindings on the wrap (survives image swaps)
  if (mainWrap) {
    if (canHoverZoom) {
      mainWrap.addEventListener("mousemove", (e: MouseEvent) => {
        const cur = currentImages[currentIndex];
        if (!cur || isVideo(cur)) return;
        const imgEl = mainWrap.querySelector<HTMLElement>("#main-img");
        if (!imgEl || imgEl instanceof HTMLVideoElement) return;
        const rect = mainWrap.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * 100;
        const y = ((e.clientY - rect.top) / rect.height) * 100;
        imgEl.style.transformOrigin = `${x}% ${y}%`;
        mainWrap.classList.add("is-zooming");
      });
      mainWrap.addEventListener("mouseleave", () => {
        mainWrap.classList.remove("is-zooming");
        const imgEl = mainWrap.querySelector<HTMLElement>("#main-img");
        if (imgEl) (imgEl as HTMLElement).style.transformOrigin = "50% 50%";
      });
    }
    mainWrap.addEventListener("click", (e: MouseEvent) => {
      const cur = currentImages[currentIndex];
      if (!cur || isVideo(cur)) return;
      // Don't open if click originated from video controls area (not relevant for images)
      e.preventDefault();
      openLightbox(currentIndex);
    });
  }

  // Lightbox logic
  function renderLightbox() {
    if (!lbContent || !lightbox) return;
    const img = currentImages[currentIndex];
    if (!img) return;
    lbContent.replaceChildren();
    if (isVideo(img)) {
      const v = document.createElement("video");
      v.src = img.url;
      v.controls = true;
      v.autoplay = true;
      v.playsInline = true;
      v.style.maxWidth = "100%";
      v.style.maxHeight = "88vh";
      lbContent.appendChild(v);
    } else {
      const el = document.createElement("img");
      el.src = img.url;
      el.alt = img.alt ?? "";
      lbContent.appendChild(el);
    }
    if (lbCounter) lbCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;
    const showNav = currentImages.length > 1;
    if (lbPrev) lbPrev.hidden = !showNav;
    if (lbNext) lbNext.hidden = !showNav;
  }

  function openLightbox(index: number) {
    if (!lightbox || currentImages.length === 0) return;
    // Don't open for video main image click via hover path — but lightbox supports video too via thumb navigation
    const target = currentImages[index];
    if (target && isVideo(target)) return;
    currentIndex = index;
    renderLightbox();
    lightbox.hidden = false;
    lightbox.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    // Focus close button for accessibility
    lbClose?.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.hidden = true;
    lightbox.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
  }

  function nextImage(dir: number) {
    if (currentImages.length <= 1) return;
    // Skip videos when navigating via lightbox arrows — only images are enlargable
    let next = currentIndex;
    for (let i = 0; i < currentImages.length; i++) {
      next = (next + dir + currentImages.length) % currentImages.length;
      if (!isVideo(currentImages[next])) break;
    }
    currentIndex = next;
    renderLightbox();
    // Sync main image as well so thumbs stay consistent after closing
    setMainImage(currentImages[currentIndex], currentIndex);
  }

  // Lightbox event bindings (once)
  lbClose?.addEventListener("click", closeLightbox);
  lbPrev?.addEventListener("click", (e) => { e.stopPropagation(); nextImage(-1); });
  lbNext?.addEventListener("click", (e) => { e.stopPropagation(); nextImage(1); });
  // Clicking the dark backdrop behind the enlarged image closes it — covers both
  // the outer lightbox padding and the empty area of .pg-lb-content around the image.
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox || e.target === lbContent) closeLightbox();
  });
  lbContent?.addEventListener("click", (e) => {
    if (e.target === lbContent) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (!lightbox || lightbox.hidden) return;
    if (e.key === "Escape") { e.preventDefault(); closeLightbox(); }
    if (e.key === "ArrowLeft") { e.preventDefault(); nextImage(-1); }
    if (e.key === "ArrowRight") { e.preventDefault(); nextImage(1); }
  });

  // Touch swipe inside lightbox
  let touchStartX = 0;
  lbContent?.addEventListener("touchstart", (e: TouchEvent) => { touchStartX = e.touches[0].clientX; }, { passive: true });
  lbContent?.addEventListener("touchend", (e: TouchEvent) => {
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 40) nextImage(dx < 0 ? 1 : -1);
  });

  function renderGallery(images: GalleryImage[]) {
    if (!mainWrap || !thumbRow) return;
    currentImages = images.slice();
    currentIndex = 0;
    if (images.length === 0) {
      mainWrap.innerHTML = `<div class="no-image">${noImageText}</div>`;
      thumbRow.replaceChildren();
      return;
    }
    setMainImage(images[0], 0);
    thumbRow.replaceChildren();
    if (images.length > 1) {
      for (let i = 0; i < images.length; i++) {
        const img = images[i];
        const btn = document.createElement("button");
        btn.className = `thumb-btn ${i === 0 ? "thumb-btn--active" : ""}`;
        btn.dataset.url = img.url;
        btn.dataset.alt = img.alt ?? "";
        btn.dataset.type = img.media_type === "video" ? "video" : "image";
        btn.dataset.index = String(i);
        btn.setAttribute("aria-label", img.alt ?? `Image ${i + 1}`);
        const media = img.media_type === "video" ? document.createElement("video") : document.createElement("img");
        media.className = "thumb-img";
        (media as HTMLImageElement | HTMLVideoElement).src = img.url;
        if (media instanceof HTMLImageElement) { media.alt = img.alt ?? ""; media.loading = "lazy"; }
        if (media instanceof HTMLVideoElement) { media.preload = "metadata"; (media as HTMLVideoElement).muted = true; }
        btn.appendChild(media);
        thumbRow.appendChild(btn);
      }
      bindThumbClicks();
    }
    // Close lightbox if open during variant switch to avoid stale index
    if (lightbox && !lightbox.hidden) closeLightbox();
  }

  // Initial bindings
  bindThumbClicks();

  // Switching the selected variant swaps the whole gallery to that variant's own images —
  // dispatched by ProductPurchasePanel alongside its price/stock update.
  document.addEventListener("variantchange", ((e: CustomEvent<{ variantId: string }>) => {
    const images = variantImages[e.detail.variantId];
    if (images) renderGallery(images);
  }) as EventListener);
</script>
