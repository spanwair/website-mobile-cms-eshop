---
import { useT, getLang } from "../../lib/i18n";
import { formatPrice } from "@shared/utils/format";
import { computeShippingCost } from "@shared/services/shippingConfigService";
import { getProviderLogoSrc } from "@shared/constants/providerLogos";
import type { ShippingProviderConfig } from "@shared/types";

interface Props {
  configs: ShippingProviderConfig[];
  subtotal: number;
  currency?: string;
}
const { configs, subtotal, currency } = Astro.props;
const t = useT(Astro);
const lang = getLang(Astro);

// Pickup-point map widget keys. process.env first = the production source: wrangler.toml
// [vars], version-controlled and read at request time. (PUBLIC_* cannot be used in prod —
// Vite inlines it at build time from the Cloudflare build machine's env, where a stale PPL key
// got baked into the bundle and produced the customer-facing "Mapa není nastavena správně"
// error.) import.meta.env.PUBLIC_* is the local-dev source: astro dev exposes it from
// .env.development and does not populate process.env. Both resolve to the same real key.
const packetaWidgetKey = process.env.PACKETA_WIDGET_API_KEY ?? import.meta.env.PUBLIC_PACKETA_WIDGET_API_KEY ?? "";
const pplWidgetKey = process.env.PPL_WIDGET_API_KEY ?? import.meta.env.PUBLIC_PPL_WIDGET_API_KEY ?? "";
---

<div class="shipping-selector card" id="shipping-selector" data-pickup-required-msg={t.shop.pickupPointRequired}>
  <h2 class="section-title">{t.shop.shippingMethod}</h2>

  <div class="provider-list">
    {configs.flatMap((cfg, ci) =>
      (["home", "pickup"] as const).map((dt, di) => {
        const cost = computeShippingCost(cfg, subtotal, dt);
        const logo = getProviderLogoSrc(cfg.code);
        const dtLabel = dt === "home" ? t.shop.shippingHome : t.shop.shippingPickup;
        return (
          <label class="provider-option">
            <input type="radio" name="shipping_provider" value={cfg.code} data-cost={cost} data-delivery-type={dt} data-label={cfg.display_name} form="checkout-form" checked={ci === 0 && di === 0} class="styled-radio" required />
            {logo ? (
              <img src={logo} alt={cfg.display_name} title={cfg.display_name} class="provider-logo" />
            ) : (
              <span class="provider-name">{cfg.display_name}</span>
            )}
            <span class="provider-delivery-type">{dtLabel}</span>
            <span class="provider-price" data-provider-price>{cost === 0 ? t.shop.freeShipping : formatPrice(cost, lang, currency)}</span>
          </label>
        );
      })
    )}
  </div>

  <input type="hidden" name="delivery_type" form="checkout-form" value="home" />

  {configs.map((cfg) => (
    <div class="pickup-block" data-pickup-block={cfg.code} style="display:none">
      {cfg.code === "ppl" ? (
        <button type="button" class="btn btn-secondary" data-open-ppl-widget data-api-key={pplWidgetKey}>{t.shop.choosePickupPoint}</button>
      ) : (
        <button type="button" class="btn btn-secondary" data-open-packeta-widget data-api-key={packetaWidgetKey}>{t.shop.choosePickupPoint}</button>
      )}
    </div>
  ))}

  <p class="pickup-summary" data-pickup-summary style="display:none">
    {t.shop.pickupPointChosen} <span data-pickup-summary-text></span>
  </p>

  <p class="pickup-error" data-pickup-error role="alert" style="display:none"></p>

  <input type="hidden" name="pickup_point_id" form="checkout-form" />
  <input type="hidden" name="pickup_point_name" form="checkout-form" />
  <input type="hidden" name="pickup_point_address" form="checkout-form" />
</div>

<script>
  import { initShippingSelector } from "../../lib/client/shippingSelector";
  initShippingSelector();
</script>

<style>
  .section-title { font-size:18px; font-weight:700; margin:0 0 16px; }
  .shipping-selector { display:flex; flex-direction:column; gap:16px; }

  .provider-list { display:flex; flex-direction:column; gap:10px; }

  .provider-option {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border: 1.5px solid var(--border);
    border-radius: 10px;
    cursor: pointer;
    transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
  }
  .provider-option:hover { border-color: var(--primary); }
  .provider-option:has(input:checked) {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 6%, transparent);
    box-shadow: 0 0 0 1px var(--primary);
  }

  /* Ordinary browser-native radio — just sized and tinted with accent-color, no custom
     appearance/redraw. */
  .styled-radio {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin: 0;
    cursor: pointer;
    accent-color: var(--primary);
  }

  .provider-logo {
    flex-shrink: 0;
    height: 26px;
    max-width: 90px;
    object-fit: contain;
  }

  .provider-name { font-size: 14px; font-weight: 600; }
  .provider-delivery-type { flex: 1; font-size: 14px; font-weight: 600; color: var(--text-primary); }
  .provider-price { font-size: 14px; font-weight: 700; color: var(--primary); white-space: nowrap; }

  .pickup-block { margin-top: 4px; }
  .pickup-summary { font-size:13px; color:var(--text-muted); margin:0; }
  .pickup-error { font-size:13px; font-weight:600; color:var(--danger, #dc2626); margin:0; }
  .shipping-selector :global(.btn.pickup-btn-invalid) { border-color: var(--danger, #dc2626); }
</style>
