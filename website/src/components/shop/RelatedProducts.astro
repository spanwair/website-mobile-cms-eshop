---
import { useT, getLang } from "../../lib/i18n";
import { formatPrice } from "@shared/utils/format";

interface Props {
  products: { slug: string; primaryImage?: string; title: string; discount_price: number | null; price: number }[];
  linkBase: string;
  currency?: string;
}
const { products, linkBase, currency } = Astro.props;
const t = useT(Astro);
const lang = getLang(Astro);
---

{products.length > 0 && (
  <section class="related-section">
    <h2 class="section-title">{t.shop.youMightLike}</h2>
    <div class="related-grid">
      {products.map((p) => (
        <a href={`${linkBase}/${p.slug}`} class="related-card">
          {p.primaryImage && <img src={p.primaryImage} alt={p.title} class="related-img" loading="lazy" />}
          <p class="related-title">{p.title}</p>
          <p class="related-price">{formatPrice(Number(p.discount_price ?? p.price), lang, currency)}</p>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  .related-section { max-width:1280px; margin:0 auto; padding:0 24px 64px; }
  .section-title { font-size:20px; font-weight:700; margin-bottom:16px; }
  .related-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(180px, 1fr)); gap:16px; }
  .related-card { border:1px solid var(--border); border-radius:10px; overflow:hidden; text-decoration:none; color:inherit; transition:box-shadow .2s; }
  .related-card:hover { box-shadow:0 4px 16px rgba(0,0,0,.08); }
  .related-img { width:100%; aspect-ratio:1; object-fit:cover; }
  .related-title { font-size:13px; font-weight:600; padding:8px 10px 2px; line-height:1.3; }
  .related-price { font-size:14px; font-weight:700; color:var(--primary); padding:0 10px 10px; }
</style>
