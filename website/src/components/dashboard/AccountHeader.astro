---
import { useT } from "../../lib/i18n";

interface Props {
  displayName: string;
  brandName: string;
  shopHref: string;
  logoUrl: string | null;
}
const { displayName, brandName, shopHref, logoUrl } = Astro.props;
const t = useT(Astro);
const initial = (displayName || "?").trim()[0]?.toUpperCase() ?? "?";
---

<header class="dash-header">
  <div class="dash-header-avatar">
    {logoUrl
      ? <img src={logoUrl} alt={brandName} />
      : <span>{initial}</span>}
  </div>
  <div class="dash-header-text">
    <p class="dash-header-eyebrow">
      {t.dashboard.welcomeBack}{brandName ? <>, <a href={shopHref} class="dash-header-shop">{brandName}</a></> : null}
    </p>
    <h1 class="dash-header-name">{displayName}</h1>
    <p class="dash-header-sub">
      {brandName ? `${t.dashboard.subtitlePrefix} ${brandName}` : t.dashboard.subtitleGeneric}
    </p>
  </div>
</header>

<style>
  .dash-header {
    display: flex; align-items: center; gap: 20px;
    padding: 28px; border-radius: var(--radius-xl, 16px);
    background: linear-gradient(120deg, color-mix(in srgb, var(--accent-primary) 16%, var(--bg-page)), var(--bg-page));
    border: 1px solid var(--border);
  }
  .dash-header-avatar {
    width: 72px; height: 72px; border-radius: 50%; flex-shrink: 0; overflow: hidden;
    background: var(--accent-primary); color: #fff; display: flex; align-items: center;
    justify-content: center; font-size: 30px; font-weight: 900;
  }
  .dash-header-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .dash-header-eyebrow { font-size: 13px; font-weight: 600; color: var(--text-muted); margin: 0; }
  .dash-header-shop { color: var(--accent-primary); font-weight: 800; text-decoration: none; }
  .dash-header-shop:hover { text-decoration: underline; }
  .dash-header-name { font-size: 26px; font-weight: 900; color: var(--text-primary); margin: 2px 0 4px; }
  .dash-header-sub { font-size: 14px; color: var(--text-muted); margin: 0; }
  @media (max-width: 560px) { .dash-header { flex-direction: column; text-align: center; } }
</style>
