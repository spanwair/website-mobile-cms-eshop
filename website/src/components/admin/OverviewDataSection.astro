---
import { useT } from "../../lib/i18n";

interface Props {
  section: "top-products" | "activity" | "orders";
  title: string;
  pageSize?: number;
  modalPageSize?: number;
}

const { section, title, pageSize = 5, modalPageSize = 20 } = Astro.props;
const t = useT(Astro);
const s = t.admin.overviewSection;

const config = {
  section,
  title,
  pageSize,
  modalPageSize,
  labels: {
    range1d: s.range1d, range7d: s.range7d, range1m: s.range1m, rangeAll: s.rangeAll,
    viewAll: s.viewAll, exportCsv: s.exportCsv, prev: t.common.previous, next: t.common.next,
    pageOf: s.pageOf, loading: s.loading, empty: s.empty, error: s.error, total: t.common.total,
  },
};
---

<overview-section>
  <script type="application/json" class="os-config" set:html={JSON.stringify(config)} />
</overview-section>

<script>
  import "./overviewSection.client.ts";
</script>

<style is:global>
  overview-section { display: block; }
  .os-card { display: block; }
  .os-header { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
  .os-controls { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .os-ranges { display: inline-flex; border: 1px solid var(--border-default); border-radius: 8px; overflow: hidden; }
  .os-range { background: var(--bg-surface, #fff); border: none; border-right: 1px solid var(--border-default); padding: 5px 10px; font-size: 12px; font-weight: 600; color: var(--text-muted); cursor: pointer; }
  .os-range:last-child { border-right: none; }
  .os-range:hover { background: var(--bg-subtle); }
  .os-range.is-active { background: var(--accent-primary); color: #fff; }
  .os-viewall { padding: 6px 12px; font-size: 13px; }
  .os-empty { color: var(--text-muted); font-size: 14px; padding: 16px 0; }
  .os-clickable { cursor: pointer; }
  .os-clickable:hover { background: var(--bg-subtle); }
  .os-clickable:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: -2px; }

  .os-modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; align-items: center; justify-content: center; padding: 24px; }
  .os-modal { background: var(--bg-surface, #fff); border-radius: 12px; width: min(900px, 100%); max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; }
  .os-modal-head { display: flex; align-items: center; justify-content: space-between; padding: 20px 24px; border-bottom: 1px solid var(--border-default); }
  .os-close { background: none; border: none; font-size: 28px; line-height: 1; cursor: pointer; color: var(--text-muted); }
  .os-modal-controls { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 24px; flex-wrap: wrap; }
  .os-modal-body { overflow: auto; padding: 0 24px; flex: 1; }
  .os-modal-foot { display: flex; align-items: center; gap: 12px; padding: 16px 24px; border-top: 1px solid var(--border-default); }
  .os-pageinfo { font-size: 13px; color: var(--text-muted); }
  @media (max-width: 768px) { .os-modal-overlay { padding: 0; } .os-modal { max-height: 100vh; border-radius: 0; width: 100%; } }
</style>
