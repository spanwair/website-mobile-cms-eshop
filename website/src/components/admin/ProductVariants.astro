---
import type { ProductVariant } from "@shared/types";
import { useT } from "../../lib/i18n";

interface Props {
  variants: ProductVariant[];
  productId: string;
  editingId: string | null;
  selectedVariantId?: string | null;
}

const { variants, productId, editingId, selectedVariantId = null } = Astro.props;
const t = useT(Astro);
const s = t.admin.products;
// A product with variants always has one "in focus" (selected row, green dot) — the form below
// mirrors that by default so it's never a blank add-form next to data that already exists.
// editingId === "new" is the explicit escape hatch back to a blank form.
const editing = editingId === "new"
  ? null
  : editingId
    ? variants.find((v) => v.id === editingId) ?? null
    : selectedVariantId
      ? variants.find((v) => v.id === selectedVariantId) ?? null
      : null;
---

<div class="card variants-card" style="max-width:720px">
  <h3 class="variants-title">{s.variantsTitle}</h3>
  <p class="variants-desc">{s.variantsDesc}</p>

  {variants.length > 0 && (
    <table class="data-table" style="margin-bottom:20px">
      <thead>
        <tr><th>{s.variantName}</th><th>{s.variantPrice}</th><th>{s.variantActive}</th><th>{t.admin.products.colActions}</th></tr>
      </thead>
      <tbody>
        {variants.map((v) => (
          <tr class={v.id === selectedVariantId ? "selected-row" : ""}>
            <td style="font-weight:600">
              <a href={`/admin/products/${productId}?variant=${v.id}`} class="variant-select-link">
                {v.id === selectedVariantId && <span class="selected-marker">●</span>} {v.name}
              </a>
            </td>
            <td>{v.price != null ? v.price : "—"}</td>
            <td><span class={`badge ${v.is_active ? "badge-active" : "badge-inactive"}`}>{v.is_active ? t.admin.conditions.active : t.admin.conditions.inactive}</span></td>
            <td class="action-cell">
              <a href={`/admin/products/${productId}?variant=${v.id}&edit_variant=${v.id}`} class="btn btn-ghost" style="padding:6px 12px;font-size:13px">{s.editVariant}</a>
              <form method="POST" onsubmit={`return confirm('${s.deleteVariantConfirm}')`} style="display:inline">
                <input type="hidden" name="action" value="delete_variant" />
                <input type="hidden" name="variant_id" value={v.id} />
                <button type="submit" class="btn btn-danger" style="padding:6px 12px;font-size:13px">{t.common.delete}</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  )}
  {variants.length === 0 && <p class="no-variants">{s.noVariants}</p>}

  <form method="POST" class="variant-form">
    <input type="hidden" name="action" value={editing ? "update_variant" : "add_variant"} />
    {editing && <input type="hidden" name="variant_id" value={editing.id} />}
    <div class="form-row">
      <div class="form-group">
        <label class="form-label">{s.variantName}</label>
        <input class="form-input" name="name" required value={editing?.name ?? ""} placeholder={s.variantNamePlaceholder} />
      </div>
      <div class="form-group">
        <label class="form-label">{s.variantPrice}</label>
        <input class="form-input" name="price" type="number" step="0.01" min="0" value={editing?.price ?? ""} />
      </div>
    </div>
    <div class="form-group">
      <label class="form-label">{s.variantSku}</label>
      <input class="form-input" name="sku" value={editing?.sku ?? ""} />
    </div>
    <div class="form-check">
      <input type="checkbox" name="is_active" id="variant_active" checked={editing ? editing.is_active : true} />
      <label for="variant_active">{s.variantActive}</label>
    </div>
    <div class="form-actions">
      {editingId && (
        <a href={`/admin/products/${productId}${selectedVariantId ? `?variant=${selectedVariantId}` : ""}`} class="btn btn-ghost">{s.cancelEdit}</a>
      )}
      {editing && (
        <a href={`/admin/products/${productId}?variant=${selectedVariantId ?? ""}&edit_variant=new`} class="btn btn-ghost">{s.addVariant}</a>
      )}
      <button type="submit" class="btn btn-primary">{editing ? s.saveVariant : s.addVariant}</button>
    </div>
  </form>
</div>

<style>
  .variants-title { font-size:16px; font-weight:700; margin:0 0 4px; }
  .variants-desc { font-size:13px; color:var(--text-muted); margin:0 0 16px; }
  .no-variants { font-size:14px; color:var(--text-muted); margin:0 0 16px; }
  .variant-form { display:flex; flex-direction:column; gap:16px; padding-top:16px; border-top:1px solid var(--border); }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .form-group { display:flex; flex-direction:column; gap:4px; }
  .form-label { font-size:13px; font-weight:500; color:var(--text-secondary); }
  .form-check { display:flex; align-items:center; gap:8px; font-size:14px; }
  .form-check input { width:auto; }
  .form-actions { display:flex; gap:12px; justify-content:flex-end; }
  .action-cell { display:flex; gap:8px; align-items:center; }
  .selected-row { background:var(--bg-subtle); }
  .variant-select-link { color:inherit; text-decoration:none; }
  .variant-select-link:hover { text-decoration:underline; }
  .selected-marker { color:var(--accent-primary); font-size:10px; }
  @media(max-width:600px) { .form-row { grid-template-columns:1fr; } }
</style>
