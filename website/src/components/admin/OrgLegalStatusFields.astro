---
// IČO toggle + both conditional field panels (own-company vs Smalljobs commission) + the
// platform Privacy Policy / Terms checkboxes. Shared by /admin/parties/new.astro for both the
// onboarding flow and staff creating additional orgs — an org without IČO needs the same
// commission-mode + approval treatment regardless of who creates it.
interface Props {
  t: any;
  hasIcoValue: string;
}
const { t, hasIcoValue } = Astro.props;
---

<div class="form-group ico-toggle">
  <label class="form-label">{t.admin.parties.onboarding.fieldHasIco}</label>
  <div class="radio-row">
    <label class="form-check">
      <input type="radio" name="has_ico" value="yes" checked={hasIcoValue === "yes"} data-ico-radio />
      {t.admin.parties.onboarding.hasIcoYes}
    </label>
    <label class="form-check">
      <input type="radio" name="has_ico" value="no" checked={hasIcoValue === "no"} data-ico-radio />
      {t.admin.parties.onboarding.hasIcoNo}
    </label>
  </div>
</div>

<div
  id="ico-fields"
  data-ico-panel="yes"
  data-ares-searching={t.admin.parties.onboarding.aresSearching}
  data-ares-notfound={t.admin.parties.onboarding.aresNotFound}
  data-ares-found={t.admin.parties.onboarding.aresFoundPrefix}
>
  <p class="mode-hint">{t.admin.parties.onboarding.icoHint}</p>
  <div class="form-row">
    <div class="form-group ares-name-group">
      <label class="form-label">{t.admin.parties.fieldCompany}</label>
      <input class="form-input" name="company_name" placeholder={t.admin.parties.fieldCompanyPlaceholder} autocomplete="off" data-ares-name />
      <ul class="ares-suggest hidden" data-ares-suggest></ul>
    </div>
    <div class="form-group">
      <label class="form-label">{t.admin.parties.onboarding.fieldIco}</label>
      <input class="form-input" name="company_ico" placeholder={t.admin.parties.onboarding.fieldIcoPlaceholder} data-required-in-panel="yes" inputmode="numeric" data-ares-ico />
      <p class="ares-status hidden" data-ares-status></p>
    </div>
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label">{t.admin.parties.fieldVat}</label>
      <input class="form-input" name="vat_number" placeholder={t.admin.parties.fieldVatPlaceholder} data-ares-vat />
    </div>
    <div class="form-group">
      <label class="form-label">{t.admin.parties.fieldBillingEmail}</label>
      <input class="form-input" name="billing_email" type="email" placeholder={t.admin.parties.fieldBillingEmailPlaceholder} />
    </div>
  </div>
</div>

<div id="no-ico-fields" data-ico-panel="no" class="hidden">
  <p class="mode-hint">{t.admin.parties.onboarding.noIcoHint}</p>
  <div class="form-group">
    <label class="form-label">{t.admin.parties.sellerMode.fieldLegalFullName}</label>
    <input class="form-input" name="legal_full_name" placeholder={t.admin.parties.fieldCompanyPlaceholder} data-required-in-panel="no" />
  </div>
  <div class="form-group">
    <label class="form-label">{t.admin.parties.sellerMode.fieldAddressLine1}</label>
    <input class="form-input" name="address_line1" data-required-in-panel="no" />
  </div>
  <div class="form-row">
    <div class="form-group">
      <label class="form-label">{t.admin.parties.sellerMode.fieldAddressCity}</label>
      <input class="form-input" name="address_city" data-required-in-panel="no" />
    </div>
    <div class="form-group">
      <label class="form-label">{t.admin.parties.sellerMode.fieldAddressPostalCode}</label>
      <input class="form-input" name="address_postal_code" data-required-in-panel="no" />
    </div>
  </div>
  <div class="form-group">
    <label class="form-label">{t.admin.parties.sellerMode.fieldBankAccount}</label>
    <input class="form-input" name="bank_account" data-required-in-panel="no" />
  </div>
  <div class="form-group">
    <label class="form-label">{t.admin.parties.sellerMode.fieldPersonalIdNote}</label>
    <input class="form-input" name="personal_id_note" />
  </div>
  <details class="terms-box">
    <summary>{t.admin.parties.onboarding.commissionTermsToggle}</summary>
    <h3>{t.admin.parties.sellerMode.agreementTitle}</h3>
    {t.admin.parties.sellerMode.agreementTerms.map((para: string) => <p class="terms-paragraph">{para}</p>)}
  </details>
  <label class="form-check">
    <input type="checkbox" name="commission_terms_accepted" data-required-in-panel="no" />
    {t.admin.parties.sellerMode.termsCheckboxLabel}
  </label>
</div>

<div class="legal-section">
  <details class="terms-box">
    <summary>{t.admin.parties.onboarding.privacyToggle}</summary>
    <h3>{t.admin.parties.onboarding.privacyTitle}</h3>
    {t.admin.parties.onboarding.privacyParagraphs.map((para: string) => <p class="terms-paragraph">{para}</p>)}
  </details>
  <label class="form-check">
    <input type="checkbox" name="privacy_accepted" required />
    {t.admin.parties.onboarding.privacyCheckboxLabel}
  </label>

  <details class="terms-box">
    <summary>{t.admin.parties.onboarding.platformTermsToggle}</summary>
    <h3>{t.admin.parties.onboarding.platformTermsTitle}</h3>
    {t.admin.parties.onboarding.platformTermsParagraphs.map((para: string) => <p class="terms-paragraph">{para}</p>)}
  </details>
  <label class="form-check">
    <input type="checkbox" name="terms_accepted" required />
    {t.admin.parties.onboarding.platformTermsCheckboxLabel}
  </label>
</div>

<script>
  const radios = document.querySelectorAll<HTMLInputElement>("[data-ico-radio]");
  const yesPanel = document.getElementById("ico-fields")!;
  const noPanel = document.getElementById("no-ico-fields")!;
  const conditionallyRequired = document.querySelectorAll<HTMLInputElement>("[data-required-in-panel]");
  function sync() {
    const checked = document.querySelector<HTMLInputElement>("[data-ico-radio]:checked")?.value ?? "yes";
    yesPanel.classList.toggle("hidden", checked !== "yes");
    noPanel.classList.toggle("hidden", checked !== "no");
    // A field's `required` must track which panel is actually visible — a required field
    // left over from a hidden panel can abort submission in some browsers instead of being
    // silently exempted, since it can't be focused to report the validation failure.
    conditionallyRequired.forEach((el) => {
      el.required = el.dataset.requiredInPanel === checked;
    });
  }
  radios.forEach((r) => r.addEventListener("change", sync));
  sync();

  // --- ARES autofill (own-company panel): IČO -> company name/DIČ, and name -> suggestions ---
  const aresPanel = document.getElementById("ico-fields");
  if (aresPanel) {
    const labels = aresPanel.dataset;
    const icoEl = aresPanel.querySelector<HTMLInputElement>("[data-ares-ico]");
    const nameEl = aresPanel.querySelector<HTMLInputElement>("[data-ares-name]");
    const vatEl = aresPanel.querySelector<HTMLInputElement>("[data-ares-vat]");
    const statusEl = aresPanel.querySelector<HTMLElement>("[data-ares-status]");
    const suggestEl = aresPanel.querySelector<HTMLUListElement>("[data-ares-suggest]");

    const setStatus = (text: string, kind: "muted" | "ok" | "warn") => {
      if (!statusEl) return;
      statusEl.textContent = text;
      statusEl.className = text ? `ares-status ares-status--${kind}` : "ares-status hidden";
    };

    let icoTimer: ReturnType<typeof setTimeout>;
    const lookupIco = async () => {
      const ico = (icoEl?.value ?? "").replace(/\s/g, "");
      if (!/^\d{8}$/.test(ico)) { setStatus("", "muted"); return; }
      setStatus(labels.aresSearching ?? "…", "muted");
      try {
        const d = await (await fetch(`/api/ares?ico=${ico}`)).json();
        if (d.found) {
          if (nameEl) nameEl.value = d.name;
          if (vatEl && d.dic) vatEl.value = d.dic;
          setStatus(`${labels.aresFound ?? ""} ${d.name}`.trim(), "ok");
        } else {
          setStatus(labels.aresNotfound ?? "", "warn");
        }
      } catch { setStatus("", "muted"); }
    };
    icoEl?.addEventListener("blur", lookupIco);
    icoEl?.addEventListener("input", () => { clearTimeout(icoTimer); icoTimer = setTimeout(lookupIco, 600); });

    const closeSuggest = () => { if (suggestEl) { suggestEl.innerHTML = ""; suggestEl.classList.add("hidden"); } };
    let nameTimer: ReturnType<typeof setTimeout>;
    const searchName = async () => {
      const q = (nameEl?.value ?? "").trim();
      if (q.length < 2 || !suggestEl) { closeSuggest(); return; }
      try {
        const d = await (await fetch(`/api/ares?q=${encodeURIComponent(q)}`)).json();
        const results: Array<{ ico: string; name: string; dic: string; city: string }> = d.results ?? [];
        if (!results.length) { closeSuggest(); return; }
        suggestEl.innerHTML = "";
        for (const res of results) {
          const li = document.createElement("li");
          li.className = "ares-suggest-item";
          const nm = document.createElement("span"); nm.className = "ares-suggest-name"; nm.textContent = res.name;
          const meta = document.createElement("span"); meta.className = "ares-suggest-meta";
          meta.textContent = `IČO ${res.ico}${res.city ? " · " + res.city : ""}`;
          li.append(nm, meta);
          // mousedown (not click) so it fires before the input's blur closes the list
          li.addEventListener("mousedown", (e) => {
            e.preventDefault();
            if (nameEl) nameEl.value = res.name;
            if (icoEl) icoEl.value = res.ico;
            if (vatEl && res.dic) vatEl.value = res.dic;
            setStatus(`${labels.aresFound ?? ""} ${res.name}`.trim(), "ok");
            closeSuggest();
          });
          suggestEl.appendChild(li);
        }
        suggestEl.classList.remove("hidden");
      } catch { closeSuggest(); }
    };
    nameEl?.addEventListener("input", () => { clearTimeout(nameTimer); nameTimer = setTimeout(searchName, 350); });
    nameEl?.addEventListener("blur", () => setTimeout(closeSuggest, 150));
  }
</script>

<style>
  .radio-row { display:flex; gap:20px; margin-top:4px; }
  .form-check { display:flex; align-items:center; gap:8px; font-size:13px; }
  .form-check input { width:auto; }
  .mode-hint { font-size:13px; color:var(--text-muted); line-height:1.6; margin:0 0 12px; }
  .hidden { display:none; }
  .legal-section { display:flex; flex-direction:column; gap:8px; border-top:1px solid var(--border-default); padding-top:16px; }
  .terms-box { font-size:13px; background:var(--bg-subtle); border-radius:8px; padding:12px 14px; }
  .terms-box summary { cursor:pointer; font-weight:600; }
  .terms-box h3 { font-size:13px; margin:10px 0 6px; }
  .terms-paragraph { color:var(--text-muted); line-height:1.6; margin:0 0 8px; }
  .ares-name-group { position:relative; }
  .ares-suggest {
    position:absolute; left:0; right:0; top:100%; z-index:20; margin:4px 0 0; padding:4px;
    list-style:none; background:var(--bg-page); border:1px solid var(--border-default);
    border-radius:8px; box-shadow:var(--shadow-lg); max-height:260px; overflow:auto;
  }
  /* Suggestion rows are created in JS, so they don't get Astro's scope attribute —
     target them as :global descendants of the scoped .ares-suggest container. */
  .ares-suggest :global(.ares-suggest-item) { display:flex; flex-direction:column; gap:2px; padding:8px 10px; border-radius:6px; cursor:pointer; }
  .ares-suggest :global(.ares-suggest-item:hover) { background:var(--bg-subtle); }
  .ares-suggest :global(.ares-suggest-name) { font-size:13px; font-weight:600; color:var(--text-primary); }
  .ares-suggest :global(.ares-suggest-meta) { font-size:12px; color:var(--text-muted); }
  .ares-status { font-size:12px; margin:4px 0 0; }
  .ares-status--muted { color:var(--text-muted); }
  .ares-status--ok { color:var(--success); }
  .ares-status--warn { color:var(--text-muted); }
</style>
