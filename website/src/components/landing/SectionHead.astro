---
// Numbered section heading used across the redesigned marketing pages.
interface Props {
  index: string;
  title: string;
  lead?: string;
  center?: boolean;
}
const { index, title, lead, center = false } = Astro.props;
---

<div class:list={["section-head", { "section-head--center": center }]} data-reveal-group>
  <span class="section-head-index font-mono" data-reveal>{index}</span>
  <div class="section-head-copy">
    <h2 class="section-title font-display" data-reveal>{title}</h2>
    {lead && <p class="section-sub" data-reveal>{lead}</p>}
  </div>
</div>

<style>
  .section-head { display: grid; grid-template-columns: 80px 1fr; gap: 24px; align-items: start; margin-bottom: 40px; }
  .section-head-index { color: var(--landing-mint); font-size: 13px; padding-top: 8px; }
  .section-head--center { grid-template-columns: 1fr; text-align: center; justify-items: center; }
  .section-head--center .section-head-index { padding-top: 0; }

  @media (max-width: 640px) {
    .section-head { grid-template-columns: 1fr; }
  }
</style>
