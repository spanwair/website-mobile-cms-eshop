---
import { useT } from "@/lib/i18n";
const t = useT(Astro);

const images = [
  "/img/template-store.jpg",
  "/img/desk-work.jpg",
  "/img/support-team.jpg",
  "/img/admin-analytics.jpg",
  "/img/payment.jpg",
  "/img/template-fashion.jpg",
];
---

<section class="landing" id="features">
  <div class="container-lg">
    <p class="section-eyebrow section-eyebrow--center">{t.landing.features.eyebrow}</p>
    <h2 class="section-title section-title--center">{t.landing.features.title}</h2>
    <p class="section-sub section-sub--center" style="margin-bottom:56px">{t.landing.features.sub}</p>

    <div class="feature-grid" data-reveal-group>
      {t.landing.features.items.map((item, i) => (
        <article class="card karta feature-card" data-reveal>
          <div class="feature-shot">
            <img src={images[i % images.length]} alt="" loading="lazy" width="440" height="300" />
          </div>
          <div class="feature-text">
            <h3 class="card-title">{item.title}</h3>
            <p class="card-desc">{item.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Fixed 3-up grid so the 6 feature cards land as a clean 3×2 block (auto-fit was
     giving an unbalanced 4 + 2). Collapses to 2-up, then 1-up on small screens. */
  .feature-grid { display: grid; gap: var(--space-m); grid-template-columns: repeat(3, 1fr); }
  @media (max-width: 860px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .feature-grid { grid-template-columns: 1fr; } }

  .feature-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .feature-shot { aspect-ratio: 16 / 10; background: var(--bg-subtle); overflow: hidden; }
  .feature-shot img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dur-base) var(--ease-out); }
  .feature-card:hover .feature-shot img { transform: scale(1.04); }
  .feature-text { padding: clamp(1.1rem, 2vw, 1.5rem); }
</style>
