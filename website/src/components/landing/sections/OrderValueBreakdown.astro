---
// Public pricing calculator — Phase 1 (display only), same pattern as CommissionCalculator.astro.
// Unlike that component (monthly turnover), this one walks through a SINGLE order.
//
// This shows a PROPOSED model, not what the backend does today: today commission is charged on
// item price + delivery combined (shared/utils/billingFeeCalc.ts / website/src/pages/eshop-
// [partySlug]/checkout.astro, where total_amount = subtotal + shipping_amount). Per Jan's
// 2026-11-04 direction, commission applies to the item price only — delivery is a pass-through
// the customer pays, but it is MámToDoma (not the seller) who pays the carrier for it: the
// platform owns the one shared carrier account per provider (see shared/services/
// shippingConfigService.ts / supabase/migrations/20260103000069_shipping_providers.sql — sellers
// never hold their own carrier account). So the delivery amount never reaches the seller's
// payout either way — it is money that passes from the customer, through the platform, to the
// carrier. Stripe still charges its fee on the WHOLE payment (item + delivery, that's how Stripe
// works) and that fee stays a platform cost, never passed to the customer or deducted from the
// seller's payout (one central Stripe account, no Stripe Connect — see shared/constants/
// payment.ts) — which is exactly why the break-even note below matters: with delivery no longer
// padding the commission base, the commission has less room to cover Stripe's cut on small
// orders.
import { getLang, useT } from "@/lib/i18n";
import { COMMISSION_ENTRY_RATE } from "@shared/constants/sellerMode";
import { STRIPE_FEE_PERCENT_EU, STRIPE_FEE_FIXED_CZK } from "@shared/constants/payment";

const t = useT(Astro);
const ob = t.landing.orderBreakdown;
const lang = getLang(Astro);
const locale = lang === "en" ? "en-US" : "cs-CZ";

// Flat rate — every order is charged the same COMMISSION_ENTRY_RATE, whether it's the party's
// first order of the month or its hundredth. See the interactive calculator above for how this
// plays out against a whole month's turnover.
const commissionPct = (Math.round(COMMISSION_ENTRY_RATE * 10000) / 100).toLocaleString(locale);
const stripePct = STRIPE_FEE_PERCENT_EU * 100;
const stripePctLabel = stripePct.toLocaleString(locale);

const rowStripe = ob.rowStripe
  .replace("{pct}", stripePctLabel)
  .replace("{fixed}", String(STRIPE_FEE_FIXED_CZK));
const rowCommission = ob.rowCommission.replace("{rate}", commissionPct);
const explainerRateTitle = ob.explainerRateTitle.replace("{rate}", commissionPct);
const explainerRateText = ob.explainerRateText;

// Server-rendered defaults so the receipt is complete (and correct) before the slider script
// runs. Must match the input's default value and the pickup delivery option below.
const fmtKc = (n: number) => `${Math.round(n).toLocaleString(locale)} Kč`;
const fmtNegativeKc = (n: number) => `−${Math.round(Math.abs(n)).toLocaleString(locale)} Kč`;
const DEFAULT_ITEM = 500;
const DEFAULT_DELIVERY = 69;
const defaultCommission = DEFAULT_ITEM * COMMISSION_ENTRY_RATE;
const defaultTotal = DEFAULT_ITEM + DEFAULT_DELIVERY;
const defaultStripeFee = defaultTotal * STRIPE_FEE_PERCENT_EU + STRIPE_FEE_FIXED_CZK;
const defaultMargin = defaultCommission - defaultStripeFee;
const defaultBreakEven = (DEFAULT_DELIVERY * STRIPE_FEE_PERCENT_EU + STRIPE_FEE_FIXED_CZK) / (COMMISSION_ENTRY_RATE - STRIPE_FEE_PERCENT_EU);

const defaultStripeNote = ob.rowStripeNote.replace("{total}", fmtKc(defaultTotal));
const defaultMarginNote = ob.marginNote
  .replace("{amount}", fmtKc(Math.max(defaultMargin, 0)))
  .replace("{commission}", fmtKc(defaultCommission));
const defaultBreakEvenNote = ob.breakEvenNote
  .replace("{rate}", String(commissionPct))
  .replace("{amount}", fmtKc(defaultBreakEven));
---

<section class="landing ob-section" id="order-breakdown">
  <div class="container-lg">
    <div class="ob-head">
      <p class="section-eyebrow section-eyebrow--center">{ob.eyebrow}</p>
      <h2 class="section-title section-title--center">{ob.title}</h2>
      <p class="section-sub section-sub--center">{ob.sub}</p>
    </div>

    <div class="ob-layout" data-reveal-group>
      <div
        class="ob-receipt"
        data-reveal
        data-standard-rate={COMMISSION_ENTRY_RATE}
        data-stripe-pct={STRIPE_FEE_PERCENT_EU}
        data-stripe-fixed={STRIPE_FEE_FIXED_CZK}
        data-row-stripe-note-template={ob.rowStripeNote}
        data-margin-note-template={ob.marginNote}
        data-break-even-template={ob.breakEvenNote}
        data-locale={locale}
      >
        <span class="ob-badge">{ob.exampleBadge}</span>

        <div class="ob-field">
          <div class="ob-field-head">
            <label class="ob-label" for="ob-item-price">{ob.itemPriceLabel}</label>
            <output class="ob-amount tnum" for="ob-item-price" id="ob-item-price-value">{fmtKc(DEFAULT_ITEM)}</output>
          </div>
          <input id="ob-item-price" type="range" min="100" max="3000" step="50" value={DEFAULT_ITEM} class="ob-slider" />
        </div>

        <div class="ob-field">
          <span class="ob-label" id="ob-delivery-label">{ob.deliveryLabel}</span>
          <div class="ob-segmented" role="group" aria-labelledby="ob-delivery-label">
            <button type="button" class="ob-segmented-btn ob-segmented-btn--active" data-delivery="69">{ob.deliveryPickup}</button>
            <button type="button" class="ob-segmented-btn" data-delivery="119">{ob.deliveryHome}</button>
          </div>
        </div>

        <div class="ob-lines">
          <div class="ob-line"><span>{ob.rowItem}</span><span class="tnum" id="ob-row-item">{fmtKc(DEFAULT_ITEM)}</span></div>
          <div class="ob-line ob-line--sub">
            <span>{rowCommission}</span>
            <span class="tnum" id="ob-row-commission">{fmtNegativeKc(defaultCommission)}</span>
          </div>
          <div class="ob-line ob-line--note">
            <span>{rowStripe}</span><span class="tnum" id="ob-row-stripe">{fmtNegativeKc(defaultStripeFee)}</span>
          </div>
          <div class="ob-line ob-line--net">
            <span>{ob.rowNet}</span>
            <span class="tnum" id="ob-row-net">{fmtKc(DEFAULT_ITEM - defaultCommission)}</span>
          </div>
        </div>

        <div class="ob-sub">
          <p class="ob-sub-label">{ob.paymentSectionLabel}</p>
          <div class="ob-line ob-line--muted">
            <span>{ob.rowDeliveryCharged}</span><span class="tnum" id="ob-row-delivery">{fmtKc(DEFAULT_DELIVERY)}</span>
          </div>
          <p class="ob-sub-total">
            <span>{ob.customerPaysLabel}</span>
            <strong class="tnum" id="ob-row-total">{fmtKc(defaultTotal)}</strong>
          </p>
        </div>
      </div>

      <aside class="ob-explain" data-reveal>
        <div class="ob-explain-item">
          <span class="ob-explain-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 7h10v9H3z"></path>
              <path d="M13 10h4l3 3v3h-7z"></path>
              <circle cx="7" cy="18.5" r="1.5"></circle>
              <circle cx="17" cy="18.5" r="1.5"></circle>
            </svg>
          </span>
          <div>
            <h3 class="ob-explain-title">{ob.explainerDeliveryTitle}</h3>
            <p class="ob-explain-text">{ob.explainerDeliveryText}</p>
          </div>
        </div>

        <div class="ob-explain-item">
          <span class="ob-explain-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="6" width="18" height="12" rx="2"></rect>
              <path d="M3 10h18"></path>
            </svg>
          </span>
          <div>
            <h3 class="ob-explain-title">{ob.explainerStripeTitle}</h3>
            <p class="ob-explain-text">{ob.explainerStripeText}</p>
          </div>
        </div>

        <div class="ob-explain-item">
          <span class="ob-explain-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 18 18 6"></path>
              <circle cx="7.5" cy="7.5" r="2"></circle>
              <circle cx="16.5" cy="16.5" r="2"></circle>
            </svg>
          </span>
          <div>
            <h3 class="ob-explain-title">{explainerRateTitle}</h3>
            <p class="ob-explain-text">{explainerRateText}</p>
          </div>
        </div>

        <details class="ob-details">
          <summary>{ob.platformDetailsTitle}</summary>
          <p id="ob-row-stripe-note">{defaultStripeNote}</p>
          <p id="ob-margin-note">{defaultMarginNote}</p>
          <p class:list={["ob-note--warn", defaultMargin >= 0 && "ob-note--hidden"]} id="ob-margin-warning">{ob.marginWarning}</p>
          <p id="ob-break-even">{defaultBreakEvenNote}</p>
        </details>

        <p class="ob-disclaimer">{ob.disclaimer}</p>
      </aside>
    </div>
  </div>
</section>

<script>
  const card = document.querySelector<HTMLElement>(".ob-receipt");
  const itemInput = document.getElementById("ob-item-price") as HTMLInputElement | null;
  const deliveryBtns = Array.from(document.querySelectorAll<HTMLButtonElement>(".ob-segmented-btn"));

  let deliveryPrice = 69;
  const locale = card?.dataset.locale ?? "cs-CZ";

  function formatKc(n: number) {
    return `${Math.round(n).toLocaleString(locale)} Kč`;
  }
  function formatNegativeKc(n: number) {
    return `−${Math.round(Math.abs(n)).toLocaleString(locale)} Kč`;
  }

  function update() {
    if (!card || !itemInput) return;
    const rate = Number(card.dataset.standardRate);
    const stripePct = Number(card.dataset.stripePct);
    const stripeFixed = Number(card.dataset.stripeFixed);

    const itemPrice = Number(itemInput.value);
    const totalPayment = itemPrice + deliveryPrice;
    const commission = itemPrice * rate;
    const netItem = itemPrice - commission;
    const stripeFee = totalPayment * stripePct + stripeFixed;
    const platformMargin = commission - stripeFee;
    const breakEven = (deliveryPrice * stripePct + stripeFixed) / (rate - stripePct);

    const amountOut = document.getElementById("ob-item-price-value");
    if (amountOut) amountOut.textContent = formatKc(itemPrice);
    document.getElementById("ob-row-item")!.textContent = formatKc(itemPrice);
    document.getElementById("ob-row-net")!.textContent = formatKc(netItem);
    document.getElementById("ob-row-delivery")!.textContent = formatKc(deliveryPrice);
    document.getElementById("ob-row-stripe")!.textContent = formatNegativeKc(stripeFee);
    document.getElementById("ob-row-total")!.textContent = formatKc(totalPayment);

    const stripeNote = document.getElementById("ob-row-stripe-note");
    if (stripeNote) {
      stripeNote.textContent = (card.dataset.rowStripeNoteTemplate ?? "").replace("{total}", formatKc(totalPayment));
    }

    document.getElementById("ob-row-commission")!.textContent = formatNegativeKc(commission);

    const marginNote = document.getElementById("ob-margin-note");
    if (marginNote) {
      marginNote.textContent = (card.dataset.marginNoteTemplate ?? "")
        .replace("{amount}", formatKc(Math.max(platformMargin, 0)))
        .replace("{commission}", formatKc(commission));
    }

    const warning = document.getElementById("ob-margin-warning");
    warning?.classList.toggle("ob-note--hidden", platformMargin >= 0);

    const breakEvenNote = document.getElementById("ob-break-even");
    if (breakEvenNote) {
      breakEvenNote.textContent = (card.dataset.breakEvenTemplate ?? "")
        .replace("{rate}", (Math.round(rate * 10000) / 100).toLocaleString(locale))
        .replace("{amount}", formatKc(breakEven));
    }
  }

  itemInput?.addEventListener("input", update);
  deliveryBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      deliveryBtns.forEach((b) => b.classList.remove("ob-segmented-btn--active"));
      btn.classList.add("ob-segmented-btn--active");
      deliveryPrice = Number(btn.dataset.delivery);
      update();
    });
  });

  update();
</script>

<style>
  .ob-section { background: var(--bg-subtle); }

  .ob-head { max-width: 640px; margin: 0 auto clamp(2rem, 4vw, 3rem); text-align: center; }
  .ob-head .section-sub { margin-inline: auto; }

  .ob-layout {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(1.5rem, 3vw, 3rem); align-items: start;
    max-width: 1040px; margin-inline: auto;
  }

  .ob-receipt {
    background: var(--bg-surface); border: 1px solid var(--border-default);
    border-radius: var(--radius-xl); padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-sm);
  }
  .ob-badge {
    display: inline-block; margin-bottom: 22px; padding: 4px 10px;
    background: var(--accent-soft); color: var(--accent-primary-hover);
    border-radius: var(--radius-full); font-size: var(--fs-label); font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase;
  }

  .ob-field + .ob-field { margin-top: 22px; }
  .ob-field-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 10px; }
  .ob-label { display: block; font-size: 13px; color: var(--text-muted); }
  .ob-amount { font-family: var(--font-display); font-size: 20px; font-weight: 700; color: var(--text-primary); letter-spacing: -0.01em; }
  .ob-slider { width: 100%; margin: 0; accent-color: var(--accent-primary); cursor: pointer; }
  .ob-slider:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 4px; border-radius: var(--radius-full); }

  .ob-segmented {
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px; padding: 4px;
    background: var(--bg-subtle); border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }
  .ob-segmented-btn {
    padding: 9px 10px; border: 0; border-radius: calc(var(--radius-md) - 4px);
    background: transparent; color: var(--text-muted); font-size: 13px; line-height: 1.35;
    cursor: pointer; transition: background var(--dur-fast) ease, color var(--dur-fast) ease, box-shadow var(--dur-fast) ease;
  }
  .ob-segmented-btn:hover { color: var(--text-primary); }
  .ob-segmented-btn:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 1px; }
  .ob-segmented-btn--active {
    background: var(--bg-surface); color: var(--text-primary); font-weight: 600;
    box-shadow: var(--shadow-sm);
  }

  .ob-lines { margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--border-default); }
  .ob-line { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 6px 0; font-size: 15px; }
  .ob-line > span:last-child { white-space: nowrap; }
  .ob-line--sub { color: var(--text-muted); font-size: 14px; }
  .ob-line--sub span:last-child { color: var(--text-primary); font-weight: 600; }
  .ob-line--note {
    margin: 0 0 0 2px; padding: 3px 0 3px 12px;
    border-left: 2px solid var(--border-default);
    font-size: 12.5px; color: var(--text-muted);
  }
  .ob-line--note span:last-child { color: var(--text-muted); }
  .ob-line--net {
    margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--border-default);
    font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.01em;
  }
  .ob-line--net span:last-child { font-size: 30px; line-height: 1.1; color: var(--accent-primary); }

  .ob-sub { margin-top: 20px; padding: 16px; background: var(--bg-subtle); border-radius: var(--radius-md); }
  .ob-sub-label {
    margin: 0 0 4px; font-size: var(--fs-label); font-weight: 600;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted);
  }
  .ob-line--muted { font-size: 13.5px; color: var(--text-muted); padding: 3px 0; }
  .ob-line--muted span:last-child { color: var(--text-primary); }
  .ob-sub-total {
    display: flex; align-items: baseline; justify-content: space-between; gap: 16px;
    margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--border-default);
    font-size: 13.5px; color: var(--text-muted);
  }
  .ob-sub-total strong { font-size: 15px; font-weight: 700; color: var(--text-primary); }

  .ob-explain { display: flex; flex-direction: column; gap: 22px; padding-top: 6px; }
  .ob-explain-item { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; }
  .ob-explain-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px; border-radius: var(--radius-md);
    background: var(--accent-soft); color: var(--accent-primary);
  }
  .ob-explain-icon svg { width: 20px; height: 20px; }
  .ob-explain-title {
    margin: 0 0 4px; font-family: var(--font-display); font-size: 15px;
    font-weight: 700; line-height: 1.35; letter-spacing: -0.01em; color: var(--text-primary);
  }
  .ob-explain-text { margin: 0; max-width: 46ch; font-size: 14px; line-height: 1.65; color: var(--text-muted); }

  .ob-details { margin-top: 4px; padding-top: 18px; border-top: 1px solid var(--border-default); }
  .ob-details summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    cursor: pointer; list-style: none; font-size: 13px; font-weight: 600; color: var(--text-primary);
  }
  .ob-details summary::-webkit-details-marker { display: none; }
  .ob-details summary::after { content: "+"; font-size: 18px; line-height: 1; color: var(--text-muted); }
  .ob-details[open] summary::after { content: "−"; }
  .ob-details summary:hover { color: var(--accent-primary-hover); }
  .ob-details summary:focus-visible { outline: 2px solid var(--accent-primary); outline-offset: 4px; border-radius: var(--radius-sm); }
  .ob-details p { margin: 10px 0 0; font-size: 13px; line-height: 1.6; color: var(--text-muted); }
  .ob-details .ob-note--warn {
    padding: 8px 10px; background: rgba(224, 137, 79, 0.12);
    border-radius: var(--radius-sm); color: var(--text-primary); font-weight: 500;
  }
  .ob-note--hidden { display: none; }
  .ob-disclaimer { margin: 12px 0 0; font-size: 11.5px; line-height: 1.55; color: var(--text-placeholder); font-style: italic; }

  @media (max-width: 900px) {
    .ob-layout { grid-template-columns: 1fr; }
    .ob-explain { padding-top: 0; }
  }

  @media (max-width: 640px) {
    .ob-receipt { padding: 24px 20px; }
    .ob-segmented { grid-template-columns: 1fr; }
    .ob-segmented-btn { color: var(--text-primary); }
    .ob-segmented-btn--active { font-weight: 700; }
    .ob-line { font-size: 14px; }
    .ob-line--net { font-size: 16px; }
    .ob-line--net span:last-child { font-size: 26px; }
    .ob-explain-item { grid-template-columns: 36px 1fr; gap: 12px; }
    .ob-explain-icon { width: 36px; height: 36px; }
  }
</style>
