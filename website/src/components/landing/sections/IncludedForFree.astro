---
import { useT } from "@/lib/i18n";
const t = useT(Astro);
const included = t.landing.included;

// One consistent stroke-icon family, 24px box, drawn inline. Decorative only — every tile
// is already named by its heading.
const icons = [
  '<path d="M4 9h16l-1 11H5L4 9Z"/><path d="M9 9V6.5a3 3 0 0 1 6 0V9"/>',
  '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/>',
  '<path d="M7 3h7l4 4v14H7V3Z"/><path d="M14 3v4h4"/><path d="M10 11h5M10 15h5"/>',
  '<path d="M3 8.5 12 4l9 4.5-9 4.5-9-4.5Z"/><path d="M3 8.5V16l9 4.5 9-4.5V8.5"/><path d="M12 13v7.5"/>',
  '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><path d="M16 5.5a3 3 0 0 1 0 5.5"/><path d="M18.5 20a5 5 0 0 0-3-4.6"/>',
  '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3Z"/><path d="M9 8h6M9 12h6"/>',
];
---

<section class="landing included" id="included">
  <div class="container-lg">
    <div class="included-head" data-reveal>
      <p class="section-eyebrow section-eyebrow--center">{included.eyebrow}</p>
      <h2 class="section-title section-title--center">{included.title}</h2>
      <p class="section-sub section-sub--center">{included.sub}</p>
    </div>

    <div class="included-grid" data-reveal-group>
      {included.items.map((item, i) => (
        <article class:list={["included-tile", i % 2 === 0 && "included-tile--wash"]} data-reveal>
          <div class="included-top">
            <svg class="included-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[i]} />
            <span class="included-badge">{included.badge}</span>
          </div>
          <h3 class="included-title">{item.title}</h3>
          <p class="included-desc">{item.desc}</p>
        </article>
      ))}
    </div>

    <a class="included-wide" href="/contact" data-reveal>
      <p class="included-wide-text">{included.wide.text}</p>
      <span class="included-wide-cta">
        {included.wide.cta} <span aria-hidden="true">→</span>
      </span>
    </a>

    <p class="included-note">{included.note}</p>
  </div>
</section>

<style>
  .included-head { max-width: 660px; margin: 0 auto clamp(2rem, 4vw, 2.75rem); text-align: center; }
  .included-head .section-sub { margin-inline: auto; margin-bottom: 0; }

  .included-grid { display: grid; gap: 16px; grid-template-columns: repeat(3, 1fr); }

  .included-tile {
    display: flex; flex-direction: column;
    padding: clamp(1.25rem, 2vw, 1.6rem);
    background: var(--bg-surface); border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
  }
  .included-tile--wash { background: rgba(22, 165, 113, 0.14); border-color: rgba(14, 143, 99, 0.16); }

  .included-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .included-icon { width: 24px; height: 24px; color: var(--accent-primary); flex: none; }
  .included-badge {
    padding: 3px 8px; border-radius: var(--radius-full);
    background: var(--bg-surface); border: 1px solid rgba(14, 143, 99, 0.22);
    color: var(--accent-primary-hover); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap;
  }

  .included-title {
    margin: 0 0 6px; font-family: var(--font-display); font-size: 17px;
    font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; color: var(--text-primary);
  }
  .included-desc { margin: 0; font-size: 14px; line-height: 1.6; color: var(--text-muted); }

  .included-wide {
    display: flex; align-items: center; justify-content: space-between; gap: clamp(1rem, 3vw, 2.5rem);
    margin-top: 48px; padding: clamp(1.5rem, 2.6vw, 2.1rem) clamp(1.5rem, 2.8vw, 2.5rem);
    background: var(--landing-dark); border-radius: var(--radius-lg);
    color: var(--landing-dark-text); text-decoration: none;
    transition: background 0.2s ease;
  }
  .included-wide:hover { background: var(--landing-dark-elevated); }
  .included-wide-text {
    margin: 0; max-width: 74ch; font-family: var(--font-display);
    font-size: clamp(17px, 1.5vw, 21px); font-weight: 650; line-height: 1.4;
    letter-spacing: -0.01em; text-wrap: pretty;
  }
  .included-wide-cta {
    flex: none; font-size: 14px; font-weight: 700; white-space: nowrap;
    padding-bottom: 2px; border-bottom: 1px solid rgba(255, 255, 255, 0.45);
    transition: border-color 0.2s ease;
  }
  .included-wide:hover .included-wide-cta { border-color: #fff; }

  .included-note {
    margin: 24px auto 0; max-width: 54ch; text-align: center;
    font-size: 14px; font-weight: 600; color: var(--text-muted);
  }

  /* Floating collage: side columns sit lower than the center one. `top` (not transform)
     keeps the reveal animation's transform intact and leaves layout height predictable. */
  @media (min-width: 901px) {
    .included-grid { align-items: start; padding-bottom: 44px; }
    .included-grid > :nth-child(3n + 1),
    .included-grid > :nth-child(3n) { position: relative; top: 44px; }
  }

  @media (max-width: 900px) { .included-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 700px) { .included-wide { flex-direction: column; align-items: flex-start; } }
  @media (max-width: 560px) {
    .included-grid { grid-template-columns: 1fr; }
    .included-top { margin-bottom: 14px; }
  }
</style>
