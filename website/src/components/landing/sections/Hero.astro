---
import { useT } from "@/lib/i18n";
const t = useT(Astro);
// Launch/founding headline rate shown in the hero stat card. The standard tiered model
// (10% dropping to 5%) lives in the commission calculator; the index leads with 5%.
const commissionPct = 5;
---

<section class="landing hero" id="hero">
  <div class="container-lg hero-grid">
    <div class="hero-copy" data-hero-reveal>
      <span class="hero-eyebrow"><span class="hero-dot" aria-hidden="true"></span>{t.landing.hero.eyebrow}</span>

      <h1 class="hero-title">
        <span class="hero-line">{t.landing.hero.titleLine1} <span class="hero-accent">{t.landing.hero.titleHighlight}</span></span>
        <span class="hero-line hero-line--sm">{t.landing.hero.titleLine2}</span>
      </h1>

      <p class="hero-sub measure">{t.landing.hero.sub}</p>

      <form id="hero-lead-form" class="hero-form" novalidate>
        <input type="email" name="email" required placeholder={t.landing.hero.formPlaceholder} class="hero-input" aria-label={t.landing.hero.formPlaceholder} />
        <button type="submit" class="btn btn-primary btn-lg">{t.landing.hero.formCta}</button>
      </form>
      <p class="hero-trust tnum">{t.landing.hero.trustLine}</p>
    </div>

    <figure class="hero-visual" data-reveal>
      <span class="hero-block hero-block--accent" aria-hidden="true"></span>
      <span class="hero-block hero-block--soft" aria-hidden="true"></span>
      <div class="hero-frame">
        <img src="/img/hero-seller.jpg" alt="" width="1400" height="2100" class="hero-image" loading="eager" fetchpriority="high" />
      </div>
      <figcaption class="hero-float float">
        <span class="hero-float-num font-display tnum">{commissionPct}<span class="hero-float-pct"> %</span></span>
        <span class="hero-float-label">{t.landing.hero.floatLabel}</span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const form = document.getElementById("hero-lead-form") as HTMLFormElement | null;
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const emailInput = form.elements.namedItem("email") as HTMLInputElement | null;
    const email = emailInput ? emailInput.value.trim() : "";
    const params = new URLSearchParams({ mode: "signup" });
    if (email) params.set("email", email);
    window.location.href = `/login?${params.toString()}`;
  });
</script>

<style>
  .hero { position: relative; padding-block: clamp(2.5rem, 4vw + 1.5rem, 5rem) clamp(2rem, 4vw, 4rem); overflow: clip; }
  .hero-grid {
    display: grid; grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
  }

  .hero-copy { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-size: var(--fs-label); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }
  .hero-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }

  .hero-title { font-size: var(--display-2xl); line-height: 1.02; margin: 0 0 clamp(1.1rem, 2vw, 1.6rem); max-width: 15ch; }
  .hero-line { display: block; }
  .hero-line--sm { font-size: 0.4em; line-height: 1.2; font-weight: 600; color: var(--text-muted); margin-top: 0.55em; }
  .hero-accent { color: var(--accent); }

  .hero-sub { font-size: var(--fs-body-lg); line-height: 1.6; color: var(--text-muted); margin-bottom: clamp(1.5rem, 3vw, 2rem); }

  .hero-form { display: flex; gap: 0.6rem; width: 100%; max-width: 30rem; margin-bottom: 0.9rem; }
  .hero-input {
    flex: 1; padding: 0.9rem 1rem; border-radius: var(--radius-full);
    border: 1.5px solid var(--border-strong); background: var(--bg-surface);
    font: inherit; font-size: var(--fs-sm); color: var(--text-primary);
    transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .hero-input:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .hero-trust { font-size: var(--fs-sm); font-weight: 600; color: var(--text-muted); letter-spacing: -0.005em; }

  /* Visual: portrait photo in a rounded frame, with two offset brand blocks behind it
     (evergreen + soft mint) echoing Shoptet's geometric hero, kept in our palette. */
  .hero-visual { position: relative; justify-self: center; width: 100%; max-width: 26rem; }
  .hero-frame {
    position: relative; z-index: 1; aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl); overflow: hidden;
    box-shadow: 0 40px 70px -34px rgba(15, 26, 22, 0.45);
  }
  .hero-image { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 18%; }
  .hero-block { position: absolute; border-radius: var(--radius-lg); z-index: 0; }
  .hero-block--accent { width: 46%; height: 55%; top: -1.1rem; right: -1.1rem; background: var(--accent); }
  .hero-block--soft { width: 40%; height: 42%; bottom: -1.1rem; left: -1.1rem; background: var(--accent-soft); }

  .hero-float {
    position: absolute; z-index: 2; left: -0.9rem; bottom: clamp(1.25rem, 4vw, 2.5rem);
    background: var(--bg-surface); border: 1px solid var(--border-default);
    border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    padding: 0.85rem 1.15rem; display: flex; flex-direction: column; gap: 0.15rem; text-align: left;
  }
  .hero-float-num { font-size: 2rem; line-height: 1; color: var(--accent); font-weight: 800; }
  .hero-float-pct { font-size: 0.55em; font-weight: 700; }
  .hero-float-label { font-size: var(--fs-sm); color: var(--text-muted); max-width: 14ch; }

  /* Load-time entrance — above-fold, so it animates on load (not scroll) and never blocks LCP. */
  [data-hero-reveal] .hero-line { opacity: 0; transform: translateY(0.4em); animation: hero-rise 0.9s var(--ease-out) forwards; }
  [data-hero-reveal] .hero-line:nth-child(1) { animation-delay: 0.05s; }
  [data-hero-reveal] .hero-line:nth-child(2) { animation-delay: 0.15s; }
  @keyframes hero-rise { to { opacity: 1; transform: none; } }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; gap: clamp(2.5rem, 8vw, 3.5rem); }
    .hero-copy { align-items: center; text-align: center; }
    .hero-title { margin-inline: auto; }
    .hero-sub { margin-inline: auto; }
    .hero-form { margin-inline: auto; }
    .hero-visual { max-width: 24rem; }
  }
  @media (max-width: 640px) {
    .hero-form { flex-direction: column; }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-hero-reveal] .hero-line { opacity: 1; transform: none; animation: none; }
  }
</style>
