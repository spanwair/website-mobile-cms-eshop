---
import { useT } from "@/lib/i18n";
import { COMMISSION_RATE } from "@shared/constants/sellerMode";
const t = useT(Astro);
const h = t.landing.hero;
const commissionPct = Math.round(COMMISSION_RATE * 100);
---

<section class="landing hero-section" id="hero">
  <div class="container-lg hero-layout">
    <div class="hero-content">
      <span class="hero-badge font-mono">{h.eyebrow}</span>
      <h1 class="hero-title font-display">
        {h.titleLine1} <span class="gradient-text">{h.titleHighlight}</span> — {h.titleLine2}
      </h1>
      <p class="hero-sub">{h.sub}</p>

      <form id="hero-lead-form" class="hero-form" novalidate>
        <input type="email" name="email" required placeholder={h.formPlaceholder} class="hero-input" />
        <button type="submit" class="btn btn-primary btn-lg">{h.formCta}</button>
      </form>
      <p class="hero-note" id="hero-form-msg">{h.formNote}</p>
      <p class="hero-trust font-mono">{h.trustLine}</p>
    </div>

    <div class="hero-visual" data-reveal>
      <img src="/img/hero-eshop.jpg" alt="" width="560" height="640" class="hero-image" loading="eager" />
      <div class="hero-float-card float">
        <span class="hero-float-num font-display">{commissionPct} %</span>
        <span class="hero-float-label">{h.floatLabel}</span>
      </div>
    </div>
  </div>
  <div class="hero-blob hero-blob--mint" aria-hidden="true"></div>
  <div class="hero-blob hero-blob--sky" aria-hidden="true"></div>
</section>

<script>
  const form = document.getElementById("hero-lead-form");
  const msg = document.getElementById("hero-form-msg");
  const originalMsg = msg?.textContent ?? "";

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const emailInput = form.elements.namedItem("email") as HTMLInputElement | null;
      const email = emailInput ? emailInput.value : "";

      try {
        const res = await fetch("/api/landing/lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        if (msg) msg.textContent = res.ok ? "✓" : originalMsg;
        if (res.ok && emailInput) emailInput.value = "";
      } catch {
        if (msg) msg.textContent = originalMsg;
      }
    });
  }
</script>

<style>
  .hero-section {
    position: relative; overflow: hidden;
    padding-block: clamp(48px, 8vw, 96px);
  }
  .hero-layout { display: grid; grid-template-columns: 1.05fr 1fr; gap: 56px; align-items: center; position: relative; z-index: 1; }
  .hero-content { max-width: 600px; }
  .hero-badge {
    display: inline-block; padding: 6px 14px; border-radius: var(--radius-full);
    background: var(--landing-mint-soft); color: var(--accent-primary);
    font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase;
    margin-bottom: 20px;
  }
  .hero-title { font-size: var(--display-2xl); line-height: 1.06; letter-spacing: -0.02em; margin-bottom: 20px; }
  .hero-sub { font-size: 1.125rem; line-height: 1.65; color: var(--text-muted); max-width: 560px; margin-bottom: 32px; }
  .hero-form { display: flex; gap: 10px; max-width: 460px; margin-bottom: 12px; }
  .hero-input {
    flex: 1; padding: 14px 16px; border-radius: var(--radius-md);
    border: 1.5px solid var(--border-default); background: var(--bg-page); font-size: 15px;
  }
  .hero-note { font-size: 13px; color: var(--text-placeholder); margin-bottom: 24px; }
  .hero-trust { font-size: 13px; font-weight: 600; color: var(--text-primary); }

  .hero-visual { position: relative; }
  .hero-image { width: 100%; height: auto; aspect-ratio: 7 / 8; object-fit: cover; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); }
  .hero-float-card {
    position: absolute; left: -24px; bottom: 32px;
    background: var(--bg-page); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
    padding: 14px 20px; display: flex; flex-direction: column;
  }
  .hero-float-num { font-family: var(--font-display); font-size: 28px; line-height: 1; }
  .hero-float-label { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

  .hero-blob { position: absolute; border-radius: 50%; filter: blur(90px); opacity: 0.55; z-index: 0; }
  .hero-blob--mint { width: 380px; height: 380px; background: var(--landing-mint-soft); top: -100px; right: -60px; }
  .hero-blob--sky { width: 280px; height: 280px; background: rgba(125,211,252,0.3); bottom: -80px; left: 20%; }

  @media (max-width: 900px) {
    .hero-layout { grid-template-columns: 1fr; }
    .hero-content { max-width: 100%; text-align: center; }
    .hero-sub, .hero-form, .hero-trust { margin-inline: auto; }
    .hero-visual { max-width: 380px; margin-inline: auto; }
    .hero-float-card { left: 12px; }
  }
  @media (max-width: 640px) {
    .hero-form { flex-direction: column; }
  }
</style>
