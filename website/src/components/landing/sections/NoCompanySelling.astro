---
import { useT } from "@/lib/i18n";
const t = useT(Astro);
---

<section class="landing" id="no-company" style="background:var(--bg-surface)">
  <div class="container-lg">
    <div class="nc-intro" data-reveal-group>
      <figure class="nc-media" data-reveal>
        <img src="/img/maker-candles.jpg" alt="" width="1200" height="1800" loading="lazy" />
      </figure>
      <div class="nc-head" data-reveal>
        <p class="section-eyebrow">{t.landing.noCompanySelling.eyebrow}</p>
        <h2 class="section-title">{t.landing.noCompanySelling.title}</h2>
        <p class="section-sub">{t.landing.noCompanySelling.sub}</p>
      </div>
    </div>

    <div class="compare-row" data-reveal-group>
      <div class="compare-card" data-reveal>
        <h3 class="compare-title">{t.landing.noCompanySelling.ownCompanyTitle}</h3>
        <ul class="compare-list">
          {t.landing.noCompanySelling.ownCompanyBullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
      <div class="compare-card compare-card--highlight" data-reveal>
        <h3 class="compare-title">{t.landing.noCompanySelling.noCompanyTitle}</h3>
        <ul class="compare-list">
          {t.landing.noCompanySelling.noCompanyBullets.map((b) => <li>{b}</li>)}
        </ul>
      </div>
    </div>

    <div class="compare-footer">
      <a href="/pricing#faq" class="btn btn-secondary">{t.landing.noCompanySelling.ctaLabel}</a>
      <p class="compare-disclaimer">{t.landing.noCompanySelling.disclaimer}</p>
    </div>
  </div>
</section>

<style>
  .nc-intro {
    display: grid; grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(1.5rem, 4vw, 3.5rem); align-items: stretch; margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  /* Image fills its column so its height tracks the copy instead of ballooning to the
     portrait's intrinsic ratio (which left a large imbalance beside the short heading). */
  .nc-media {
    position: relative; margin: 0; min-height: 15rem; border-radius: var(--radius-xl);
    overflow: hidden; box-shadow: 0 30px 60px -40px rgba(15, 26, 22, 0.4);
  }
  .nc-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; }
  .nc-head { display: flex; flex-direction: column; justify-content: center; }
  .nc-head .section-title { margin-bottom: 0.75rem; }
  .nc-head .section-sub { margin: 0; }
  @media (max-width: 820px) {
    .nc-intro { grid-template-columns: 1fr; }
    .nc-media { max-width: 26rem; margin-inline: auto; aspect-ratio: 4 / 3; min-height: 0; width: 100%; }
    .nc-head { text-align: center; }
    .nc-head .section-eyebrow { justify-content: center; }
    .nc-head .section-eyebrow::before { display: none; }
  }

  .compare-row { display: grid; gap: var(--space-6); grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); }
  .compare-card { padding: var(--space-6); border-radius: var(--radius-lg); background: var(--bg-page); border: 1px solid var(--border-default); }
  .compare-card--highlight { border-color: var(--accent-primary); background: var(--landing-mint-soft); }
  .compare-title { font-size: 17px; font-weight: 700; margin-bottom: 14px; }
  .compare-list { display: flex; flex-direction: column; gap: 10px; padding: 0; margin: 0; list-style: none; }
  .compare-list li { font-size: 14px; color: var(--text-muted); line-height: 1.5; padding-left: 22px; position: relative; }
  .compare-list li::before { content: "✓"; position: absolute; left: 0; color: var(--accent-primary); font-weight: 700; }
  .compare-footer { text-align: center; margin-top: 36px; }
  .compare-disclaimer { margin-top: 10px; font-size: 12px; color: var(--text-placeholder); }
</style>
