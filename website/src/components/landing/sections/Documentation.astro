---
import { useT } from "@/lib/i18n";
const t = useT(Astro);

const icons = [
  `<path d="M12 3 3 8l9 5 9-5-9-5Z"/><path d="M3 8v6l9 5 9-5V8"/>`,
  `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 4v16"/>`,
  `<path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"/><path d="M14 4v5h5"/>`,
];
---

<section class="landing" id="documentation">
  <div class="container-lg">
    <p class="section-eyebrow section-eyebrow--center">{t.landing.documentation.eyebrow}</p>
    <h2 class="section-title section-title--center">{t.landing.documentation.title}</h2>
    <p class="section-sub section-sub--center" style="margin-bottom:48px">{t.landing.documentation.sub}</p>

    <div class="grid-auto" data-reveal-group>
      {t.landing.documentation.items.map((item, i) => (
        <div class="card doc-card" data-reveal>
          <div class="doc-icon-badge">
            <svg class="doc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={icons[i % icons.length]} />
          </div>
          <h3 class="doc-title">{item.title}</h3>
          <p class="doc-desc">{item.desc}</p>
        </div>
      ))}
    </div>

    <div class="doc-cta">
      <a href="/docs" class="btn btn-primary btn-lg">{t.landing.documentation.primaryCta}</a>
    </div>
  </div>
</section>

<style>
  .doc-card {
    background: var(--landing-cream);
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .doc-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); border-color: var(--border-strong); }
  .doc-icon-badge {
    display: flex; align-items: center; justify-content: center;
    width: 56px; height: 56px; border-radius: var(--radius-md);
    background: var(--landing-mint-soft); margin-bottom: 16px;
  }
  .doc-icon { width: 32px; height: 32px; color: var(--accent-primary); }
  .doc-title { font-size: 17px; font-weight: 700; margin-bottom: 8px; }
  .doc-desc { color: var(--text-muted); font-size: 14px; line-height: 1.6; }
  .doc-cta { display: flex; justify-content: center; margin-top: 40px; }
</style>
