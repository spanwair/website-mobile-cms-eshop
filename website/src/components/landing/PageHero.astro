---
// Reusable inner-page hero: eyebrow + serif headline + optional lead + optional image.
// `titleHtml`, when given, is trusted markup from i18n copy (e.g. to italicize a word) —
// never pass user input through it.
interface Props {
  eyebrow: string;
  title: string;
  titleHtml?: string;
  lead?: string;
  image?: string;
  imageAlt?: string;
}
const { eyebrow, title, titleHtml, lead, image, imageAlt = "" } = Astro.props;
---

<section class="landing page-hero" data-reveal-group>
  <div class="container-lg page-hero-grid">
    <div class="page-hero-copy">
      <span class="section-eyebrow font-mono" data-reveal>{eyebrow}</span>
      {titleHtml ? (
        <h1 class="page-hero-title font-display" data-reveal set:html={titleHtml} />
      ) : (
        <h1 class="page-hero-title font-display" data-reveal>{title}</h1>
      )}
      {lead && <p class="page-hero-lead" data-reveal>{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="page-hero-media" data-reveal>
        <img src={image} alt={imageAlt} width="640" height="480" loading="eager" />
      </div>
    )}
  </div>
  <div class="page-hero-blob page-hero-blob--mint" aria-hidden="true"></div>
  <div class="page-hero-blob page-hero-blob--sky" aria-hidden="true"></div>
</section>

<style>
  .page-hero { position: relative; overflow: hidden; padding-bottom: 0; }
  .page-hero-grid { display: grid; gap: 48px; grid-template-columns: 1.1fr 1fr; align-items: center; position: relative; z-index: 1; }
  .page-hero-title { font-size: var(--display-xl); line-height: 1.05; letter-spacing: -0.02em; margin-block: 16px; }
  .page-hero-lead { font-size: 18px; color: var(--text-muted); line-height: 1.6; max-width: 46ch; }
  .page-hero-media img { width: 100%; height: auto; border-radius: var(--radius-xl); object-fit: cover; aspect-ratio: 4 / 3; box-shadow: var(--shadow-lg); }
  .page-hero-blob { position: absolute; border-radius: 50%; filter: blur(80px); z-index: 0; opacity: 0.5; }
  .page-hero-blob--mint { width: 320px; height: 320px; background: var(--landing-mint-soft); top: -80px; right: 10%; }
  .page-hero-blob--sky { width: 260px; height: 260px; background: rgba(125,211,252,0.35); bottom: -60px; left: -60px; }

  @media (max-width: 900px) {
    .page-hero-grid { grid-template-columns: 1fr; }
  }
</style>
