---
// Integrations section — real, verified integrations only, pulled from the caller,
// never hardcoded here, so this never overstates what's actually connected (see
// shared/constants/shipping.ts for the source of truth on carriers).
import Icon from "./Icon.astro";

interface Props {
  logos: string[];
  label: string;
}
const { logos, label } = Astro.props;

const style: Record<string, { icon: string; color: string; bg: string }> = {
  Stripe: { icon: "card", color: "#635BFF", bg: "rgba(99,91,255,0.1)" },
  PPL: { icon: "truck", color: "#DC2626", bg: "rgba(220,38,38,0.1)" },
  Zásilkovna: { icon: "box", color: "#EA9A1A", bg: "rgba(234,154,26,0.12)" },
};
const fallback = { icon: "shop", color: "var(--accent-primary)", bg: "var(--bg-subtle)" };
const items = [...new Set(logos)].map((name) => ({ name, ...(style[name] ?? fallback) }));
---

<section class="landing integrations">
  <div class="container-lg">
    <p class="integrations-label font-mono">{label}</p>
    <div class="integrations-row">
      {items.map((item) => (
        <div class="integrations-item">
          <span class="integrations-icon" style={`color:${item.color}; background:${item.bg}`}>
            <Icon name={item.icon} size={22} />
          </span>
          <span class="integrations-name">{item.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .integrations { padding-block: 40px; border-block: 1px solid var(--border-default); }
  .integrations-label {
    text-align: center; color: var(--text-placeholder); text-transform: uppercase;
    letter-spacing: 0.08em; font-size: 11px; margin-bottom: 24px;
  }
  .integrations-row {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;
  }
  .integrations-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 20px; border: 1px solid var(--border-default); border-radius: var(--radius-full);
    background: var(--bg-page); transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .integrations-item:hover { box-shadow: var(--shadow-sm); border-color: var(--border-strong); transform: translateY(-1px); }
  .integrations-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: 50%; flex-shrink: 0;
  }
  .integrations-name { font-weight: 600; font-size: 15px; color: var(--text-primary); white-space: nowrap; }

  @media (max-width: 640px) {
    .integrations-row { gap: 12px; }
    .integrations-item { padding: 8px 16px; }
  }
</style>
