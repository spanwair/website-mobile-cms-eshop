---
import { useT } from "../../../lib/i18n";
const t = useT(Astro);
const s = t.landing.templatesShowcase;

const tabs = [
  { key: "grid", label: "Mřížka" },
  { key: "editorial", label: "Editoriál" },
  { key: "gallery", label: "Galerie" },
];
---

<section class="landing" id="templates" style="background:var(--bg-surface)">
  <div class="container-lg showcase-grid">
    <div>
      <p class="section-eyebrow">{s.eyebrow}</p>
      <h2 class="section-title">{s.title}</h2>
      <p class="section-sub" style="margin-bottom:32px">{s.sub}</p>
      <ul class="showcase-list">
        {s.items.map((item) => (
          <li>
            <strong>{item.title}</strong>
            <span>{item.desc}</span>
          </li>
        ))}
      </ul>
      <a href="/templates" class="btn btn-primary" style="margin-top:24px">{s.cta}</a>
    </div>

    <div class="showcase-visual">
      <div class="device-frame" id="templates-device">
        <div class="device-bar">
          <span class="device-dot"></span><span class="device-dot"></span><span class="device-dot"></span>
          <span class="device-url">vaseznacka.cz</span>
        </div>

        <div class="device-tabs">
          {tabs.map((tab, i) => (
            <button type="button" class="device-tab" data-tab={i}>{tab.label}</button>
          ))}
        </div>

        <div class="device-body">
          <div class="layout-panel" data-panel="0">
            <div class="mock-nav">
              <span class="mock-logo"></span>
              <span class="mock-navlink"></span>
              <span class="mock-navlink"></span>
              <span class="mock-navlink"></span>
              <span class="mock-cart">🛍</span>
            </div>
            <div class="grid-cards">
              {["Tričko", "Mikina", "Kšiltovka", "Batoh", "Ponožky", "Šátek"].map((name, i) => (
                <div class="grid-card">
                  <div class:list={["grid-card-swatch", `swatch-${i % 6}`]}></div>
                  <span class="grid-card-name">{name}</span>
                  <span class="grid-card-price">{490 + i * 60} Kč</span>
                </div>
              ))}
            </div>
          </div>

          <div class="layout-panel" data-panel="1">
            <div class="editorial-hero">
              <div class="editorial-hero-text">
                <span class="editorial-eyebrow">Nová kolekce</span>
                <span class="editorial-title">Podzim / Zima</span>
                <span class="editorial-cta">Zobrazit kolekci</span>
              </div>
              <div class="editorial-hero-media swatch-1"></div>
            </div>
            <div class="editorial-row">
              <div class="editorial-feature">
                <div class="editorial-feature-media swatch-3"></div>
                <span class="editorial-feature-caption">Redakční výběr</span>
              </div>
              <div class="editorial-feature">
                <div class="editorial-feature-media swatch-4"></div>
                <span class="editorial-feature-caption">Nejprodávanější</span>
              </div>
            </div>
          </div>

          <div class="layout-panel" data-panel="2">
            <div class="gallery-grid">
              <div class="gallery-tile gallery-tile--big swatch-2"></div>
              <div class="gallery-tile swatch-5"></div>
              <div class="gallery-tile swatch-0"></div>
              <div class="gallery-tile swatch-3"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.getElementById("templates-device");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".device-tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".layout-panel"));
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let active = 0;
    let visible = true;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(i: number) {
      active = i;
      tabs.forEach((t, idx) => t.classList.toggle("is-active", idx === i));
      panels.forEach((p, idx) => p.classList.toggle("is-active", idx === i));
    }

    function restart() {
      if (timer) clearInterval(timer);
      if (reducedMotion) return;
      timer = setInterval(() => {
        if (visible) show((active + 1) % tabs.length);
      }, 3200);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        show(i);
        restart();
      });
    });

    show(0);
    restart();

    new IntersectionObserver(
      (entries) => entries.forEach((entry) => (visible = entry.isIntersecting)),
      { threshold: 0.2 },
    ).observe(root);
  }
</script>

<style>
  .showcase-grid { display: grid; gap: 48px; grid-template-columns: 1.1fr 1fr; align-items: center; }
  .showcase-list { display: flex; flex-direction: column; gap: 16px; list-style: none; }
  .showcase-list li { display: flex; flex-direction: column; gap: 2px; }
  .showcase-list strong { font-size: 15px; }
  .showcase-list span { color: var(--text-muted); font-size: 14px; }
  .showcase-visual { position: relative; }

  .device-frame {
    background: var(--bg-page);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .device-bar {
    display: flex; align-items: center; gap: 6px;
    padding: 12px 16px;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-default);
  }
  .device-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border-strong); }
  .device-url {
    margin-left: 10px; padding: 3px 12px; border-radius: var(--radius-full);
    background: var(--bg-page); color: var(--text-placeholder);
    font-size: 11px; font-family: monospace;
  }

  .device-tabs {
    display: flex; gap: 6px; padding: 10px 14px;
    border-bottom: 1px solid var(--border-default);
  }
  .device-tab {
    padding: 6px 14px; border-radius: var(--radius-full); border: 1px solid var(--border-default);
    background: var(--bg-page); color: var(--text-muted);
    font-size: 12px; font-weight: 600; cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }
  .device-tab.is-active { background: var(--accent-primary); color: #fff; border-color: var(--accent-primary); }

  .device-body { position: relative; aspect-ratio: 1; padding: 20px; }
  .layout-panel {
    position: absolute; inset: 0; padding: 20px;
    opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
    display: flex; flex-direction: column; gap: 16px;
  }
  .layout-panel.is-active { opacity: 1; pointer-events: auto; }

  .mock-nav { display: flex; align-items: center; gap: 10px; }
  .mock-logo { width: 20px; height: 20px; border-radius: 6px; background: var(--accent-primary); }
  .mock-navlink { width: 34px; height: 6px; border-radius: 3px; background: var(--border-strong); }
  .mock-cart { margin-left: auto; font-size: 14px; }

  .grid-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; flex: 1; }
  .grid-card { display: flex; flex-direction: column; gap: 4px; }
  .grid-card-swatch { aspect-ratio: 1; border-radius: 10px; }
  .grid-card-name { font-size: 11px; font-weight: 600; color: var(--text-primary); }
  .grid-card-price { font-size: 11px; color: var(--text-muted); }

  .editorial-hero { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .editorial-hero-text { display: flex; flex-direction: column; gap: 8px; justify-content: center; }
  .editorial-eyebrow { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-primary); }
  .editorial-title { font-size: 20px; font-weight: 800; color: var(--text-primary); }
  .editorial-cta { font-size: 11px; font-weight: 600; color: var(--accent-primary); }
  .editorial-hero-media { border-radius: 14px; min-height: 90px; }
  .editorial-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; flex: 1; }
  .editorial-feature { display: flex; flex-direction: column; gap: 6px; }
  .editorial-feature-media { border-radius: 12px; flex: 1; }
  .editorial-feature-caption { font-size: 10px; color: var(--text-muted); font-weight: 600; }

  .gallery-grid { display: grid; grid-template-columns: 1.4fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px; flex: 1; }
  .gallery-tile { border-radius: 12px; }
  .gallery-tile--big { grid-row: 1 / 3; }

  .swatch-0 { background: linear-gradient(135deg, #EEF2FF, #C7D2FE); }
  .swatch-1 { background: linear-gradient(135deg, #ECFDF5, #A7F3D0); }
  .swatch-2 { background: linear-gradient(135deg, #FFF7ED, #FED7AA); }
  .swatch-3 { background: linear-gradient(135deg, #FDF4FF, #F0ABFC); }
  .swatch-4 { background: linear-gradient(135deg, #EFF6FF, #93C5FD); }
  .swatch-5 { background: linear-gradient(135deg, #FEF2F2, #FCA5A5); }

  @media (max-width: 900px) {
    .showcase-grid { grid-template-columns: 1fr; }
  }
</style>
