# Cloudflare Workers static-asset cache headers.
# Default for assets is "public, max-age=0, must-revalidate", which forces the
# browser to revalidate every file on every navigation. For the render-blocking
# /_astro/*.css bundles that stall (observed 6s+ on real connections) caused a
# flash of unstyled content. These filenames are content-hashed by Astro, so a
# changed file always gets a new URL — caching them forever is safe.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable-named static media: cache a day, then revalidate.
/img/*
  Cache-Control: public, max-age=86400
/demo-media/*
  Cache-Control: public, max-age=86400
/logo-delivery-providers/*
  Cache-Control: public, max-age=86400
/favicon.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
