# Supabase — production project
PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY

# DB connection string for db-push.sh (Dashboard → Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY
# Base domain for storefront subdomains (store-slug.PUBLIC_APP_DOMAIN)
PUBLIC_APP_DOMAIN=yourdomain.cz
# Server-only — Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY

EXPO_PUBLIC_VERSION=1.0.0
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend transactional email — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.cz
# Inbox that receives /landingpage lead-capture and contact-form emails
LEADS_INBOX=founders@yourdomain.cz

# Public shop URL (used in emails for links)
PUBLIC_SHOP_URL=https://yourdomain.cz

# Shared secret checked by POST /api/cron/monthly-platform-fees against the x-cron-secret
# header — generate a random value (e.g. `openssl rand -hex 32`). After deploying, also run
# once in the Supabase SQL editor (values are per-environment, so not stored in this file):
#   ALTER DATABASE postgres SET app.settings.site_url = 'https://yourdomain.cz';
#   ALTER DATABASE postgres SET app.settings.cron_secret = '<same value as below>';
# See supabase/migrations/20260103000073_monthly_fee_cron.sql for details.
CRON_SECRET=

# Shipping — PPL CPL API. Not self-serve: request client_id/client_secret from a PPL
# sales rep (ithelp@ppl.cz) or via https://developer.ppl.cz. PPL does publish a public
# sandbox (https://sandbox.ppl.cz) and its full OpenAPI spec is fetchable without auth at
# https://api-sandbox.dhl.com/ecs/ppl/sandbox/swagger/cpl/localizedSwagger.json — use that
# to verify request/response shapes (ppl.ts/pplHelpers.ts) against any future CPL API
# changes. Sandbox login itself still requires emailing CISteam@ppl.cz first.
PPL_CLIENT_ID=
PPL_CLIENT_SECRET=
PPL_API_BASE_URL=https://api.dhl.com/ecs/ppl/myapi2
# Gates REAL billable shipment creation (createShipment/label/cancel/return). The creds
# above are ALSO used read-only for the pickup-point map + server-side validation
# (GET /accessPoint), which is free — that works regardless of this flag. Set "true" here
# in production to actually book parcels; leave empty in dev so booking stays mocked.
PPL_LIVE_BOOKING=true

# PPL Widget 2.0 (pickup-point map) key — separate from the CPL API credentials above.
# Requires an actual PPL business account: register at "Stát se zákazníkem" on ppl.cz,
# then generate the key at https://klient.ppl.cz/widgetadmin. Unlike Packeta's widget,
# PPL's validates the key server-side immediately on load (fails hard with "Neplatný API
# klíč" on anything invalid/placeholder) — there is no way to preview the real map without
# a genuine key. Full implementation docs: https://ppl-widget2.apidog.io
PUBLIC_PPL_WIDGET_API_KEY=

# Shipping — Packeta / Zásilkovna. Not self-serve: apiPassword + apiKey come from a real
# Zásilkovna merchant account (client.packeta.com) or e-commerce.support@packeta.com.
PACKETA_API_PASSWORD=
PACKETA_SENDER_LABEL=
PUBLIC_PACKETA_WIDGET_API_KEY=

# Shipping — when the secrets above are empty, PPL/Packeta calls use a built-in mock
# provider (visibly marked "TEST MODE" in admin) instead of failing. Set to "false"
# only once real carrier credentials are in place above.
PUBLIC_SHIPPING_MOCK_MODE=true
