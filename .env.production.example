# Supabase — production project
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY

# DB connection string for db-push.sh (Dashboard → Settings → Database → Connection string)
SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

PUBLIC_SUPABASE_URL=https://YOUR_PROD_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR_PROD_ANON_KEY
# Base domain for storefront subdomains (store-slug.PUBLIC_APP_DOMAIN)
PUBLIC_APP_DOMAIN=yourdomain.cz
# Server-only — Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY

EXPO_PUBLIC_VERSION=1.0.0
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend transactional email — https://resend.com/api-keys
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.cz
# Inbox that receives /landingpage lead-capture and contact-form emails
LEADS_INBOX=founders@yourdomain.cz

# Public shop URL (used in emails for links)
PUBLIC_SHOP_URL=https://yourdomain.cz
