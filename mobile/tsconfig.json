{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"],
      "@supabase/supabase-js": ["./node_modules/@supabase/supabase-js"],
      "@supabase/supabase-js/*": ["./node_modules/@supabase/supabase-js/*"],
      "i18next": ["./node_modules/i18next"],
      "react-i18next": ["./node_modules/react-i18next"],
      "react-i18next/*": ["./node_modules/react-i18next/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts", "../shared/**/*.ts"]
}
